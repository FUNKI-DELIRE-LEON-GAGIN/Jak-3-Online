;; rayons de la boutique du Naughty Ottsel (les vehicules et pouvoirs sont dans le menu SELECT)
;; 76-81 : ameliorations (secrets du jeu) ; 82-93 : teleportations (consommables, mode 10 + lieu)
(defun ow-shop-extra-init! ()
  (let ((fr (new 'static 'boxed-array :type string
              "Capacite munitions jaunes" "Capacite munitions rouges" "Capacite munitions bleues"
              "Capacite munitions noires" "Turbo JetBoard dans le desert" "Vehicules renforces"))
        (en (new 'static 'boxed-array :type string
              "Yellow ammo capacity" "Red ammo capacity" "Blue ammo capacity"
              "Dark ammo capacity" "Desert JetBoard turbo" "Tougher vehicles"))
        (bits (new 'static 'array int8 6 55 54 56 57 29 28))
        )
    (dotimes (i 6)
      (set! (-> *ow-shop-names* (+ 76 i)) (-> fr i))
      (set! (-> *ow-shop-names-en* (+ 76 i)) (-> en i))
      (set! (-> *ow-shop-kind* (+ 76 i)) 2)
      (set! (-> *ow-shop-bit* (+ 76 i)) (-> bits i))
      )
    )
  ;; 54-58 : personnages (objets a nous, bits 9-13)
  (let ((nm (new 'static 'boxed-array :type string "Jak 2" "Jak 1 HD" "Jak 4" "Tess" "Daxter")))
    (dotimes (i 5)
      (set! (-> *ow-shop-names* (+ 54 i)) (-> nm i))
      (set! (-> *ow-shop-names-en* (+ 54 i)) (-> nm i))
      (set! (-> *ow-shop-kind* (+ 54 i)) 4)
      (set! (-> *ow-shop-bit* (+ 54 i)) (+ 9 i))
      )
    )
  ;; 96-98 : MAISONS (objets a nous, bits 14-16) ; 99-103 : STYLE (bits 17-21, secrets du jeu)
  (let ((fr (new 'static 'boxed-array :type string
              "Maison : cabane dans les bois" "Maison : villa au bord de l'eau" "Maison : chateau"
              "Grosse tete" "Petite tete" "Pantalon pour Daxter" "Monde miroir" "Sans barbe (Jak)"))
        (en (new 'static 'boxed-array :type string
              "House: forest cabin" "House: seaside villa" "House: castle"
              "Big head" "Small head" "Daxter's pants" "Mirror world" "No goatee (Jak)"))
        )
    (dotimes (i 8)
      (set! (-> *ow-shop-names* (+ 96 i)) (-> fr i))
      (set! (-> *ow-shop-names-en* (+ 96 i)) (-> en i))
      (set! (-> *ow-shop-kind* (+ 96 i)) 4)
      (set! (-> *ow-shop-bit* (+ 96 i)) (+ 14 i))
      )
    )
  ;; 105..108 : personnages ASHELIN, TORN, SIG, SAMOS (objets a nous, bits 23..26)
  (let ((nm (new 'static 'boxed-array :type string "Ashelin" "Torn" "Sig" "Samos")))
    (dotimes (i 4)
      (set! (-> *ow-shop-names* (+ 105 i)) (-> nm i))
      (set! (-> *ow-shop-names-en* (+ 105 i)) (-> nm i))
      (set! (-> *ow-shop-kind* (+ 105 i)) 4)
      (set! (-> *ow-shop-bit* (+ 105 i)) (+ 23 i))
      )
    )
  ;; 114..127 : ACCESSOIRES (1.3 ; sorte 7, bits 0..13 de cosm-owned)
  (let ((fr (new 'static 'boxed-array :type string
              "Casquette" "Chapeau de cowboy" "Haut-de-forme" "Casque de guerrier" "Cornes de demon"
              "Couronne d'or" "Aureole" "Lunettes de soleil" "Masque de ninja" "Masque de fer"
              "Sac a dos" "Cape rouge" "Ailes d'ange" "Ailes de demon"))
        (en (new 'static 'boxed-array :type string
              "Cap" "Cowboy hat" "Top hat" "Warrior helmet" "Demon horns"
              "Golden crown" "Halo" "Sunglasses" "Ninja mask" "Iron mask"
              "Backpack" "Red cape" "Angel wings" "Demon wings"))
        )
    (dotimes (i 14)
      (set! (-> *ow-shop-names* (+ 114 i)) (-> fr i))
      (set! (-> *ow-shop-names-en* (+ 114 i)) (-> en i))
      (set! (-> *ow-shop-kind* (+ 114 i)) 7)
      (set! (-> *ow-shop-bit* (+ 114 i)) i)
      )
    )
  ;; 109..113 : les nouvelles MAISONS (objets a nous, bits 27..31)
  (let ((fr (new 'static 'boxed-array :type string
              "Maison : maison en cubes" "Maison : manoir" "Maison : penthouse du gratte-ciel"
              "Maison : temple precurseur" "Maison : PALAIS DE L'ILE"))
        (en (new 'static 'boxed-array :type string
              "House: block house" "House: manor" "House: skyscraper penthouse"
              "House: Precursor temple" "House: ISLAND PALACE"))
        )
    (dotimes (i 5)
      (set! (-> *ow-shop-names* (+ 109 i)) (-> fr i))
      (set! (-> *ow-shop-names-en* (+ 109 i)) (-> en i))
      (set! (-> *ow-shop-kind* (+ 109 i)) 4)
      (set! (-> *ow-shop-bit* (+ 109 i)) (+ 27 i))
      )
    )
  ;; 104 : le HELLCAT pilotable (vole !), objet a nous (bit 22)
  (set! (-> *ow-shop-names* 104) "HELLCAT (vole partout)")
  (set! (-> *ow-shop-names-en* 104) "HELLCAT (flies anywhere)")
  (set! (-> *ow-shop-kind* 104) 4)
  (set! (-> *ow-shop-bit* 104) 22)
  (dotimes (i 12)
    (set! (-> *ow-shop-names* (+ 82 i)) (-> *ow-race-names* i))
    (set! (-> *ow-shop-names-en* (+ 82 i)) (-> *ow-race-names-en* i))
    (set! (-> *ow-shop-kind* (+ 82 i)) 5)
    (set! (-> *ow-shop-bit* (+ 82 i)) (+ 10 i))
    )
  (none)
  )

(define *ow-shop-cat-first* (new 'static 'array int8 7 0 12 24 28 34 39 60))
(define *ow-shop-cat-last* (new 'static 'array int8 7 11 23 27 32 38 42 62))
(defconstant OW_SHOP_CATS 7)

(defun ow-shop-cat-name ((c int))
  (case c
    ((0) (online-fr "ARMES" "WEAPONS"))
    ((1) (online-fr "CHARGEURS ET DEGATS" "AMMO AND DAMAGE"))
    ((2) "JETBOARD")
    ((3) "DARK JAK")
    ((4) "LIGHT JAK")
    ((5) (online-fr "ARMURES" "ARMOR"))
    (else (online-fr "SOINS" "HEALTH"))
    )
  )

(defun ow-item-name ((id int))
  ;; vehicules du desert : le nom du jeu (juste dans toutes ses langues)
  (let ((tid (case id
               ((43) (text-id progress-inventory-v-turtle))
               ((44) (text-id progress-inventory-v-toad))
               ((45) (text-id progress-inventory-v-snake))
               ((46) (text-id progress-inventory-v-scorpion))
               ((47) (text-id progress-inventory-v-rhino))
               ((48) (text-id progress-inventory-v-fox))
               ((49) (text-id progress-inventory-v-mirage))
               ((50) (text-id progress-inventory-v-x-ride))
               (else (text-id null))
               )
             )
        )
    (if (and (!= tid (text-id null)) *common-text*)
        (lookup-text! *common-text* tid #f)
        (online-fr (-> *ow-shop-names* id) (-> *ow-shop-names-en* id))
        )
    )
  )

(defun ow-price ((id int))
  (let ((ext *online-ext*))
    (cond
      ((< id 64) (-> ext prices id))
      ((< id 96) (-> ext prices-hi (- id 64)))
      (else (-> ext prices-x (- id 96)))
      )
    )
  )

(defun ow-req-level ((id int))
  (if (< id 96)
      (the-as int (-> *online-ext* req-level id))
      (the-as int (-> *online-ext* req-level-x (- id 96)))
      )
  )

(defun ow-owned? ((id int))
  (let ((ext *online-ext*)
        (bit (-> *ow-shop-bit* id))
        )
    (case (-> *ow-shop-kind* id)
      ((1) (logtest? (the-as int (-> ext features)) (ash 1 bit)))
      ((2) (logtest? (the-as int (-> ext secrets)) (ash 1 bit)))
      ((3) (logtest? (-> ext vehicles) (ash 1 bit)))
      ((4) (logtest? (-> ext items) (ash 1 bit)))
      ((7) (logtest? (-> ext cosm-owned) (ash 1 bit)))
      (else #f)
      )
    )
  )

(defun ow-level-ok? ((id int))
  (<= (ow-req-level id) (the-as int (-> *online-ext* level)))
  )

(define-extern ow-shop-zone? (function object))

(defun ow-remote-buy? ((id int))
  "objet du Naughty Ottsel (armes, planche, Dark / Light Jak, armures) achete hors de la boutique"
  (the-as symbol (and (>= id 0) (<= id 42) (not (ow-shop-zone?))))
  )

(defun ow-price-here ((id int))
  "prix ici : +50 % a distance pour les objets du Naughty Ottsel (le programme compte pareil)"
  (let ((p (the-as int (ow-price id))))
    (if (ow-remote-buy? id)
        (/ (* 3 p) 2)
        p
        )
    )
  )

(defun ow-buy! ((id int))
  "demande d'achat (verifiee par Jak3Online.exe) ; #t si envoyee"
  (let ((kind (-> *ow-shop-kind* id))
        (req (-> *ow-shop-req* id))
        )
    (cond
      ((and (!= kind 5) (!= kind 6) (ow-owned? id))
       (sound-play "generic-beep")
       #f
       )
      ((< 200 (ow-req-level id))
       (sound-play "generic-beep")
       (ow-hint! (online-fr "Interdit dans le monde en ligne" "Not allowed in the online world"))
       #f
       )
      ((and (= kind 6) (ow-parkour-now?))
       ;; super-pouvoirs : pas sur un parcours (pas de raccourci)
       (sound-play "generic-beep")
       (ow-hint! (online-fr "Pas de super-pouvoirs sur un parcours" "No super powers on a parkour"))
       #f
       )
      ((not (ow-level-ok? id))
       (sound-play "generic-beep")
       (format (clear (-> *online-world* str3)) (online-fr "Niveau ~D requis" "Level ~D required") (ow-req-level id))
       (ow-hint! (-> *online-world* str3))
       #f
       )
      ((and (>= req 0) (not (ow-owned? req)))
       (sound-play "generic-beep")
       (ow-hint! (online-fr "Achete d'abord l'objet requis" "Buy the required item first"))
       #f
       )
      ((< (-> *online-ext* money) (ow-price-here id))
       (sound-play "generic-beep")
       (ow-hint! (online-fr "Pas assez d'orbes" "Not enough orbs"))
       #f
       )
      ((and (>= id 82) (<= id 93) (or (ow-map-inside?) (not *target*) (focus-test? *target* dead)))
       (sound-play "generic-beep")
       (ow-hint! (online-fr "Teleportation impossible ici" "Can't teleport from here"))
       #f
       )
      (else
        ;; player-id 1 = achat a distance (+50 % sur les objets du Naughty Ottsel)
        (online-push-out-event! ONLINE_EVENT_BUY (the-as uint (if (ow-remote-buy? id) 1 0)) 0.0 id (the-as vector #f))
        (sound-play "skill-pickup")
        #t
        )
      )
    )
  )

(defun ow-item-state ((dst string) (id int))
  "texte de droite : prix / achete / niveau requis"
  (let ((kind (-> *ow-shop-kind* id))
        (req (-> *ow-shop-req* id))
        )
    (clear dst)
    (cond
      ((and (!= kind 5) (!= kind 6) (ow-owned? id))
       (format dst (if (= kind 3) (online-fr "APPELER" "CALL") (online-fr "ACHETE" "OWNED")))
       )
      ((= kind 6)
       (let ((left (-> *online-ext* power-left (-> *ow-shop-bit* id))))
         (cond
           ((< 0.0 left) (format dst (online-fr "ACTIF ~Ds  (+~D)" "ON ~Ds  (+~D)") (the int left) (ow-price id)))
           ((not (ow-level-ok? id)) (format dst (online-fr "Nv~D requis" "Lv~D needed") (ow-req-level id)))
           (else (format dst (online-fr "~D orbes" "~D orbs") (ow-price id)))
           )
         )
       )
      ((< 200 (ow-req-level id)) (format dst (online-fr "INTERDIT" "BANNED")))
      ((not (ow-level-ok? id)) (format dst (online-fr "Nv~D requis" "Lv~D needed") (ow-req-level id)))
      ((and (>= req 0) (not (ow-owned? req))) (format dst (online-fr "requis : ~S" "needs: ~S") (ow-item-name req)))
      ((zero? (ow-price-here id)) (format dst (online-fr "GRATUIT" "FREE")))
      (else (format dst (if (ow-remote-buy? id) (online-fr "~D orbes (a distance)" "~D orbs (remote)") (online-fr "~D orbes" "~D orbs")) (ow-price-here id)))
      )
    )
  dst
  )

(defun ow-item-color ((id int))
  (let ((kind (-> *ow-shop-kind* id)))
    (cond
      ((and (!= kind 5) (!= kind 6) (ow-owned? id)) (font-color green))
      ((or (not (ow-level-ok? id)) (< 200 (ow-req-level id))) (font-color font-color-44))
      ((< (-> *online-ext* money) (ow-price-here id)) (font-color red))
      (else (font-color flat-yellow))
      )
    )
  )

(defun ow-shop-zone? ()
  "Jak est dans le Naughty Ottsel"
  (and (-> *online-world* active)
       *target*
       (-> *target* current-level)
       (= (-> *target* current-level name) 'hiphog)
       (not (focus-test? *target* dead pilot))
       )
  )

(defun ow-shop-input! ()
  (let* ((w *online-world*)
         (cat (-> w shop-cat))
         (first (-> *ow-shop-cat-first* cat))
         (count (+ (- (-> *ow-shop-cat-last* cat) first) 1))
         )
    (cond
      ((or (ow-key? ONLINE_KEY_ESC) (ow-key? ONLINE_KEY_TAB) (cpad-pressed? 0 circle) (cpad-pressed? 0 triangle))
       (set! (-> w shop-open) #f)
       (ow-kb-on-later!)
       (sound-play "window-contract")
       )
      ((or (ow-key? ONLINE_KEY_LEFT) (cpad-pressed? 0 left) (cpad-pressed? 0 l1))
       (set! (-> w shop-cat) (if (> cat 0) (+ cat -1) (+ OW_SHOP_CATS -1)))
       (set! (-> w shop-row) 0)
       (sound-play "roll-over")
       )
      ((or (ow-key? ONLINE_KEY_RIGHT) (cpad-pressed? 0 right) (cpad-pressed? 0 r1))
       (set! (-> w shop-cat) (if (< cat (+ OW_SHOP_CATS -1)) (+ cat 1) 0))
       (set! (-> w shop-row) 0)
       (sound-play "roll-over")
       )
      ((or (ow-key? ONLINE_KEY_UP) (cpad-pressed? 0 up))
       (set! (-> w shop-row) (if (> (-> w shop-row) 0) (+ (-> w shop-row) -1) (+ count -1)))
       (sound-play "roll-over")
       )
      ((or (ow-key? ONLINE_KEY_DOWN) (cpad-pressed? 0 down))
       (set! (-> w shop-row) (if (< (-> w shop-row) (+ count -1)) (+ (-> w shop-row) 1) 0))
       (sound-play "roll-over")
       )
      ((or (ow-key? ONLINE_KEY_ENTER) (cpad-pressed? 0 x))
       (ow-buy! (+ first (-> w shop-row)))
       )
      )
    )
  (none)
  )

(defun ow-shop-draw! ()
  (let* ((w *online-world*)
         (ext *online-ext*)
         (s (-> w str))
         (cat (-> w shop-cat))
         (first (-> *ow-shop-cat-first* cat))
         (last (-> *ow-shop-cat-last* cat))
         (x 76.0)
         (y 34.0)
         )
    (ow-box x y 360.0 318.0 0 0 0 120)
    (ow-box x y 360.0 2.0 255 160 0 128)
    (ow-text-mid (online-fr "BOUTIQUE DU NAUGHTY OTTSEL" "NAUGHTY OTTSEL SHOP") (+ y 6.0) 0.55 (font-color flat-yellow))
    (format (clear s) "~33L~C ~S ~33L~C" 163 (ow-shop-cat-name cat) 161)
    (ow-text-mid s (+ y 30.0) 0.42 (font-color white))
    (format (clear s) (online-fr "TES ORBES : ~D   -   NIVEAU ~D" "YOUR ORBS: ~D   -   LEVEL ~D") (-> ext money) (-> ext level))
    (ow-text-mid s (+ y 46.0) 0.38 (font-color flat-yellow))
    (let ((yy (+ y 66.0)))
      (dotimes (k (+ (- last first) 1))
        (let* ((id (+ first k))
               (sel (= k (-> w shop-row)))
               )
          (if sel
              (ow-box (+ x 6.0) (+ yy -2.0) 348.0 16.0 255 160 0 48)
              )
          (ow-text (ow-item-name id) (+ x 14.0) yy 0.38 (if sel (font-color font-color-33) (font-color white)))
          (ow-text (ow-item-state (-> w str2) id) (+ x 226.0) (+ yy 1.0) 0.32 (ow-item-color id))
          (set! yy (+ yy 17.0))
          )
        )
      )
    (ow-text-mid (online-fr "X / ENTREE : acheter    GAUCHE / DROITE : rayon    ROND / ECHAP : sortir"
                            "X / ENTER: buy    LEFT / RIGHT: aisle    CIRCLE / ESC: leave"
                            )
                 (+ y 300.0)
                 0.28
                 (font-color font-color-32)
                 )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; vehicules : chacun appelle les siens
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; VEHICULES PARTOUT : le code et les modeles (art du jeu) de tous les vehicules du desert et de
;; Haven sont charges en permanence (GAME.CGO, voir dgos/game.gd). Seuls leurs maillages pour le
;; rendu PC restent dans le FR3 de leur niveau d'origine : on demande au rendu de le charger
;; (*online-extra-fr3*, voir engine/level/level.gc) quand un vehicule en a besoin.

;; l'art de ces vehicules n'est plus dans leur niveau (desert, ville) mais dans GAME : leurs
;; squelettes doivent aller le chercher dans le niveau par defaut, sinon le jeu essaie de le
;; charger depuis le disque et se bloque. texture-level 11 (ajoute dans process-drawable.gc) :
;; art pris dans GAME, mais dessine dans les files du niveau du vehicule (celles du niveau par
;; defaut n'ont pas tous les rendus sur PC : le jeu plantait avec certains vehicules).
(define *ow-resident-art*
  (new 'static 'boxed-array :type string
    "turtle" "snake" "scorpion" "toad" "fox" "rhino" "bikea" "bikeb" "bikec" "newbike" "cara" "carb" "carc"
    "vehicle-explosion" "hellcat"
    )
  )

(defun ow-patch-resident-skels! ()
  (let ((arr (-> *level* level-default art-group art-group-array))
        (n 0)
        )
    (dotimes (k (-> arr length))
      (let ((e (-> arr k)))
        (when (and e (nonzero? e) (type? e skeleton-group))
          (let ((sg (the-as skeleton-group e)))
            (dotimes (i (-> *ow-resident-art* length))
              (when (string= (-> sg art-group-name) (-> *ow-resident-art* i))
                (set! (-> sg texture-level) 11)
                (+! n 1)
                )
              )
            )
          )
        )
      )
    (format 0 "[jak3-online] vehicules partout : ~D squelettes rattaches a GAME~%" n)
    )
  (none)
  )

(ow-patch-resident-skels!)

(defun ow-veh-fr3 ((vt int))
  "niveau dont le FR3 porte le maillage de ce type de vehicule"
  (cond
    ((and (>= vt 12) (<= vt 19)) "wasall")
    ((<= vt 2) "ctycarb")
    ((<= vt 5) "ctycara")
    ((= vt 6) "ctywide")
    ((= vt 7) "ctycarc")
    ((= vt 8) "ctycarc") ;; Hellcat (h-warf)
    (else "")
    )
  )

(defun ow-skel-fr3 ((name string))
  "idem a partir du nom du squelette (vehicules des autres joueurs)"
  (cond
    ((ow-prefix? name "skel-v-") "wasall")
    ((ow-prefix? name "skel-h-bike-d") "ctywide")
    ((ow-prefix? name "skel-h-bike") "ctycarb")
    ((ow-prefix? name "skel-h-car") "ctycara")
    ((ow-prefix? name "skel-h-hellcat") "ctycarc")
    ((ow-prefix? name "skel-h-warf") "ctycarc")
    ;; meme modele "hellcat" enregistre sous d'autres noms (cinematiques, oasis)
    ((ow-prefix? name "skel-hellcat") "ctycarc")
    ((ow-prefix? name "skel-desoasis-hellcat") "ctycarc")
    (else "")
    )
  )

(define-extern oe-event-pos (function vector vector))
(define-extern oe-boss-pos (function vector vector))
(define-extern ow-map-inside? (function symbol))
(define-extern ow-map-join! (function none))
(define-extern ow-map-leave! (function none))
(define-extern ow-maps-tick! (function none))
(define-extern ow-maisons-test! (function int none))
(define-extern ow-evk-map? (function int symbol))
(defconstant OW_MAP_CIRCUIT 16)
(defconstant OW_MAP_HIDE 12)
(define-extern online-coll-test! (function int none))
(define-extern online-coll-test-tick! (function none))

(define-extern online-maps-test! (function int none))
(define-extern ow-mer-test! (function int none))
(define-extern ow-boss-fr3 (function int string))

(defun ow-fr3-want! ((name string))
  (when (nonzero? (length name))
    (let ((arr *online-extra-fr3*)
          (have #f)
          (free -1)
          )
      (dotimes (i (-> arr length))
        (if (string= (-> arr i) name)
            (set! have #t)
            )
        (if (and (< free 0) (zero? (length (-> arr i))))
            (set! free i)
            )
        )
      (if (and (not have) (>= free 0))
          (set! (-> arr free) name)
          )
      )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; PAS DE TRICHE : les secrets du jeu (invincibilite, munitions infinies, Dark / Light Jak
;; illimites, turbo, invisibilite...) sont retires du menu et coupes a chaque image, partout.
;; Seul le CREATEUR peut s'en servir, depuis ADMIN (dans une session). Idem mode debug.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; triches PC d'OpenGOAL interdites en session : planche turbo, vehicule invincible, aspirer tout,
;; vitesse rapide / lente, voyage rapide, figures, meteo, paix au desert (on garde barres de vie,
;; statistiques, lecteur de musique, heure reelle, paix a Haven, sans textures, suivi des orbes)
(defconstant OW_PC_CHEATS_BANNED #x3c729)
(defconstant OW_CHEAT_COUNT 5)
(define *ow-admin-cheats* 0) ;; bits : 0 invincible, 1 munitions, 2 dark illimite, 3 light illimite, 4 debug

;; secrets de triche du jeu (game-secrets) : 16 munitions, 17 invincible, 18 dark, 19 light,
;; 27 turbos illimites, 37 dark jak guide, 40 invisibilite (28 et 29 se vendent a la boutique)
(defconstant OW_CHEAT_SECRETS #x120080f0000)

(defun ow-cheat-name ((i int))
  (case i
    ((0) (online-fr "Triche createur : INVINCIBLE" "Creator cheat: INVINCIBLE"))
    ((1) (online-fr "Triche createur : munitions infinies" "Creator cheat: endless ammo"))
    ((2) (online-fr "Triche createur : Dark Jak illimite" "Creator cheat: endless Dark Jak"))
    ((3) (online-fr "Triche createur : Light Jak illimite" "Creator cheat: endless Light Jak"))
    (else (online-fr "Triche createur : MODE DEBUG" "Creator cheat: DEBUG MODE"))
    )
  )

(define *ow-cheat-seen* 0)
(defun ow-cheats-detect! ()
  "au tout debut de l'image, AVANT que le monde en ligne remette l'inventaire du profil : une
   triche activee (memoire modifiee, console, menus, mode debug) est signalee au programme
   (ce joueur ne gagne plus rien dans le monde en ligne)"
  (let ((gi *game-info*))
    (when (and (online-in-session?) (not (ow-createur?)))
      (when (and (or (and gi (logtest? (the-as int (-> gi secrets)) OW_CHEAT_SECRETS))
                     (logtest? (the-as int (-> *pc-settings* cheats)) OW_PC_CHEATS_BANNED)
                     (= *cheat-mode* 'debug)
                     *debug-unkillable*
                     )
                 (< (seconds 5) (- (online-now) *ow-cheat-seen*))
                 )
        (set! *ow-cheat-seen* (online-now))
        (online-push-out-event! ONLINE_EVENT_CHEAT (the-as uint 0) 0.0 (if (= *cheat-mode* 'debug) 1 4) (the-as vector #f))
        )
      )
    )
  (none)
  )

(defun ow-cheats-tick! ()
  (ow-cheats-detect!)
  (let* ((gi *game-info*)
         (boss? (and (online-in-session?) (ow-createur?)))
         (on (if boss? *ow-admin-cheats* 0))
         (want 0)
         )
    (if (not boss?)
        (set! *ow-admin-cheats* 0)
        )
    ;; triche vue AVANT qu'on la coupe (memoire modifiee, console, menus) : signalee au programme
    ;; (plus aucun gain dans le monde en ligne pour ce joueur)
    (when (and (online-in-session?) (not boss?))
      (set! (-> *pc-settings* cheats)
            (the-as pc-cheats (logclear (the-as int (-> *pc-settings* cheats)) OW_PC_CHEATS_BANNED))
            )
      )
    (if (logtest? on 1) (set! want (logior want (ash 1 17))))
    (if (logtest? on 2) (set! want (logior want (ash 1 16))))
    (if (logtest? on 4) (set! want (logior want (ash 1 18))))
    (if (logtest? on 8) (set! want (logior want (ash 1 19))))
    (when gi
      (set! (-> gi secrets) (the-as game-secrets (logior (logclear (the-as int (-> gi secrets)) OW_CHEAT_SECRETS) want)))
      (set! (-> gi purchase-secrets) (the-as game-secrets (logclear (the-as int (-> gi purchase-secrets)) OW_CHEAT_SECRETS)))
      )
    ;; mode debug et invincibilite de debug : createur seulement
    (cond
      ((logtest? on 16)
       (set! *cheat-mode* 'debug)
       )
      ((= *cheat-mode* 'debug)
       (set! *cheat-mode* #f)
       )
      )
    (when (not (logtest? on 16))
      (set! *debug-unkillable* #f)
      (set! *debug-player-vehicle-unkillable* #f)
      )
    ;; banc de test : triches actives ici (1 secrets, 2 mode debug)
    (set! (-> *online-shm* local pad 21)
          (the-as uint (logior (if (and gi (logtest? (the-as int (-> gi secrets)) OW_CHEAT_SECRETS)) 1 0) (if *cheat-mode* 2 0)))
          )
    )
  (none)
  )

(define *ow-owcom-sticky* #f)

(defun ow-fr3-update! ()
  "maillages dont on a besoin : mon vehicule et ceux des joueurs autour"
  (let ((arr *online-extra-fr3*)
        (w *online-world*)
        )
    (dotimes (i (-> arr length))
      (set! (-> arr i) "")
      )
    (if (not (online-in-session?))
        (set! *ow-owcom-sticky* #f)
        )
    (when (online-in-session?)
      ;; vrai boss en cours (robot, titan, bete) : son maillage
      (if (and (= (-> *online-ext* ev-state) 1) (= (-> *online-ext* ev-kind) ONLINE_EVK_BOSS))
          (ow-fr3-want! (ow-boss-fr3 (the-as int (-> *online-ext* ev-boss))))
          )
      (if (and (>= (-> w veh-vt) 0) (handle->process (-> w veh-last)))
          (ow-fr3-want! (ow-veh-fr3 (-> w veh-vt)))
          )
      ;; personnages joues (moi ou les joueurs autour) : leur maillage est dans owcom.fr3
      ;; une fois charge, owcom.fr3 reste charge toute la session (le decharger et le recharger
      ;; a chaque changement de personnage fait disparaitre des maillages chez certains)
      ;; (et les ACCESSOIRES portes : leurs maillages aussi)
      (let ((need (or *ow-owcom-sticky* (> *ow-perso-cur* 0) (> (ow-acc-packed) 0))))
        (dotimes (i ONLINE_MAX_PUPPETS)
          (let ((p (online-puppet-proc i)))
            (if (and p (or (> (-> p perso) 0) (> (-> p wear) 0)))
                (set! need #t)
                )
            )
          )
        (when need
          (set! *ow-owcom-sticky* #t)
          (ow-fr3-want! "owcom")
          )
        )
      (when (-> w veh-wait)
        (ow-fr3-want! (ow-veh-fr3 (-> w veh-vt)))
        )
      (dotimes (i ONLINE_MAX_PUPPETS)
        (let ((p (online-puppet-proc i)))
          (when p
            (dotimes (j ONLINE_MAX_OBJECTS)
              (when (nonzero? (-> p obj-name (* j 32)))
                (ow-fr3-want!
                  (ow-skel-fr3 (online-chars->string (-> w str3) (the-as (pointer uint8) (&-> p obj-name (* j 32))) 32))
                  )
                )
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun ow-vehicle-host ((vt int))
  "niveau auquel on rattache le vehicule appele : il doit rester charge pendant qu'on roule
   (jamais le niveau par defaut du jeu, sur lequel un vehicule ne peut pas vivre)"
  (let ((native (-> *traffic-info* vehicle-levels vt)))
    (cond
      ((and native (let ((lev (level-get *level* native))) (and lev (= (-> lev status) 'active))))
       native
       )
      ((ow-level-active? "wasall") 'wasall)
      ((ow-level-active? "ctywide") 'ctywide)
      ((ow-level-active? "waswide") 'waswide)
      (else
        (let ((lev (level-get-target-inside *level*)))
          (if (and lev
                   (-> lev name)
                   (= (-> lev status) 'active)
                   (not (member (-> lev name) '(hiphog onintent freehq title)))
                   )
              (-> lev name)
              (the-as symbol #f)
              )
          )
        )
      )
    )
  )

(defun ow-vehicle-type-ok? ((vt int))
  "peut-on creer ce vehicule ici ? (il faut un niveau pour le porter)"
  (the-as symbol (ow-vehicle-host vt))
  )

(defun ow-vehicle-for-item ((id int))
  "type de vehicule pour un objet de la boutique (-1 si ce n'est pas un vehicule)"
  (case id
    ((43) 12)
    ((44) 15)
    ((45) 13)
    ((46) 14)
    ((47) 17)
    ((48) 16)
    ((49) 18)
    ((50) 19)
    ((51) 0)
    ((52) 3)
    ((53) 6)
    ((104) 8) ;; Hellcat (h-warf, repris du mod Jak 4)
    (else -1)
    )
  )

(define-extern *ow-veh-free* symbol)

(defun ow-vehicle-allowed? ((id int))
  "dans le monde en ligne il faut l'avoir achete ; en session privee tout est libre (et en COURSE AUTO)"
  (or *ow-veh-free* (not (-> *online-world* active)) (ow-owned? id)))

(defun ow-spawn-vehicle! ((id int))
  (let ((w *online-world*)
        (t *target*)
        (vt (ow-vehicle-for-item id))
        )
    (cond
      ((not t)
       )
      ((not (ow-vehicle-allowed? id))
       (ow-hint! (online-fr "Achete-le d'abord a la boutique du Naughty Ottsel" "Buy it first at the Naughty Ottsel shop"))
       )
      ((ow-parkour-now?)
       (ow-hint! (online-fr "Pas de vehicule sur un parcours" "No vehicles on a parkour"))
       )
      ((< vt 0)
       )
      ((not (ow-vehicle-host vt))
       (ow-hint! (online-fr "Pas ici (a l'interieur) : sors d'abord" "Not here (indoors): go outside first"))
       )
      ((focus-test? t dead pilot board mech flut dark light grabbed)
       (ow-hint! (online-fr "Impossible maintenant" "Not now"))
       )
      ((< (online-now) (-> w veh-cool))
       (ow-hint! (online-fr "Patiente un peu..." "Wait a moment..."))
       )
      (else
        (set! (-> w veh-cool) (+ (online-now) (seconds 3)))
        ;; l'ancien vehicule appele disparait (un seul a la fois, comme dans GTA)
        (let ((old (handle->process (-> w veh-last))))
          (if old
              (send-event old 'die)
              )
          )
        (set! (-> w veh-last) (the-as handle #f))
        (set! (-> w veh-wait) #t)
        (set! (-> w veh-wait-time) (online-now))
        (set! (-> w veh-vt) vt)
        ;; le vehicule vit dans un niveau qui reste charge (wasall au desert, ctywide a Haven...)
        (set! (-> *traffic-info* vehicle-levels vt) (ow-vehicle-host vt))
        ;; et le rendu doit avoir son maillage
        (ow-fr3-want! (ow-veh-fr3 vt))
        (send-event t 'change-mode 'pilot #f vt #f)
        )
      )
    )
  (none)
  )

(defun ow-vehicle-tick! ()
  "retient le vehicule qui vient d'etre appele"
  (let ((w *online-world*)
        (t *target*)
        )
    (if (not (and t (focus-test? t pilot)))
        (set! (-> w veh-since) (online-now))
        )
    ;; securite : le niveau qui porte mon vehicule appele n'est plus charge -> il disparait
    (let ((v (handle->process (-> w veh-last))))
      (when (and v (or (not (-> v level)) (!= (-> v level status) 'active)))
        (cond
          ((and t (focus-test? t pilot))
           (send-event t 'end-mode 'pilot)
           )
          (else
            (deactivate v)
            (set! (-> w veh-last) (the-as handle #f))
            )
          )
        )
      )
    (when (-> w veh-wait)
      (cond
        ((< (seconds 6) (- (online-now) (-> w veh-wait-time)))
         (set! (-> w veh-wait) #f)
         )
        ((and t (focus-test? t pilot) (nonzero? (-> t pilot)) (handle->process (-> t pilot vehicle)))
         (set! (-> w veh-last) (-> t pilot vehicle))
         (set! (-> w veh-wait) #f)
         )
        )
      )
    )
  (none)
  )

;; collisions entre vehicules / joueurs : chacun gere son propre vehicule (et son Jak)
(defun ow-my-vehicle ()
  (let ((t *target*))
    (if (and t (focus-test? t pilot) (nonzero? (-> t pilot)))
        (let ((veh (handle->process (-> t pilot vehicle))))
          (if (and veh (type? veh rigid-body-object))
              (the-as rigid-body-object veh)
              (the-as rigid-body-object #f)
              )
          )
        (the-as rigid-body-object #f)
        )
    )
  )

(defun ow-float-ok? ((f float))
  (and (= f f) (< (fabs f) 100000000.0)))

(defun ow-vehicle-kick! ((veh rigid-body-object) (dv vector))
  "change la vitesse du vehicule (dv en unites par seconde, plafonnee)"
  (let ((rb (-> veh rbody)))
    (when (and rb
               (nonzero? rb)
               (nonzero? (-> rb info))
               (< 0.0 (-> rb info mass))
               (ow-float-ok? (-> rb info mass))
               (ow-float-ok? (-> rb lin-velocity x))
               (ow-float-ok? (-> rb lin-velocity y))
               (ow-float-ok? (-> rb lin-velocity z))
               (ow-float-ok? (-> dv x))
               (ow-float-ok? (-> dv y))
               (ow-float-ok? (-> dv z))
               )
      (let ((len (vector-length dv)))
        (if (< (meters 24.0) len)
            (vector-float*! dv dv (/ (meters 24.0) len))
            )
        )
      (set! (-> dv w) 0.0)
      (vector+float*! (-> rb lin-momentum) (-> rb lin-momentum) dv (-> rb info mass))
      (init-velocities! rb)
      )
    )
  (none)
  )

(defun online-world-vehicle-lift! ((dir vector))
  "tir de gravite recu en vehicule : le vehicule s'envole en tournant ; #f si a pied"
  (let ((veh (ow-my-vehicle)))
    (when veh
      (let ((dv (vector-float*! (new 'stack-no-clear 'vector) dir (meters 4.0))))
        (set! (-> dv y) (meters 22.0))
        (set! (-> dv w) 0.0)
        (ow-vehicle-kick! veh dv)
        (let ((rb (-> veh rbody)))
          (when (and rb (nonzero? rb) (nonzero? (-> rb info)) (< 0.0 (-> rb info mass)) (ow-float-ok? (-> rb info mass)))
            (+! (-> rb ang-momentum x) (* 0.6 (-> rb info mass) 4096.0))
            (+! (-> rb ang-momentum z) (* 0.4 (-> rb info mass) 4096.0))
            (init-velocities! rb)
            )
          )
        )
      )
    (the-as symbol veh)
    )
  )

(defun ow-collisions! ()
  "vehicules des autres joueurs : on rebondit dessus, et ils peuvent nous ecraser"
  (let ((t *target*)
        (w *online-world*)
        (shm *online-shm*)
        (now (online-now))
        )
    ;; les chocs existent toujours (vraie physique) ; les degats seulement si le PvP est actif
    (when (and t (not (paused?)) (not (focus-test? t dead)))
      (let ((veh (ow-my-vehicle))
            (pvp (online-pvp-allowed?))
            )
        (dotimes (i ONLINE_MAX_PUPPETS)
          (let ((rs (-> shm remote i))
                (p (online-puppet-proc i))
                )
            (when (and p
                       (-> p shown)
                       (nonzero? (-> rs active))
                       (logtest? (-> rs flags) ONLINE_FLAG_VEHICLE)
                       (not (logtest? (-> rs flags) (logior ONLINE_FLAG_DEAD ONLINE_FLAG_PAUSED)))
                       )
              (let* ((d (vector-! (new 'stack-no-clear 'vector) (-> t control trans) (-> p root trans)))
                     (dy (fabs (-> d y)))
                     )
                (set! (-> d y) 0.0)
                (let ((dist (vector-length d))
                      (their-speed (sqrtf (+ (* (-> rs vel x) (-> rs vel x)) (* (-> rs vel z) (-> rs vel z)))))
                      )
                  (cond
                    (veh
                      ;; vehicule contre vehicule : on rebondit (pas pendant les 3 premieres secondes
                      ;; dans le vehicule : deux joueurs qui apparaissent au meme endroit se superposent)
                      (when (and (< dist (meters 4.5)) (< dy (meters 3.0)) (< (-> w bump-cool) now)
                                 (< (seconds 3) (- now (-> w veh-since)))
                                 )
                        (let* ((n (vector-normalize! (if (< dist 1.0) (vector-copy! d (-> t control c-R-w fvec)) d) 1.0))
                               (rb (-> veh rbody))
                               (rel (vector-! (new 'stack-no-clear 'vector) (-> rb lin-velocity) (-> rs vel)))
                               (vn (vector-dot rel n))
                               )
                          (when (and (< vn (meters -2.0)) (ow-float-ok? vn))
                            (set! (-> w bump-cool) (+ now (seconds 0.25)))
                            ;; CHOC REALISTE (masses egales, choc peu elastique) : chacun prend 65 % de la
                            ;; vitesse relative. Celui qui fonce ralentit, celui qui est percute part comme
                            ;; un vehicule civil. Chaque jeu calcule SON vehicule (meme choc des deux cotes).
                            (let ((dv (vector-float*! (new 'stack-no-clear 'vector) n (fmin (meters 10.0) (+ (meters 1.5) (* -0.5 vn))))))
                              (set! (-> dv y) (fmin (meters 6.0) (* 0.2 (fabs vn))))
                              (set! (-> dv w) 0.0)
                              (ow-vehicle-kick! veh dv)
                              )
                            ;; choc violent : les deux vehicules s'abiment (on peut detruire celui de
                            ;; l'autre en le percutant). Chaque jeu envoie le coup a l'autre et
                            ;; encaisse sa part.
                            ;; etincelles + bruit de choc (chez moi) pour tout choc franc
                            (when (< (meters 5.0) (fabs vn))
                              (let ((mid (vector-lerp! (new 'stack-no-clear 'vector) (-> t control trans) (-> p root trans) 0.5)))
                                (+! (-> mid y) (meters 1.0))
                                (vector-copy! (-> *launch-matrix* trans) mid)
                                (set! (-> *launch-matrix* trans w) 1.0)
                                (part-tracker-spawn part-tracker :to *entity-pool* :group group-gun-yellow-shot-hit-object)
                                (sound-play "punch-hit" :position mid)
                                )
                              )
                            (when (and pvp (< (meters 10.0) (fabs vn)))
                              (let ((dmg (fmax 1.0 (fmin 6.0 (/ (fabs vn) (meters 8.0)))))
                                    (away (vector-float*! (new 'stack-no-clear 'vector) n -1.0))
                                    )
                                (online-send-hit! i dmg ONLINE_MODE_IMPACT away)
                                (set! (-> *online* veh-hit-by) (-> rs player-id))
                                (set! (-> *online* veh-hit-time) now)
                                (send-event veh 'attack #f
                                  (static-attack-info :mask (vehicle-impulse-factor)
                                    ((id (new-attack-id)) (damage (* 0.4 dmg)) (vehicle-damage-factor 1.0) (vehicle-impulse-factor 0.2) (mode 'generic))
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    (else
                      ;; a pied : un vehicule lance nous ecrase (PvP)
                      (when (and pvp (< dist (meters 3.2)) (< dy (meters 2.5)) (< (meters 8.0) their-speed) (< (-> w hit-cool) now))
                        (set! (-> w hit-cool) (+ now (seconds 1.2)))
                        (let ((ev (new 'stack-no-clear 'online-event))
                              (dir (vector-normalize-copy! (new 'stack-no-clear 'vector) (-> rs vel) 1.0))
                              )
                          (set! (-> ev kind) (the-as uint ONLINE_EVENT_HIT))
                          (set! (-> ev player-id) (-> rs player-id))
                          (set! (-> ev damage) (fmin 8.0 (* their-speed (/ 1.0 (meters 6.0)))))
                          (set! (-> ev mode) (the-as uint ONLINE_MODE_IMPACT))
                          (vector-copy! (-> ev dir) dir)
                          (online-apply-in-event! ev)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; mini-carte et carte : les autres joueurs
;; Chaque joueur est dessine avec la MEME fleche que Jak, orientee dans le sens ou il regarde,
;; et avec SA couleur (la meme chez tout le monde : elle vient de son numero de joueur).
;; Mini-carte : les joueurs proches (avec le RADAR, tous, au bord de la carte). Tete mise a
;; prix : fleche rouge clignotante, toujours visible. Joueur "fantome" : invisible.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define *ow-colors*
  (new 'static 'array rgba 12
    (new 'static 'rgba :r #xff :g #x46 :b #x46 :a #x80)
    (new 'static 'rgba :r #xff :g #xaa :b #x00 :a #x80)
    (new 'static 'rgba :r #xff :g #xff :b #x3c :a #x80)
    (new 'static 'rgba :r #x5a :g #xff :b #x5a :a #x80)
    (new 'static 'rgba :r #xff :g #x5a :b #xff :a #x80)
    (new 'static 'rgba :r #xaa :g #x6e :b #xff :a #x80)
    (new 'static 'rgba :r #xff :g #xff :b #xff :a #x80)
    (new 'static 'rgba :r #x46 :g #x8c :b #xff :a #x80)
    (new 'static 'rgba :r #xff :g #x8c :b #xbe :a #x80)
    (new 'static 'rgba :r #xa0 :g #xff :b #x28 :a #x80)
    (new 'static 'rgba :r #xff :g #xd2 :b #x82 :a #x80)
    (new 'static 'rgba :r #x78 :g #xff :b #xdc :a #x80)
    )
  )

(defun ow-color-index ((id uint))
  (let ((h (logand (* (the-as int id) 2654435761) #xffffffff)))
    (mod (the-as int (shr h 16)) 12)
    )
  )

(defun ow-player-color ((id uint) (bounty symbol))
  (if (and bounty (< (logand (-> *display* base-clock integral-frame-counter) 15) 8))
      (new 'static 'rgba :r #xff :g #x10 :b #x10 :a #x80)
      (-> *ow-colors* (ow-color-index id))
      )
  )

(deftype ow-heading-table (structure)
  ((id    uint32 100)
   (pos   vector 100 :inline)
   (dir   vector 100 :inline)
   )
  )

(define *ow-headings* (new 'global 'ow-heading-table))

(let ((h *ow-headings*))
  (dotimes (i 100)
    (set! (-> h id i) (the-as uint 0))
    (set-vector! (-> h dir i) 0.0 0.0 1.0 0.0)
    )
  )

(defun ow-heading-of ((id uint) (pos vector) (out vector))
  "direction d'un joueur lointain : celle de son dernier deplacement"
  (let ((h *ow-headings*)
        (slot -1)
        (free -1)
        )
    (dotimes (i 100)
      (if (= (-> h id i) id)
          (set! slot i)
          )
      (if (and (< free 0) (zero? (-> h id i)))
          (set! free i)
          )
      )
    (when (< slot 0)
      (set! slot (if (>= free 0) free (mod (the-as int id) 100)))
      (set! (-> h id slot) id)
      (vector-copy! (-> h pos slot) pos)
      (set-vector! (-> h dir slot) 0.0 0.0 1.0 0.0)
      )
    (let ((d (vector-! (new 'stack-no-clear 'vector) pos (-> h pos slot))))
      (set! (-> d y) 0.0)
      (when (< (meters 1.0) (vector-length d))
        (vector-normalize-copy! (-> h dir slot) d 1.0)
        (vector-copy! (-> h pos slot) pos)
        )
      )
    (vector-copy! out (-> h dir slot))
    )
  out
  )

(defun ow-map-player-pos ((k int) (pos vector) (dir vector))
  "position + direction du joueur k (liste EXT) ; #f si inconnue"
  (let* ((ext *online-ext*)
         (pl (-> ext players k))
         (id (-> pl id))
         (found #f)
         )
    ;; avatar proche : position et orientation exactes
    (dotimes (i ONLINE_MAX_PUPPETS)
      (let ((rs (-> *online-shm* remote i)))
        (when (and (not found) (nonzero? (-> rs active)) (= (-> rs player-id) id))
          (let ((p (online-puppet-proc i)))
            (when (and p (-> p placed))
              (vector-copy! pos (-> p root trans))
              (vector-z-quaternion! dir (-> p root quat))
              (set! found #t)
              )
            )
          )
        )
      )
    (when (and (not found) (nonzero? (-> pl has-pos)))
      (set-vector! pos (-> pl x) (-> pl y) (-> pl z) 1.0)
      (ow-heading-of id pos dir)
      (set! found #t)
      )
    found
    )
  )

(defun ow-map-player-visible? ((pl online-ext-player))
  (and (nonzero? (-> pl id))
       (not (logtest? (-> pl flags) (logior ONLINE_PX_ME ONLINE_PX_BANNED)))
       ;; fantome : invisible sur les cartes (le createur voit tout)
       (or (not (logtest? (-> pl flags2) 1)) (ow-createur?))
       )
  )

(defun ow-minimap-extra ((mm minimap) (work minimap-draw-work) (buf dma-buffer))
  "appelee par la mini-carte (engine/ui/minimap.gc) apres la fleche de Jak"
  (when (and (online-in-session?) *target*)
    (let* ((ext *online-ext*)
           (n (min 100 (the-as int (-> ext player-count))))
           (radar (< 0.0 (-> ext power-left ONLINE_POW_RADAR)))
           (pos (new 'stack-no-clear 'vector))
           (dir (new 'stack-no-clear 'vector))
           )
      (dotimes (k n)
        (let ((pl (-> ext players k)))
          (when (and (ow-map-player-visible? pl) (ow-map-player-pos k pos dir))
            (let ((bounty (logtest? (-> pl flags) ONLINE_PX_BOUNTY)))
              (minimap-draw-arrow mm work buf pos dir (ow-player-color (-> pl id) bounty) (if bounty 8.5 6.5) (or radar bounty))
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun ow-bigmap-extra ((bm bigmap) (buf dma-buffer))
  "appelee par la grande carte (engine/ui/bigmap.gc) apres la fleche de Jak"
  (when (online-in-session?)
    (let* ((ext *online-ext*)
           (n (min 100 (the-as int (-> ext player-count))))
           (pos (new 'stack-no-clear 'vector))
           (dir (new 'stack-no-clear 'vector))
           )
      (dotimes (k n)
        (let ((pl (-> ext players k)))
          (when (and (ow-map-player-visible? pl) (ow-map-player-pos k pos dir))
            (let ((bounty (logtest? (-> pl flags) ONLINE_PX_BOUNTY)))
              (bigmap-draw-arrow bm buf pos dir (ow-player-color (-> pl id) bounty) (if bounty 11.0 9.0))
              )
            )
          )
        )
      )
    )
  (none)
  )

(set! *minimap-extra-draw* ow-minimap-extra)
(set! *bigmap-extra-draw* ow-bigmap-extra)

(defun ow-icon-owner ()
  "processus proprietaire des icones de la carte (les icones disparaissent avec lui)"
  (let* ((w *online-world*)
         (p (handle->process (-> w icon-owner)))
         )
    (when (not p)
      (set! (-> w race-icon) #f)
      (set! (-> w ev-icon) #f)
      (set! (-> w shop-icon) #f)
      (let ((pp (process-spawn-function
                  process
                  (lambda :behavior process () (until #f (suspend)) #f)
                  :name "online-carte"
                  :to *default-pool*
                  :stack-size #x1000
                  )
                )
            )
        (when pp
          (set! (-> w icon-owner) (ppointer->handle pp))
          (set! p (ppointer->process pp))
          )
        )
      )
    p
    )
  )

(defun ow-icon-mine? ((c connection-minimap) (owner process) (pos vector))
  "cette connexion est-elle toujours la notre ? (le moteur peut l'avoir liberee)"
  (and c
       (= (-> c handle) (process->handle owner))
       (= (the-as vector (-> c position)) pos)
       )
  )

(defun ow-player-name ((id uint))
  "pseudo d'un autre joueur (par son numero)"
  (let ((s (-> *online-world* str3)))
    (clear s)
    (dotimes (i ONLINE_MAX_PUPPETS)
      (let ((rs (-> *online-shm* remote i)))
        (if (and (nonzero? (-> rs active)) (= (-> rs player-id) id))
            (online-chars->string s (-> rs name) 16)
            )
        )
      )
    s
    )
  )

(defun ow-ride-driver-pos ((id uint))
  "position du vehicule de ce joueur (s'il conduit et qu'il est en vie), #f sinon"
  (let ((found (the-as vector #f)))
    (dotimes (i ONLINE_MAX_PUPPETS)
      (let ((rs (-> *online-shm* remote i)))
        (when (and (not found)
                   (nonzero? (-> rs active))
                   (= (-> rs player-id) id)
                   (logtest? (-> rs flags) ONLINE_FLAG_VEHICLE)
                   (not (logtest? (-> rs flags) ONLINE_FLAG_DEAD))
                   )
          (let ((p (online-puppet-proc i)))
            (set! found (if (and p (-> p placed)) (-> p root trans) (-> rs pos)))
            )
          )
        )
      )
    found
    )
  )

(defun ow-ride-hide! ((hide symbol))
  "Jak (et Daxter) caches pendant qu'il est passager"
  (let ((t *target*))
    (when t
      (if hide
          (logior! (-> t draw status) (draw-control-status no-draw))
          (logclear! (-> t draw status) (draw-control-status no-draw))
          )
      (let ((sk (ppointer->process (-> t sidekick))))
        (when (and sk (nonzero? (-> (the-as process-drawable sk) draw)))
          (if hide
              (logior! (-> (the-as process-drawable sk) draw status) (draw-control-status no-draw))
              (logclear! (-> (the-as process-drawable sk) draw status) (draw-control-status no-draw))
              )
          )
        )
      )
    )
  (none)
  )

(defun ow-ride-stop! ((pos vector))
  "je descends du vehicule (a cote de lui)"
  (let ((w *online-world*)
        (t *target*)
        )
    (set! (-> w ride-with) (the-as uint 0))
    (ow-ride-hide! #f)
    (when (and t (= (-> t state name) 'target-grab))
      (if pos
          (let ((out (new 'stack-no-clear 'vector)))
            (vector-copy! out pos)
            (+! (-> out x) (meters 3.0))
            (+! (-> out y) (meters 1.5))
            (move-to-point! (-> t control) out)
            )
          )
      (send-event t 'end-mode 'grab)
      )
    )
  (none)
  )

(define *ow-ride-press* #f)   ;; banc de test : comme un appui sur TRIANGLE
(define *ow-ride-anim* #f)    ;; pose assise demandee (ow-seat-car / ow-seat-bike)

(defun ow-ride-driver-proc ((id uint))
  "avatar du conducteur"
  (let ((found (the-as online-puppet #f)))
    (dotimes (i ONLINE_MAX_PUPPETS)
      (let ((rs (-> *online-shm* remote i)))
        (when (and (not found) (nonzero? (-> rs active)) (= (-> rs player-id) id))
          (let ((p (online-puppet-proc i)))
            (if (and p (-> p placed))
                (set! found p)
                )
            )
          )
        )
      )
    found
    )
  )

(defun ow-ride-driver-quat ((id uint))
  (let ((p (ow-ride-driver-proc id)))
    (if p (-> p root quat) (the-as quaternion #f))
    )
  )

(defun ow-ride-driver-bike? ((id uint))
  (let ((p (ow-ride-driver-proc id)))
    (the-as symbol (and p (logtest? (-> *online-shm* remote (-> p slot) flags) ONLINE_FLAG_BIKE)))
    )
  )

(defun ow-ride-update! ()
  "monter a plusieurs dans un vehicule : TRIANGLE pres du vehicule d'un autre joueur"
  (let ((w *online-world*)
        (t *target*)
        )
    (set! (-> w ride-near) (the-as uint 0))
    (let ((press *ow-ride-press*))
    (set! *ow-ride-press* press)
    (cond
      ((nonzero? (-> w ride-with))
       (let ((pos (ow-ride-driver-pos (-> w ride-with))))
         (cond
           ((or (not t) (not pos) (focus-test? t dead) (!= (-> t state name) 'target-grab) (not (-> w active))
                (and (or (cpad-pressed? 0 triangle) *ow-ride-press*) (not (-> w tab-open)) (not (-> w shop-open)) (not (-> w chat-open)) (not *progress-process*))
                )
            (ow-ride-stop! pos)
            )
           (else
             ;; assis dans le vehicule du conducteur : a cote (voiture) ou derriere (moto), tourne
             ;; comme lui, avec la pose de pilote du jeu
             (let* ((dq (ow-ride-driver-quat (-> w ride-with)))
                    (bike (ow-ride-driver-bike? (-> w ride-with)))
                    (seat (new 'stack-no-clear 'vector))
                    )
               (vector-copy! seat pos)
               (when dq
                 (let ((off (new 'stack-no-clear 'vector)))
                   (online-seat-offset! off dq bike)
                   (vector+! seat seat off)
                   )
                 (set-quaternion! (-> t control) dq)
                 (quaternion-copy! (-> t control quat-for-control) dq)
                 )
               (move-to-point! (-> t control) seat)
               (vector-reset! (-> t control transv))
               (let ((want (if bike 'ow-seat-bike 'ow-seat-car)))
                 (when (and (!= want *ow-ride-anim*)
                            (online-anim-ok? (-> t draw art-group data (if bike 241 234)))
                            )
                   (set! *ow-ride-anim* want)
                   (send-event t 'anim want)
                   )
                 )
               )
             (ow-ride-hide! #f)
             )
           )
         )
       )
      ((and t (-> w active) (not (-> w tab-open)) (not (-> w shop-open)) (not (-> w chat-open)) (not *progress-process*)
            (not (-> w in-shop-zone)) (not (focus-test? t dead pilot board flut grabbed hit)) (not (movie?)))
       (let ((best (the-as uint 0))
             (bd (meters 5.0))
             )
         (dotimes (i ONLINE_MAX_PUPPETS)
           (let ((rs (-> *online-shm* remote i)))
             (when (and (nonzero? (-> rs active))
                        (logtest? (-> rs flags) ONLINE_FLAG_VEHICLE)
                        (not (logtest? (-> rs flags) ONLINE_FLAG_DEAD))
                        )
               (let ((pos (ow-ride-driver-pos (-> rs player-id))))
                 (when pos
                   (let ((d (vector-vector-distance (-> t control trans) pos)))
                     (when (< d bd)
                       (set! bd d)
                       (set! best (-> rs player-id))
                       )
                     )
                   )
                 )
               )
             )
           )
         (when (nonzero? best)
           (set! (-> w ride-near) best)
           (when (or (cpad-pressed? 0 triangle) *ow-ride-press*)
             (when (send-event t 'change-mode 'grab #t)
               (set! (-> w ride-with) best)
               (set! *ow-ride-anim* #f)
               (sound-play "menu-pick")
               )
             )
           )
         )
       )
      )
    (set! *ow-ride-press* #f)
    (set! *ow-riding* (the-as symbol (nonzero? (-> w ride-with))))
    (set! *ow-riding-id* (-> w ride-with))
    )
    )
  (none)
  )

(defun ow-puppet-pos ((id uint))
  "position lissee de l'avatar de ce joueur (s'il est proche), #f sinon"
  (let ((found (the-as vector #f)))
    (dotimes (i ONLINE_MAX_PUPPETS)
      (let ((rs (-> *online-shm* remote i)))
        (when (and (not found) (nonzero? (-> rs active)) (= (-> rs player-id) id))
          (let ((p (online-puppet-proc i)))
            (set! found (if (and p (-> p placed)) (-> p root trans) (-> rs pos)))
            )
          )
        )
      )
    found
    )
  )

;; entree du Naughty Ottsel (position de son icone dans le jeu)
(define *ow-ottsel-pos* (new 'static 'vector :x -282624.0 :y 45056.0 :z 5464064.0 :w 1.0))

(defun ow-ottsel-label! ()
  "panneau BOUTIQUE au-dessus de l'entree du Naughty Ottsel"
  (when *target*
    (let ((d (vector-vector-distance *ow-ottsel-pos* (-> *target* control trans)))
          (head (new 'stack-no-clear 'vector))
          (screen (new 'stack-no-clear 'vector))
          )
      (when (and (< d (meters 140.0)) (< (meters 2.0) d))
        (vector-copy! head *ow-ottsel-pos*)
        (+! (-> head y) (meters 5.5))
        (set! (-> head w) 1.0)
        (when (transform-point-vector! screen head)
          (let ((sx (+ -1792.0 (-> screen x)))
                (sy (+ -1840.0 (-> screen y)))
                (sc (fmax 0.3 (fmin 0.6 (- 0.64 (* 0.0024 (/ d 4096.0))))))
                )
            (when (and (< 0.0 sx) (< sx 512.0) (< 0.0 sy) (< sy 400.0))
              (online-print (online-fr "BOUTIQUE : NAUGHTY OTTSEL" "SHOP: NAUGHTY OTTSEL") (+ sx -160.0) sy 320.0 sc
                            (font-color flat-yellow) (font-flags shadow kerning middle large))
              (online-print (online-fr "armes, Dark / Light Jak, armures" "weapons, Dark / Light Jak, armor") (+ sx -160.0) (+ sy (* 34.0 sc)) 320.0 (* 0.72 sc)
                            (font-color white) (font-flags shadow kerning middle large))
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun ow-icons-update! ()
  "icones fixes : arrivee de la course et lieu de l'evenement du monde"
  (let* ((w *online-world*)
         (ext *online-ext*)
         (want (and (online-in-session?) *target* (not (movie?))))
         (owner (if want (ow-icon-owner) (the-as process #f)))
         )
    (when owner
      ;; arrivee de la course
      (let ((race-on (or (= (-> ext race-state) 1) (= (-> ext race-state) 2))))
        (cond
          ((and race-on (not (-> w race-icon)))
           (vector-copy! (-> w race-pos) (-> ext race-dest))
           (set! (-> w race-pos w) 1.0)
           (set! (-> w race-icon) (add-icon! *minimap* owner (the-as uint 130) (the-as int #f) (-> w race-pos) 0))
           )
          ((and (not race-on) (-> w race-icon))
           (if (ow-icon-mine? (-> w race-icon) owner (-> w race-pos))
               (kill-callback (-> *minimap* engine) (-> w race-icon))
               )
           (set! (-> w race-icon) #f)
           )
          (race-on
            (vector-copy! (-> w race-pos) (-> ext race-dest))
            (set! (-> w race-pos w) 1.0)
            )
          )
        )
      ;; le Naughty Ottsel (la boutique) toujours sur la carte dans le monde en ligne
      (let ((on (-> w active)))
        (cond
          ((and on (not (-> w shop-icon)))
           (set! (-> w shop-icon) (add-icon! *minimap* owner (the-as uint 6) (the-as int #f) *ow-ottsel-pos* 0))
           )
          ((and (not on) (-> w shop-icon))
           (if (ow-icon-mine? (-> w shop-icon) owner *ow-ottsel-pos*)
               (kill-callback (-> *minimap* engine) (-> w shop-icon))
               )
           (set! (-> w shop-icon) #f)
           )
          )
        )
      ;; evenement du monde (boss : rouge clignotant, sinon vert clignotant)
      (let ((ev-on (and (= (-> ext ev-state) 1) (nonzero? (-> ext ev-kind))))
            (klass (if (or (= (-> ext ev-kind) ONLINE_EVK_BOSS) (= (-> ext ev-kind) ONLINE_EVK_HUNT)) 129 130))
            )
        (when (and (-> w ev-icon) (or (not ev-on) (!= klass (-> w ev-class)) (!= (-> ext ev-id) (-> w ev-icon-id))))
          (if (ow-icon-mine? (-> w ev-icon) owner (-> w ev-pos))
              (kill-callback (-> *minimap* engine) (-> w ev-icon))
              )
          (set! (-> w ev-icon) #f)
          )
        (when (and ev-on (not (-> w ev-icon)) (!= (-> ext ev-kind) ONLINE_EVK_DOUBLEXP) (!= (-> ext ev-kind) ONLINE_EVK_PARKOUR) (!= (-> ext ev-kind) ONLINE_EVK_MISSION)
                   ;; chasse a l'homme : la cible ne se voit pas elle-meme
                   (not (and (= (-> ext ev-kind) ONLINE_EVK_HUNT) (= (-> ext ev-target) (-> *online-shm* my-id))))
                   )
          (oe-event-pos (-> w ev-pos))
          (set! (-> w ev-pos w) 1.0)
          (set! (-> w ev-icon) (add-icon! *minimap* owner (the-as uint klass) (the-as int #f) (-> w ev-pos) 0))
          (set! (-> w ev-class) klass)
          (set! (-> w ev-icon-id) (-> ext ev-id))
          )
        ;; le point suit le boss (ou la cible) la ou il est vraiment
        (when (-> w ev-icon)
          (oe-event-pos (-> w ev-pos))
          (set! (-> w ev-pos w) 1.0)
          )
        )
      )
    )
  (none)
  )

