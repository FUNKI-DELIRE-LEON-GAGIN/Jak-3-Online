(defconstant OW_HOUSE_COUNT 8)

(defun ow-house-item ((k int))
  "objet de la boutique de la maison k (0-2 : 96-98 ; 3-7 : 109-113)"
  (if (< k 3) (+ 96 k) (+ 106 k))
  )

(defun ow-parkour-now? ()
  "Jak est sur un parcours (cartes 0..7) : pas de planche, de vol, de super-pouvoirs ni de vehicule"
  (let ((i (ow-map-current)))
    (the-as symbol (and (>= i 0) (< i OW_PARKOUR_COUNT)))
    )
  )

