(defun ow-world? ()
  "session publique = monde en ligne"
  (and (online-in-session?) (logtest? (-> *online-ext* flags) ONLINE_XF_WORLD)))

(defun ow-mod? ()
  "moderation autorisee (hote d'une session privee, ou createur)"
  (and (online-in-session?) (logtest? (-> *online-ext* flags) ONLINE_XF_MOD)))

(define-extern *ow-race-cps* (array string))
(define-extern *ow-race-names* (array string))
(define-extern *ow-race-names-en* (array string))

(define-extern ow-map-inside? (function symbol))
(define-extern ow-cheats-detect! (function none))

(defun ow-createur? ()
  (logtest? (-> *online-ext* flags) ONLINE_XF_CREATEUR))

(defun online-world-names-on? ()
  (-> *online-world* show-names))

(defun online-world-active? ()
  "monde en ligne actif (le HUD des orbes remplace la ligne de statut)"
  (-> *online-world* active))

(defun ow-hint! ((text string))
  "petit message au milieu en bas de l'ecran"
  (let ((w *online-world*))
    (format (clear (-> w hint)) "~S" text)
    (set! (-> w hint-time) (online-now))
    )
  (none)
  )

(defun ow-box ((x float) (y float) (w float) (h float) (r int) (g int) (b int) (a int))
  "rectangle plein (fond des menus)"
  (with-dma-buffer-add-bucket ((buf (-> *display* frames (-> *display* on-screen) global-buf)) *online-draw-bucket*)
    (draw-sprite2d-xy buf (the int x) (the int y) (the int w) (the int h) (new 'static 'rgba :r r :g g :b b :a a) #x3fffff)
    )
  (none)
  )

(defun ow-text ((str string) (x float) (y float) (scale float) (color font-color))
  (online-print str x y 460.0 scale color (font-flags shadow kerning large))
  (none)
  )

(defun ow-text-mid ((str string) (y float) (scale float) (color font-color))
  (online-print str 0.0 y 512.0 scale color (font-flags shadow kerning middle large))
  (none)
  )

(define *ow-center-y* 124.0)

(defun ow-center-line ((str string) (scale float) (color font-color))
  "texte centre EMPILE : chaque message prend sa place sous le precedent (plus de chevauchement)"
  (ow-text-mid str *ow-center-y* scale color)
  (set! *ow-center-y* (+ *ow-center-y* (+ 3.0 (* 28.0 scale))))
  (none)
  )

(defun ow-prefix? ((s string) (p string))
  (let ((n (length p))
        (ok #t)
        )
    (if (< (length s) n)
        (set! ok #f)
        (dotimes (i n)
          (if (!= (-> s data i) (-> p data i))
              (set! ok #f)
              )
          )
        )
    ok
    )
  )

(defun ow-contains? ((s string) (p string))
  (let ((n (length p))
        (m (length s))
        (found #f)
        )
    (dotimes (i (+ (- m n) 1))
      (when (not found)
        (let ((ok #t))
          (dotimes (k n)
            (if (!= (-> s data (+ i k)) (-> p data k))
                (set! ok #f)
                )
            )
          (if ok
              (set! found #t)
              )
          )
        )
      )
    found
    )
  )

