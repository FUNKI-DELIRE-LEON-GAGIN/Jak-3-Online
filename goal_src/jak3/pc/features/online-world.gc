;; rayons de la boutique du Naughty Ottsel (les vehicules et pouvoirs sont dans le menu SELECT)
;; 76-81 : ameliorations (secrets du jeu) ; 82-93 : teleportations (consommables, mode 10 + lieu)
(defun ow-shop-extra-init! ()
  (let ((fr (new 'static 'boxed-array :type string
              "Capacite munitions jaunes" "Capacite munitions rouges" "Capacite munitions bleues"
              "Capacite munitions noires" "Turbo JetBoard dans le desert" "Vehicules renforces"))
        (en (new 'static 'boxed-array :type string
              "Yellow ammo capacity" "Red ammo capacity" "Blue ammo capacity"
              "Dark ammo capacity" "Desert JetBoard turbo" "Tougher vehicles"))
        (bits (new 'static 'array int8 6 55 54 56 57 29 28))
        )
    (dotimes (i 6)
      (set! (-> *ow-shop-names* (+ 76 i)) (-> fr i))
      (set! (-> *ow-shop-names-en* (+ 76 i)) (-> en i))
      (set! (-> *ow-shop-kind* (+ 76 i)) 2)
      (set! (-> *ow-shop-bit* (+ 76 i)) (-> bits i))
      )
    )
  ;; 54-58 : personnages (objets a nous, bits 9-13)
  (let ((nm (new 'static 'boxed-array :type string "Jak 2" "Jak 1 HD" "Jak 4" "Tess" "Daxter")))
    (dotimes (i 5)
      (set! (-> *ow-shop-names* (+ 54 i)) (-> nm i))
      (set! (-> *ow-shop-names-en* (+ 54 i)) (-> nm i))
      (set! (-> *ow-shop-kind* (+ 54 i)) 4)
      (set! (-> *ow-shop-bit* (+ 54 i)) (+ 9 i))
      )
    )
  (dotimes (i 12)
    (set! (-> *ow-shop-names* (+ 82 i)) (-> *ow-race-names* i))
    (set! (-> *ow-shop-names-en* (+ 82 i)) (-> *ow-race-names-en* i))
    (set! (-> *ow-shop-kind* (+ 82 i)) 5)
    (set! (-> *ow-shop-bit* (+ 82 i)) (+ 10 i))
    )
  (none)
  )

(define *ow-shop-cat-first* (new 'static 'array int8 7 0 12 24 28 34 39 60))
(define *ow-shop-cat-last* (new 'static 'array int8 7 11 23 27 32 38 42 62))
(defconstant OW_SHOP_CATS 7)

(defun ow-shop-cat-name ((c int))
  (case c
    ((0) (online-fr "ARMES" "WEAPONS"))
    ((1) (online-fr "CHARGEURS ET DEGATS" "AMMO AND DAMAGE"))
    ((2) "JETBOARD")
    ((3) "DARK JAK")
    ((4) "LIGHT JAK")
    ((5) (online-fr "ARMURES" "ARMOR"))
    (else (online-fr "SOINS" "HEALTH"))
    )
  )

(defun ow-item-name ((id int))
  ;; vehicules du desert : le nom du jeu (juste dans toutes ses langues)
  (let ((tid (case id
               ((43) (text-id progress-inventory-v-turtle))
               ((44) (text-id progress-inventory-v-toad))
               ((45) (text-id progress-inventory-v-snake))
               ((46) (text-id progress-inventory-v-scorpion))
               ((47) (text-id progress-inventory-v-rhino))
               ((48) (text-id progress-inventory-v-fox))
               ((49) (text-id progress-inventory-v-mirage))
               ((50) (text-id progress-inventory-v-x-ride))
               (else (text-id null))
               )
             )
        )
    (if (and (!= tid (text-id null)) *common-text*)
        (lookup-text! *common-text* tid #f)
        (online-fr (-> *ow-shop-names* id) (-> *ow-shop-names-en* id))
        )
    )
  )

(defun ow-price ((id int))
  (let ((ext *online-ext*))
    (if (< id 64)
        (-> ext prices id)
        (-> ext prices-hi (- id 64))
        )
    )
  )

(defun ow-req-level ((id int))
  (the-as int (-> *online-ext* req-level id))
  )

(defun ow-owned? ((id int))
  (let ((ext *online-ext*)
        (bit (-> *ow-shop-bit* id))
        )
    (case (-> *ow-shop-kind* id)
      ((1) (logtest? (the-as int (-> ext features)) (ash 1 bit)))
      ((2) (logtest? (the-as int (-> ext secrets)) (ash 1 bit)))
      ((3) (logtest? (-> ext vehicles) (ash 1 bit)))
      ((4) (logtest? (-> ext items) (ash 1 bit)))
      (else #f)
      )
    )
  )

(defun ow-level-ok? ((id int))
  (<= (ow-req-level id) (the-as int (-> *online-ext* level)))
  )

(defun ow-buy! ((id int))
  "demande d'achat (verifiee par Jak3Online.exe) ; #t si envoyee"
  (let ((kind (-> *ow-shop-kind* id))
        (req (-> *ow-shop-req* id))
        )
    (cond
      ((and (!= kind 5) (!= kind 6) (ow-owned? id))
       (sound-play "generic-beep")
       #f
       )
      ((< 200 (ow-req-level id))
       (sound-play "generic-beep")
       (ow-hint! (online-fr "Interdit dans le monde en ligne" "Not allowed in the online world"))
       #f
       )
      ((not (ow-level-ok? id))
       (sound-play "generic-beep")
       (format (clear (-> *online-world* str3)) (online-fr "Niveau ~D requis" "Level ~D required") (ow-req-level id))
       (ow-hint! (-> *online-world* str3))
       #f
       )
      ((and (>= req 0) (not (ow-owned? req)))
       (sound-play "generic-beep")
       (ow-hint! (online-fr "Achete d'abord l'objet requis" "Buy the required item first"))
       #f
       )
      ((< (-> *online-ext* money) (ow-price id))
       (sound-play "generic-beep")
       (ow-hint! (online-fr "Pas assez d'orbes" "Not enough orbs"))
       #f
       )
      ((and (>= id 82) (<= id 93) (or (ow-map-inside?) (not *target*) (focus-test? *target* dead)))
       (sound-play "generic-beep")
       (ow-hint! (online-fr "Teleportation impossible ici" "Can't teleport from here"))
       #f
       )
      (else
        (online-push-out-event! ONLINE_EVENT_BUY (the-as uint 0) 0.0 id (the-as vector #f))
        (sound-play "skill-pickup")
        #t
        )
      )
    )
  )

(defun ow-item-state ((dst string) (id int))
  "texte de droite : prix / achete / niveau requis"
  (let ((kind (-> *ow-shop-kind* id))
        (req (-> *ow-shop-req* id))
        )
    (clear dst)
    (cond
      ((and (!= kind 5) (!= kind 6) (ow-owned? id))
       (format dst (if (= kind 3) (online-fr "APPELER" "CALL") (online-fr "ACHETE" "OWNED")))
       )
      ((= kind 6)
       (let ((left (-> *online-ext* power-left (-> *ow-shop-bit* id))))
         (cond
           ((< 0.0 left) (format dst (online-fr "ACTIF ~Ds  (+~D)" "ON ~Ds  (+~D)") (the int left) (ow-price id)))
           ((not (ow-level-ok? id)) (format dst (online-fr "Nv~D requis" "Lv~D needed") (ow-req-level id)))
           (else (format dst (online-fr "~D orbes" "~D orbs") (ow-price id)))
           )
         )
       )
      ((< 200 (ow-req-level id)) (format dst (online-fr "INTERDIT" "BANNED")))
      ((not (ow-level-ok? id)) (format dst (online-fr "Nv~D requis" "Lv~D needed") (ow-req-level id)))
      ((and (>= req 0) (not (ow-owned? req))) (format dst (online-fr "requis : ~S" "needs: ~S") (ow-item-name req)))
      (else (format dst (online-fr "~D orbes" "~D orbs") (ow-price id)))
      )
    )
  dst
  )

(defun ow-item-color ((id int))
  (let ((kind (-> *ow-shop-kind* id)))
    (cond
      ((and (!= kind 5) (!= kind 6) (ow-owned? id)) (font-color green))
      ((or (not (ow-level-ok? id)) (< 200 (ow-req-level id))) (font-color font-color-44))
      ((< (-> *online-ext* money) (ow-price id)) (font-color red))
      (else (font-color flat-yellow))
      )
    )
  )

(defun ow-shop-zone? ()
  "Jak est dans le Naughty Ottsel"
  (and (-> *online-world* active)
       *target*
       (-> *target* current-level)
       (= (-> *target* current-level name) 'hiphog)
       (not (focus-test? *target* dead pilot))
       )
  )

(defun ow-shop-input! ()
  (let* ((w *online-world*)
         (cat (-> w shop-cat))
         (first (-> *ow-shop-cat-first* cat))
         (count (+ (- (-> *ow-shop-cat-last* cat) first) 1))
         )
    (cond
      ((or (ow-key? ONLINE_KEY_ESC) (ow-key? ONLINE_KEY_TAB) (cpad-pressed? 0 circle) (cpad-pressed? 0 triangle))
       (set! (-> w shop-open) #f)
       (ow-kb-on-later!)
       (sound-play "window-contract")
       )
      ((or (ow-key? ONLINE_KEY_LEFT) (cpad-pressed? 0 left) (cpad-pressed? 0 l1))
       (set! (-> w shop-cat) (if (> cat 0) (+ cat -1) (+ OW_SHOP_CATS -1)))
       (set! (-> w shop-row) 0)
       (sound-play "roll-over")
       )
      ((or (ow-key? ONLINE_KEY_RIGHT) (cpad-pressed? 0 right) (cpad-pressed? 0 r1))
       (set! (-> w shop-cat) (if (< cat (+ OW_SHOP_CATS -1)) (+ cat 1) 0))
       (set! (-> w shop-row) 0)
       (sound-play "roll-over")
       )
      ((or (ow-key? ONLINE_KEY_UP) (cpad-pressed? 0 up))
       (set! (-> w shop-row) (if (> (-> w shop-row) 0) (+ (-> w shop-row) -1) (+ count -1)))
       (sound-play "roll-over")
       )
      ((or (ow-key? ONLINE_KEY_DOWN) (cpad-pressed? 0 down))
       (set! (-> w shop-row) (if (< (-> w shop-row) (+ count -1)) (+ (-> w shop-row) 1) 0))
       (sound-play "roll-over")
       )
      ((or (ow-key? ONLINE_KEY_ENTER) (cpad-pressed? 0 x))
       (ow-buy! (+ first (-> w shop-row)))
       )
      )
    )
  (none)
  )

(defun ow-shop-draw! ()
  (let* ((w *online-world*)
         (ext *online-ext*)
         (s (-> w str))
         (cat (-> w shop-cat))
         (first (-> *ow-shop-cat-first* cat))
         (last (-> *ow-shop-cat-last* cat))
         (x 76.0)
         (y 34.0)
         )
    (ow-box x y 360.0 318.0 0 0 0 120)
    (ow-box x y 360.0 2.0 255 160 0 128)
    (ow-text-mid (online-fr "BOUTIQUE DU NAUGHTY OTTSEL" "NAUGHTY OTTSEL SHOP") (+ y 6.0) 0.55 (font-color flat-yellow))
    (format (clear s) "~33L~C ~S ~33L~C" 163 (ow-shop-cat-name cat) 161)
    (ow-text-mid s (+ y 30.0) 0.42 (font-color white))
    (format (clear s) (online-fr "TES ORBES : ~D   -   NIVEAU ~D" "YOUR ORBS: ~D   -   LEVEL ~D") (-> ext money) (-> ext level))
    (ow-text-mid s (+ y 46.0) 0.38 (font-color flat-yellow))
    (let ((yy (+ y 66.0)))
      (dotimes (k (+ (- last first) 1))
        (let* ((id (+ first k))
               (sel (= k (-> w shop-row)))
               )
          (if sel
              (ow-box (+ x 6.0) (+ yy -2.0) 348.0 16.0 255 160 0 48)
              )
          (ow-text (ow-item-name id) (+ x 14.0) yy 0.38 (if sel (font-color font-color-33) (font-color white)))
          (ow-text (ow-item-state (-> w str2) id) (+ x 226.0) (+ yy 1.0) 0.32 (ow-item-color id))
          (set! yy (+ yy 17.0))
          )
        )
      )
    (ow-text-mid (online-fr "X / ENTREE : acheter    GAUCHE / DROITE : rayon    ROND / ECHAP : sortir"
                            "X / ENTER: buy    LEFT / RIGHT: aisle    CIRCLE / ESC: leave"
                            )
                 (+ y 300.0)
                 0.28
                 (font-color font-color-32)
                 )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; vehicules : chacun appelle les siens
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; VEHICULES PARTOUT : le code et les modeles (art du jeu) de tous les vehicules du desert et de
;; Haven sont charges en permanence (GAME.CGO, voir dgos/game.gd). Seuls leurs maillages pour le
;; rendu PC restent dans le FR3 de leur niveau d'origine : on demande au rendu de le charger
;; (*online-extra-fr3*, voir engine/level/level.gc) quand un vehicule en a besoin.

;; l'art de ces vehicules n'est plus dans leur niveau (desert, ville) mais dans GAME : leurs
;; squelettes doivent aller le chercher dans le niveau par defaut, sinon le jeu essaie de le
;; charger depuis le disque et se bloque. texture-level 11 (ajoute dans process-drawable.gc) :
;; art pris dans GAME, mais dessine dans les files du niveau du vehicule (celles du niveau par
;; defaut n'ont pas tous les rendus sur PC : le jeu plantait avec certains vehicules).
(define *ow-resident-art*
  (new 'static 'boxed-array :type string
    "turtle" "snake" "scorpion" "toad" "fox" "rhino" "bikea" "bikeb" "bikec" "newbike" "cara" "carb" "carc"
    "vehicle-explosion"
    )
  )

(defun ow-patch-resident-skels! ()
  (let ((arr (-> *level* level-default art-group art-group-array))
        (n 0)
        )
    (dotimes (k (-> arr length))
      (let ((e (-> arr k)))
        (when (and e (nonzero? e) (type? e skeleton-group))
          (let ((sg (the-as skeleton-group e)))
            (dotimes (i (-> *ow-resident-art* length))
              (when (string= (-> sg art-group-name) (-> *ow-resident-art* i))
                (set! (-> sg texture-level) 11)
                (+! n 1)
                )
              )
            )
          )
        )
      )
    (format 0 "[jak3-online] vehicules partout : ~D squelettes rattaches a GAME~%" n)
    )
  (none)
  )

(ow-patch-resident-skels!)

(defun ow-veh-fr3 ((vt int))
  "niveau dont le FR3 porte le maillage de ce type de vehicule"
  (cond
    ((and (>= vt 12) (<= vt 19)) "wasall")
    ((<= vt 2) "ctycarb")
    ((<= vt 5) "ctycara")
    ((= vt 6) "ctywide")
    ((= vt 7) "ctycarc")
    (else "")
    )
  )

(defun ow-skel-fr3 ((name string))
  "idem a partir du nom du squelette (vehicules des autres joueurs)"
  (cond
    ((ow-prefix? name "skel-v-") "wasall")
    ((ow-prefix? name "skel-h-bike-d") "ctywide")
    ((ow-prefix? name "skel-h-bike") "ctycarb")
    ((ow-prefix? name "skel-h-car") "ctycara")
    ((ow-prefix? name "skel-h-hellcat") "ctycarc")
    (else "")
    )
  )

(define-extern oe-event-pos (function vector vector))
(define-extern oe-boss-pos (function vector vector))
(define-extern ow-map-inside? (function symbol))
(define-extern ow-map-join! (function none))
(define-extern ow-map-leave! (function none))
(define-extern ow-maps-tick! (function none))
(define-extern online-maps-test! (function int none))
(define-extern ow-boss-fr3 (function int string))

(defun ow-fr3-want! ((name string))
  (when (nonzero? (length name))
    (let ((arr *online-extra-fr3*)
          (have #f)
          (free -1)
          )
      (dotimes (i (-> arr length))
        (if (string= (-> arr i) name)
            (set! have #t)
            )
        (if (and (< free 0) (zero? (length (-> arr i))))
            (set! free i)
            )
        )
      (if (and (not have) (>= free 0))
          (set! (-> arr free) name)
          )
      )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; PAS DE TRICHE : les secrets du jeu (invincibilite, munitions infinies, Dark / Light Jak
;; illimites, turbo, invisibilite...) sont retires du menu et coupes a chaque image, partout.
;; Seul le CREATEUR peut s'en servir, depuis ADMIN (dans une session). Idem mode debug.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; triches PC d'OpenGOAL interdites en session : planche turbo, vehicule invincible, aspirer tout,
;; vitesse rapide / lente, voyage rapide, figures, meteo, paix au desert (on garde barres de vie,
;; statistiques, lecteur de musique, heure reelle, paix a Haven, sans textures, suivi des orbes)
(defconstant OW_PC_CHEATS_BANNED #x3c729)
(defconstant OW_CHEAT_COUNT 5)
(define *ow-admin-cheats* 0) ;; bits : 0 invincible, 1 munitions, 2 dark illimite, 3 light illimite, 4 debug

;; secrets de triche du jeu (game-secrets) : 16 munitions, 17 invincible, 18 dark, 19 light,
;; 27 turbos illimites, 37 dark jak guide, 40 invisibilite (28 et 29 se vendent a la boutique)
(defconstant OW_CHEAT_SECRETS #x120080f0000)

(defun ow-cheat-name ((i int))
  (case i
    ((0) (online-fr "Triche createur : INVINCIBLE" "Creator cheat: INVINCIBLE"))
    ((1) (online-fr "Triche createur : munitions infinies" "Creator cheat: endless ammo"))
    ((2) (online-fr "Triche createur : Dark Jak illimite" "Creator cheat: endless Dark Jak"))
    ((3) (online-fr "Triche createur : Light Jak illimite" "Creator cheat: endless Light Jak"))
    (else (online-fr "Triche createur : MODE DEBUG" "Creator cheat: DEBUG MODE"))
    )
  )

(define *ow-cheat-seen* 0)
(defun ow-cheats-detect! ()
  "au tout debut de l'image, AVANT que le monde en ligne remette l'inventaire du profil : une
   triche activee (memoire modifiee, console, menus, mode debug) est signalee au programme
   (ce joueur ne gagne plus rien dans le monde en ligne)"
  (let ((gi *game-info*))
    (when (and (online-in-session?) (not (ow-createur?)))
      (when (and (or (and gi (logtest? (the-as int (-> gi secrets)) OW_CHEAT_SECRETS))
                     (logtest? (the-as int (-> *pc-settings* cheats)) OW_PC_CHEATS_BANNED)
                     (= *cheat-mode* 'debug)
                     *debug-unkillable*
                     )
                 (< (seconds 5) (- (online-now) *ow-cheat-seen*))
                 )
        (set! *ow-cheat-seen* (online-now))
        (online-push-out-event! ONLINE_EVENT_CHEAT (the-as uint 0) 0.0 (if (= *cheat-mode* 'debug) 1 4) (the-as vector #f))
        )
      )
    )
  (none)
  )

(defun ow-cheats-tick! ()
  (ow-cheats-detect!)
  (let* ((gi *game-info*)
         (boss? (and (online-in-session?) (ow-createur?)))
         (on (if boss? *ow-admin-cheats* 0))
         (want 0)
         )
    (if (not boss?)
        (set! *ow-admin-cheats* 0)
        )
    ;; triche vue AVANT qu'on la coupe (memoire modifiee, console, menus) : signalee au programme
    ;; (plus aucun gain dans le monde en ligne pour ce joueur)
    (when (and (online-in-session?) (not boss?))
      (set! (-> *pc-settings* cheats)
            (the-as pc-cheats (logclear (the-as int (-> *pc-settings* cheats)) OW_PC_CHEATS_BANNED))
            )
      )
    (if (logtest? on 1) (set! want (logior want (ash 1 17))))
    (if (logtest? on 2) (set! want (logior want (ash 1 16))))
    (if (logtest? on 4) (set! want (logior want (ash 1 18))))
    (if (logtest? on 8) (set! want (logior want (ash 1 19))))
    (when gi
      (set! (-> gi secrets) (the-as game-secrets (logior (logclear (the-as int (-> gi secrets)) OW_CHEAT_SECRETS) want)))
      (set! (-> gi purchase-secrets) (the-as game-secrets (logclear (the-as int (-> gi purchase-secrets)) OW_CHEAT_SECRETS)))
      )
    ;; mode debug et invincibilite de debug : createur seulement
    (cond
      ((logtest? on 16)
       (set! *cheat-mode* 'debug)
       )
      ((= *cheat-mode* 'debug)
       (set! *cheat-mode* #f)
       )
      )
    (when (not (logtest? on 16))
      (set! *debug-unkillable* #f)
      (set! *debug-player-vehicle-unkillable* #f)
      )
    ;; banc de test : triches actives ici (1 secrets, 2 mode debug)
    (set! (-> *online-shm* local pad 21)
          (the-as uint (logior (if (and gi (logtest? (the-as int (-> gi secrets)) OW_CHEAT_SECRETS)) 1 0) (if *cheat-mode* 2 0)))
          )
    )
  (none)
  )

(define *ow-owcom-sticky* #f)

(defun ow-fr3-update! ()
  "maillages dont on a besoin : mon vehicule et ceux des joueurs autour"
  (let ((arr *online-extra-fr3*)
        (w *online-world*)
        )
    (dotimes (i (-> arr length))
      (set! (-> arr i) "")
      )
    (if (not (online-in-session?))
        (set! *ow-owcom-sticky* #f)
        )
    (when (online-in-session?)
      ;; vrai boss en cours (robot, titan, bete) : son maillage
      (if (and (= (-> *online-ext* ev-state) 1) (= (-> *online-ext* ev-kind) ONLINE_EVK_BOSS))
          (ow-fr3-want! (ow-boss-fr3 (the-as int (-> *online-ext* ev-boss))))
          )
      (if (and (>= (-> w veh-vt) 0) (handle->process (-> w veh-last)))
          (ow-fr3-want! (ow-veh-fr3 (-> w veh-vt)))
          )
      ;; personnages joues (moi ou les joueurs autour) : leur maillage est dans owcom.fr3
      ;; une fois charge, owcom.fr3 reste charge toute la session (le decharger et le recharger
      ;; a chaque changement de personnage fait disparaitre des maillages chez certains)
      (let ((need (or *ow-owcom-sticky* (> *ow-perso-cur* 0))))
        (dotimes (i ONLINE_MAX_PUPPETS)
          (let ((p (online-puppet-proc i)))
            (if (and p (> (-> p perso) 0))
                (set! need #t)
                )
            )
          )
        (when need
          (set! *ow-owcom-sticky* #t)
          (ow-fr3-want! "owcom")
          )
        )
      (when (-> w veh-wait)
        (ow-fr3-want! (ow-veh-fr3 (-> w veh-vt)))
        )
      (dotimes (i ONLINE_MAX_PUPPETS)
        (let ((p (online-puppet-proc i)))
          (when p
            (dotimes (j ONLINE_MAX_OBJECTS)
              (when (nonzero? (-> p obj-name (* j 32)))
                (ow-fr3-want!
                  (ow-skel-fr3 (online-chars->string (-> w str3) (the-as (pointer uint8) (&-> p obj-name (* j 32))) 32))
                  )
                )
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun ow-vehicle-host ((vt int))
  "niveau auquel on rattache le vehicule appele : il doit rester charge pendant qu'on roule
   (jamais le niveau par defaut du jeu, sur lequel un vehicule ne peut pas vivre)"
  (let ((native (-> *traffic-info* vehicle-levels vt)))
    (cond
      ((and native (let ((lev (level-get *level* native))) (and lev (= (-> lev status) 'active))))
       native
       )
      ((ow-level-active? "wasall") 'wasall)
      ((ow-level-active? "ctywide") 'ctywide)
      ((ow-level-active? "waswide") 'waswide)
      (else
        (let ((lev (level-get-target-inside *level*)))
          (if (and lev
                   (-> lev name)
                   (= (-> lev status) 'active)
                   (not (member (-> lev name) '(hiphog onintent freehq title)))
                   )
              (-> lev name)
              (the-as symbol #f)
              )
          )
        )
      )
    )
  )

(defun ow-vehicle-type-ok? ((vt int))
  "peut-on creer ce vehicule ici ? (il faut un niveau pour le porter)"
  (the-as symbol (ow-vehicle-host vt))
  )

(defun ow-vehicle-for-item ((id int))
  "type de vehicule pour un objet de la boutique (-1 si ce n'est pas un vehicule)"
  (case id
    ((43) 12)
    ((44) 15)
    ((45) 13)
    ((46) 14)
    ((47) 17)
    ((48) 16)
    ((49) 18)
    ((50) 19)
    ((51) 0)
    ((52) 3)
    ((53) 6)
    (else -1)
    )
  )

(defun ow-vehicle-allowed? ((id int))
  "dans le monde en ligne il faut l'avoir achete ; en session privee tout est libre"
  (or (not (-> *online-world* active)) (ow-owned? id)))

(defun ow-spawn-vehicle! ((id int))
  (let ((w *online-world*)
        (t *target*)
        (vt (ow-vehicle-for-item id))
        )
    (cond
      ((not t)
       )
      ((not (ow-vehicle-allowed? id))
       (ow-hint! (online-fr "Achete-le d'abord a la boutique du Naughty Ottsel" "Buy it first at the Naughty Ottsel shop"))
       )
      ((< vt 0)
       )
      ((not (ow-vehicle-host vt))
       (ow-hint! (online-fr "Pas ici (a l'interieur) : sors d'abord" "Not here (indoors): go outside first"))
       )
      ((focus-test? t dead pilot board mech flut dark light grabbed)
       (ow-hint! (online-fr "Impossible maintenant" "Not now"))
       )
      ((< (online-now) (-> w veh-cool))
       (ow-hint! (online-fr "Patiente un peu..." "Wait a moment..."))
       )
      (else
        (set! (-> w veh-cool) (+ (online-now) (seconds 3)))
        ;; l'ancien vehicule appele disparait (un seul a la fois, comme dans GTA)
        (let ((old (handle->process (-> w veh-last))))
          (if old
              (send-event old 'die)
              )
          )
        (set! (-> w veh-last) (the-as handle #f))
        (set! (-> w veh-wait) #t)
        (set! (-> w veh-wait-time) (online-now))
        (set! (-> w veh-vt) vt)
        ;; le vehicule vit dans un niveau qui reste charge (wasall au desert, ctywide a Haven...)
        (set! (-> *traffic-info* vehicle-levels vt) (ow-vehicle-host vt))
        ;; et le rendu doit avoir son maillage
        (ow-fr3-want! (ow-veh-fr3 vt))
        (send-event t 'change-mode 'pilot #f vt #f)
        )
      )
    )
  (none)
  )

(defun ow-vehicle-tick! ()
  "retient le vehicule qui vient d'etre appele"
  (let ((w *online-world*)
        (t *target*)
        )
    (if (not (and t (focus-test? t pilot)))
        (set! (-> w veh-since) (online-now))
        )
    ;; securite : le niveau qui porte mon vehicule appele n'est plus charge -> il disparait
    (let ((v (handle->process (-> w veh-last))))
      (when (and v (or (not (-> v level)) (!= (-> v level status) 'active)))
        (cond
          ((and t (focus-test? t pilot))
           (send-event t 'end-mode 'pilot)
           )
          (else
            (deactivate v)
            (set! (-> w veh-last) (the-as handle #f))
            )
          )
        )
      )
    (when (-> w veh-wait)
      (cond
        ((< (seconds 6) (- (online-now) (-> w veh-wait-time)))
         (set! (-> w veh-wait) #f)
         )
        ((and t (focus-test? t pilot) (nonzero? (-> t pilot)) (handle->process (-> t pilot vehicle)))
         (set! (-> w veh-last) (-> t pilot vehicle))
         (set! (-> w veh-wait) #f)
         )
        )
      )
    )
  (none)
  )

;; collisions entre vehicules / joueurs : chacun gere son propre vehicule (et son Jak)
(defun ow-my-vehicle ()
  (let ((t *target*))
    (if (and t (focus-test? t pilot) (nonzero? (-> t pilot)))
        (let ((veh (handle->process (-> t pilot vehicle))))
          (if (and veh (type? veh rigid-body-object))
              (the-as rigid-body-object veh)
              (the-as rigid-body-object #f)
              )
          )
        (the-as rigid-body-object #f)
        )
    )
  )

(defun ow-float-ok? ((f float))
  (and (= f f) (< (fabs f) 100000000.0)))

(defun ow-vehicle-kick! ((veh rigid-body-object) (dv vector))
  "change la vitesse du vehicule (dv en unites par seconde, plafonnee)"
  (let ((rb (-> veh rbody)))
    (when (and rb
               (nonzero? rb)
               (nonzero? (-> rb info))
               (< 0.0 (-> rb info mass))
               (ow-float-ok? (-> rb info mass))
               (ow-float-ok? (-> rb lin-velocity x))
               (ow-float-ok? (-> rb lin-velocity y))
               (ow-float-ok? (-> rb lin-velocity z))
               (ow-float-ok? (-> dv x))
               (ow-float-ok? (-> dv y))
               (ow-float-ok? (-> dv z))
               )
      (let ((len (vector-length dv)))
        (if (< (meters 24.0) len)
            (vector-float*! dv dv (/ (meters 24.0) len))
            )
        )
      (set! (-> dv w) 0.0)
      (vector+float*! (-> rb lin-momentum) (-> rb lin-momentum) dv (-> rb info mass))
      (init-velocities! rb)
      )
    )
  (none)
  )

(defun online-world-vehicle-lift! ((dir vector))
  "tir de gravite recu en vehicule : le vehicule s'envole en tournant ; #f si a pied"
  (let ((veh (ow-my-vehicle)))
    (when veh
      (let ((dv (vector-float*! (new 'stack-no-clear 'vector) dir (meters 4.0))))
        (set! (-> dv y) (meters 22.0))
        (set! (-> dv w) 0.0)
        (ow-vehicle-kick! veh dv)
        (let ((rb (-> veh rbody)))
          (when (and rb (nonzero? rb) (nonzero? (-> rb info)) (< 0.0 (-> rb info mass)) (ow-float-ok? (-> rb info mass)))
            (+! (-> rb ang-momentum x) (* 0.6 (-> rb info mass) 4096.0))
            (+! (-> rb ang-momentum z) (* 0.4 (-> rb info mass) 4096.0))
            (init-velocities! rb)
            )
          )
        )
      )
    (the-as symbol veh)
    )
  )

(defun ow-collisions! ()
  "vehicules des autres joueurs : on rebondit dessus, et ils peuvent nous ecraser"
  (let ((t *target*)
        (w *online-world*)
        (shm *online-shm*)
        (now (online-now))
        )
    (when (and t (online-pvp-allowed?) (not (paused?)) (not (focus-test? t dead)))
      (let ((veh (ow-my-vehicle)))
        (dotimes (i ONLINE_MAX_PUPPETS)
          (let ((rs (-> shm remote i))
                (p (online-puppet-proc i))
                )
            (when (and p
                       (-> p shown)
                       (nonzero? (-> rs active))
                       (logtest? (-> rs flags) ONLINE_FLAG_VEHICLE)
                       (not (logtest? (-> rs flags) (logior ONLINE_FLAG_DEAD ONLINE_FLAG_PAUSED)))
                       )
              (let* ((d (vector-! (new 'stack-no-clear 'vector) (-> t control trans) (-> p root trans)))
                     (dy (fabs (-> d y)))
                     )
                (set! (-> d y) 0.0)
                (let ((dist (vector-length d))
                      (their-speed (sqrtf (+ (* (-> rs vel x) (-> rs vel x)) (* (-> rs vel z) (-> rs vel z)))))
                      )
                  (cond
                    (veh
                      ;; vehicule contre vehicule : on rebondit (pas pendant les 3 premieres secondes
                      ;; dans le vehicule : deux joueurs qui apparaissent au meme endroit se superposent)
                      (when (and (< dist (meters 4.5)) (< dy (meters 3.0)) (< (-> w bump-cool) now)
                                 (< (seconds 3) (- now (-> w veh-since)))
                                 )
                        (let* ((n (vector-normalize! (if (< dist 1.0) (vector-copy! d (-> t control c-R-w fvec)) d) 1.0))
                               (rb (-> veh rbody))
                               (rel (vector-! (new 'stack-no-clear 'vector) (-> rb lin-velocity) (-> rs vel)))
                               (vn (vector-dot rel n))
                               )
                          (when (and (< vn (meters -2.0)) (ow-float-ok? vn))
                            (set! (-> w bump-cool) (+ now (seconds 0.25)))
                            ;; CHOC REALISTE (masses egales, choc peu elastique) : chacun prend 65 % de la
                            ;; vitesse relative. Celui qui fonce ralentit, celui qui est percute part comme
                            ;; un vehicule civil. Chaque jeu calcule SON vehicule (meme choc des deux cotes).
                            (let ((dv (vector-float*! (new 'stack-no-clear 'vector) n (+ (meters 1.5) (* -0.65 vn)))))
                              (set! (-> dv y) (fmin (meters 6.0) (* 0.2 (fabs vn))))
                              (set! (-> dv w) 0.0)
                              (ow-vehicle-kick! veh dv)
                              )
                            ;; choc violent : les deux vehicules s'abiment (on peut detruire celui de
                            ;; l'autre en le percutant). Chaque jeu envoie le coup a l'autre et
                            ;; encaisse sa part.
                            (when (< (meters 10.0) (fabs vn))
                              (let ((dmg (fmax 1.0 (fmin 6.0 (/ (fabs vn) (meters 8.0)))))
                                    (away (vector-float*! (new 'stack-no-clear 'vector) n -1.0))
                                    )
                                (online-send-hit! i dmg ONLINE_MODE_IMPACT away)
                                (set! (-> *online* veh-hit-by) (-> rs player-id))
                                (set! (-> *online* veh-hit-time) now)
                                (send-event veh 'attack #f
                                  (static-attack-info :mask (vehicle-impulse-factor)
                                    ((id (new-attack-id)) (damage (* 0.4 dmg)) (vehicle-damage-factor 1.0) (vehicle-impulse-factor 0.2) (mode 'generic))
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    (else
                      ;; a pied : un vehicule lance nous ecrase
                      (when (and (< dist (meters 3.2)) (< dy (meters 2.5)) (< (meters 8.0) their-speed) (< (-> w hit-cool) now))
                        (set! (-> w hit-cool) (+ now (seconds 1.2)))
                        (let ((ev (new 'stack-no-clear 'online-event))
                              (dir (vector-normalize-copy! (new 'stack-no-clear 'vector) (-> rs vel) 1.0))
                              )
                          (set! (-> ev kind) (the-as uint ONLINE_EVENT_HIT))
                          (set! (-> ev player-id) (-> rs player-id))
                          (set! (-> ev damage) (fmin 8.0 (* their-speed (/ 1.0 (meters 6.0)))))
                          (set! (-> ev mode) (the-as uint ONLINE_MODE_IMPACT))
                          (vector-copy! (-> ev dir) dir)
                          (online-apply-in-event! ev)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; mini-carte et carte : les autres joueurs
;; Chaque joueur est dessine avec la MEME fleche que Jak, orientee dans le sens ou il regarde,
;; et avec SA couleur (la meme chez tout le monde : elle vient de son numero de joueur).
;; Mini-carte : les joueurs proches (avec le RADAR, tous, au bord de la carte). Tete mise a
;; prix : fleche rouge clignotante, toujours visible. Joueur "fantome" : invisible.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define *ow-colors*
  (new 'static 'array rgba 12
    (new 'static 'rgba :r #xff :g #x46 :b #x46 :a #x80)
    (new 'static 'rgba :r #xff :g #xaa :b #x00 :a #x80)
    (new 'static 'rgba :r #xff :g #xff :b #x3c :a #x80)
    (new 'static 'rgba :r #x5a :g #xff :b #x5a :a #x80)
    (new 'static 'rgba :r #xff :g #x5a :b #xff :a #x80)
    (new 'static 'rgba :r #xaa :g #x6e :b #xff :a #x80)
    (new 'static 'rgba :r #xff :g #xff :b #xff :a #x80)
    (new 'static 'rgba :r #x46 :g #x8c :b #xff :a #x80)
    (new 'static 'rgba :r #xff :g #x8c :b #xbe :a #x80)
    (new 'static 'rgba :r #xa0 :g #xff :b #x28 :a #x80)
    (new 'static 'rgba :r #xff :g #xd2 :b #x82 :a #x80)
    (new 'static 'rgba :r #x78 :g #xff :b #xdc :a #x80)
    )
  )

(defun ow-color-index ((id uint))
  (let ((h (logand (* (the-as int id) 2654435761) #xffffffff)))
    (mod (the-as int (shr h 16)) 12)
    )
  )

(defun ow-player-color ((id uint) (bounty symbol))
  (if (and bounty (< (logand (-> *display* base-clock integral-frame-counter) 15) 8))
      (new 'static 'rgba :r #xff :g #x10 :b #x10 :a #x80)
      (-> *ow-colors* (ow-color-index id))
      )
  )

(deftype ow-heading-table (structure)
  ((id    uint32 100)
   (pos   vector 100 :inline)
   (dir   vector 100 :inline)
   )
  )

(define *ow-headings* (new 'global 'ow-heading-table))

(let ((h *ow-headings*))
  (dotimes (i 100)
    (set! (-> h id i) (the-as uint 0))
    (set-vector! (-> h dir i) 0.0 0.0 1.0 0.0)
    )
  )

(defun ow-heading-of ((id uint) (pos vector) (out vector))
  "direction d'un joueur lointain : celle de son dernier deplacement"
  (let ((h *ow-headings*)
        (slot -1)
        (free -1)
        )
    (dotimes (i 100)
      (if (= (-> h id i) id)
          (set! slot i)
          )
      (if (and (< free 0) (zero? (-> h id i)))
          (set! free i)
          )
      )
    (when (< slot 0)
      (set! slot (if (>= free 0) free (mod (the-as int id) 100)))
      (set! (-> h id slot) id)
      (vector-copy! (-> h pos slot) pos)
      (set-vector! (-> h dir slot) 0.0 0.0 1.0 0.0)
      )
    (let ((d (vector-! (new 'stack-no-clear 'vector) pos (-> h pos slot))))
      (set! (-> d y) 0.0)
      (when (< (meters 1.0) (vector-length d))
        (vector-normalize-copy! (-> h dir slot) d 1.0)
        (vector-copy! (-> h pos slot) pos)
        )
      )
    (vector-copy! out (-> h dir slot))
    )
  out
  )

(defun ow-map-player-pos ((k int) (pos vector) (dir vector))
  "position + direction du joueur k (liste EXT) ; #f si inconnue"
  (let* ((ext *online-ext*)
         (pl (-> ext players k))
         (id (-> pl id))
         (found #f)
         )
    ;; avatar proche : position et orientation exactes
    (dotimes (i ONLINE_MAX_PUPPETS)
      (let ((rs (-> *online-shm* remote i)))
        (when (and (not found) (nonzero? (-> rs active)) (= (-> rs player-id) id))
          (let ((p (online-puppet-proc i)))
            (when (and p (-> p placed))
              (vector-copy! pos (-> p root trans))
              (vector-z-quaternion! dir (-> p root quat))
              (set! found #t)
              )
            )
          )
        )
      )
    (when (and (not found) (nonzero? (-> pl has-pos)))
      (set-vector! pos (-> pl x) (-> pl y) (-> pl z) 1.0)
      (ow-heading-of id pos dir)
      (set! found #t)
      )
    found
    )
  )

(defun ow-map-player-visible? ((pl online-ext-player))
  (and (nonzero? (-> pl id))
       (not (logtest? (-> pl flags) (logior ONLINE_PX_ME ONLINE_PX_BANNED)))
       ;; fantome : invisible sur les cartes (le createur voit tout)
       (or (not (logtest? (-> pl flags2) 1)) (ow-createur?))
       )
  )

(defun ow-minimap-extra ((mm minimap) (work minimap-draw-work) (buf dma-buffer))
  "appelee par la mini-carte (engine/ui/minimap.gc) apres la fleche de Jak"
  (when (and (online-in-session?) *target*)
    (let* ((ext *online-ext*)
           (n (min 100 (the-as int (-> ext player-count))))
           (radar (< 0.0 (-> ext power-left ONLINE_POW_RADAR)))
           (pos (new 'stack-no-clear 'vector))
           (dir (new 'stack-no-clear 'vector))
           )
      (dotimes (k n)
        (let ((pl (-> ext players k)))
          (when (and (ow-map-player-visible? pl) (ow-map-player-pos k pos dir))
            (let ((bounty (logtest? (-> pl flags) ONLINE_PX_BOUNTY)))
              (minimap-draw-arrow mm work buf pos dir (ow-player-color (-> pl id) bounty) (if bounty 8.5 6.5) (or radar bounty))
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun ow-bigmap-extra ((bm bigmap) (buf dma-buffer))
  "appelee par la grande carte (engine/ui/bigmap.gc) apres la fleche de Jak"
  (when (online-in-session?)
    (let* ((ext *online-ext*)
           (n (min 100 (the-as int (-> ext player-count))))
           (pos (new 'stack-no-clear 'vector))
           (dir (new 'stack-no-clear 'vector))
           )
      (dotimes (k n)
        (let ((pl (-> ext players k)))
          (when (and (ow-map-player-visible? pl) (ow-map-player-pos k pos dir))
            (let ((bounty (logtest? (-> pl flags) ONLINE_PX_BOUNTY)))
              (bigmap-draw-arrow bm buf pos dir (ow-player-color (-> pl id) bounty) (if bounty 11.0 9.0))
              )
            )
          )
        )
      )
    )
  (none)
  )

(set! *minimap-extra-draw* ow-minimap-extra)
(set! *bigmap-extra-draw* ow-bigmap-extra)

(defun ow-icon-owner ()
  "processus proprietaire des icones de la carte (les icones disparaissent avec lui)"
  (let* ((w *online-world*)
         (p (handle->process (-> w icon-owner)))
         )
    (when (not p)
      (set! (-> w race-icon) #f)
      (set! (-> w ev-icon) #f)
      (let ((pp (process-spawn-function
                  process
                  (lambda :behavior process () (until #f (suspend)) #f)
                  :name "online-carte"
                  :to *default-pool*
                  :stack-size #x1000
                  )
                )
            )
        (when pp
          (set! (-> w icon-owner) (ppointer->handle pp))
          (set! p (ppointer->process pp))
          )
        )
      )
    p
    )
  )

(defun ow-icon-mine? ((c connection-minimap) (owner process) (pos vector))
  "cette connexion est-elle toujours la notre ? (le moteur peut l'avoir liberee)"
  (and c
       (= (-> c handle) (process->handle owner))
       (= (the-as vector (-> c position)) pos)
       )
  )

(defun ow-player-name ((id uint))
  "pseudo d'un autre joueur (par son numero)"
  (let ((s (-> *online-world* str3)))
    (clear s)
    (dotimes (i ONLINE_MAX_PUPPETS)
      (let ((rs (-> *online-shm* remote i)))
        (if (and (nonzero? (-> rs active)) (= (-> rs player-id) id))
            (online-chars->string s (-> rs name) 16)
            )
        )
      )
    s
    )
  )

(defun ow-ride-driver-pos ((id uint))
  "position du vehicule de ce joueur (s'il conduit et qu'il est en vie), #f sinon"
  (let ((found (the-as vector #f)))
    (dotimes (i ONLINE_MAX_PUPPETS)
      (let ((rs (-> *online-shm* remote i)))
        (when (and (not found)
                   (nonzero? (-> rs active))
                   (= (-> rs player-id) id)
                   (logtest? (-> rs flags) ONLINE_FLAG_VEHICLE)
                   (not (logtest? (-> rs flags) ONLINE_FLAG_DEAD))
                   )
          (let ((p (online-puppet-proc i)))
            (set! found (if (and p (-> p placed)) (-> p root trans) (-> rs pos)))
            )
          )
        )
      )
    found
    )
  )

(defun ow-ride-hide! ((hide symbol))
  "Jak (et Daxter) caches pendant qu'il est passager"
  (let ((t *target*))
    (when t
      (if hide
          (logior! (-> t draw status) (draw-control-status no-draw))
          (logclear! (-> t draw status) (draw-control-status no-draw))
          )
      (let ((sk (ppointer->process (-> t sidekick))))
        (when (and sk (nonzero? (-> (the-as process-drawable sk) draw)))
          (if hide
              (logior! (-> (the-as process-drawable sk) draw status) (draw-control-status no-draw))
              (logclear! (-> (the-as process-drawable sk) draw status) (draw-control-status no-draw))
              )
          )
        )
      )
    )
  (none)
  )

(defun ow-ride-stop! ((pos vector))
  "je descends du vehicule (a cote de lui)"
  (let ((w *online-world*)
        (t *target*)
        )
    (set! (-> w ride-with) (the-as uint 0))
    (ow-ride-hide! #f)
    (when (and t (= (-> t state name) 'target-grab))
      (if pos
          (let ((out (new 'stack-no-clear 'vector)))
            (vector-copy! out pos)
            (+! (-> out x) (meters 3.0))
            (+! (-> out y) (meters 1.5))
            (move-to-point! (-> t control) out)
            )
          )
      (send-event t 'end-mode 'grab)
      )
    )
  (none)
  )

(define *ow-ride-press* #f)   ;; banc de test : comme un appui sur TRIANGLE

(defun ow-ride-update! ()
  "monter a plusieurs dans un vehicule : TRIANGLE pres du vehicule d'un autre joueur"
  (let ((w *online-world*)
        (t *target*)
        )
    (set! (-> w ride-near) (the-as uint 0))
    (let ((press *ow-ride-press*))
    (set! *ow-ride-press* press)
    (cond
      ((nonzero? (-> w ride-with))
       (let ((pos (ow-ride-driver-pos (-> w ride-with))))
         (cond
           ((or (not t) (not pos) (focus-test? t dead) (!= (-> t state name) 'target-grab) (not (-> w active))
                (and (or (cpad-pressed? 0 triangle) *ow-ride-press*) (not (-> w tab-open)) (not (-> w shop-open)) (not (-> w chat-open)) (not *progress-process*))
                )
            (ow-ride-stop! pos)
            )
           (else
             ;; assis dans le vehicule du conducteur (ma position suit la sienne)
             (let ((seat (new 'stack-no-clear 'vector)))
               (vector-copy! seat pos)
               (+! (-> seat y) (meters 1.2))
               (move-to-point! (-> t control) seat)
               )
             (ow-ride-hide! #t)
             )
           )
         )
       )
      ((and t (-> w active) (not (-> w tab-open)) (not (-> w shop-open)) (not (-> w chat-open)) (not *progress-process*)
            (not (-> w in-shop-zone)) (not (focus-test? t dead pilot board flut grabbed hit)) (not (movie?)))
       (let ((best (the-as uint 0))
             (bd (meters 5.0))
             )
         (dotimes (i ONLINE_MAX_PUPPETS)
           (let ((rs (-> *online-shm* remote i)))
             (when (and (nonzero? (-> rs active))
                        (logtest? (-> rs flags) ONLINE_FLAG_VEHICLE)
                        (not (logtest? (-> rs flags) ONLINE_FLAG_DEAD))
                        )
               (let ((pos (ow-ride-driver-pos (-> rs player-id))))
                 (when pos
                   (let ((d (vector-vector-distance (-> t control trans) pos)))
                     (when (< d bd)
                       (set! bd d)
                       (set! best (-> rs player-id))
                       )
                     )
                   )
                 )
               )
             )
           )
         (when (nonzero? best)
           (set! (-> w ride-near) best)
           (when (or (cpad-pressed? 0 triangle) *ow-ride-press*)
             (when (send-event t 'change-mode 'grab #t)
               (set! (-> w ride-with) best)
               (ow-ride-hide! #t)
               (sound-play "menu-pick")
               )
             )
           )
         )
       )
      )
    (set! *ow-ride-press* #f)
    )
    )
  (none)
  )

(defun ow-puppet-pos ((id uint))
  "position lissee de l'avatar de ce joueur (s'il est proche), #f sinon"
  (let ((found (the-as vector #f)))
    (dotimes (i ONLINE_MAX_PUPPETS)
      (let ((rs (-> *online-shm* remote i)))
        (when (and (not found) (nonzero? (-> rs active)) (= (-> rs player-id) id))
          (let ((p (online-puppet-proc i)))
            (set! found (if (and p (-> p placed)) (-> p root trans) (-> rs pos)))
            )
          )
        )
      )
    found
    )
  )

(defun ow-icons-update! ()
  "icones fixes : arrivee de la course et lieu de l'evenement du monde"
  (let* ((w *online-world*)
         (ext *online-ext*)
         (want (and (online-in-session?) *target* (not (movie?))))
         (owner (if want (ow-icon-owner) (the-as process #f)))
         )
    (when owner
      ;; arrivee de la course
      (let ((race-on (or (= (-> ext race-state) 1) (= (-> ext race-state) 2))))
        (cond
          ((and race-on (not (-> w race-icon)))
           (vector-copy! (-> w race-pos) (-> ext race-dest))
           (set! (-> w race-pos w) 1.0)
           (set! (-> w race-icon) (add-icon! *minimap* owner (the-as uint 130) (the-as int #f) (-> w race-pos) 0))
           )
          ((and (not race-on) (-> w race-icon))
           (if (ow-icon-mine? (-> w race-icon) owner (-> w race-pos))
               (kill-callback (-> *minimap* engine) (-> w race-icon))
               )
           (set! (-> w race-icon) #f)
           )
          (race-on
            (vector-copy! (-> w race-pos) (-> ext race-dest))
            (set! (-> w race-pos w) 1.0)
            )
          )
        )
      ;; evenement du monde (boss : rouge clignotant, sinon vert clignotant)
      (let ((ev-on (and (= (-> ext ev-state) 1) (nonzero? (-> ext ev-kind))))
            (klass (if (or (= (-> ext ev-kind) ONLINE_EVK_BOSS) (= (-> ext ev-kind) ONLINE_EVK_HUNT)) 129 130))
            )
        (when (and (-> w ev-icon) (or (not ev-on) (!= klass (-> w ev-class)) (!= (-> ext ev-id) (-> w ev-icon-id))))
          (if (ow-icon-mine? (-> w ev-icon) owner (-> w ev-pos))
              (kill-callback (-> *minimap* engine) (-> w ev-icon))
              )
          (set! (-> w ev-icon) #f)
          )
        (when (and ev-on (not (-> w ev-icon)) (!= (-> ext ev-kind) ONLINE_EVK_DOUBLEXP) (!= (-> ext ev-kind) ONLINE_EVK_PARKOUR)
                   ;; chasse a l'homme : la cible ne se voit pas elle-meme
                   (not (and (= (-> ext ev-kind) ONLINE_EVK_HUNT) (= (-> ext ev-target) (-> *online-shm* my-id))))
                   )
          (oe-event-pos (-> w ev-pos))
          (set! (-> w ev-pos w) 1.0)
          (set! (-> w ev-icon) (add-icon! *minimap* owner (the-as uint klass) (the-as int #f) (-> w ev-pos) 0))
          (set! (-> w ev-class) klass)
          (set! (-> w ev-icon-id) (-> ext ev-id))
          )
        ;; le point suit le boss (ou la cible) la ou il est vraiment
        (when (-> w ev-icon)
          (oe-event-pos (-> w ev-pos))
          (set! (-> w ev-pos w) 1.0)
          )
        )
      )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; menu SELECT / TAB : joueurs, BOUTIQUE, evenements, moi, ADMIN (createur / hote)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defconstant OW_TA_NONE 0)
(defconstant OW_TA_PLAYER 1)
(defconstant OW_TA_CMD 2)
(defconstant OW_TA_ALL 3)
(defconstant OW_TA_TIME 4)
(defconstant OW_TA_ANNOUNCE 5)
(defconstant OW_TA_RACE 6)
(defconstant OW_TA_TOGGLE 7)
(defconstant OW_TA_VEHICLE 8)
(defconstant OW_TA_GOTO 9)
(defconstant OW_TA_PVP 10)
(defconstant OW_TA_BACK 11)
(defconstant OW_TA_UNBAN 12)
(defconstant OW_TA_IGNORE 13)
(defconstant OW_TA_GIVE 14)
(defconstant OW_TA_BUY 15)
(defconstant OW_TA_EVENT 16)
(defconstant OW_TA_GIVEVEH 17)
(defconstant OW_TA_VERSION 18)
(defconstant OW_TA_HUNT 19)       ;; chasse a l'homme sur ce joueur (createur)
(defconstant OW_TA_BOUNTY 20)     ;; prime du createur sur ce joueur (arg = orbes)
(defconstant OW_TA_MAP_JOIN 21)   ;; rejoindre le parcours en cours
(defconstant OW_TA_MAP_LEAVE 22)  ;; quitter la carte du parcours (retour au port)
(defconstant OW_TA_PERSO 23)      ;; jouer ce personnage (arg = numero, 0 = Jak)
(defconstant OW_TA_SETLV 24)      ;; createur : niveau du joueur choisi (arg = niveau)
(defconstant OW_TA_SETMONEY 25)   ;; createur : orbes du joueur choisi (arg = orbes)
(defconstant OW_TA_MYLV 26)       ;; createur : mon niveau (arg = niveau)
(defconstant OW_TA_MYMONEY 27)    ;; createur : mes orbes (arg = orbes)
(defconstant OW_TA_CHEAT 28)      ;; createur : ses triches (arg = bit)

(defconstant OW_PAGE_PLAYERS 0)
(defconstant OW_PAGE_SHOP 1)
(defconstant OW_PAGE_EVENTS 2)
(defconstant OW_PAGE_ME 3)
(defconstant OW_PAGE_ADMIN 4)

(defun ow-page-count ()
  (if (ow-mod?) 5 4)
  )

;; destinations des courses (points de passage du jeu) : Haven 0-5, desert 6-11
(define *ow-race-cps*
  (new 'static 'boxed-array :type string
    "ctyport-hiphog" "ctyport-start" "ctysluma-start" "ctyslumc-freehq-exit" "ctygenb-start" "ctyinda-start"
    "wasdoors-desert" "desert-lizard-corral" "desert-nest-exit" "desert-bbush-desa" "desert-bbush-desd" "desert-bbush-desg"
    )
  )

(define *ow-race-names*
  (new 'static 'boxed-array :type string
    "le Naughty Ottsel" "le port de Haven" "le bidonville" "le QG de la resistance" "le centre de Haven" "la zone industrielle"
    "les portes de Spargus" "le corral aux lezards" "l'entree du nid" "le desert (A)" "le desert (D)" "le desert (G)"
    )
  )

(define *ow-race-names-en*
  (new 'static 'boxed-array :type string
    "the Naughty Ottsel" "the Haven port" "the slums" "the Freedom HQ" "Haven center" "the industrial zone"
    "the Spargus gates" "the lizard corral" "the nest entrance" "the desert (A)" "the desert (D)" "the desert (G)"
    )
  )

;; rangs (memes paliers que Jak3Online.exe)
(define *ow-rank-from* (new 'static 'array int32 9 1 5 10 15 20 30 40 50 75))
(define *ow-rank-names*
  (new 'static 'boxed-array :type string "Recrue" "Pillard" "Chasseur" "Guerrier" "Commando" "Champion" "Heros" "Legende" "Precurseur")
  )
(define *ow-rank-names-en*
  (new 'static 'boxed-array :type string "Rookie" "Raider" "Hunter" "Warrior" "Commando" "Champion" "Hero" "Legend" "Precursor")
  )

(defun ow-rank ((level int))
  (let ((r 0))
    (dotimes (i 9)
      (if (>= level (-> *ow-rank-from* i))
          (set! r i)
          )
      )
    r
    )
  )

(defun ow-rank-name ((level int))
  (online-fr (-> *ow-rank-names* (ow-rank level)) (-> *ow-rank-names-en* (ow-rank level)))
  )

(defun ow-rank-color ((level int))
  (case (ow-rank level)
    ((0) (font-color white))
    ((1) (font-color green))
    ((2) (font-color cyan))
    ((3) (font-color yellow))
    ((4) (font-color orange))
    ((5) (font-color red))
    ((6) (font-color pink))
    ((7) (font-color flat-yellow))
    (else (if (< (logand (-> *display* base-clock integral-frame-counter) 31) 16) (font-color cyan) (font-color pink)))
    )
  )

(defmacro ow-row (action arg on fmt &rest args)
  `(let ((ri (-> *online-world* row-count)))
     (when (< ri OW_MAX_ROWS)
       (set! (-> *online-world* row-action ri) ,action)
       (set! (-> *online-world* row-arg ri) ,arg)
       (set! (-> *online-world* row-on ri) ,on)
       (set! (-> *online-world* row-color ri) -1)
       (format (clear (-> *online-world* row-text ri)) ,fmt ,@args)
       (clear (-> *online-world* row-right ri))
       (+! (-> *online-world* row-count) 1)
       )
     )
  )

(defun ow-row-right! ((text string) (color int))
  "texte a droite de la derniere ligne (prix, etat)"
  (let* ((w *online-world*)
         (ri (+ (-> w row-count) -1))
         )
    (when (>= ri 0)
      (format (clear (-> w row-right ri)) "~S" text)
      (set! (-> w row-color ri) color)
      )
    )
  (none)
  )

(defun ow-player-index ((id uint))
  (let ((found -1))
    (dotimes (i (min 100 (the-as int (-> *online-shm* player-count))))
      (if (and (< found 0) (= (-> *online-shm* players i player-id) id))
          (set! found i)
          )
      )
    found
    )
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; PERSONNAGES (menu SELECT > BOUTIQUE) : Jak gratuit, les autres a acheter (objets du profil,
;; sauves par Jak3Online.exe comme les vehicules). Le choix est aussi sauve dans le profil
;; (ext perso). Le corps est pose sur le dessin de Jak (voir ow-perso-lods! dans online.gc).
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define *ow-perso-item* (new 'static 'array int8 7 -1 75 54 55 56 57 58))

(defun ow-perso-name ((k int))
  (case k
    ((1) "Keira")
    ((2) "Jak 2")
    ((3) "Jak 1 HD")
    ((4) "Jak 4")
    ((5) "Tess")
    ((6) "Daxter")
    (else "Jak")
    )
  )

(defun ow-perso-owned? ((k int))
  (or (<= k 0) (and (< k OW_PERSO_COUNT) (ow-owned? (-> *ow-perso-item* k))))
  )

(defun ow-perso-want ()
  "personnage a afficher sur mon Jak"
  (let ((k (the-as int (-> *online-ext* perso))))
    (if (and (online-in-session?) (-> *online-world* active) (> k 0) (< k OW_PERSO_COUNT) (ow-perso-owned? k))
        k
        0
        )
    )
  )

(defun ow-perso-choose! ((k int))
  (cond
    ((not (ow-perso-owned? k))
     (sound-play "generic-beep")
     (ow-hint! (online-fr "Achete d'abord ce personnage" "Buy this character first"))
     )
    (*target*
      (online-push-out-event! ONLINE_EVENT_PERSO (the-as uint 0) 0.0 k (-> *target* control trans))
      (sound-play "menu-pick")
      )
    )
  (none)
  )

(define-extern ow-shop-rows! (function int int none))

(defun ow-perso-rows! ()
  (ow-row OW_TA_NONE 0 #f (online-fr "-- PERSONNAGES : ton corps, avec les mouvements de Jak --" "-- CHARACTERS: your body, with Jak's moves --"))
  (dotimes (k OW_PERSO_COUNT)
    (let ((cur (= k (the-as int (-> *online-ext* perso)))))
      (cond
        ((ow-perso-owned? k)
         (ow-row OW_TA_PERSO k #t (online-fr "Jouer : ~S" "Play: ~S") (ow-perso-name k))
         (ow-row-right! (if cur
                            (online-fr "ACTIF" "ACTIVE")
                            (if (zero? k) (online-fr "GRATUIT" "FREE") (online-fr "ACHETE" "OWNED"))
                            )
                        (the-as int (if cur (font-color green) (font-color flat-yellow)))
                        )
         )
        (else
          (ow-shop-rows! (-> *ow-perso-item* k) (-> *ow-perso-item* k))
          )
        )
      )
    )
  (none)
  )

(defun ow-perso-cloth-off! ((t target))
  "le tissu de Jak (echarpe, jupe) ne doit pas etre dessine sur un autre corps"
  (let ((ci (-> t draw cloth-instances)))
    (when (and ci (nonzero? ci))
      (dotimes (i (-> ci length))
        ;; ses bandes se dessinent meme a l'arret (files du niveau du corps) : on les vide
        (if (not (logtest? (-> ci i flags) (cloth-flag hidden)))
            (hide! (-> ci i))
            )
        (logclear! (-> ci i flags) (cloth-flag active))
        )
      )
    )
  (none)
  )

;; ce qu'avait Jak avant le changement de corps (restaure au retour a Jak)
(define *ow-perso-jak-seg* (the-as uint -1))
(define *ow-perso-jak-shadow* (the-as shadow-geo #f))
(define *ow-perso-jak-cloth* 0) ;; tissus actifs (bits)
(define *ow-perso-jak-lods* (new 'global 'lod-set))
(define *ow-perso-jak-eff* (the-as uint 0))

(defun ow-perso-note-jak! ((t target))
  "Jak juste avant de changer de corps (etat sur) : on note son corps, ses masques, son ombre
   et son tissu, remis tels quels au retour a Jak"
  (mem-copy! (the-as pointer *ow-perso-jak-lods*) (the-as pointer (-> t draw lod-set)) 49)
  (set! *ow-perso-jak-seg* (-> t draw seg-mask))
  (set! *ow-perso-jak-eff* (-> t draw effect-mask))
  (if (-> t draw shadow)
      (set! *ow-perso-jak-shadow* (-> t draw shadow))
      )
  (let ((ci (-> t draw cloth-instances))
        (bits 0)
        )
    (when (and ci (nonzero? ci))
      (dotimes (i (-> ci length))
        (if (and (logtest? (-> ci i flags) (cloth-flag active)) (not (logtest? (-> ci i flags) (cloth-flag hidden))))
            (set! bits (logior bits (ash 1 i)))
            )
        )
      )
    (if (or (nonzero? bits) (zero? *ow-perso-cur*))
        (set! *ow-perso-jak-cloth* bits)
        )
    )
  (none)
  )

(defun ow-perso-restore-jak! ((t target))
  "remet le corps de Jak comme le fait l'avatar (target-continue-init-art appele hors de son
   etat rend Jak et Daxter invisibles)"
  (ow-perso-draw-level! (-> t draw) #f)
  (lods-assign! (-> t draw) *ow-perso-jak-lods*)
  (set! (-> t draw seg-mask) *ow-perso-jak-seg*)
  (set! (-> t draw effect-mask) *ow-perso-jak-eff*)
  (set! (-> t draw shadow) *ow-perso-jak-shadow*)
  (let ((ci (-> t draw cloth-instances)))
    (when (and ci (nonzero? ci))
      (dotimes (i (-> ci length))
        (logclear! (-> ci i flags) (cloth-flag hidden no-draw))
        (if (logtest? *ow-perso-jak-cloth* (ash 1 i))
            (logior! (-> ci i flags) (cloth-flag need-reset active))
            )
        )
      )
    )
  (none)
  )

(defun ow-perso-indax-ok? ((t target))
  "Jak peut devenir Daxter ici (au sol, a pied, pas en train de mourir ou de conduire)"
  (and (not (focus-test? t dead grabbed pilot board mech flut dark light edge-grab in-head teleporting tube pole carry turret))
       (logtest? (-> t control status) (collide-status on-surface))
       (= (-> t ext-anim) (target-anim default))
       (not (ow-map-inside?))
       )
  )

(defun ow-perso-tick! ()
  "pose (ou enleve) le corps du personnage choisi sur mon Jak"
  (let ((t *target*)
        (k (ow-perso-want))
        )
    ;; DAXTER : le vrai mode Daxter du jeu (indax), pas un corps pose sur Jak
    (when (and t (nonzero? (-> t draw)))
      (cond
        ((= k OW_PERSO_DAXTER)
         (cond
           ((focus-test? t indax)
            (set! *ow-perso-cur* OW_PERSO_DAXTER)
            )
           ((ow-perso-indax-ok? t)
            (when (and (> *ow-perso-cur* 0) (!= *ow-perso-cur* OW_PERSO_DAXTER))
              (set! *ow-perso-cur* 0)
              (ow-perso-restore-jak! t)
              )
            (send-event t 'change-mode 'indax #f #t)
            )
           )
         )
        ((= *ow-perso-cur* OW_PERSO_DAXTER)
         (if (focus-test? t indax)
             (send-event t 'end-mode 'indax)
             (set! *ow-perso-cur* 0)
             )
         )
        )
      )
    ;; Daxter sur l'epaule : seulement avec Jak de Jak 3
    (set! *ow-sidekick-hide* (the-as symbol (and t (> k 0) (!= k OW_PERSO_DAXTER))))
    (when (and t (nonzero? (-> t draw)) (-> t draw lod-set lod 0 geo) (!= k OW_PERSO_DAXTER) (!= *ow-perso-cur* OW_PERSO_DAXTER))
      (cond
        ((> k 0)
         (let ((geo (ow-perso-geo k)))
           (cond
             (geo
               (if (zero? *ow-perso-cur*)
                   (ow-perso-note-jak! t)
                   )
               ;; tissu et ombre de Jak : pas sur un autre corps (et ils ne se dessinent pas dans
               ;; les files d'un niveau : le rendu PC plante), donc coupes AVANT de changer de files
               (ow-perso-cloth-off! t)
               (set! (-> t draw shadow) #f)
               (if (!= (-> t draw lod-set lod 0 geo) geo)
                   (ow-perso-lods! (-> t draw) k)
                   (ow-perso-draw-level! (-> t draw) #t)
                   )
               (set! *ow-perso-cur* k)
               )
             ((> *ow-perso-cur* 0)
              (set! *ow-perso-cur* 0)
              (ow-perso-restore-jak! t)
              )
             )
           )
         )
        ((> *ow-perso-cur* 0)
         ;; retour a Jak
         (set! *ow-perso-cur* 0)
         (ow-perso-restore-jak! t)
         )
        )
      )
    ;; banc de test : personnage pose sur moi / vu sur le premier avatar
    (let ((loc (-> *online-shm* local))
          (seen 0)
          )
      (set! (-> loc pad 19) (the-as uint *ow-perso-cur*))
      (dotimes (i ONLINE_MAX_PUPPETS)
        (let ((p (online-puppet-proc i)))
          (if (and p (zero? seen) (>= (-> p geo) 100))
              (set! seen (- (-> p geo) 100))
              )
          )
        )
      (set! (-> loc pad 20) (the-as uint seen))
      )
    )
  (none)
  )

(ow-shop-extra-init!)

(defun ow-shop-rows! ((first int) (last int))
  (let ((id first))
    (while (<= id last)
      (when (nonzero? (length (ow-item-name id)))
        (let ((kind (-> *ow-shop-kind* id)))
          (cond
            ((and (= kind 3) (ow-owned? id))
             (ow-row OW_TA_VEHICLE id (ow-vehicle-type-ok? (ow-vehicle-for-item id)) "~S" (ow-item-name id))
             )
            ((and (= kind 4) (ow-owned? id))
             (ow-row OW_TA_VEHICLE id (ow-vehicle-type-ok? (ow-vehicle-for-item id)) "~S" (ow-item-name id))
             )
            (else
              (ow-row OW_TA_BUY id #t "~S" (ow-item-name id))
              )
            )
          (ow-row-right! (ow-item-state (-> *online-world* str3) id) (the-as int (ow-item-color id)))
          )
        )
      (+! id 1)
      )
    )
  (none)
  )

(defun ow-tab-build! ()
  "lignes du menu selon la page"
  (let* ((w *online-world*)
         (shm *online-shm*)
         (ext *online-ext*)
         (mod? (ow-mod?))
         (world? (-> w active))
         (s (-> w str2))
         )
    (set! (-> w row-count) 0)
    (if (>= (-> w tab-page) (ow-page-count))
        (set! (-> w tab-page) 0)
        )
    (cond
      ;; ---------------- actions sur un joueur
      ((-> w tab-sub)
       (let* ((idx (ow-player-index (-> w tab-target)))
              (xp (online-ext-player-by-id (-> w tab-target)))
              )
         (cond
           ((< idx 0)
            (set! (-> w tab-sub) #f)
            )
           (else
             (when (or mod? (not world?))
               (ow-row OW_TA_GOTO 0 #t (online-fr "Aller vers ce joueur" "Go to this player"))
               )
             (ow-row OW_TA_IGNORE 0 #t (if (and xp (logtest? (-> xp flags) ONLINE_PX_MUTED))
                                           (online-fr "Ne plus l'ignorer (chat)" "Stop ignoring (chat)")
                                           (online-fr "L'ignorer (je ne vois plus son chat)" "Ignore (hide their chat)")
                                           )
                    )
             (when mod?
               (ow-row OW_TA_CMD ONLINE_CMD_BRING #t (online-fr "Le teleporter pres de moi" "Teleport to me"))
               (ow-row OW_TA_CMD ONLINE_CMD_HEAL #t (online-fr "Le soigner" "Heal"))
               (if (and xp (logtest? (-> xp flags) ONLINE_PX_FROZEN))
                   (ow-row OW_TA_CMD ONLINE_CMD_UNFREEZE #t (online-fr "Le degeler" "Unfreeze"))
                   (ow-row OW_TA_CMD ONLINE_CMD_FREEZE #t (online-fr "Le geler (ne bouge plus)" "Freeze"))
                   )
               (if (and xp (logtest? (-> xp flags) ONLINE_PX_MUTED))
                   (ow-row OW_TA_CMD ONLINE_CMD_UNMUTE #t (online-fr "Lui rendre la parole" "Unmute"))
                   (ow-row OW_TA_CMD ONLINE_CMD_MUTE #t (online-fr "Le rendre muet (chat)" "Mute (chat)"))
                   )
               (ow-row OW_TA_CMD ONLINE_CMD_SLAP #t (online-fr "Le projeter en l'air" "Slap into the air"))
               (ow-row OW_TA_CMD ONLINE_CMD_KILL #t (online-fr "Le foudroyer" "Smite"))
               (ow-row OW_TA_CMD ONLINE_CMD_KICK #t (online-fr "L'EXPULSER de la session" "KICK from the session"))
               (ow-row OW_TA_CMD ONLINE_CMD_BAN #t (online-fr "Le BANNIR" "BAN"))
               (when (and world? (ow-createur?))
                 (ow-row OW_TA_GIVE 500 #t (online-fr "Lui donner 500 orbes" "Give 500 orbs"))
                 (ow-row OW_TA_GIVE 5000 #t (online-fr "Lui donner 5000 orbes" "Give 5000 orbs"))
                 (ow-row OW_TA_GIVEVEH 0 #t (online-fr "Lui offrir TOUS les vehicules" "Give ALL vehicles"))
                 (ow-row OW_TA_BOUNTY 1000 #t (online-fr "Mettre une PRIME de 1000 orbes sur lui" "Put a 1000 orbs BOUNTY on them"))
                 (ow-row OW_TA_BOUNTY 5000 #t (online-fr "Mettre une PRIME de 5000 orbes sur lui" "Put a 5000 orbs BOUNTY on them"))
                 (ow-row OW_TA_HUNT 0 #t (online-fr "CHASSE A L'HOMME sur lui (1500 orbes au gagnant)" "MANHUNT on them (1500 orbs to the winner)"))
                 (ow-row OW_TA_SETLV 999 #t (online-fr "Son niveau : MAX (999)" "Their level: MAX (999)"))
                 (ow-row OW_TA_SETLV 50 #t (online-fr "Son niveau : 50" "Their level: 50"))
                 (ow-row OW_TA_SETLV 20 #t (online-fr "Son niveau : 20" "Their level: 20"))
                 (ow-row OW_TA_SETLV 10 #t (online-fr "Son niveau : 10" "Their level: 10"))
                 (ow-row OW_TA_SETLV 1 #t (online-fr "Son niveau : 1 (remise a zero)" "Their level: 1 (reset)"))
                 (ow-row OW_TA_SETMONEY 1000000 #t (online-fr "Ses orbes : 1 000 000" "Their orbs: 1,000,000"))
                 (ow-row OW_TA_SETMONEY 100000 #t (online-fr "Ses orbes : 100 000" "Their orbs: 100,000"))
                 (ow-row OW_TA_SETMONEY 10000 #t (online-fr "Ses orbes : 10 000" "Their orbs: 10,000"))
                 (ow-row OW_TA_SETMONEY 0 #t (online-fr "Ses orbes : 0 (tout lui retirer)" "Their orbs: 0 (take all)"))
                 )
               )
             (ow-row OW_TA_BACK 0 #t (online-fr "Retour" "Back"))
             )
           )
         )
       )
      ;; ---------------- joueurs
      ((= (-> w tab-page) OW_PAGE_PLAYERS)
       (dotimes (i (min 100 (the-as int (-> shm player-count))))
         (let* ((pe (-> shm players i))
                (xp (online-ext-player-by-id (-> pe player-id)))
                (me? (logtest? (-> pe flags) ONLINE_PFLAG_ME))
                (lv (if xp (the-as int (-> xp level)) 1))
                )
           (ow-zone-name s (-> pe level))
           (ow-row (if me? OW_TA_NONE OW_TA_PLAYER)
                   i
                   (not me?)
                   (online-fr "Nv~D ~S  ~S  -  ~S~S" "Lv~D ~S  ~S  -  ~S~S")
                   lv
                   (ow-rank-name lv)
                   (online-chars->string (-> w str3) (-> pe name) 16)
                   s
                   (cond
                     (me? (online-fr "  (VOUS)" "  (YOU)"))
                     ((and xp (logtest? (-> xp flags) ONLINE_PX_BOUNTY)) (online-fr "  (PRIME)" "  (BOUNTY)"))
                     ((and xp (logtest? (-> xp flags) ONLINE_PX_CREATEUR)) (online-fr "  (CREATEUR)" "  (CREATOR)"))
                     ((logtest? (-> pe flags) ONLINE_PFLAG_HOST) (online-fr "  (HOTE)" "  (HOST)"))
                     ((and xp (logtest? (-> xp flags2) 2)) (online-fr "  (SUSPECT)" "  (SUSPECT)"))
                     (else "")
                     )
                   )
           )
         )
       )
      ;; ---------------- BOUTIQUE (vehicules a appeler partout, super-pouvoirs, soins)
      ((= (-> w tab-page) OW_PAGE_SHOP)
       (cond
         ((not world?)
          (ow-row OW_TA_NONE 0 #f (online-fr "La boutique est ouverte dans le MONDE EN LIGNE (session publique)" "The shop is open in the ONLINE WORLD (public session)"))
          (ow-row OW_TA_NONE 0 #f (online-fr "-- MES VEHICULES --" "-- MY VEHICLES --"))
          (let ((id 43))
            (while (<= id 53)
              (ow-row OW_TA_VEHICLE id (ow-vehicle-type-ok? (ow-vehicle-for-item id)) (online-fr "Appeler : ~S" "Call: ~S") (ow-item-name id))
              (+! id 1)
              )
            )
          )
         (else
           (ow-row OW_TA_NONE 0 #f (online-fr "-- TELEPORTATION : paye, et tu y es --" "-- TELEPORT: pay and you're there --"))
           (ow-shop-rows! 82 93)
           (ow-row OW_TA_NONE 0 #f (online-fr "-- VEHICULES : achete-les, puis appelle-les partout --" "-- VEHICLES: buy them, then call them anywhere --"))
           (ow-shop-rows! 43 53)
           (ow-row OW_TA_NONE 0 #f (online-fr "-- AMELIORATIONS --" "-- UPGRADES --"))
           (ow-shop-rows! 76 81)
           (ow-row OW_TA_NONE 0 #f (online-fr "-- SUPER-POUVOIRS --" "-- SUPER POWERS --"))
           (ow-shop-rows! 64 71)
           (ow-row OW_TA_NONE 0 #f (online-fr "-- SOINS ET SERVICES --" "-- HEALTH AND SERVICES --"))
           (ow-shop-rows! 60 63)
           (ow-shop-rows! 72 74)
           (ow-perso-rows!)
           (ow-row OW_TA_NONE 0 #f (online-fr "Armes, Dark / Light Jak, armures : au Naughty Ottsel (port de Haven)" "Weapons, Dark / Light Jak, armor: at the Naughty Ottsel (Haven port)"))
           )
         )
       )
      ;; ---------------- evenements et courses
      ((= (-> w tab-page) OW_PAGE_EVENTS)
       (cond
         ((= (-> ext ev-state) 1)
          (ow-zone-name s (-> ext ev-level))
          (ow-row OW_TA_NONE 0 #f (online-fr "EN COURS : ~S  -  ~S" "RUNNING: ~S  -  ~S")
                  (case (the-as int (-> ext ev-kind))
                    ((ONLINE_EVK_BOSS) (online-fr "BOSS GEANT" "GIANT BOSS"))
                    ((ONLINE_EVK_ORBS) (online-fr "PLUIE D'ORBES" "ORB RAIN"))
                    ((ONLINE_EVK_TREASURE) (online-fr "CHASSE AU TRESOR" "TREASURE HUNT"))
                    ((ONLINE_EVK_DOUBLEXP) (online-fr "DOUBLE XP" "DOUBLE XP"))
                    ((ONLINE_EVK_HUNT) (online-fr "CHASSE A L'HOMME" "MANHUNT"))
                    ((ONLINE_EVK_PARKOUR) (online-fr "PARCOURS" "PARKOUR"))
                    ((ONLINE_EVK_METEOR) (online-fr "PLUIE DE METEORES" "METEOR SHOWER"))
                    (else (online-fr "ZONE A CAPTURER" "CAPTURE THE ZONE"))
                    )
                  s
                  )
          ;; parcours : on peut le rejoindre tant qu'il n'est pas fini
          (when (and (= (-> ext ev-kind) ONLINE_EVK_PARKOUR) (not (ow-map-inside?)))
            (ow-row OW_TA_MAP_JOIN 0 #t (online-fr "REJOINDRE LE PARCOURS : ~S" "JOIN THE PARKOUR: ~S") (ow-map-name (the-as int (-> ext ev-boss))))
            )
          )
         (else
           (ow-row OW_TA_NONE 0 #f (online-fr "Un evenement arrive toutes les 6 a 9 minutes : boss geant, tresor, pluie d'orbes..." "An event happens every 6 to 9 minutes: giant boss, treasure, orb rain..."))
           )
         )
       (if (ow-map-inside?)
           (ow-row OW_TA_MAP_LEAVE 0 #t (online-fr "QUITTER CETTE CARTE (retour au port de Haven)" "LEAVE THIS MAP (back to Haven port)"))
           )
       (case (-> ext race-state)
         ((1) (ow-row OW_TA_NONE 0 #f (online-fr "Course en preparation..." "Race starting...")))
         ((2) (ow-row OW_TA_NONE 0 #f (online-fr "Course en cours !" "Race in progress!")))
         (else
           (ow-row OW_TA_NONE 0 #f (online-fr "-- COURSES : les joueurs a moins de 80 m participent --" "-- RACES: players within 80 m take part --"))
           )
         )
       (let* ((lev (ow-my-level-name))
              (desert? (or (ow-prefix? lev "des") (ow-prefix? lev "was")))
              (first (if desert? 6 0))
              )
         (dotimes (k 6)
           (ow-row OW_TA_RACE (+ first k) (zero? (-> ext race-state))
                   (online-fr "Lancer une course vers ~S" "Start a race to ~S")
                   (online-fr (-> *ow-race-names* (+ first k)) (-> *ow-race-names-en* (+ first k)))
                   )
           )
         )
       )
      ;; ---------------- moi
      ((= (-> w tab-page) OW_PAGE_ME)
       (when world?
         (ow-row OW_TA_NONE 0 #f (online-fr "Niveau ~D  -  ~S  -  ~D XP (prochain : ~D)" "Level ~D  -  ~S  -  ~D XP (next: ~D)")
                 (-> ext level) (ow-rank-name (the-as int (-> ext level))) (-> ext xp) (-> ext xp-next))
         (ow-row OW_TA_NONE 0 #f (online-fr "~D orbes  -  ~D eliminations  -  ~D morts  -  serie : ~D" "~D orbs  -  ~D kills  -  ~D deaths  -  streak: ~D")
                 (-> ext money) (-> ext kills) (-> ext deaths) (-> ext streak))
         )
       (ow-row OW_TA_TOGGLE 1 #t (online-fr "Liste des joueurs en haut a gauche : ~S" "Players list top-left: ~S")
               (if (-> w show-list) (online-fr "OUI" "ON") (online-fr "NON" "OFF")))
       (ow-row OW_TA_TOGGLE 2 #t (online-fr "Pseudos au-dessus des joueurs : ~S" "Names above players: ~S")
               (if (-> w show-names) (online-fr "OUI" "ON") (online-fr "NON" "OFF")))
       (ow-row OW_TA_TOGGLE 3 #t (online-fr "Chat a l'ecran : ~S" "Chat on screen: ~S")
               (if (-> w show-chat) (online-fr "OUI" "ON") (online-fr "NON" "OFF")))
       (ow-row OW_TA_NONE 0 #f (online-fr "-- MES VEHICULES (appel rapide) --" "-- MY VEHICLES (quick call) --"))
       (let ((any #f)
             (id 43)
             )
         (while (<= id 53)
           (when (ow-vehicle-allowed? id)
             (set! any #t)
             (ow-row OW_TA_VEHICLE id (ow-vehicle-type-ok? (ow-vehicle-for-item id)) (online-fr "Appeler : ~S" "Call: ~S") (ow-item-name id))
             )
           (+! id 1)
           )
         (if (not any)
             (ow-row OW_TA_NONE 0 #f (online-fr "Aucun : va dans l'onglet BOUTIQUE" "None: see the SHOP tab"))
             )
         )
       )
      ;; ---------------- ADMIN (createur partout, hote en session privee)
      (else
        (ow-row OW_TA_NONE 0 #f
                (online-fr "Session ~S  -  ~D / ~D joueurs  -  PvP ~S" "Session ~S  -  ~D / ~D players  -  PvP ~S")
                (online-chars->string (-> w str3) (-> shm session-code) 8)
                (-> shm session-players)
                (-> shm session-max)
                (if (online-pvp-allowed?) (online-fr "OUI" "ON") (online-fr "NON" "OFF"))
                )
        (ow-row OW_TA_EVENT ONLINE_EVK_BOSS #t (online-fr "Lancer : BOSS au hasard ici" "Start: random BOSS here"))
        (ow-row OW_TA_EVENT (+ ONLINE_EVK_BOSS (* 100 (+ ONLINE_BOSS_ROBOT 1))) #t (online-fr "Lancer : ROBO BOSS ici" "Start: ROBO BOSS here"))
        (ow-row OW_TA_EVENT (+ ONLINE_EVK_BOSS (* 100 (+ ONLINE_BOSS_TITAN 1))) #t (online-fr "Lancer : TITAN ici" "Start: TITAN here"))
        (ow-row OW_TA_EVENT (+ ONLINE_EVK_BOSS (* 100 (+ ONLINE_BOSS_BETE 1))) #t (online-fr "Lancer : BETE DU DESERT ici" "Start: DESERT BEAST here"))
        (ow-row OW_TA_EVENT (+ ONLINE_EVK_BOSS (* 100 (+ ONLINE_BOSS_DARKJAK 1))) #t (online-fr "Lancer : DARK JAK GEANT ici" "Start: GIANT DARK JAK here"))
        (ow-row OW_TA_EVENT ONLINE_EVK_HUNT #t (online-fr "Lancer : CHASSE A L'HOMME sur moi (qui me tue gagne)" "Start: MANHUNT on me (whoever kills me wins)"))
        (ow-row OW_TA_EVENT ONLINE_EVK_METEOR #t (online-fr "Lancer : PLUIE DE METEORES ici" "Start: METEOR SHOWER here"))
        (ow-row OW_TA_EVENT ONLINE_EVK_ORBS #t (online-fr "Lancer : PLUIE D'ORBES ici" "Start: ORB RAIN here"))
        (ow-row OW_TA_EVENT ONLINE_EVK_TREASURE #t (online-fr "Lancer : CHASSE AU TRESOR ici" "Start: TREASURE HUNT here"))
        (ow-row OW_TA_EVENT ONLINE_EVK_ZONE #t (online-fr "Lancer : ZONE A CAPTURER ici" "Start: CAPTURE THE ZONE here"))
        (ow-row OW_TA_EVENT ONLINE_EVK_DOUBLEXP #t (online-fr "Lancer : DOUBLE XP (5 min)" "Start: DOUBLE XP (5 min)"))
        (ow-row OW_TA_PVP 0 #t (if (online-pvp-allowed?) (online-fr "PvP : OUI  (couper)" "PvP: ON  (turn off)") (online-fr "PvP : NON  (activer)" "PvP: OFF  (turn on)")))
        (ow-row OW_TA_ANNOUNCE 0 #t (online-fr "Faire une ANNONCE a tout le monde" "Make an ANNOUNCEMENT"))
        (ow-row OW_TA_TIME 800 #t (online-fr "Heure du monde : matin" "World time: morning"))
        (ow-row OW_TA_TIME 1300 #t (online-fr "Heure du monde : midi" "World time: noon"))
        (ow-row OW_TA_TIME 1900 #t (online-fr "Heure du monde : soir" "World time: evening"))
        (ow-row OW_TA_TIME 2300 #t (online-fr "Heure du monde : nuit" "World time: night"))
        (ow-row OW_TA_ALL ONLINE_CMD_HEAL_ALL #t (online-fr "Soigner tout le monde" "Heal everyone"))
        (ow-row OW_TA_ALL ONLINE_CMD_BRING_ALL #t (online-fr "Teleporter tout le monde pres de moi" "Teleport everyone to me"))
        (ow-row OW_TA_ALL ONLINE_CMD_FREEZE_ALL #t (online-fr "Geler tout le monde" "Freeze everyone"))
        (ow-row OW_TA_ALL ONLINE_CMD_UNFREEZE_ALL #t (online-fr "Degeler tout le monde" "Unfreeze everyone"))
        (ow-row OW_TA_ALL ONLINE_CMD_RESET_ACTORS #t (online-fr "Remettre le monde a neuf (ennemis, caisses, objets)" "Reset the world (enemies, crates, items)"))
        (dotimes (mi OW_MAP_COUNT)
          (ow-row OW_TA_EVENT (+ ONLINE_EVK_PARKOUR (* 100 (+ mi 1))) #t (online-fr "Lancer un PARCOURS : ~S" "Start a PARKOUR: ~S") (ow-map-name mi))
          )
        (when (and world? (ow-createur?))
          (ow-row OW_TA_NONE 0 #f (online-fr "-- MOI (createur) --" "-- ME (creator) --"))
          (ow-row OW_TA_MYLV 999 #t (online-fr "Mon niveau : MAX (999)" "My level: MAX (999)"))
          (ow-row OW_TA_MYLV 50 #t (online-fr "Mon niveau : 50" "My level: 50"))
          (ow-row OW_TA_MYLV 20 #t (online-fr "Mon niveau : 20" "My level: 20"))
          (ow-row OW_TA_MYLV 1 #t (online-fr "Mon niveau : 1 (remise a zero)" "My level: 1 (reset)"))
          (ow-row OW_TA_MYMONEY 9999999 #t (online-fr "Mes orbes : 9 999 999" "My orbs: 9,999,999"))
          (ow-row OW_TA_MYMONEY 100000 #t (online-fr "Mes orbes : 100 000" "My orbs: 100,000"))
          (ow-row OW_TA_MYMONEY 0 #t (online-fr "Mes orbes : 0" "My orbs: 0"))
          (dotimes (ci OW_CHEAT_COUNT)
            (ow-row OW_TA_CHEAT ci #t "~S : ~S" (ow-cheat-name ci)
                    (if (logtest? *ow-admin-cheats* (ash 1 ci)) (online-fr "OUI" "ON") (online-fr "NON" "OFF"))
                    )
            )
          (ow-row OW_TA_UNBAN 0 #t (online-fr "Debannir le dernier joueur banni" "Unban the last banned player"))
          (ow-row OW_TA_VERSION 0 #t (online-fr "Ma version du mod = la version officielle (anti-triche, PAS une sauvegarde)" "My mod version = the official one (anti-cheat, NOT a save)"))
          )
        )
      )
    (if (>= (-> w tab-row) (-> w row-count))
        (set! (-> w tab-row) (max 0 (+ (-> w row-count) -1)))
        )
    (when (-> w tab-fix-row)
      (set! (-> w tab-fix-row) #f)
      (let ((first -1))
        (dotimes (i (-> w row-count))
          (if (and (< first 0) (-> w row-on i))
              (set! first i)
              )
          )
        (if (>= first 0)
            (set! (-> w tab-row) first)
            )
        )
      )
    )
  (none)
  )

(defun ow-tab-open! ()
  (let ((w *online-world*))
    (set! (-> w tab-open) #t)
    (set! (-> w tab-sub) #f)
    (set! (-> w tab-row) 0)
    (set! (-> w tab-scroll) 0)
    (set! (-> w tab-fix-row) #t)
    (ow-kb-off!)
    (sound-play "window-expand")
    )
  (none)
  )

(defun ow-tab-close! ()
  (let ((w *online-world*))
    (set! (-> w tab-open) #f)
    (set! (-> w tab-sub) #f)
    (ow-kb-on-later!)
    (sound-play "window-contract")
    )
  (none)
  )

(defun ow-admin! ((target uint) (cmd int) (arg float))
  "commande de moderation (signee et envoyee par Jak3Online.exe)"
  (let ((pos (new 'stack-no-clear 'vector)))
    (if *target*
        (vector-copy! pos (-> *target* control trans))
        (vector-reset! pos)
        )
    (online-push-out-event! ONLINE_EVENT_ADMIN target arg cmd pos)
    )
  (none)
  )

(defun ow-tab-activate! ()
  (let* ((w *online-world*)
         (row (-> w tab-row))
         (action (-> w row-action row))
         (arg (-> w row-arg row))
         )
    (cond
      ((or (>= row (-> w row-count)) (not (-> w row-on row)))
       (sound-play "generic-beep")
       )
      (else
        (if (!= action OW_TA_BUY)
            (sound-play "select-option")
            )
        (case action
          ((OW_TA_PLAYER)
           (set! (-> w tab-target) (-> *online-shm* players arg player-id))
           (set! (-> w tab-sub) #t)
           (set! (-> w tab-row) 0)
           (set! (-> w tab-scroll) 0)
           )
          ((OW_TA_BACK)
           (set! (-> w tab-sub) #f)
           (set! (-> w tab-row) 0)
           )
          ((OW_TA_CMD)
           (ow-admin! (-> w tab-target) arg 0.0)
           (when (or (= arg ONLINE_CMD_KICK) (= arg ONLINE_CMD_BAN))
             (set! (-> w tab-sub) #f)
             (set! (-> w tab-row) 0)
             )
           )
          ((OW_TA_GIVE)
           (ow-admin! (-> w tab-target) ONLINE_CMD_GIVE (the float arg))
           )
          ((OW_TA_GIVEVEH)
           (ow-admin! (-> w tab-target) ONLINE_CMD_GIVE_VEHICLES 0.0)
           )
          ((OW_TA_IGNORE)
           (ow-admin! (-> w tab-target) ONLINE_CMD_IGNORE 0.0)
           )
          ((OW_TA_ALL)
           (ow-admin! (the-as uint 0) arg 0.0)
           )
          ((OW_TA_TIME)
           (ow-admin! (the-as uint 0) ONLINE_CMD_TIME (the float arg))
           )
          ((OW_TA_UNBAN)
           (ow-admin! (the-as uint 0) ONLINE_CMD_UNBAN 0.0)
           )
          ((OW_TA_EVENT)
           (ow-admin! (the-as uint 0) ONLINE_CMD_EVENT (the float arg))
           (ow-tab-close!)
           )
          ((OW_TA_HUNT)
           (ow-admin! (-> w tab-target) ONLINE_CMD_EVENT (the float ONLINE_EVK_HUNT))
           (ow-tab-close!)
           )
          ((OW_TA_BOUNTY)
           (ow-admin! (-> w tab-target) ONLINE_CMD_BOUNTY (the float arg))
           )
          ((OW_TA_MAP_JOIN)
           (ow-map-join!)
           (ow-tab-close!)
           )
          ((OW_TA_MAP_LEAVE)
           (ow-map-leave!)
           (ow-tab-close!)
           )
          ((OW_TA_PERSO)
           (ow-perso-choose! arg)
           )
          ((OW_TA_SETLV)
           (ow-admin! (-> w tab-target) ONLINE_CMD_SET_LEVEL (the float arg))
           )
          ((OW_TA_SETMONEY)
           (ow-admin! (-> w tab-target) ONLINE_CMD_SET_MONEY (the float arg))
           )
          ((OW_TA_MYLV)
           (ow-admin! (the-as uint 0) ONLINE_CMD_SET_LEVEL (the float arg))
           )
          ((OW_TA_MYMONEY)
           (ow-admin! (the-as uint 0) ONLINE_CMD_SET_MONEY (the float arg))
           )
          ((OW_TA_CHEAT)
           (set! *ow-admin-cheats* (logxor *ow-admin-cheats* (ash 1 arg)))
           )
          ((OW_TA_VERSION)
           (ow-admin! (the-as uint 0) ONLINE_CMD_PUBLISH_VERSION 0.0)
           )
          ((OW_TA_BUY)
           (ow-buy! arg)
           )
          ((OW_TA_PVP)
           (cond
             ((-> w active)
              (ow-admin! (the-as uint 0) ONLINE_CMD_PVP (if (online-pvp-allowed?) 0.0 1.0))
              )
             (else
               (online-send-settings! (not (online-pvp-allowed?)) (nonzero? (-> *online-shm* session-public)))
               )
             )
           )
          ((OW_TA_ANNOUNCE)
           (ow-tab-close!)
           (ow-chat-open! 3)
           )
          ((OW_TA_GOTO)
           (let ((idx (ow-player-index (-> w tab-target)))
                 (pos (ow-puppet-pos (-> w tab-target)))
                 (xp (online-ext-player-by-id (-> w tab-target)))
                 )
             (cond
               ((< idx 0)
                )
               ((or pos (and xp (nonzero? (-> xp has-pos))))
                (let ((dst (new 'stack-no-clear 'vector)))
                  (if pos
                      (vector-copy! dst pos)
                      (set-vector! dst (-> xp x) (-> xp y) (-> xp z) 1.0)
                      )
                  (ow-tab-close!)
                  (ow-teleport-to! dst (online-chars->string (-> w str3) (-> *online-shm* players idx level) 16))
                  )
                )
               (else
                 (ow-hint! (online-fr "Position inconnue pour l'instant" "Position unknown for now"))
                 )
               )
             )
           )
          ((OW_TA_RACE)
           (let ((cp (get-continue-by-name *game-info* (-> *ow-race-cps* arg))))
             (when cp
               (online-push-out-event! ONLINE_EVENT_RACE (the-as uint 0) 0.0 arg (-> cp trans))
               (ow-tab-close!)
               )
             )
           )
          ((OW_TA_TOGGLE)
           (case arg
             ((1) (set! (-> w show-list) (not (-> w show-list))))
             ((2) (set! (-> w show-names) (not (-> w show-names))))
             ((3) (set! (-> w show-chat) (not (-> w show-chat))))
             )
           )
          ((OW_TA_VEHICLE)
           (ow-tab-close!)
           (ow-spawn-vehicle! arg)
           )
          )
        )
      )
    )
  (none)
  )

(defun ow-tab-input! ()
  (let ((w *online-world*)
        (pages (ow-page-count))
        )
    (ow-tab-build!)
    (cond
      ((or (ow-key? ONLINE_KEY_TAB) (ow-key? ONLINE_KEY_ESC) (cpad-pressed? 0 select)
           (and (not (-> w tab-sub)) (or (cpad-pressed? 0 circle) (cpad-pressed? 0 triangle)))
           )
       (ow-tab-close!)
       )
      ((and (-> w tab-sub) (or (cpad-pressed? 0 circle) (cpad-pressed? 0 triangle) (ow-key? ONLINE_KEY_LEFT)))
       (set! (-> w tab-sub) #f)
       (set! (-> w tab-row) 0)
       (sound-play "roll-over")
       )
      ((and (not (-> w tab-sub)) (or (ow-key? ONLINE_KEY_LEFT) (cpad-pressed? 0 left) (cpad-pressed? 0 l1)))
       (set! (-> w tab-page) (if (> (-> w tab-page) 0) (+ (-> w tab-page) -1) (+ pages -1)))
       (set! (-> w tab-row) 0)
       (set! (-> w tab-scroll) 0)
       (set! (-> w tab-fix-row) #t)
       (sound-play "roll-over")
       )
      ((and (not (-> w tab-sub)) (or (ow-key? ONLINE_KEY_RIGHT) (cpad-pressed? 0 right) (cpad-pressed? 0 r1)))
       (set! (-> w tab-page) (if (< (-> w tab-page) (+ pages -1)) (+ (-> w tab-page) 1) 0))
       (set! (-> w tab-row) 0)
       (set! (-> w tab-scroll) 0)
       (set! (-> w tab-fix-row) #t)
       (sound-play "roll-over")
       )
      ((or (ow-key? ONLINE_KEY_UP) (cpad-pressed? 0 up))
       (set! (-> w tab-row) (if (> (-> w tab-row) 0) (+ (-> w tab-row) -1) (max 0 (+ (-> w row-count) -1))))
       (sound-play "roll-over")
       )
      ((or (ow-key? ONLINE_KEY_DOWN) (cpad-pressed? 0 down))
       (set! (-> w tab-row) (if (< (-> w tab-row) (+ (-> w row-count) -1)) (+ (-> w tab-row) 1) 0))
       (sound-play "roll-over")
       )
      ((ow-key? ONLINE_KEY_PGDN)
       (set! (-> w tab-row) (min (max 0 (+ (-> w row-count) -1)) (+ (-> w tab-row) OW_VISIBLE_ROWS)))
       )
      ((ow-key? ONLINE_KEY_PGUP)
       (set! (-> w tab-row) (max 0 (- (-> w tab-row) OW_VISIBLE_ROWS)))
       )
      ((or (ow-key? ONLINE_KEY_ENTER) (cpad-pressed? 0 x))
       (ow-tab-activate!)
       )
      )
    ;; defilement
    (if (< (-> w tab-row) (-> w tab-scroll))
        (set! (-> w tab-scroll) (-> w tab-row))
        )
    (if (>= (-> w tab-row) (+ (-> w tab-scroll) OW_VISIBLE_ROWS))
        (set! (-> w tab-scroll) (+ (- (-> w tab-row) OW_VISIBLE_ROWS) 1))
        )
    )
  (none)
  )

(defun ow-text-chars ((s string))
  "nombre de lettres (UTF-8 : les octets de suite ne comptent pas)"
  (let ((n 0))
    (dotimes (i (length s))
      (if (!= (logand (-> s data i) #xc0) #x80)
          (+! n 1)
          )
      )
    n
    )
  )

(defun ow-fit-scale ((s string) (most int) (scale float))
  "taille du texte reduite si le mot est plus long que most lettres (onglets traduits)"
  (let ((n (ow-text-chars s)))
    (if (< most n)
        (fmax 0.22 (* scale (/ (the float most) (the float n))))
        scale
        )
    )
  )

(defun ow-tab-page-name ((p int))
  (case p
    ((OW_PAGE_PLAYERS) (online-fr "JOUEURS" "PLAYERS"))
    ((OW_PAGE_SHOP) (online-fr "BOUTIQUE" "SHOP"))
    ((OW_PAGE_EVENTS) (online-fr "EVENEMENTS" "EVENTS"))
    ((OW_PAGE_ME) (online-fr "MOI" "ME"))
    (else "ADMIN")
    )
  )

(defun ow-tab-draw! ()
  (let* ((w *online-world*)
         (shm *online-shm*)
         (ext *online-ext*)
         (s (-> w str))
         (x 56.0)
         (y 26.0)
         (width 400.0)
         (pages (ow-page-count))
         (tabw (/ (+ width -16.0) (the float pages)))
         )
    (ow-tab-build!)
    (ow-box x y width 334.0 0 0 0 128)
    (ow-box x y width 2.0 0 170 255 128)
    ;; onglets
    (dotimes (p pages)
      (let ((px (+ x 8.0 (* tabw (the float p)))))
        (if (and (= p (-> w tab-page)) (not (-> w tab-sub)))
            (ow-box px (+ y 6.0) (+ tabw -4.0) 16.0 0 170 255 60)
            )
        (online-print (ow-tab-page-name p) px (+ y 8.0) (+ tabw -4.0) (ow-fit-scale (ow-tab-page-name p) 8 0.33)
                      (cond
                        ((= p OW_PAGE_ADMIN) (font-color red))
                        ((= p (-> w tab-page)) (font-color font-color-33))
                        (else (font-color font-color-32))
                        )
                      (font-flags shadow kerning middle large)
                      )
        )
      )
    ;; titre
    (cond
      ((-> w tab-sub)
       (let* ((idx (ow-player-index (-> w tab-target)))
              (xp (online-ext-player-by-id (-> w tab-target)))
              )
         (when (>= idx 0)
           (ow-zone-name (-> w str2) (-> shm players idx level))
           (format (clear s) (online-fr "~S  -  Nv~D  -  ~S  -  ~D PV" "~S  -  Lv~D  -  ~S  -  ~D HP")
                   (online-chars->string (-> w str3) (-> shm players idx name) 16)
                   (if xp (-> xp level) 1)
                   (-> w str2)
                   (the int (-> shm players idx health))
                   )
           (ow-text-mid s (+ y 30.0) 0.42 (font-color white))
           )
         )
       )
      (else
        (if (-> w active)
            (format (clear s) (online-fr "MONDE EN LIGNE  -  ~D JOUEURS  -  ~D ORBES" "ONLINE WORLD  -  ~D PLAYERS  -  ~D ORBS")
                    (-> shm session-players) (-> ext money))
            (format (clear s) (online-fr "SESSION ~S  -  ~D JOUEURS" "SESSION ~S  -  ~D PLAYERS")
                    (online-chars->string (-> w str3) (-> shm session-code) 8) (-> shm session-players))
            )
        (ow-text-mid s (+ y 30.0) 0.42 (font-color white))
        )
      )
    ;; lignes
    (let ((yy (+ y 50.0)))
      (dotimes (k OW_VISIBLE_ROWS)
        (let ((r (+ (-> w tab-scroll) k)))
          (when (< r (-> w row-count))
            (let ((sel (= r (-> w tab-row))))
              (if sel
                  (ow-box (+ x 4.0) (+ yy -2.0) (+ width -8.0) 17.0 0 170 255 56)
                  )
              (online-print (-> w row-text r)
                            (+ x 12.0)
                            yy
                            (if (nonzero? (length (-> w row-right r))) 250.0 (+ width -20.0))
                            0.36
                            (cond
                              ((not (-> w row-on r)) (font-color font-color-44))
                              (sel (font-color font-color-33))
                              (else (font-color white))
                              )
                            (font-flags shadow kerning large)
                            )
              (when (nonzero? (length (-> w row-right r)))
                (online-print (-> w row-right r) (+ x 262.0) (+ yy 1.0) 130.0 0.3
                              (if (>= (-> w row-color r) 0) (the-as font-color (-> w row-color r)) (font-color white))
                              (font-flags shadow kerning large)
                              )
                )
              )
            )
          )
        (set! yy (+ yy 19.0))
        )
      )
    (if (< (+ (-> w tab-scroll) OW_VISIBLE_ROWS) (-> w row-count))
        (ow-text-mid "..." (+ y 298.0) 0.4 (font-color font-color-32))
        )
    (ow-text-mid (online-fr "ENTREE / X : valider    GAUCHE / DROITE : onglets    SELECT / TAB : fermer"
                            "ENTER / X: select    LEFT / RIGHT: tabs    SELECT / TAB: close"
                            )
                 (+ y 316.0)
                 0.27
                 (font-color font-color-32)
                 )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; HUD : orbes + niveau, liste des joueurs, annonces, recompenses, course
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun ow-money-icon-update! ((show symbol))
  "orbe precurseur en 3D qui tourne : le logo de l'argent du monde en ligne"
  (let* ((w *online-world*)
         (p (the-as process-drawable (handle->process (-> w money-icon))))
         )
    (when (and show (not p))
      (let ((sg (art-group-get-by-name *level* "skel-skill" (the-as (pointer level) #f))))
        (when (and sg (nonzero? sg))
          (let ((pp (process-spawn
                      manipy
                      :init manipy-init
                      (new 'static 'vector :w 1.0)
                      (the-as entity-actor #f)
                      (the-as skeleton-group sg)
                      (the-as vector #f)
                      (the-as manipy-options 0)
                      :name "online-orbe"
                      :to *default-pool*
                      :stack-size #x20000
                      )
                    )
                )
            (when (and pp (nonzero? (-> (the-as process-drawable (ppointer->process pp)) draw)))
              (set! p (the-as process-drawable (ppointer->process pp)))
              (set! (-> p draw dma-add-func)
                    (the-as (function process-drawable draw-control symbol object none) dma-add-process-drawable-hud)
                    )
              (logior! (-> p mask) (process-mask freeze pause))
              (logclear! (-> p mask) (process-mask menu progress))
              (set! (-> w money-icon) (ppointer->handle pp))
              )
            )
          )
        )
      )
    (when p
      (cond
        (show
          (logclear! (-> p draw status) (draw-control-status no-draw))
          (send-event p 'draw #t)
          ;; position a l'ecran (coordonnees du HUD : 512 x 416)
          (set-vector! (-> p root scale) (* 0.0055 (-> *video-params* relative-x-scale)) -0.011 (* 0.0055 (-> *video-params* relative-x-scale)) 1.0)
          (set! (-> p root trans x) (the float (+ (the int (* 30.0 (-> *video-params* relative-x-scale))) -256)))
          (set! (-> p root trans y) (* 2.0 (+ 29.0 -208.0)))
          (set! (-> p root trans z) 1024.0)
          (+! (-> w money-spin) (* 182.04445 (* 60.0 (-> *display* real-clock seconds-per-frame))))
          (quaternion-axis-angle! (-> p root quat) 0.0 1.0 0.0 (-> w money-spin))
          )
        (else
          (send-event p 'draw #f)
          (logior! (-> p draw status) (draw-control-status no-draw))
          )
        )
      )
    )
  (none)
  )

(defun ow-hud-money! ()
  "orbes + niveau + barre d'experience (monde en ligne)"
  (let* ((w *online-world*)
         (ext *online-ext*)
         (s (-> w str))
         (x0 (+ 12.0 (* 34.0 (-> *video-params* relative-x-scale))))
         )
    (format (clear s) "~D" (-> ext money))
    (ow-text s x0 22.0 0.5 (font-color flat-yellow))
    (format (clear s) (online-fr "NIVEAU ~D  ~S" "LEVEL ~D  ~S") (-> ext level) (ow-rank-name (the-as int (-> ext level))))
    (ow-text s (+ x0 70.0) 24.0 0.34 (ow-rank-color (the-as int (-> ext level))))
    ;; barre d'experience
    (let* ((base (-> ext xp-base))
           (next (-> ext xp-next))
           (frac (if (< base next)
                     (fmax 0.0 (fmin 1.0 (/ (the float (- (-> ext xp) base)) (the float (- next base)))))
                     0.0
                     )
                 )
           )
      (ow-box (+ x0 70.0) 37.0 80.0 3.0 40 40 40 110)
      (ow-box (+ x0 70.0) 37.0 (* 80.0 frac) 3.0 255 200 0 128)
      )
    )
  (none)
  )

(defun ow-hud-list! ((y0 float))
  "liste des joueurs en haut a gauche : niveau, pseudo, zone (les autres : TAB)"
  (let* ((w *online-world*)
         (shm *online-shm*)
         (s (-> w str))
         (n (min 100 (the-as int (-> shm player-count))))
         (y y0)
         (shown 0)
         (room (max 2 (+ -1 (the int (/ (- 118.0 y0) 11.0)))))
         (most (if (< room n) room n))
         )
    (dotimes (i n)
      (when (< shown most)
        (let* ((pe (-> shm players i))
               (xp (online-ext-player-by-id (-> pe player-id)))
               (me? (logtest? (-> pe flags) ONLINE_PFLAG_ME))
               )
          (ow-zone-name (-> w str2) (-> pe level))
          (format (clear s) (online-fr "Nv~D ~S  ~S" "Lv~D ~S  ~S")
                  (if xp (-> xp level) 1)
                  (online-chars->string (-> w str3) (-> pe name) 16)
                  (-> w str2)
                  )
          (ow-text s 14.0 y 0.28
                   (cond
                     (me? (font-color green))
                     ((and xp (logtest? (-> xp flags) ONLINE_PX_BOUNTY)) (font-color orange))
                     ((and xp (logtest? (-> xp flags) ONLINE_PX_CREATEUR)) (font-color flat-yellow))
                     ((logtest? (-> pe flags) ONLINE_PFLAG_DEAD) (font-color red))
                     (else (ow-rank-color (if xp (the-as int (-> xp level)) 1)))
                     )
                   )
          (set! y (+ y 11.0))
          (+! shown 1)
          )
        )
      )
    (when (< shown n)
      (format (clear s) (online-fr "+ ~D autres (TAB)" "+ ~D more (TAB)") (- n shown))
      (ow-text s 14.0 y 0.28 (font-color font-color-32))
      )
    )
  (none)
  )

(defun ow-hud-events! ()
  "annonces, recompenses, messages, course"
  (let* ((w *online-world*)
         (ext *online-ext*)
         (s (-> w str))
         (now (online-now))
         )
    ;; annonce (createur, niveau gagne, prime)
    (when (!= (-> ext ann-seq) (-> w ann-seq))
      (set! (-> w ann-seq) (-> ext ann-seq))
      (set! (-> w ann-time) now)
      (if (= (-> ext ann-kind) 1)
          (sound-play "skill-pickup")
          (sound-play "menu-pick")
          )
      )
    (when (and (< (- now (-> w ann-time)) (seconds 6)) (nonzero? (-> ext ann-text 0)))
      (case (-> ext ann-kind)
        ((0)
         (ow-center-line (online-fr "ANNONCE" "ANNOUNCEMENT") 0.36 (font-color orange))
         (ow-center-line (online-chars->string s (-> ext ann-text) 88) 0.5 (font-color white))
         )
        ((1)
         (ow-center-line (online-chars->string s (-> ext ann-text) 88) 0.7 (font-color flat-yellow))
         )
        (else
          (ow-center-line (online-chars->string s (-> ext ann-text) 88) 0.5 (font-color red))
          )
        )
      )
    ;; recompense (+orbes, +XP)
    (when (!= (-> ext reward-seq) (-> w reward-seq))
      (set! (-> w reward-seq) (-> ext reward-seq))
      (set! (-> w reward-time) now)
      )
    (when (and (< (- now (-> w reward-time)) (seconds 3)) (nonzero? (-> w reward-seq)))
      (let ((m (-> ext reward-money))
            (xp (-> ext reward-xp))
            )
        (when (or (!= m 0) (> xp 0))
          (cond
            ((and (!= m 0) (> xp 0))
             (format (clear s) (online-fr "~S~D orbes    +~D XP" "~S~D orbs    +~D XP") (if (> m 0) "+" "") m xp)
             )
            ((!= m 0)
             (format (clear s) (online-fr "~S~D orbes" "~S~D orbs") (if (> m 0) "+" "") m)
             )
            (else
              (format (clear s) "+~D XP" xp)
              )
            )
          (ow-center-line s 0.45 (if (< m 0) (font-color red) (font-color flat-yellow)))
          )
        (when (nonzero? (-> ext reward-text 0))
          (ow-center-line (online-chars->string s (-> ext reward-text) 48) 0.34 (font-color white))
          )
        )
      )
    ;; course
    (case (-> ext race-state)
      ((1)
       (format (clear s) (online-fr "COURSE vers ~S" "RACE to ~S") (online-chars->string (-> w str2) (-> ext race-name) 24))
       (ow-center-line s 0.5 (font-color cyan))
       (format (clear s) "~D" (+ 1 (the int (fmax 0.0 (-> ext race-timer)))))
       (ow-center-line s 1.2 (font-color flat-yellow))
       )
      ((2)
       (let ((dist (if *target* (vector-vector-distance (-> *target* control trans) (-> ext race-dest)) 0.0)))
         (format (clear s) (online-fr "COURSE : ~,,1f s   -   arrivee a ~D m" "RACE: ~,,1f s   -   finish in ~D m")
                 (-> ext race-timer)
                 (the int (/ dist 4096.0))
                 )
         (ow-center-line s 0.45 (font-color cyan))
         (if (< (-> ext race-timer) 1.5)
             (ow-center-line (online-fr "PARTEZ !" "GO!") 1.2 (font-color green))
             )
         )
       )
      ((3)
       (when (< 0 (the-as int (-> ext race-rank)))
         (format (clear s) (online-fr "ARRIVEE : ~D / ~D" "FINISH: ~D / ~D") (-> ext race-rank) (-> ext race-count))
         (ow-center-line s 0.6 (font-color flat-yellow))
         )
       )
      )
    ;; petit message
    (when (< (- now (-> w hint-time)) (seconds 3.5))
      (ow-center-line (-> w hint) 0.4 (font-color yellow))
      )
    ;; gele
    (if (-> w frozen)
        (ow-center-line (online-fr "GELE PAR LA MODERATION" "FROZEN BY A MODERATOR") 0.6 (font-color cyan))
        )
    ;; boutique
    (if (and (-> w in-shop-zone) (not (-> w shop-open)) (not (-> w tab-open)))
        (ow-text-mid (online-fr "TRIANGLE : BOUTIQUE DU NAUGHTY OTTSEL" "TRIANGLE: NAUGHTY OTTSEL SHOP") 318.0 0.45 (font-color flat-yellow))
        )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; boucle (appelee chaque image par online-update)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun online-world-blocks-input? ()
  (let ((w *online-world*))
    (the-as symbol (or (-> w tab-open) (-> w shop-open) (-> w chat-open) (-> w frozen)))
    )
  )

;; MONDE EN LIGNE SANS BROUILLARD : pas de brume meteo (le ciel garde ses nuages) et le
;; brouillard de distance commence 4 fois plus loin (voir engine/draw/drawable.gc)
(define *ow-fog-override* #f)

(defun ow-fog-tick! ()
  (let ((on (and (-> *online-world* active) (online-in-session?))))
    (set! *online-fog-far* on)
    (cond
      (on
        (set! (-> *mood-control* overide-weather-flag) #t)
        (set! (-> *mood-control* overide cloud) (-> *mood-control* current-interp cloud))
        (set! (-> *mood-control* overide fog) 0.0)
        (set! *ow-fog-override* #t)
        )
      (*ow-fog-override*
        (set! (-> *mood-control* overide-weather-flag) #f)
        (set! *ow-fog-override* #f)
        )
      )
    )
  (none)
  )

(defun online-world-update ((in-session symbol))
  (let* ((w *online-world*)
         (shm *online-shm*)
         (ext *online-ext*)
         (alive (online-companion-alive?))
         )
    (ow-cheats-detect!)
    (ow-read-keys!)
    (ow-kb-tick!)
    (ow-chat-update!)
    ;; lancement : vitrine dans Haven avec le menu du titre
    (ow-hub-tick!)
    ;; monde en ligne
    (ow-world-tick!)
    (ow-fog-tick!)
    (ow-cheats-tick!)
    (ow-perso-tick!)
    ;; cartes du mod (parcours)
    (ow-maps-tick!)
    (ow-teleport-tick!)
    ;; gel (commande de moderation) : sans session, plus de gel
    (if (not in-session)
        (set! (-> w frozen) #f)
        )
    (let ((can (and in-session alive *target* (not *progress-process*) (not (movie?)))))
      ;; chat : T
      (when (and in-session alive (not *progress-process*) (not (-> w chat-open)) (not (-> w tab-open)) (not (-> w shop-open)) (ow-key? ONLINE_KEY_T))
        (ow-chat-open! 2)
        )
      ;; menu TAB (ou SELECT a la manette)
      (cond
        ((-> w tab-open)
         (if (or (not can) (-> w chat-open))
             (ow-tab-close!)
             (ow-tab-input!)
             )
         )
        ((and can (not (-> w chat-open)) (not (-> w shop-open)) (or (ow-key? ONLINE_KEY_TAB) (cpad-pressed? 0 select)))
         (ow-tab-open!)
         )
        )
      ;; boutique du Naughty Ottsel
      (set! (-> w in-shop-zone) (the-as symbol (and can (ow-shop-zone?))))
      (cond
        ((-> w shop-open)
         (if (not (-> w in-shop-zone))
             (begin
               (set! (-> w shop-open) #f)
               (ow-kb-on-later!)
               )
             (ow-shop-input!)
             )
         )
        ((and (-> w in-shop-zone) (not (-> w tab-open)) (not (-> w chat-open)) (cpad-pressed? 0 triangle))
         (set! (-> w shop-open) #t)
         (set! (-> w shop-row) 0)
         (ow-kb-off!)
         (sound-play "window-expand")
         )
        )
      )
    ;; heure du monde choisie par le createur / l'hote
    (when (and in-session (!= (-> ext time-seq) (-> w time-seq)))
      (set! (-> w time-seq) (-> ext time-seq))
      (if (and (<= 0.0 (-> ext time-hour)) *time-of-day*)
          (send-event (ppointer->process *time-of-day*) 'change 'hour (the int (-> ext time-hour)))
          )
      )
    ;; vehicules : maillages a charger, collisions et ecrasement
    (ow-fr3-update!)
    (ow-vehicle-tick!)
    (when in-session
      (ow-collisions!)
      (ow-ride-update!)
      )
    ;; la mini-carte s'efface pendant les menus (sinon elle mange le coin du cadre)
    (if (or (-> w tab-open) (-> w shop-open))
        (logclear! (-> *setting-control* user-default minimap) 128)
        (logior! (-> *setting-control* user-default minimap) 128)
        )
    ;; carte
    (ow-icons-update!)
    ;; evenements du monde, super-pouvoirs, anti-triche
    (online-events-update)
    ;; etat pour Jak3Online.exe
    (set! (-> shm ui-mode) (the-as uint (cond
                                          ((-> w tab-open) 1)
                                          ((-> w shop-open) 2)
                                          (else 0)
                                          )
                                    )
          )
    (set! (-> shm ui-flags) (the-as uint (logior (if (and *target* (not *progress-process*)) 1 0)
                                                 (if (-> w active) 2 0)
                                                 (if *cheat-mode* 4 0)
                                                 )
                                     )
          )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; banc de test : quelles lettres la police du jeu sait dessiner (commande 78)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define *ow-font-test* #f)

(define *ow-font-test-lines*
  (new 'static 'boxed-array :type string
    "1 ÇÑØÆÐÞÝŰ ÂÃÕÙ· ¡º° äöüß åæø éèêàç"
    "2 ĄĆĘŃŹŻ ČĎĚŇŘŠŤŮŽ ĐĖĮŪŲ Ő"
    "3 čďěňřšťůž đėįūų ąćęńźżł ő ű ðþý"
    "4 ЙЩЪЫЬЮЁ йщъыьюё АБВГДЕЖЗИКЛМНОПРСТУФХЦЧШЭЯ"
    "5 견결과관광괴깐꽁꽉끊끔냥넷녁님덤돈돼된됨뜻렸령"
    "6 롭릴말멀못밖받밤밴벤봐빨송숨엄와완왼월의잘잦존"
    "7 좌참채챔천철청쳤최춤켬킬탭텨팅화확환황회획 한국어"
    "8 上下中乗了交人以位低作使倒像先入内切利制前力動勝北友台右合向告器地場壊外天字完容"
    "9 対射左幕式弾後必応性感成戻所押換撃攻敗数敵方映時書替機水泳源無物用画発矢砲破示秒"
    "A 種空突箱終続者能自薬行表要見解言記試話語警走跡転輸送逆連進遊選量録開間限電面頭高"
    "B ねばケザネホワ ぁぃぅぇぉゃゅょっ ァィゥェォャュョッヴー"
    )
  )

(defun ow-font-test-draw ()
  (when *ow-font-test*
    (ow-box 8.0 40.0 496.0 330.0 0 0 0 200)
    (dotimes (i (-> *ow-font-test-lines* length))
      (online-print (-> *ow-font-test-lines* i) 16.0 (+ 48.0 (* 29.0 (the float i))) 480.0 0.5 (font-color white) (font-flags shadow kerning large))
      )
    )
  (none)
  )

(defun online-world-draw ((in-session symbol))
  (let* ((w *online-world*)
         (hud? (and in-session (not *progress-process*) (not (movie?))))
         )
    ;; lancement : le monde en ligne va demarrer (ecran titre) -> compte a rebours et choix
    (when (and (= (-> w starting) 1) (not (-> w active)) (ow-at-title?) (not *online-world-go*))
      (let ((left (- 5 (the int (/ (the float (- (online-now) (-> w want-time))) 300.0)))))
        (when (< 0 left)
          (ow-box 56.0 84.0 400.0 50.0 0 0 0 170)
          (format (clear (-> w str)) (online-fr "MONDE EN LIGNE DANS ~D s" "ONLINE WORLD IN ~D s") left)
          (ow-text-mid (-> w str) 90.0 0.55 (font-color flat-yellow))
          (ow-text-mid (online-fr "ROND : RESTER HORS LIGNE (SOLO)" "CIRCLE: STAY OFFLINE (SOLO)") 114.0 0.38 (font-color white))
          )
        )
      )
    ;; passager : invite
    (when (and hud? (-> w active) (not (-> w tab-open)) (not (-> w shop-open)))
      (cond
        ((nonzero? (-> w ride-with))
         (format (clear (-> w str)) (online-fr "PASSAGER DE ~S  -  TRIANGLE : DESCENDRE" "RIDING WITH ~S  -  TRIANGLE: GET OFF")
                 (ow-player-name (-> w ride-with)))
         (ow-text-mid (-> w str) 196.0 0.4 (font-color cyan))
         )
        ((nonzero? (-> w ride-near))
         (format (clear (-> w str)) (online-fr "TRIANGLE : MONTER AVEC ~S" "TRIANGLE: RIDE WITH ~S")
                 (ow-player-name (-> w ride-near)))
         (ow-text-mid (-> w str) 196.0 0.4 (font-color flat-yellow))
         )
        )
      )
    ;; menu ouvert : son en-tete affiche deja les orbes (sinon le compteur touche le cadre)
    (ow-money-icon-update! (the-as symbol (and hud? (-> w active) (not (-> w tab-open)) (not (-> w shop-open)))))
    (set! *ow-center-y* 124.0)
    (when hud?
      (let ((y 22.0))
        (when (and (-> w active) (not (-> w tab-open)) (not (-> w shop-open)))
          (ow-hud-money!)
          (set! y 46.0)
          (+! y (online-powers-draw y))
          )
        (if (and (-> w show-list) (not (-> w tab-open)) (not (-> w shop-open)))
            (ow-hud-list! y)
            )
        )
      (when (not (or (-> w tab-open) (-> w shop-open)))
        (online-events-draw)
        (ow-hud-events!)
        )
      (ow-font-test-draw)
      ;; menus : dessines apres la mini-carte (sinon elle mange le coin du cadre)
      (set! *online-draw-bucket* (bucket-id hud-draw-pris2))
      (cond
        ((-> w tab-open) (ow-tab-draw!))
        ((-> w shop-open) (ow-shop-draw!))
        )
      (set! *online-draw-bucket* (bucket-id hud-draw-hud-alpha))
      )
    (if in-session
        (ow-chat-draw!)
        )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; banc de test (Jak3Online.exe --duo2) : menus et actions sans clavier
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun online-world-test! ((arg int))
  (let ((w *online-world*))
    (cond
      ((= arg 60) (if (not (-> w tab-open)) (ow-tab-open!)))
      ((= arg 61) (if (-> w tab-open) (ow-tab-close!)))
      ((= arg 62)
       (set! (-> w tab-page) (if (< (-> w tab-page) (+ (ow-page-count) -1)) (+ (-> w tab-page) 1) 0))
       (set! (-> w tab-row) 0)
       (set! (-> w tab-fix-row) #t)
       )
      ((= arg 63)
       (when (ow-shop-zone?)
         (set! (-> w shop-open) #t)
         (set! (-> w shop-row) 0)
         (ow-kb-off!)
         )
       )
      ((= arg 64)
       (when (-> w shop-open)
         (set! (-> w shop-open) #f)
         (ow-kb-on-later!)
         )
       )
      ((= arg 65) (set! (-> w shop-cat) (if (< (-> w shop-cat) (+ OW_SHOP_CATS -1)) (+ (-> w shop-cat) 1) 0)))
      ((= arg 66) (ow-chat-open! 2))
      ((= arg 67) (if (-> w chat-open) (ow-chat-close!)))
      ((= arg 68)
       ;; dans le Naughty Ottsel
       (let ((cp (get-continue-by-name *game-info* "hiphog-start")))
         (if (and *target* cp)
             (start 'play cp)
             )
         )
       )
      ((= arg 70)
       (if *target*
           (send-event *target* 'end-mode 'pilot)
           )
       )
      ((or (= arg 72) (= arg 93))
       ;; banc de test : frappe le boss (10 degats) / boss devant Jak
       (online-events-test! arg)
       )
      ((= arg 73)
       ;; banc de test : menu SELECT sur l'onglet donne par la commande suivante
       (set! (-> w tab-page) OW_PAGE_SHOP)
       (if (not (-> w tab-open)) (ow-tab-open!))
       (set! (-> w tab-page) OW_PAGE_SHOP)
       )
      ((= arg 74)
       (set! (-> w tab-page) OW_PAGE_ADMIN)
       (if (not (-> w tab-open)) (ow-tab-open!))
       (set! (-> w tab-page) OW_PAGE_ADMIN)
       )
      ((= arg 75)
       ;; monter sur un lezard (Spargus)
       (if *target*
           (send-event *target* 'change-mode 'flut #f)
           )
       )
      ((= arg 76)
       (if *target*
           (send-event *target* 'end-mode 'flut)
           )
       )
      ((= arg 79)
       ;; banc de test : ouvre le menu Start (comme la touche Start)
       (if (not *progress-process*)
           (activate-progress *dproc* 'main)
           )
       )
      ((= arg 81)
       ;; banc de test : menu Start directement sur la page OPTIONS (page classique)
       (if (not *progress-process*)
           (activate-progress *dproc* 'options)
           )
       )
      ((= arg 82)
       (if (not *progress-process*)
           (activate-progress *dproc* 'secret)
           )
       )
      ((= arg 80)
       (if *progress-process*
           (hide-progress-screen)
           )
       )
      ((= arg 84)
       ;; banc de test : se placer a 2,5 m du premier autre joueur (meme zone)
       (let ((done #f))
         (dotimes (i ONLINE_MAX_PUPPETS)
           (let ((rs (-> *online-shm* remote i)))
             (when (and (not done) (nonzero? (-> rs active)) *target*)
               (let ((pos (ow-puppet-pos (-> rs player-id))))
                 (when pos
                   (let ((dst (new 'stack-no-clear 'vector)))
                     (vector-copy! dst pos)
                     (+! (-> dst x) (meters 2.5))
                     (+! (-> dst y) (meters 1.0))
                     (move-to-point! (-> *target* control) dst)
                     (set! done #t)
                     )
                   )
                 )
               )
             )
           )
         )
       )
      ((= arg 83)
       ;; banc de test : TRIANGLE (monter / descendre du vehicule d'un autre joueur)
       (set! *ow-ride-press* #t)
       )
      ((= arg 85)
       ;; banc de test : menu Start directement sur la CARTE
       (if (not *progress-process*)
           (activate-progress *dproc* 'bigmap)
           )
       )
      ((= arg 86)
       ;; banc de test : eco bleu (comme l'achat de la boutique)
       (when *target*
         (send-event *target* 'get-pickup (pickup-type eco-blue) 100.0)
         (set! (-> *target* fact eco-timeout) (the-as seconds (seconds 180)))
         )
       )
      ((= arg 87)
       ;; banc de test : 5 vies au sol
       (ow-drop-pickups! (pickup-type health) 5 1.0)
       )
      ((= arg 89)
       ;; banc de test : monde remis a neuf
       (ow-reset-actors!)
       )
      ((or (= arg 90) (= arg 91) (= arg 92))
       ;; banc de test : se placer a 12 m (90), 30 m (91) ou 60 m (92) du boss, face a lui
       (let ((pos (oe-boss-pos (new 'stack-no-clear 'vector)))
             (bp (new 'stack-no-clear 'vector))
             (d (case arg ((91) (meters 30.0)) ((92) (meters 60.0)) (else (meters 12.0))))
             )
         (when (and *target* (!= (-> *online-ext* ev-kind) 0))
           (vector-copy! bp pos)
           (+! (-> pos x) d)
           (+! (-> pos y) (meters 2.0))
           (move-to-point! (-> *target* control) pos)
           (let ((dir (vector-! (new 'stack-no-clear 'vector) bp pos))
                 (tc (-> *target* control))
                 )
             (set! (-> dir y) 0.0)
             (vector-normalize! dir 1.0)
             (forward-up-nopitch->quaternion (-> tc dir-targ) dir *up-vector*)
             (quaternion-copy! (-> tc quat-for-control) (-> tc dir-targ))
             (quaternion-copy! (-> tc quat) (-> tc dir-targ))
             )
           (send-event *camera* 'teleport)
           )
         )
       )
      ((= arg 480)
       ;; banc de test : essayer de tricher (secret invincible + mode debug)
       (set! (-> *game-info* secrets) (the-as game-secrets (logior (the-as int (-> *game-info* secrets)) (ash 1 17))))
       (set! *cheat-mode* 'debug)
       )
      ((= arg 481)
       ;; banc de test : triche createur (invincible) depuis ADMIN
       (set! *ow-admin-cheats* (logxor *ow-admin-cheats* 1))
       )
      ((and (>= arg 460) (< arg 470))
       ;; banc de test : personnage
       (ow-perso-choose! (- arg 460))
       )
      ((and (>= arg 470) (< arg 474))
       ;; banc de test : se placer a 4 m du premier autre joueur, face a lui (470 devant, 471 cote, 472 derriere)
       (let ((done #f))
         (dotimes (i ONLINE_MAX_PUPPETS)
           (let ((p (online-puppet-proc i)))
             (when (and (not done) p *target* (-> p placed))
               (let ((pp (-> p root trans))
                     (pos (new 'stack-no-clear 'vector))
                     (fw (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> p root quat)))
                     (tc (-> *target* control))
                     )
                 (set! (-> fw y) 0.0)
                 (vector-normalize! fw 1.0)
                 (case arg
                   ((471) (set-vector! fw (-> fw z) 0.0 (- (-> fw x)) 0.0))
                   ((472) (vector-float*! fw fw -1.0))
                   )
                 (vector+float*! pos pp fw (meters 4.0))
                 (+! (-> pos y) (meters 0.5))
                 (move-to-point! tc pos)
                 (let ((dir (vector-! (new 'stack-no-clear 'vector) pp pos)))
                   (set! (-> dir y) 0.0)
                   (vector-normalize! dir 1.0)
                   (forward-up-nopitch->quaternion (-> tc dir-targ) dir *up-vector*)
                   (quaternion-copy! (-> tc quat-for-control) (-> tc dir-targ))
                   (quaternion-copy! (-> tc quat) (-> tc dir-targ))
                   )
                 (send-event *camera* 'teleport)
                 (set! done #t)
                 )
               )
             )
           )
         )
       )
      ((and (>= arg 400) (< arg 450))
       ;; banc de test : cartes du mod
       (online-maps-test! arg)
       )
      ((= arg 78)
       (set! *ow-font-test* (not *ow-font-test*))
       )
      ((and (>= arg 300) (< arg 325))
       ;; banc de test : langue du jeu
       (set! (-> *pc-settings* text-language) (the-as pc-language (- arg 300)))
       )
      ((and (>= arg 330) (< arg 355))
       ;; premier lancement : langue de Windows (textes et sous-titres), sauvee dans les reglages
       (set! (-> *pc-settings* text-language) (the-as pc-language (- arg 330)))
       (set! (-> *pc-settings* subtitle-language) (the-as pc-language (- arg 330)))
       (set! (-> *setting-control* user-default subtitle-language) (the-as language-enum (- arg 330)))
       (commit-to-file *pc-settings*)
       )
      ((= arg 77)
       ;; banc de test : fonce avec mon vehicule sur le vehicule d'un autre joueur
       (let ((veh (ow-my-vehicle))
             (t *target*)
             (best -1)
             (bd (meters 60.0))
             )
         (when (and veh t)
           (dotimes (i ONLINE_MAX_PUPPETS)
             (let ((rs (-> *online-shm* remote i)))
               (when (and (nonzero? (-> rs active)) (logtest? (-> rs flags) ONLINE_FLAG_VEHICLE))
                 (let ((d (vector-vector-xz-distance (-> t control trans) (-> rs pos))))
                   (when (< d bd)
                     (set! bd d)
                     (set! best i)
                     )
                   )
                 )
               )
             )
           (when (>= best 0)
             (let ((dv (vector-! (new 'stack-no-clear 'vector) (-> *online-shm* remote best pos) (-> t control trans))))
               (set! (-> dv y) 0.0)
               (vector-normalize! dv (meters 20.0))
               (set! (-> dv y) (meters 1.0))
               (ow-vehicle-kick! veh dv)
               )
             )
           )
         )
       )
      ((= arg 71)
       ;; en plein desert (loin du garage)
       (let ((cp (get-continue-by-name *game-info* "desert-bbush-desd")))
         (if (and *target* cp)
             (start 'play cp)
             )
         )
       )
      ((= arg 69)
       ;; course vers les portes de Spargus
       (let ((cp (get-continue-by-name *game-info* (-> *ow-race-cps* 6))))
         (if cp
             (online-push-out-event! ONLINE_EVENT_RACE (the-as uint 0) 0.0 6 (-> cp trans))
             )
         )
       )
      ((and (>= arg 100) (< arg 196))
       ;; achat de l'objet (arg - 100) par le chemin normal (verifie par Jak3Online.exe)
       (online-push-out-event! ONLINE_EVENT_BUY (the-as uint 0) 0.0 (+ arg -100) (the-as vector #f))
       )
      ((and (>= arg 200) (< arg 296))
       ;; appeler le vehicule (objet arg - 200)
       (ow-spawn-vehicle! (+ arg -200))
       )
      )
    )
  (none)
  )
