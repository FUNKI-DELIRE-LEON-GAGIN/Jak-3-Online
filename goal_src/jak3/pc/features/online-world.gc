    "5 vies au sol" "Caisse de munitions au sol" "ECO BLEU (3 min)"
    "Keira" "" "" "" "" "" "" "" "" "" "" "" "" "" "" "" "" "" "" "" ""
    )
  )

(define *ow-shop-names-en*
  (new 'static 'boxed-array :type string
    "Blaster" "Scatter Gun" "Vulcan Fury" "Peacemaker" "Beam Reflexor" "Wave Concussor" "Arc Wielder" "Mass Inverter"
    "Gyro Burster" "Plasmite RPG" "Needle Lazer" "Super Nova"
    "Yellow ammo +" "Yellow ammo ++" "Red ammo +" "Red ammo ++" "Blue ammo +" "Blue ammo ++"
    "Dark ammo +" "Dark ammo ++"
    "Yellow gun damage" "Red gun damage" "Blue gun damage" "Dark gun damage"
    "JetBoard" "JetBoard: launch" "JetBoard: trail" "JetBoard: zap"
    "Dark Jak" "Dark Jak: smack" "Dark Jak: bomb" "Dark Jak: blast" "Dark Jak: tracking" "Dark Jak: invincible"
    "Light Jak" "Light Jak: regen" "Light Jak: flight" "Light Jak: freeze" "Light Jak: shield"
    "Armor 1" "Armor 2" "Armor 3" "Armor 4"
    "Tough Puppy" "Dune Hopper" "Sand Shark" "Gila Stomper" "Slam Dozer" "Heat Seeker" "Dust Demon" "Desert Screamer"
    "Haven bike" "Haven car" "Racing zoomer"
    "" "" "" "" "" ""
    "Full ammo" "Full heal" "Dark + light eco" "Repair my vehicle"
    "Turbo (60 s)" "Super jump (60 s)" "Steel skin (60 s)" "Ghost (2 min)" "Radar (3 min)" "Double XP (10 min)"
    "Orb magnet (10 min)" "Regeneration (60 s)"
    "5 lives on the ground" "Ammo crate on the ground" "BLUE ECO (3 min)"
    "Keira" "" "" "" "" "" "" "" "" "" "" "" "" "" "" "" "" "" "" "" ""
    )
  )

;; 1 game-feature, 2 game-secrets, 3 game-vehicles, 4 objets a nous, 5 consommable, 6 super-pouvoir
