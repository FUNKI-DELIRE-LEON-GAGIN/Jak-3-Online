;; destinations des courses (points de passage du jeu) : Haven 0-5, desert 6-11
(define *ow-race-cps*
  (new 'static 'boxed-array :type string
    "ctyport-hiphog" "ctyport-start" "ctysluma-start" "ctyslumc-freehq-exit" "ctygenb-start" "ctyinda-start"
    "wasdoors-desert" "desert-lizard-corral" "desert-nest-exit" "desert-bbush-desa" "desert-bbush-desd" "desert-bbush-desg"
    )
  )

