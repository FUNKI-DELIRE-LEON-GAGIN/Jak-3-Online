;;-*-Lisp-*-
(in-package goal)

;; name: online-world.gc
;; dgos: GAME
;;
;; JAK 3 EN LIGNE - le MONDE EN LIGNE et l'interface en jeu
;;
;; - en haut a gauche : orbes (argent), niveau, experience et la liste des joueurs
;;   (niveau, pseudo, zone ou ils se trouvent) - masquable dans le menu TAB
;; - T : chat          TAB (ou SELECT a la manette) : menu des joueurs / moderation
;; - les autres joueurs sur la mini-carte et sur la carte du menu
;; - session publique = MONDE EN LIGNE : le jeu est termine a 100 % (monde entier ouvert,
;;   missions secondaires jouables) mais on commence SANS RIEN. On gagne des orbes
;;   (missions secondaires, orbes du monde, eliminations, primes, courses...) et on achete
;;   armes, pouvoirs et vehicules a la boutique du Naughty Ottsel (port de Haven).
;; - vehicules : chacun appelle ses vehicules (desert / Spargus et Haven City),
;;   collisions entre joueurs, on peut ecraser un autre joueur, tir de gravite sur les vehicules.
;;
;; Tout ce qui compte (argent, achats, moderation) est verifie par Jak3Online.exe.

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; etat
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defconstant OW_MAX_ROWS 160)
(defconstant OW_VISIBLE_ROWS 13)
(defconstant OW_MAX_ICONS 24)

(deftype online-world-state (basic)
  ((active         symbol)
   (starting       int32)          ;; 0 rien, 1 menu a fermer, 2 demarrage
   (want-time      time-frame)
   (start-clock    int64)
   (cheats-saved   uint64)
   (last-skill     float)
   (last-enemies   float)
   (task-scan      time-frame)
   (tasks-done     uint8 140)
   (keys-synced    symbol)
   (key-read       uint32)
   (keys-now       int64)
   (tab-open       symbol)
   (tab-page       int32)
   (tab-row        int32)
   (tab-scroll     int32)
   (tab-sub        symbol)
   (tab-target     uint32)
   (tab-fix-row    symbol)
   (row-count      int32)
   (row-action     int32 160)
   (row-arg        int32 160)
   (row-on         symbol 160)
   (row-text       string 160)
   (row-right      string 160)
   (row-color      int32 160)
   (shop-open      symbol)
   (shop-cat       int32)
   (shop-row       int32)
   (chat-open      symbol)
   (chat-seq       uint32)
   (chat-mode      int32)
   (chat-open-time time-frame)
   (kb-off         symbol)
   (kb-prev        symbol)
   (kb-restore     time-frame)
   (show-list      symbol)
   (show-names     symbol)
   (show-chat      symbol)
   (chat-write     uint32)
   (chat-time      time-frame)
   (ann-seq        uint32)
   (ann-time       time-frame)
   (declined-time  time-frame)
   (reward-seq     uint32)
   (reward-time    time-frame)
   (time-seq       uint32)
   (frozen         symbol)
   (icon-owner     handle)
   (icons          connection-minimap 24)
   (icon-id        uint32 24)
   (icon-class     int32 24)
   (icon-pos       vector 24 :inline)
   (race-icon      connection-minimap)
   (race-pos       vector :inline)
   (ev-icon        connection-minimap)
   (ev-pos         vector :inline)
   (ev-class       int32)
   (ev-icon-id     uint32)
   (shop-icon      connection-minimap)  ;; le Naughty Ottsel sur la carte
   (money-icon     handle)
   (money-spin     float)
   (tp-pending     symbol)
   (tp-pos         vector :inline)
   (tp-level       string)
   (tp-time        time-frame)
   (tp-started     symbol)
   (hint           string)
   (hint-time      time-frame)
   (veh-cool       time-frame)
   (veh-last       handle)         ;; dernier vehicule appele (efface quand on en appelle un autre)
   (veh-wait       symbol)
   (veh-wait-time  time-frame)
   (veh-since      time-frame)     ;; depuis quand je suis dans un vehicule
   (veh-vt         int32)          ;; type du dernier vehicule appele
   (hit-cool       time-frame)
   (bump-cool      time-frame)
   (in-shop-zone   symbol)
   (ride-with      uint32)   ;; je suis passager du vehicule de ce joueur (0 = non)
   (ride-near      uint32)   ;; vehicule d'un joueur a portee (TRIANGLE pour monter)
   (str            string)
   (str2           string)
   (str3           string)
   (pad-prev       uint32)
   )
  )

(define *online-world* (new 'global 'online-world-state))

;; MAJ 1.3 : meteo et dialogues (online-events.gc)
(define-extern ow-meteo-tick! (function none))
(deftype ow-meteo-state (structure)
  ((kind      int32)
   (f         float)
   (saved     symbol)
   (flag0     symbol)
   (c0        float)
   (g0        float)
   (flash     float)
   (next-bolt time-frame)
   (thunder   time-frame)
   )
  )
(define-extern *ow-meteo* ow-meteo-state)
(define-extern ow-dialog-play! (function int none))
(define-extern *ow-dialog-last* sound-id)
(define-extern ow-dialog-text (function int string))
(define-extern ow-dialog-who-name (function int string))
(define-extern *ow-dialog-who* (array string))
(defconstant OW_DIALOG_COUNT 35)

(define-extern online-events-update (function none))
(define-extern online-events-draw (function none))
(define-extern online-powers-draw (function float float))
(define-extern online-events-test! (function int none))

(let ((w *online-world*))
  ;; tout a zero d'abord (compteurs, delais...), puis les valeurs par defaut
  ;; (l'objet commence 4 octets avant son adresse : c'est la place du type)
  (mem-set32! (the-as pointer w) (/ (- (size-of online-world-state) 4) 4) 0)
  (set! (-> w active) #f)
  (set! (-> w tab-fix-row) #f)
  (set! (-> w tp-started) #f)
  (set! (-> w starting) 0)
  (set! (-> w keys-synced) #f)
  (set! (-> w tab-open) #f)
  (set! (-> w tab-sub) #f)
  (set! (-> w shop-open) #f)
  (set! (-> w chat-open) #f)
  (set! (-> w kb-off) #f)
  (set! (-> w show-list) #t)
  (set! (-> w show-names) #t)
  (set! (-> w show-chat) #t)
  (set! (-> w frozen) #f)
  (set! (-> w icon-owner) (the-as handle #f))
  (set! (-> w veh-last) (the-as handle #f))
  (set! (-> w veh-wait) #f)
  (set! (-> w veh-vt) -1)
  (set! (-> w money-icon) (the-as handle #f))
  (set! (-> w race-icon) #f)
  (set! (-> w tp-pending) #f)
  (set! (-> w in-shop-zone) #f)
  (dotimes (i OW_MAX_ROWS)
    (set! (-> w row-text i) (new 'global 'string 96 (the-as string #f)))
    (set! (-> w row-right i) (new 'global 'string 48 (the-as string #f)))
    )
  (set! (-> w ev-icon) #f)
  (set! (-> w shop-icon) #f)
  ;; le menu SELECT s'ouvre d'abord sur la BOUTIQUE (OW_PAGE_SHOP)
  (set! (-> w tab-page) 1)
  (dotimes (i OW_MAX_ICONS)
    (set! (-> w icons i) #f)
    (set! (-> w icon-id i) (the-as uint 0))
    )
  (set! (-> w tp-level) (new 'global 'string 32 (the-as string #f)))
  (set! (-> w hint) (new 'global 'string 128 (the-as string #f)))
  (set! (-> w str) (new 'global 'string 256 (the-as string #f)))
  (set! (-> w str2) (new 'global 'string 256 (the-as string #f)))
  (set! (-> w str3) (new 'global 'string 64 (the-as string #f)))
  )

