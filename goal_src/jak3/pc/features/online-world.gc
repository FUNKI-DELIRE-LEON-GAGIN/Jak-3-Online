;; rangs (memes paliers que Jak3Online.exe)
(define *ow-rank-from* (new 'static 'array int32 9 1 5 10 15 20 30 40 50 75))
(define *ow-rank-names*
  (new 'static 'boxed-array :type string "Recrue" "Pillard" "Chasseur" "Guerrier" "Commando" "Champion" "Heros" "Legende" "Precurseur")
  )
(define *ow-rank-names-en*
  (new 'static 'boxed-array :type string "Rookie" "Raider" "Hunter" "Warrior" "Commando" "Champion" "Hero" "Legend" "Precursor")
  )

(defun ow-rank ((level int))
  (let ((r 0))
    (dotimes (i 9)
      (if (>= level (-> *ow-rank-from* i))
          (set! r i)
          )
      )
    r
    )
  )

(defun ow-rank-name ((level int))
  (online-fr (-> *ow-rank-names* (ow-rank level)) (-> *ow-rank-names-en* (ow-rank level)))
  )

(defun ow-rank-color ((level int))
  (case (ow-rank level)
    ((0) (font-color white))
    ((1) (font-color green))
    ((2) (font-color cyan))
    ((3) (font-color yellow))
    ((4) (font-color orange))
    ((5) (font-color red))
    ((6) (font-color pink))
    ((7) (font-color flat-yellow))
    (else (if (< (logand (-> *display* base-clock integral-frame-counter) 31) 16) (font-color cyan) (font-color pink)))
    )
  )

(defmacro ow-row (action arg on fmt &rest args)
  `(let ((ri (-> *online-world* row-count)))
     (when (< ri OW_MAX_ROWS)
       (set! (-> *online-world* row-action ri) ,action)
       (set! (-> *online-world* row-arg ri) ,arg)
       (set! (-> *online-world* row-on ri) ,on)
       (set! (-> *online-world* row-color ri) -1)
       (format (clear (-> *online-world* row-text ri)) ,fmt ,@args)
       (clear (-> *online-world* row-right ri))
       (+! (-> *online-world* row-count) 1)
       )
     )
  )

(defun ow-row-right! ((text string) (color int))
  "texte a droite de la derniere ligne (prix, etat)"
  (let* ((w *online-world*)
         (ri (+ (-> w row-count) -1))
         )
    (when (>= ri 0)
      (format (clear (-> w row-right ri)) "~S" text)
      (set! (-> w row-color ri) color)
      )
    )
  (none)
  )

(defun ow-player-index ((id uint))
  (let ((found -1))
    (dotimes (i (min 100 (the-as int (-> *online-shm* player-count))))
      (if (and (< found 0) (= (-> *online-shm* players i player-id) id))
          (set! found i)
          )
      )
    found
    )
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; PERSONNAGES (menu SELECT > BOUTIQUE) : Jak gratuit, les autres a acheter (objets du profil,
;; sauves par Jak3Online.exe comme les vehicules). Le choix est aussi sauve dans le profil
;; (ext perso). Le corps est pose sur le dessin de Jak (voir ow-perso-lods! dans online.gc).
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define *ow-perso-item* (new 'static 'array int8 11 -1 75 54 55 56 57 58 105 106 107 108))

(defun ow-perso-name ((k int))
  (case k
    ((1) "Keira")
    ((2) "Jak 2")
    ((3) "Jak 1 HD")
    ((4) "Jak 4")
    ((5) "Tess")
    ((6) "Daxter")
    ((7) "Ashelin")
    ((8) "Torn")
    ((9) "Sig")
    ((10) "Samos")
    (else "Jak")
    )
  )

(defun ow-perso-owned? ((k int))
  (or (<= k 0) (and (< k OW_PERSO_COUNT) (ow-owned? (-> *ow-perso-item* k))))
  )

(defun ow-perso-want ()
  "personnage a afficher sur mon Jak"
  (let ((k (the-as int (-> *online-ext* perso))))
    (if (and (online-in-session?) (-> *online-world* active) (> k 0) (< k OW_PERSO_COUNT) (ow-perso-owned? k))
        k
        0
        )
    )
  )

(defun ow-perso-choose! ((k int))
  (cond
    ((not (ow-perso-owned? k))
     (sound-play "generic-beep")
     (ow-hint! (online-fr "Achete d'abord ce personnage" "Buy this character first"))
     )
    (*target*
      (online-push-out-event! ONLINE_EVENT_PERSO (the-as uint 0) 0.0 k (-> *target* control trans))
      (sound-play "menu-pick")
      )
    )
  (none)
  )

(define-extern ow-shop-rows! (function int int none))

(defun ow-perso-rows! ()
  (ow-row OW_TA_NONE 0 #f (online-fr "-- PERSONNAGES : ton corps, avec les mouvements de Jak --" "-- CHARACTERS: your body, with Jak's moves --"))
  (dotimes (k OW_PERSO_COUNT)
    (let ((cur (= k (the-as int (-> *online-ext* perso)))))
      (cond
        ((ow-perso-owned? k)
         (ow-row OW_TA_PERSO k #t (online-fr "Jouer : ~S" "Play: ~S") (ow-perso-name k))
         (ow-row-right! (if cur
                            (online-fr "ACTIF" "ACTIVE")
                            (if (zero? k) (online-fr "GRATUIT" "FREE") (online-fr "ACHETE" "OWNED"))
                            )
                        (the-as int (if cur (font-color green) (font-color flat-yellow)))
                        )
         )
        (else
          (ow-shop-rows! (-> *ow-perso-item* k) (-> *ow-perso-item* k))
          )
        )
      )
    )
  (none)
  )

(defun ow-perso-cloth-off! ((t target))
  "le tissu de Jak (echarpe, jupe) ne doit pas etre dessine sur un autre corps"
  (let ((ci (-> t draw cloth-instances)))
    (when (and ci (nonzero? ci))
      (dotimes (i (-> ci length))
        ;; ses bandes se dessinent meme a l'arret (files du niveau du corps) : on les vide
        (if (not (logtest? (-> ci i flags) (cloth-flag hidden)))
            (hide! (-> ci i))
            )
        (logclear! (-> ci i flags) (cloth-flag active))
        )
      )
    )
  (none)
  )

;; ce qu'avait Jak avant le changement de corps (restaure au retour a Jak)
(define *ow-perso-jak-seg* (the-as uint -1))
(define *ow-perso-jak-shadow* (the-as shadow-geo #f))
(define *ow-perso-jak-cloth* 0) ;; tissus actifs (bits)
(define *ow-perso-jak-lods* (new 'global 'lod-set))
(define *ow-perso-jak-eff* (the-as uint 0))

(defun ow-perso-note-jak! ((t target))
  "Jak juste avant de changer de corps (etat sur) : on note son corps, ses masques, son ombre
   et son tissu, remis tels quels au retour a Jak"
  (mem-copy! (the-as pointer *ow-perso-jak-lods*) (the-as pointer (-> t draw lod-set)) 49)
  (set! *ow-perso-jak-seg* (-> t draw seg-mask))
  (set! *ow-perso-jak-eff* (-> t draw effect-mask))
  (if (-> t draw shadow)
      (set! *ow-perso-jak-shadow* (-> t draw shadow))
      )
  (let ((ci (-> t draw cloth-instances))
        (bits 0)
        )
    (when (and ci (nonzero? ci))
      (dotimes (i (-> ci length))
        (if (and (logtest? (-> ci i flags) (cloth-flag active)) (not (logtest? (-> ci i flags) (cloth-flag hidden))))
            (set! bits (logior bits (ash 1 i)))
            )
        )
      )
    (if (or (nonzero? bits) (zero? *ow-perso-cur*))
        (set! *ow-perso-jak-cloth* bits)
        )
    )
  (none)
  )

(defun ow-perso-restore-jak! ((t target))
  "remet le corps de Jak comme le fait l'avatar (target-continue-init-art appele hors de son
   etat rend Jak et Daxter invisibles)"
  (ow-perso-draw-level! (-> t draw) #f)
  (lods-assign! (-> t draw) *ow-perso-jak-lods*)
  (set! (-> t draw seg-mask) *ow-perso-jak-seg*)
  (set! (-> t draw effect-mask) *ow-perso-jak-eff*)
  (set! (-> t draw shadow) *ow-perso-jak-shadow*)
  (let ((ci (-> t draw cloth-instances)))
    (when (and ci (nonzero? ci))
      (dotimes (i (-> ci length))
        (logclear! (-> ci i flags) (cloth-flag hidden no-draw))
        (if (logtest? *ow-perso-jak-cloth* (ash 1 i))
            (logior! (-> ci i flags) (cloth-flag need-reset active))
            )
        )
      )
    )
  (none)
  )

(defun ow-perso-indax-ok? ((t target))
  "Jak peut devenir Daxter ici (au sol, a pied, pas en train de mourir ou de conduire)"
  (and (not (focus-test? t dead grabbed pilot board mech flut dark light edge-grab in-head teleporting tube pole carry turret))
       (logtest? (-> t control status) (collide-status on-surface))
       (= (-> t ext-anim) (target-anim default))
       (not (ow-map-inside?))
       )
  )

(define *ow-perso-body* 0)   ;; corps pose sur mon Jak (0 = celui de Jak)
(define *ow-geo-swap* 0)     ;; changement du corps de Jak (Jak 3 / vrai Jak 2) en cours
(define *ow-geo-cloth-test* #f)
;; le changement du corps natif de Jak en direct (Jak 3 / Jak 2 du secret) : le retour a Jak 3 plante
;; (le code de Jak 3 garde des pointeurs vers son modele) -> coupe ; le Jak 2 est le vrai maillage
;; de Jak 2 du jeu, pose comme les autres personnages
(define *ow-jak2-native-ok* #f)

(define-extern ow-perso-cloth-off! (function target none))

(defun ow-geo-swap-tick! ()
  "change le corps de Jak (Jak 3 / vrai Jak 2) SANS reapparaitre : comme le fait le jeu quand Jak
   revient en jeu (target-continue), mais pendant qu'on joue. Pendant le chargement (une fraction de
   seconde), Jak garde le corps de secours du jeu."
  (let ((t *target*))
    (when (and t
               (nonzero? (-> t draw))
               (nonzero? (-> t ext-geo-control))
               (!= (-> t ext-geo) (-> t pending-ext-geo))
               (zero? *ow-perso-body*)
               (!= *ow-perso-cur* OW_PERSO_DAXTER)
               (not (focus-test? t dead teleporting indax))
               )
      (let ((ctl (-> t ext-geo-control)))
        (cond
          ((zero? *ow-geo-swap*)
           ;; 1. Jak cache (corps de secours du jeu) : l'ancien modele n'est plus dessine
           (let ((sg (the-as skeleton-group (art-group-get-by-name *level* "skel-jchar" (the-as (pointer level) #f))))
                 (lods (new 'stack-no-clear 'lod-set))
                 )
             (if (and sg (setup-lods! lods sg (-> t draw art-group) (-> t entity)))
                 (lods-assign! (-> t draw) lods)
                 )
             )
           (set! (-> t draw shadow) #f)
           (ow-perso-cloth-off! t)
           (logior! (-> t draw status) (draw-control-status no-draw))
           (set! *ow-geo-swap* 1)
           )
          ((< *ow-geo-swap* 4)
           ;; 2. on attend quelques images (le dessin en cours utilise encore l'ancien modele)
           (logior! (-> t draw status) (draw-control-status no-draw))
           (+! *ow-geo-swap* 1)
           )
          ((= *ow-geo-swap* 4)
           ;; 3. on libere l'ancien modele et on charge le nouveau
           (logior! (-> t draw status) (draw-control-status no-draw))
           (when (not (or (= (-> ctl status) 'initialize) (= (-> t ext-geo) (target-geo none))))
             (unload-from-heap *anim-manager* (-> ctl heap))
             (unlink-shaders-in-heap *texture-page-dir* (-> ctl heap))
             )
           (set! (-> t ext-geo) (target-geo none))
           (set! *ow-geo-swap* 5)
           )
          (else
            (logior! (-> t draw status) (draw-control-status no-draw))
            )
          )
        (when (>= *ow-geo-swap* 5)
          (set-pending-file ctl "jak-external" (the-as int (-> t pending-ext-geo)) (process->handle t) 0.0)
          (update ctl)
          )
        (when (and (>= *ow-geo-swap* 5) (= (-> ctl status) 'active) (= (-> ctl load-file-part) (the-as int (-> t pending-ext-geo))))
          (set! (-> t ext-geo) (-> t pending-ext-geo))
          (let ((lods (new 'stack-no-clear 'lod-set)))
            (if (setup-lods! lods (target-skel-group) (-> t draw art-group) (-> t entity))
                (lods-assign! (-> t draw) lods)
                )
            )
          (let ((sg (the-as skeleton-group (art-group-get-by-name *level*
                                                                  (if (= (-> t ext-geo) (target-geo jakc)) "skel-jchar-c" "skel-jchar-normal")
                                                                  (the-as (pointer level) #f)
                                                                  )
                            )
                    )
                )
            (if (and sg (> (-> sg shadow) 0))
                (set! (-> t draw shadow) (the-as shadow-geo (-> t draw art-group data (-> sg shadow))))
                )
            )
          ;; tissu (echarpe) : seulement sur le Jak de Jak 3
          (let ((ci (-> t draw cloth-instances)))
            (when (and ci (nonzero? ci) (= (-> t ext-geo) (target-geo jakc)) *ow-geo-cloth-test*)
              (dotimes (i (-> ci length))
                (logclear! (-> ci i flags) (cloth-flag hidden no-draw))
                (logior! (-> ci i flags) (cloth-flag need-reset active))
                )
              )
            )
          (logclear! (-> t draw status) (draw-control-status no-draw))
          (set! *ow-geo-swap* 0)
          )
        )
      )
    )
  (none)
  )
(define *ow-jak2-native* #f) ;; le vrai Jak de Jak 2 (secret du jeu) est actif

(defun ow-perso-tick! ()
  "pose (ou enleve) le corps du personnage choisi sur mon Jak"
  (let ((t *target*)
        (k (ow-perso-want))
        )
    ;; JAK 2 : le VRAI Jak de Jak 2 du jeu (le secret "Jak de Jak 2"), avec ses yeux animes et Daxter
    (when (and t (nonzero? (-> t game)))
      (let ((want2 (and *ow-jak2-native-ok* (= k 2))))
        (when (or want2 *ow-jak2-native*)
          (set! *ow-jak2-native* want2)
          (set! (-> *game-info* secrets)
                (the-as game-secrets (if want2
                                         (logior (the-as int (-> *game-info* secrets)) (ash 1 38))
                                         (logclear (the-as int (-> *game-info* secrets)) (ash 1 38))
                                         )
                        )
                )
          (let ((g (if (or want2 (not (logtest? (game-feature jakc) (-> t game features)))) (target-geo jakb) (target-geo jakc))))
            (if (!= (-> t pending-ext-geo) g)
                (set! (-> t pending-ext-geo) g)
                )
            )
          )
        )
      )
    ;; DAXTER : le vrai mode Daxter du jeu (indax), pas un corps pose sur Jak
    (when (and t (nonzero? (-> t draw)))
      (cond
        ((= k OW_PERSO_DAXTER)
         (cond
           ((focus-test? t indax)
            (set! *ow-perso-cur* OW_PERSO_DAXTER)
            )
           ((and (ow-perso-indax-ok? t) (= (-> t ext-geo) (-> t pending-ext-geo)))
            (when (> *ow-perso-body* 0)
              (set! *ow-perso-body* 0)
              (ow-perso-restore-jak! t)
              )
            (send-event t 'change-mode 'indax #f #t)
            )
           )
         )
        ((= *ow-perso-cur* OW_PERSO_DAXTER)
         (if (focus-test? t indax)
             (send-event t 'end-mode 'indax)
             (set! *ow-perso-cur* 0)
             )
         )
        )
      )
    ;; Daxter sur l'epaule : seulement avec Jak (de Jak 3, de Jak 2, de Jak 1 ou de Jak 4)
    (set! *ow-sidekick-hide* (the-as symbol (and t (> k 4) (!= k OW_PERSO_DAXTER))))
    ;; un changement de corps de Jak (Jak 3 / vrai Jak 2) en cours : on le laisse finir d'abord
    (when (and t (nonzero? (-> t draw)) (-> t draw lod-set lod 0 geo) (!= k OW_PERSO_DAXTER) (!= *ow-perso-cur* OW_PERSO_DAXTER)
               (or (> *ow-perso-body* 0) (and (= (-> t ext-geo) (-> t pending-ext-geo)) (zero? *ow-geo-swap*)))
               )
      (cond
        ((and (> k 0) (or (!= k 2) (not *ow-jak2-native-ok*)))
         (let ((geo (ow-perso-geo k)))
           (cond
             (geo
               (if (zero? *ow-perso-body*)
                   (ow-perso-note-jak! t)
                   )
               ;; tissu et ombre de Jak : pas sur un autre corps (et ils ne se dessinent pas dans
               ;; les files d'un niveau : le rendu PC plante), donc coupes AVANT de changer de files
               (ow-perso-cloth-off! t)
               (set! (-> t draw shadow) #f)
               (if (!= (-> t draw lod-set lod 0 geo) geo)
                   (ow-perso-lods! (-> t draw) k)
                   (ow-perso-draw-level! (-> t draw) #t)
                   )
               (set! *ow-perso-body* k)
               )
             ((> *ow-perso-body* 0)
              (set! *ow-perso-body* 0)
              (ow-perso-restore-jak! t)
              )
             )
           )
         )
        ((> *ow-perso-body* 0)
         ;; retour a Jak (ou au vrai Jak 2)
         (set! *ow-perso-body* 0)
         (ow-perso-restore-jak! t)
         )
        )
      ;; personnage annonce aux autres joueurs
      (set! *ow-perso-cur* (if (and *ow-jak2-native-ok* (= k 2) (zero? *ow-perso-body*)) 2 *ow-perso-body*))
      )
    ;; voix du personnage (sons joues par Jak)
    (set! *online-voice-pitch* (if (= *ow-perso-cur* OW_PERSO_DAXTER) 0 (ow-perso-pitch *ow-perso-cur*)))
    ;; corps de Jak : Jak 3 / vrai Jak 2 (coupe, voir *ow-jak2-native-ok*)
    (if *ow-jak2-native-ok*
        (ow-geo-swap-tick!)
        )
    ;; banc de test : personnage pose sur moi / vu sur le premier avatar
    (let ((loc (-> *online-shm* local))
          (seen 0)
          )
      (set! (-> loc pad 19) (the-as uint *ow-perso-cur*))
      ;; corps charge par le jeu (1 jakb = Jak 2, 3 jakc = Jak 3...)
      (if *target*
          (set! (-> loc pad 35) (the-as uint (-> *target* ext-geo)))
          )
      (dotimes (i ONLINE_MAX_PUPPETS)
        (let ((p (online-puppet-proc i)))
          (if (and p (zero? seen) (>= (-> p geo) 100))
              (set! seen (- (-> p geo) 100))
              )
          )
        )
      (set! (-> loc pad 20) (the-as uint seen))
      )
    )
  (none)
  )

(ow-shop-extra-init!)

(defun ow-shop-rows! ((first int) (last int))
  (let ((id first))
    (while (<= id last)
      (when (nonzero? (length (ow-item-name id)))
        (let ((kind (-> *ow-shop-kind* id)))
          (cond
            ((and (= kind 3) (ow-owned? id))
             (ow-row OW_TA_VEHICLE id (ow-vehicle-type-ok? (ow-vehicle-for-item id)) "~S" (ow-item-name id))
             )
            ((and (= kind 4) (ow-owned? id))
             (ow-row OW_TA_VEHICLE id (ow-vehicle-type-ok? (ow-vehicle-for-item id)) "~S" (ow-item-name id))
             )
            (else
              (ow-row OW_TA_BUY id #t "~S" (ow-item-name id))
              )
            )
          (ow-row-right! (ow-item-state (-> *online-world* str3) id) (the-as int (ow-item-color id)))
          )
        )
      (+! id 1)
      )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; MAISONS : achetees a la boutique (objets 96-98), ce sont des cartes du mod (online-maps.gc,
;; cartes OW_PARKOUR_COUNT et suivantes). On s'y teleporte, on y invite ses amis (ils doivent
;; accepter). Chacun ne voit que les joueurs de la MEME maison (Jak3Online.exe cache les autres).
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun ow-house-tick! ()
  "annonce au programme la maison ou je suis (seuls ses occupants se voient)"
  (let* ((i (ow-map-current))
         (me (-> *online-shm* my-id))
         (owner (if (>= i OW_PARKOUR_COUNT)
                    (if (nonzero? *ow-house-owner*) *ow-house-owner* me)
                    (the-as uint 0)
                    )
                )
         )
    (cond
      ((>= i OW_PARKOUR_COUNT)
       (set! *ow-house-until* 0)
       )
      ;; hors d'une maison (et pas en route vers une maison) : plus de proprietaire
      ((< *ow-house-until* (online-now))
       (set! *ow-house-owner* (the-as uint 0))
       )
      )
    (when (and (online-in-session?) (!= owner *ow-house-sent*))
      (set! *ow-house-sent* owner)
      (online-push-out-event! ONLINE_EVENT_HOUSE owner 0.0 (if (nonzero? owner) (+ (- i OW_PARKOUR_COUNT) 1) 0) (the-as vector #f))
      )
    ;; invitation perimee (1 minute)
    (if (and (nonzero? *ow-invite-from*) (< (seconds 60) (- (online-now) *ow-invite-time*)))
        (set! *ow-invite-from* (the-as uint 0))
        )
    ;; banc de test : invitation en attente, maison annoncee (1 la mienne, 2 celle d'un autre)
    (let ((loc (-> *online-shm* local)))
      (set! (-> loc pad 26) (the-as uint (if (nonzero? *ow-invite-from*) 1 0)))
      (set! (-> loc pad 27) (the-as uint (cond
                                           ((zero? *ow-house-sent*) 0)
                                           ((= *ow-house-sent* me) 1)
                                           (else 2)
                                           )
                                    )
            )
      )
    )
  (none)
  )

(defun ow-house-go! ((k int) (owner uint))
  (cond
    ((or (not *target*) (focus-test? *target* dead) (< k 0) (>= k OW_HOUSE_COUNT))
     (sound-play "generic-beep")
     )
    (else
      (set! *ow-house-owner* owner)
      (set! *ow-house-until* (+ (online-now) (seconds 60)))
      (ow-map-goto! (+ OW_PARKOUR_COUNT k))
      )
    )
  (none)
  )

(defun ow-house-rows! ()
  (ow-row OW_TA_NONE 0 #f (online-fr "Ta maison : invite tes amis (onglet JOUEURS)" "Your home: invite friends (PLAYERS tab)"))
  (ow-row OW_TA_NONE 0 #f (online-fr "Boites aux lettres : des orbes chaque jour (plus la maison est chere, plus elle rapporte)"
                                     "Mailboxes: orbs every day (the pricier the house, the more it pays)"))
  (dotimes (k OW_HOUSE_COUNT)
    (let ((id (ow-house-item k)))
      (cond
        ((ow-owned? id)
         (ow-row OW_TA_HOUSE_GO k #t (online-fr "Aller dans ma maison : ~S" "Go to my house: ~S") (ow-house-name k))
         (ow-row-right! (online-fr "A MOI" "MINE") (the-as int (font-color green)))
         )
        (else
          (ow-shop-rows! id id)
          )
        )
      )
    )
  (none)
  )

(defun ow-acc-rows! ()
  "ACCESSOIRES : achetes -> PORTER / RETIRER ; sinon : a acheter (orbes, niveau requis)"
  (let ((wear (the-as int (-> *online-ext* cosm-wear))))
    (dotimes (slot 3)
      (ow-row OW_TA_NONE 0 #f (case slot
                                ((0) (online-fr "-- TETE : chapeaux, casques --" "-- HEAD: hats, helmets --"))
                                ((1) (online-fr "-- VISAGE : lunettes, masques --" "-- FACE: glasses, masks --"))
                                (else (online-fr "-- DOS : sac, cape, ailes --" "-- BACK: bag, cape, wings --"))
                                ))
      (dotimes (k 14)
        (when (= (-> *ow-acc-slot* k) slot)
          (let ((id (+ 114 k)))
            (cond
              ((ow-owned? id)
               (ow-row OW_TA_WEAR k #t "~S" (ow-item-name id))
               (if (= (logand (ash wear (* -8 slot)) 255) (-> *ow-acc-index* k))
                   (ow-row-right! (online-fr "PORTE" "WORN") (the-as int (font-color green)))
                   (ow-row-right! (online-fr "PORTER" "WEAR") (the-as int (font-color flat-yellow)))
                   )
               )
              (else
                (ow-shop-rows! id id)
                )
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun ow-acc-toggle! ((k int))
  "porter / retirer l'accessoire k (un seul par emplacement) ; le programme valide et sauve"
  (let* ((wear (the-as int (-> *online-ext* cosm-wear)))
         (sh (* 8 (-> *ow-acc-slot* k)))
         (cur (logand (ash wear (- sh)) 255))
         (idx (-> *ow-acc-index* k))
         (nw (logior (logand wear (lognot (ash 255 sh))) (ash (if (= cur idx) 0 idx) sh)))
         )
    (set! (-> *online-ext* cosm-wear) (the-as uint nw))
    (online-push-out-event! ONLINE_EVENT_WEAR (the-as uint 0) 0.0 nw (new 'static 'vector))
    )
  (none)
  )

(defun ow-cosm-rows! ()
  (ow-acc-rows!)
  (ow-row OW_TA_NONE 0 #f (online-fr "-- EFFETS --" "-- EFFECTS --"))
  (dotimes (k 5)
    (let ((id (+ 99 k)))
      (cond
        ((= id 101)
         ;; le pantalon de Daxter : le jeu ne le montre que dans ses cinematiques (retire)
         )
        ((ow-owned? id)
         (ow-row OW_TA_COSM k #t "~S" (ow-item-name id))
         (if (logtest? *ow-cosm-off* (ash 1 k))
             (ow-row-right! (online-fr "COUPE" "OFF") (the-as int (font-color flat-yellow)))
             (ow-row-right! (online-fr "ACTIF" "ON") (the-as int (font-color green)))
             )
         )
        (else
          (ow-shop-rows! id id)
          )
        )
      )
    )
  (none)
  )

;; CATEGORIES du menu : une seule ouverte a la fois par onglet (le menu reste court). X ouvre ou
;; ferme, TRIANGLE referme la categorie ouverte (puis ferme le menu).
(define *ow-cat-open* (new 'static 'array int32 8 -1 -1 -1 -1 -1 -1 -1 -1))
(define *ow-cat-focus* -1) ;; apres ouverture / fermeture : le curseur revient sur ce titre
(define *ow-cat-all* #f)   ;; banc de test : toutes les categories ouvertes

(defun ow-cat-open-here ()
  (-> *ow-cat-open* (min 7 (max 0 (-> *online-world* tab-page)))))

(defun ow-cat! ((id int) (name string))
  "titre de categorie ; #t si elle est ouverte (ses lignes suivent)"
  (let ((open (or *ow-cat-all* (= (ow-cat-open-here) id))))
    (ow-row OW_TA_CAT id #t (if open "- ~S" "+ ~S") name)
    (ow-row-right! (if open (online-fr "FERMER" "CLOSE") (online-fr "OUVRIR" "OPEN")) (the-as int (font-color font-color-32)))
    open
    )
  )

(defun ow-cat-toggle! ((id int))
  (let ((page (min 7 (max 0 (-> *online-world* tab-page)))))
    (set! (-> *ow-cat-open* page) (if (= (-> *ow-cat-open* page) id) -1 id))
    (set! *ow-cat-focus* id)
    )
  (none)
  )

(defun ow-tab-step ((row int) (dir int))
  "ligne suivante (dir 1) ou precedente (dir -1) qu'on peut choisir, en bouclant"
  (let* ((w *online-world*)
         (n (-> w row-count))
         (r row)
         (res row)
         (k 0)
         )
    (while (< k n)
      (set! r (+ r dir))
      (if (< r 0) (set! r (+ n -1)))
      (if (>= r n) (set! r 0))
      (when (-> w row-on r)
        (set! res r)
        (set! k n)
        )
      (+! k 1)
      )
    res
    )
  )

(defun ow-tab-build! ()
  "lignes du menu selon la page"
  (let* ((w *online-world*)
         (shm *online-shm*)
         (ext *online-ext*)
         (mod? (ow-mod?))
         (world? (-> w active))
         (s (-> w str2))
         )
    (set! (-> w row-count) 0)
    (if (>= (-> w tab-page) (ow-page-count))
        (set! (-> w tab-page) 0)
        )
    (cond
      ;; ---------------- actions sur un joueur
      ((-> w tab-sub)
       (let* ((idx (ow-player-index (-> w tab-target)))
              (xp (online-ext-player-by-id (-> w tab-target)))
              )
         (cond
           ((< idx 0)
            (set! (-> w tab-sub) #f)
            )
           (else
             (when (or mod? (not world?))
               (ow-row OW_TA_GOTO 0 #t (online-fr "Aller vers ce joueur" "Go to this player"))
               )
             (when (and world? (!= (-> w tab-target) (-> shm my-id)))
               (dotimes (hk OW_HOUSE_COUNT)
                 (if (ow-owned? (ow-house-item hk))
                     (ow-row OW_TA_HOUSE_INVITE hk #t (online-fr "L'inviter dans ma maison : ~S" "Invite to my house: ~S") (ow-house-name hk))
                     )
                 )
               )
             (ow-row OW_TA_IGNORE 0 #t (if (and xp (logtest? (-> xp flags) ONLINE_PX_MUTED))
                                           (online-fr "Ne plus l'ignorer (chat)" "Stop ignoring (chat)")
                                           (online-fr "L'ignorer (je ne vois plus son chat)" "Ignore (hide their chat)")
                                           )
                    )
             (when mod?
               (ow-row OW_TA_CMD ONLINE_CMD_BRING #t (online-fr "Le teleporter pres de moi" "Teleport to me"))
               (ow-row OW_TA_CMD ONLINE_CMD_HEAL #t (online-fr "Le soigner" "Heal"))
               (if (and xp (logtest? (-> xp flags) ONLINE_PX_FROZEN))
                   (ow-row OW_TA_CMD ONLINE_CMD_UNFREEZE #t (online-fr "Le degeler" "Unfreeze"))
                   (ow-row OW_TA_CMD ONLINE_CMD_FREEZE #t (online-fr "Le geler (ne bouge plus)" "Freeze"))
                   )
               (if (and xp (logtest? (-> xp flags) ONLINE_PX_MUTED))
                   (ow-row OW_TA_CMD ONLINE_CMD_UNMUTE #t (online-fr "Lui rendre la parole" "Unmute"))
                   (ow-row OW_TA_CMD ONLINE_CMD_MUTE #t (online-fr "Le rendre muet (chat)" "Mute (chat)"))
                   )
               (ow-row OW_TA_CMD ONLINE_CMD_SLAP #t (online-fr "Le projeter en l'air" "Slap into the air"))
               (ow-row OW_TA_CMD ONLINE_CMD_KILL #t (online-fr "Le foudroyer" "Smite"))
               (ow-row OW_TA_CMD ONLINE_CMD_KICK #t (online-fr "L'EXPULSER de la session" "KICK from the session"))
               (ow-row OW_TA_CMD ONLINE_CMD_BAN #t (online-fr "Le BANNIR" "BAN"))
               (when (and world? (ow-createur?))
                 (ow-row OW_TA_GIVE 500 #t (online-fr "Lui donner 500 orbes" "Give 500 orbs"))
                 (ow-row OW_TA_GIVE 5000 #t (online-fr "Lui donner 5000 orbes" "Give 5000 orbs"))
                 (ow-row OW_TA_GIVEVEH 0 #t (online-fr "Lui offrir TOUS les vehicules" "Give ALL vehicles"))
                 (ow-row OW_TA_BOUNTY 1000 #t (online-fr "Mettre une PRIME de 1000 orbes sur lui" "Put a 1000 orbs BOUNTY on them"))
                 (ow-row OW_TA_BOUNTY 5000 #t (online-fr "Mettre une PRIME de 5000 orbes sur lui" "Put a 5000 orbs BOUNTY on them"))
                 (ow-row OW_TA_HUNT 0 #t (online-fr "CHASSE A L'HOMME sur lui (1500 orbes au gagnant)" "MANHUNT on them (1500 orbs to the winner)"))
                 (ow-row OW_TA_SETLV 999 #t (online-fr "Son niveau : MAX (999)" "Their level: MAX (999)"))
                 (ow-row OW_TA_SETLV 50 #t (online-fr "Son niveau : 50" "Their level: 50"))
                 (ow-row OW_TA_SETLV 20 #t (online-fr "Son niveau : 20" "Their level: 20"))
                 (ow-row OW_TA_SETLV 10 #t (online-fr "Son niveau : 10" "Their level: 10"))
                 (ow-row OW_TA_SETLV 1 #t (online-fr "Son niveau : 1 (remise a zero)" "Their level: 1 (reset)"))
                 (ow-row OW_TA_SETMONEY 1000000 #t (online-fr "Ses orbes : 1 000 000" "Their orbs: 1,000,000"))
                 (ow-row OW_TA_SETMONEY 100000 #t (online-fr "Ses orbes : 100 000" "Their orbs: 100,000"))
                 (ow-row OW_TA_SETMONEY 10000 #t (online-fr "Ses orbes : 10 000" "Their orbs: 10,000"))
                 (ow-row OW_TA_SETMONEY 0 #t (online-fr "Ses orbes : 0 (tout lui retirer)" "Their orbs: 0 (take all)"))
                 )
               )
             (ow-row OW_TA_BACK 0 #t (online-fr "Retour" "Back"))
             )
           )
         )
       )
      ;; ---------------- joueurs
      ((= (-> w tab-page) OW_PAGE_PLAYERS)
       (dotimes (i (min 100 (the-as int (-> shm player-count))))
         (let* ((pe (-> shm players i))
                (xp (online-ext-player-by-id (-> pe player-id)))
                (me? (logtest? (-> pe flags) ONLINE_PFLAG_ME))
                (lv (if xp (the-as int (-> xp level)) 1))
                )
           (ow-zone-name s (-> pe level))
           (ow-row (if me? OW_TA_NONE OW_TA_PLAYER)
                   i
                   (not me?)
                   (online-fr "Nv~D ~S  ~S  -  ~S~S" "Lv~D ~S  ~S  -  ~S~S")
                   lv
                   (ow-rank-name lv)
                   (online-chars->string (-> w str3) (-> pe name) 16)
                   s
                   (cond
                     (me? (online-fr "  (VOUS)" "  (YOU)"))
                     ((and xp (logtest? (-> xp flags) ONLINE_PX_BOUNTY)) (online-fr "  (PRIME)" "  (BOUNTY)"))
                     ((and xp (logtest? (-> xp flags) ONLINE_PX_CREATEUR)) (online-fr "  (CREATEUR)" "  (CREATOR)"))
                     ((and (not world?) (logtest? (-> pe flags) ONLINE_PFLAG_HOST)) (online-fr "  (HOTE)" "  (HOST)"))
                     ((and (ow-createur?) xp (logtest? (-> xp flags2) 2)) (online-fr "  (SUSPECT)" "  (SUSPECT)"))
                     (else "")
                     )
                   )
           )
         )
       )
      ;; ---------------- BOUTIQUE (vehicules a appeler partout, super-pouvoirs, soins)
      ((= (-> w tab-page) OW_PAGE_SHOP)
       (cond
         ((not world?)
          (ow-row OW_TA_NONE 0 #f (online-fr "La boutique est ouverte dans le MONDE EN LIGNE (session publique)" "The shop is open in the ONLINE WORLD (public session)"))
          (ow-row OW_TA_NONE 0 #f (online-fr "-- MES VEHICULES --" "-- MY VEHICLES --"))
          (let ((id 43))
            (while (<= id 104)
              (ow-row OW_TA_VEHICLE id (ow-vehicle-type-ok? (ow-vehicle-for-item id)) (online-fr "Appeler : ~S" "Call: ~S") (ow-item-name id))
              (set! id (if (= id 53) 104 (+ id 1)))
              )
            )
          )
         (else
           ;; la vraie boutique : le Naughty Ottsel (prix normal) ; ici, a distance, ses objets +50 %
           (cond
             ((ow-shop-zone?)
              (ow-row OW_TA_NONE 0 #f (online-fr "TU ES AU NAUGHTY OTTSEL : PRIX NORMAUX (ou TRIANGLE)" "YOU ARE AT THE NAUGHTY OTTSEL: NORMAL PRICES (or TRIANGLE)"))
              )
             (else
               (ow-row OW_TA_NONE 0 #f (online-fr "BOUTIQUE : le NAUGHTY OTTSEL, port de Haven (icone de la carte)" "SHOP: the NAUGHTY OTTSEL, Haven port (map icon)"))
               (ow-row OW_TA_NONE 0 #f (online-fr "Ici, a distance : armes, Dark / Light Jak, armures +50 %" "Here, remotely: weapons, Dark / Light Jak, armor +50%"))
               (ow-row OW_TA_BUY 82 #t (online-fr "ALLER AU NAUGHTY OTTSEL" "GO TO THE NAUGHTY OTTSEL"))
               (ow-row-right! (ow-item-state (-> *online-world* str3) 82) (the-as int (ow-item-color 82)))
               )
             )
           ;; les personnages sont dans l'onglet PERSOS (plus ici)
           (if (ow-cat! 1 (online-fr "TELEPORTATION" "TELEPORT"))
               (ow-shop-rows! 82 93)
               )
           (if (ow-cat! 2 (online-fr "VEHICULES (a appeler partout)" "VEHICLES (call them anywhere)"))
               (begin
                 (ow-shop-rows! 43 53)
                 (ow-shop-rows! 104 104)
                 )
               )
           (if (ow-cat! 3 (online-fr "ARMES" "WEAPONS"))
               (ow-shop-rows! 0 11)
               )
           (if (ow-cat! 4 (online-fr "CHARGEURS ET DEGATS" "AMMO AND DAMAGE"))
               (begin
                 (ow-shop-rows! 12 23)
                 (ow-shop-rows! 76 79)
                 )
               )
           (if (ow-cat! 5 "DARK JAK")
               (ow-shop-rows! 28 33)
               )
           (if (ow-cat! 6 "LIGHT JAK")
               (ow-shop-rows! 34 38)
               )
           (if (ow-cat! 7 (online-fr "ARMURES ET AMELIORATIONS" "ARMOR AND UPGRADES"))
               (begin
                 (ow-shop-rows! 39 42)
                 (ow-shop-rows! 80 81)
                 )
               )
           (if (ow-cat! 8 "JETBOARD")
               (ow-shop-rows! 24 27)
               )
           (if (ow-cat! 9 (online-fr "SUPER-POUVOIRS" "SUPER POWERS"))
               (ow-shop-rows! 64 71)
               )
           (if (ow-cat! 10 (online-fr "SOINS ET SERVICES" "HEALTH AND SERVICES"))
               (begin
                 (ow-shop-rows! 60 63)
                 (ow-shop-rows! 72 74)
                 )
               )
           (if (ow-cat! 11 (online-fr "MAISONS" "HOUSES"))
               (ow-house-rows!)
               )
           (if (ow-cat! 12 "STYLE")
               (ow-cosm-rows!)
               )
           )
         )
       )
      ;; ---------------- PERSONNAGES
      ((= (-> w tab-page) OW_PAGE_PERSO)
       (cond
         (world?
           (ow-row OW_TA_NONE 0 #f (online-fr "CHOISIS TON PERSONNAGE (X / ENTREE) : tous les mouvements de Jak" "PICK YOUR CHARACTER (X / ENTER): all of Jak's moves"))
           (ow-perso-rows!)
           )
         (else
           (ow-row OW_TA_NONE 0 #f (online-fr "Les personnages s'achetent et se choisissent dans le MONDE EN LIGNE" "Characters are bought and picked in the ONLINE WORLD"))
           )
         )
       )
      ;; ---------------- evenements et courses
      ((= (-> w tab-page) OW_PAGE_EVENTS)
       (cond
         ((= (-> ext ev-state) 1)
          (ow-zone-name s (-> ext ev-level))
          (ow-row OW_TA_NONE 0 #f (online-fr "EN COURS : ~S  -  ~S" "RUNNING: ~S  -  ~S")
                  (case (the-as int (-> ext ev-kind))
                    ((ONLINE_EVK_BOSS) (online-fr "BOSS GEANT" "GIANT BOSS"))
                    ((ONLINE_EVK_ORBS) (online-fr "PLUIE D'ORBES" "ORB RAIN"))
                    ((ONLINE_EVK_TREASURE) (online-fr "CHASSE AU TRESOR" "TREASURE HUNT"))
                    ((ONLINE_EVK_DOUBLEXP) (online-fr "DOUBLE XP" "DOUBLE XP"))
                    ((ONLINE_EVK_HUNT) (online-fr "CHASSE A L'HOMME" "MANHUNT"))
                    ((ONLINE_EVK_PARKOUR) (online-fr "PARCOURS" "PARKOUR"))
                    ((ONLINE_EVK_KART) (online-fr "COURSE AUTO" "CAR RACE"))
                    ((ONLINE_EVK_HIDE) (online-fr "CACHE-CACHE" "HIDE AND SEEK"))
                    ((ONLINE_EVK_METEOR) (online-fr "PLUIE DE METEORES" "METEOR SHOWER"))
                    (else (online-fr "ZONE A CAPTURER" "CAPTURE THE ZONE"))
                    )
                  s
                  )
          ;; parcours : on peut le rejoindre tant qu'il n'est pas fini
          (when (and (ow-evk-map? (the-as int (-> ext ev-kind))) (!= (ow-map-current) (the-as int (-> ext ev-boss))))
            (ow-row OW_TA_MAP_JOIN 0 #t (online-fr "REJOINDRE : ~S" "JOIN: ~S") (ow-map-name (the-as int (-> ext ev-boss))))
            )
          )
         (else
           (ow-row OW_TA_NONE 0 #f (online-fr "Un evenement arrive toutes les 10 a 15 minutes : boss geant, tresor, pluie d'orbes..." "An event happens every 10 to 15 minutes: giant boss, treasure, orb rain..."))
           )
         )
       (if (ow-map-inside?)
           (ow-row OW_TA_MAP_LEAVE 0 #t (online-fr "QUITTER CETTE CARTE (retour au port de Haven)" "LEAVE THIS MAP (back to Haven port)"))
           )
       (case (-> ext race-state)
         ((1) (ow-row OW_TA_NONE 0 #f (online-fr "Course en preparation..." "Race starting...")))
         ((2) (ow-row OW_TA_NONE 0 #f (online-fr "Course en cours !" "Race in progress!")))
         (else
           (ow-row OW_TA_NONE 0 #f (online-fr "-- COURSES : les joueurs a moins de 80 m participent --" "-- RACES: players within 80 m take part --"))
           )
         )
       (let* ((lev (ow-my-level-name))
              (desert? (or (ow-prefix? lev "des") (ow-prefix? lev "was")))
              (first (if desert? 6 0))
              )
         (dotimes (k 6)
           (ow-row OW_TA_RACE (+ first k) (zero? (-> ext race-state))
                   (online-fr "Lancer une course vers ~S" "Start a race to ~S")
                   (online-fr (-> *ow-race-names* (+ first k)) (-> *ow-race-names-en* (+ first k)))
                   )
           )
         )
       )
      ;; ---------------- moi
      ((= (-> w tab-page) OW_PAGE_ME)
       (when (nonzero? *ow-invite-from*)
         (ow-row OW_TA_HOUSE_ACCEPT 0 #t (online-fr "ACCEPTER : aller chez ~S (~S)" "ACCEPT: go to ~S's (~S)") *ow-invite-name* (ow-house-name *ow-invite-house*))
         (ow-row OW_TA_HOUSE_DECLINE 0 #t (online-fr "Refuser l'invitation" "Decline the invitation"))
         )
       (if (>= (ow-map-current) OW_PARKOUR_COUNT)
           (ow-row OW_TA_MAP_LEAVE 0 #t (online-fr "Quitter la maison (retour au port de Haven)" "Leave the house (back to Haven port)"))
           )
       ;; vue a la premiere personne (R3 a la manette)
       (ow-row OW_TA_FP 0 #t (online-fr "Vue a la 1re personne (R3) : ~S" "First-person view (R3): ~S")
               (if *online-fp* (online-fr "OUI" "ON") (online-fr "NON" "OFF")))
       ;; joueur 2 local : 2e fenetre du jeu avec une 2e manette (comme un ecran partage)
       (if (online-local-j2?)
           (ow-row OW_TA_J2PAD 0 #t (online-fr "Manette du joueur 2 : ~S (X = suivante)" "Player 2 controller: ~S (X = next)") (online-j2-pad-name (-> w str3)))
           (ow-row OW_TA_LOCALJ2 0 #t
                   (if (online-local-j2-on?)
                       (online-fr "Arreter le joueur 2 local" "Stop local player 2")
                       (online-fr "JOUEUR 2 LOCAL : 2e fenetre avec une 2e manette" "LOCAL PLAYER 2: 2nd window with a 2nd controller")
                       )
                   )
           )
       (when (and world? (ow-createur?))
         (ow-row OW_TA_CHEAT 4 #t (online-fr "MODE DEBUG (createur) : ~S" "DEBUG MODE (creator): ~S")
                 (if (logtest? *ow-admin-cheats* 16) (online-fr "OUI" "ON") (online-fr "NON" "OFF")))
         )
       (when world?
         (ow-row OW_TA_NONE 0 #f (online-fr "Niveau ~D  -  ~S  -  ~D XP (prochain : ~D)" "Level ~D  -  ~S  -  ~D XP (next: ~D)")
                 (-> ext level) (ow-rank-name (the-as int (-> ext level))) (-> ext xp) (-> ext xp-next))
         (ow-row OW_TA_NONE 0 #f (online-fr "~D orbes  -  ~D eliminations  -  ~D morts  -  serie : ~D" "~D orbs  -  ~D kills  -  ~D deaths  -  streak: ~D")
                 (-> ext money) (-> ext kills) (-> ext deaths) (-> ext streak))
         )
       (ow-row OW_TA_TOGGLE 1 #t (online-fr "Liste des joueurs en haut a gauche : ~S" "Players list top-left: ~S")
               (if (-> w show-list) (online-fr "OUI" "ON") (online-fr "NON" "OFF")))
       (ow-row OW_TA_TOGGLE 2 #t (online-fr "Pseudos au-dessus des joueurs : ~S" "Names above players: ~S")
               (if (-> w show-names) (online-fr "OUI" "ON") (online-fr "NON" "OFF")))
       (ow-row OW_TA_TOGGLE 3 #t (online-fr "Chat a l'ecran : ~S" "Chat on screen: ~S")
               (if (-> w show-chat) (online-fr "OUI" "ON") (online-fr "NON" "OFF")))
       (ow-row OW_TA_NONE 0 #f (online-fr "-- MES VEHICULES (appel rapide) --" "-- MY VEHICLES (quick call) --"))
       (let ((any #f)
             (id 43)
             )
         (while (<= id 104)
           (when (ow-vehicle-allowed? id)
             (set! any #t)
             (ow-row OW_TA_VEHICLE id (ow-vehicle-type-ok? (ow-vehicle-for-item id)) (online-fr "Appeler : ~S" "Call: ~S") (ow-item-name id))
             )
           (set! id (if (= id 53) 104 (+ id 1)))
           )
         (if (not any)
             (ow-row OW_TA_NONE 0 #f (online-fr "Aucun : va dans l'onglet BOUTIQUE" "None: see the SHOP tab"))
             )
         )
       )
      ;; ---------------- ADMIN (createur partout, hote en session privee) : par categories, le plus utile en haut
      (else
        (ow-row OW_TA_NONE 0 #f
                (online-fr "Session ~S  -  ~D / ~D joueurs  -  PvP ~S" "Session ~S  -  ~D / ~D players  -  PvP ~S")
                (online-chars->string (-> w str3) (-> shm session-code) 8)
                (-> shm session-players)
                (-> shm session-max)
                (if (online-pvp-allowed?) (online-fr "OUI" "ON") (online-fr "NON" "OFF"))
                )
        ;; 1. tout le monde (le plus utile : ouvert en premier)
        (ow-row OW_TA_ALL ONLINE_CMD_BRING_ALL #t (online-fr "Teleporter tout le monde pres de moi" "Teleport everyone to me"))
        (when (ow-cat! 21 (online-fr "TOUT LE MONDE" "EVERYONE"))
        (ow-row OW_TA_ALL ONLINE_CMD_HEAL_ALL #t (online-fr "Soigner tout le monde" "Heal everyone"))
        (ow-row OW_TA_ANNOUNCE 0 #t (online-fr "Faire une ANNONCE a tout le monde" "Make an ANNOUNCEMENT"))
        (ow-row OW_TA_ALL ONLINE_CMD_FREEZE_ALL #t (online-fr "Geler tout le monde" "Freeze everyone"))
        (ow-row OW_TA_ALL ONLINE_CMD_UNFREEZE_ALL #t (online-fr "Degeler tout le monde" "Unfreeze everyone"))
        (ow-row OW_TA_PVP 0 #t (if (online-pvp-allowed?) (online-fr "PvP : OUI  (couper)" "PvP: ON  (turn off)") (online-fr "PvP : NON  (activer)" "PvP: OFF  (turn on)")))
        (ow-row OW_TA_ALL ONLINE_CMD_RESET_ACTORS #t (online-fr "Remettre le monde a neuf (ennemis, caisses, objets)" "Reset the world (enemies, crates, items)"))
          )
        ;; 2. moi (createur) : mode debug et triches en premier
        (when (and world? (ow-createur?) (ow-cat! 22 (online-fr "MOI (createur)" "ME (creator)")))
          (ow-row OW_TA_CHEAT 4 #t "~S : ~S" (ow-cheat-name 4) (if (logtest? *ow-admin-cheats* 16) (online-fr "OUI" "ON") (online-fr "NON" "OFF")))
          (dotimes (ci 4)
            (ow-row OW_TA_CHEAT ci #t "~S : ~S" (ow-cheat-name ci)
                    (if (logtest? *ow-admin-cheats* (ash 1 ci)) (online-fr "OUI" "ON") (online-fr "NON" "OFF"))
                    )
            )
          (ow-row OW_TA_MYLV 999 #t (online-fr "Mon niveau : MAX (999)" "My level: MAX (999)"))
          (ow-row OW_TA_MYLV 50 #t (online-fr "Mon niveau : 50" "My level: 50"))
          (ow-row OW_TA_MYLV 20 #t (online-fr "Mon niveau : 20" "My level: 20"))
          (ow-row OW_TA_MYLV 1 #t (online-fr "Mon niveau : 1 (remise a zero)" "My level: 1 (reset)"))
          (ow-row OW_TA_MYMONEY 9999999 #t (online-fr "Mes orbes : 9 999 999" "My orbs: 9,999,999"))
          (ow-row OW_TA_MYMONEY 100000 #t (online-fr "Mes orbes : 100 000" "My orbs: 100,000"))
          (ow-row OW_TA_MYMONEY 0 #t (online-fr "Mes orbes : 0" "My orbs: 0"))
          )
        ;; 3. evenements ici
        (when (ow-cat! 23 (online-fr "EVENEMENTS (ici)" "EVENTS (here)"))
        (ow-row OW_TA_EVENT ONLINE_EVK_BOSS #t (online-fr "Lancer : BOSS au hasard ici" "Start: random BOSS here"))
        (ow-row OW_TA_EVENT (+ ONLINE_EVK_BOSS (* 100 (+ ONLINE_BOSS_ROBOT 1))) #t (online-fr "Lancer : ROBO BOSS ici" "Start: ROBO BOSS here"))
        (ow-row OW_TA_EVENT (+ ONLINE_EVK_BOSS (* 100 (+ ONLINE_BOSS_TITAN 1))) #t (online-fr "Lancer : TITAN ici" "Start: TITAN here"))
        (ow-row OW_TA_EVENT (+ ONLINE_EVK_BOSS (* 100 (+ ONLINE_BOSS_BETE 1))) #t (online-fr "Lancer : BETE DU DESERT ici" "Start: DESERT BEAST here"))
        (ow-row OW_TA_EVENT (+ ONLINE_EVK_BOSS (* 100 (+ ONLINE_BOSS_DARKJAK 1))) #t (online-fr "Lancer : DARK JAK GEANT ici" "Start: GIANT DARK JAK here"))
        (ow-row OW_TA_EVENT ONLINE_EVK_HUNT #t (online-fr "Lancer : CHASSE A L'HOMME sur moi (qui me tue gagne)" "Start: MANHUNT on me (whoever kills me wins)"))
        (ow-row OW_TA_EVENT ONLINE_EVK_METEOR #t (online-fr "Lancer : PLUIE DE METEORES ici" "Start: METEOR SHOWER here"))
        (ow-row OW_TA_EVENT ONLINE_EVK_ORBS #t (online-fr "Lancer : PLUIE D'ORBES ici" "Start: ORB RAIN here"))
        (ow-row OW_TA_EVENT ONLINE_EVK_TREASURE #t (online-fr "Lancer : CHASSE AU TRESOR ici" "Start: TREASURE HUNT here"))
        (ow-row OW_TA_EVENT ONLINE_EVK_ZONE #t (online-fr "Lancer : ZONE A CAPTURER ici" "Start: CAPTURE THE ZONE here"))
        (ow-row OW_TA_EVENT ONLINE_EVK_DOUBLEXP #t (online-fr "Lancer : DOUBLE XP (5 min)" "Start: DOUBLE XP (5 min)"))
          )
        ;; 4. missions du jeu (monde en ligne)
        (when (and world? (ow-cat! 24 (online-fr "MISSION : le premier qui la reussit gagne" "MISSION: first to complete it wins")))
          (dotimes (k OW_MISSION_COUNT)
            (ow-row OW_TA_EVENT (+ ONLINE_EVK_MISSION (* 100 (+ (-> *ow-mission-ids* k) 1))) #t (online-fr "Mission : ~S" "Mission: ~S") (ow-mission-name k))
            )
          )
        ;; 5. parcours
        (when (ow-cat! 25 (online-fr "PARCOURS (tout le monde y part)" "PARKOUR (everyone goes)"))
          (dotimes (mi OW_PARKOUR_COUNT)
            (ow-row OW_TA_EVENT (+ ONLINE_EVK_PARKOUR (* 100 (+ mi 1))) #t (online-fr "Lancer un PARCOURS : ~S" "Start a PARKOUR: ~S") (ow-map-name mi))
            )
          ;; les COURSES OFFICIELLES du jeu (missions de course : le premier qui la reussit gagne)
          (ow-row OW_TA_NONE 0 #f (online-fr "-- COURSES OFFICIELLES DU JEU --" "-- OFFICIAL GAME RACES --"))
          (dotimes (rk OW_MISSION_COUNT)
            (if (or (< rk 6) (and (>= rk 9) (< rk 13)))
                (ow-row OW_TA_EVENT (+ ONLINE_EVK_MISSION (* 100 (+ (-> *ow-mission-ids* rk) 1))) #t (online-fr "Course officielle : ~S" "Official race: ~S") (ow-mission-name rk))
                )
            )
          (ow-row OW_TA_EVENT (+ ONLINE_EVK_KART (* 100 (+ OW_MAP_CIRCUIT 1))) #t (online-fr "Lancer une COURSE AUTO (circuit, un vehicule pour chacun)" "Start a CAR RACE (circuit, a car for everyone)"))
          (ow-row OW_TA_EVENT (+ ONLINE_EVK_HIDE (* 100 (+ OW_MAP_HIDE 1))) #t (online-fr "Lancer un CACHE-CACHE (manoir : trouver le personnage rouge)" "Start HIDE AND SEEK (manor: find the red character)"))
          )
        ;; 6. heure du monde
        (when (ow-cat! 26 (online-fr "HEURE DU MONDE" "WORLD TIME"))
        (ow-row OW_TA_TIME 800 #t (online-fr "Heure du monde : matin" "World time: morning"))
        (ow-row OW_TA_TIME 1300 #t (online-fr "Heure du monde : midi" "World time: noon"))
        (ow-row OW_TA_TIME 1900 #t (online-fr "Heure du monde : soir" "World time: evening"))
        (ow-row OW_TA_TIME 2300 #t (online-fr "Heure du monde : nuit" "World time: night"))
        (ow-row OW_TA_DAYLOCK 0 #t (online-fr "Jour permanent pour tout le monde : ~S" "Always day for everyone: ~S")
                (if (nonzero? (-> ext day-lock)) (online-fr "OUI" "ON") (online-fr "NON" "OFF")))
          )
        ;; 6b. meteo (tout le monde la voit)
        (when (ow-cat! 28 (online-fr "METEO" "WEATHER"))
          (dotimes (wk 4)
            (ow-row OW_TA_WEATHER wk #t (online-fr "Meteo : ~S" "Weather: ~S")
                    (case wk
                      ((1) (online-fr "PLUIE" "RAIN"))
                      ((2) (online-fr "ORAGE (eclairs, tonnerre)" "STORM (lightning, thunder)"))
                      ((3) (online-fr "NEIGE" "SNOW"))
                      (else (online-fr "BEAU TEMPS" "CLEAR SKY"))
                      ))
            (if (= wk (the-as int (-> ext weather)))
                (ow-row-right! (online-fr "EN COURS" "NOW") (the-as int (font-color green)))
                )
            )
          )
        ;; 6c. dialogues du jeu (chacun les entend dans la langue de son jeu)
        (when (ow-cat! 29 (online-fr "DIALOGUES (voix du jeu)" "DIALOGUES (game voices)"))
          (dotimes (dk OW_DIALOG_COUNT)
            (ow-row OW_TA_DIALOG dk #t "~S : ~S" (ow-dialog-who-name dk) (ow-dialog-text dk))
            )
          )
        ;; 7. moderation
        (when (and world? (ow-createur?) (ow-cat! 27 (online-fr "MODERATION" "MODERATION")))
          (ow-row OW_TA_UNBAN 0 #t (online-fr "Debannir le dernier joueur banni" "Unban the last banned player"))
          (ow-row OW_TA_VERSION 0 #t (online-fr "Ma version du mod = la version officielle (anti-triche, PAS une sauvegarde)" "My mod version = the official one (anti-cheat, NOT a save)"))
          )
        )
      )
    (when (>= *ow-cat-focus* 0)
      (dotimes (i (-> w row-count))
        (when (and (= (-> w row-action i) OW_TA_CAT) (= (-> w row-arg i) *ow-cat-focus*))
          (set! (-> w tab-row) i)
          (set! (-> w tab-scroll) i)
          )
        )
      (set! *ow-cat-focus* -1)
      )
    (if (>= (-> w tab-row) (-> w row-count))
        (set! (-> w tab-row) (max 0 (+ (-> w row-count) -1)))
        )
    (when (-> w tab-fix-row)
      (set! (-> w tab-fix-row) #f)
      (let ((first -1))
        (dotimes (i (-> w row-count))
          (if (and (< first 0) (-> w row-on i))
              (set! first i)
              )
          )
        (if (>= first 0)
            (set! (-> w tab-row) first)
            )
        )
      )
    )
  (none)
  )

(defun ow-tab-open! ()
  (let ((w *online-world*))
    (set! (-> w tab-open) #t)
    (set! (-> w tab-sub) #f)
    (set! (-> w tab-row) 0)
    (set! (-> w tab-scroll) 0)
    (set! (-> w tab-fix-row) #t)
    (ow-kb-off!)
    (sound-play "window-expand")
    )
  (none)
  )

(defun ow-tab-close! ()
  (let ((w *online-world*))
    (set! (-> w tab-open) #f)
    (set! (-> w tab-sub) #f)
    (ow-kb-on-later!)
    (sound-play "window-contract")
    )
  (none)
  )

(defun ow-admin! ((target uint) (cmd int) (arg float))
  "commande de moderation (signee et envoyee par Jak3Online.exe)"
  (let ((pos (new 'stack-no-clear 'vector)))
    (if *target*
        (vector-copy! pos (-> *target* control trans))
        (vector-reset! pos)
        )
    (online-push-out-event! ONLINE_EVENT_ADMIN target arg cmd pos)
    )
  (none)
  )

(defun ow-tab-activate! ()
  (let* ((w *online-world*)
         (row (-> w tab-row))
         (action (-> w row-action row))
         (arg (-> w row-arg row))
         )
    (cond
      ((or (>= row (-> w row-count)) (not (-> w row-on row)))
       (sound-play "generic-beep")
       )
      (else
        (if (!= action OW_TA_BUY)
            (sound-play "select-option")
            )
        (case action
          ((OW_TA_CAT)
           (ow-cat-toggle! arg)
           )
          ((OW_TA_PLAYER)
           (set! (-> w tab-target) (-> *online-shm* players arg player-id))
           (set! (-> w tab-sub) #t)
           (set! (-> w tab-row) 0)
           (set! (-> w tab-scroll) 0)
           )
          ((OW_TA_BACK)
           (set! (-> w tab-sub) #f)
           (set! (-> w tab-row) 0)
           )
          ((OW_TA_CMD)
           (ow-admin! (-> w tab-target) arg 0.0)
           (when (or (= arg ONLINE_CMD_KICK) (= arg ONLINE_CMD_BAN))
             (set! (-> w tab-sub) #f)
             (set! (-> w tab-row) 0)
             )
           )
          ((OW_TA_GIVE)
           (ow-admin! (-> w tab-target) ONLINE_CMD_GIVE (the float arg))
           )
          ((OW_TA_GIVEVEH)
           (ow-admin! (-> w tab-target) ONLINE_CMD_GIVE_VEHICLES 0.0)
           )
          ((OW_TA_IGNORE)
           (ow-admin! (-> w tab-target) ONLINE_CMD_IGNORE 0.0)
           )
          ((OW_TA_ALL)
           (ow-admin! (the-as uint 0) arg 0.0)
           )
          ((OW_TA_TIME)
           (ow-admin! (the-as uint 0) ONLINE_CMD_TIME (the float arg))
           )
          ((OW_TA_UNBAN)
           (ow-admin! (the-as uint 0) ONLINE_CMD_UNBAN 0.0)
           )
          ((OW_TA_EVENT)
           (ow-admin! (the-as uint 0) ONLINE_CMD_EVENT (the float arg))
           (ow-tab-close!)
           )
          ((OW_TA_HUNT)
           (ow-admin! (-> w tab-target) ONLINE_CMD_EVENT (the float ONLINE_EVK_HUNT))
           (ow-tab-close!)
           )
          ((OW_TA_BOUNTY)
           (ow-admin! (-> w tab-target) ONLINE_CMD_BOUNTY (the float arg))
           )
          ((OW_TA_MAP_JOIN)
           (ow-map-join!)
           (ow-tab-close!)
           )
          ((OW_TA_MAP_LEAVE)
           (ow-map-leave!)
           (ow-tab-close!)
           )
          ((OW_TA_PERSO)
           (ow-perso-choose! arg)
           )
          ((OW_TA_HOUSE_GO)
           (ow-house-go! arg (-> *online-shm* my-id))
           (ow-tab-close!)
           )
          ((OW_TA_HOUSE_INVITE)
           (online-push-out-event! ONLINE_EVENT_INVITE (-> w tab-target) 0.0 arg (the-as vector #f))
           (ow-hint! (online-fr "Invitation envoyee !" "Invitation sent!"))
           )
          ((OW_TA_HOUSE_ACCEPT)
           (let ((from *ow-invite-from*))
             (set! *ow-invite-from* (the-as uint 0))
             (when (nonzero? from)
               (ow-house-go! *ow-invite-house* from)
               (ow-tab-close!)
               )
             )
           )
          ((OW_TA_HOUSE_DECLINE)
           (set! *ow-invite-from* (the-as uint 0))
           )
          ((OW_TA_COSM)
           (set! *ow-cosm-off* (logxor *ow-cosm-off* (ash 1 arg)))
           )
          ((OW_TA_WEAR)
           (ow-acc-toggle! arg)
           (sound-play "skill-pickup")
           )
          ((OW_TA_LOCALJ2)
           (online-request! ONLINE_REQ_LOCALJ2 2)
           )
          ((OW_TA_FP)
           (set! *online-fp* (not *online-fp*))
           (sound-play "skill-pickup")
           )
          ((OW_TA_J2PAD)
           (online-j2-next-pad!)
           )
          ((OW_TA_WEATHER)
           (ow-admin! (the-as uint 0) ONLINE_CMD_WEATHER (the float arg))
           )
          ((OW_TA_DIALOG)
           (ow-admin! (the-as uint 0) ONLINE_CMD_DIALOG (the float arg))
           )
          ((OW_TA_DAYLOCK)
           (ow-admin! (the-as uint 0) ONLINE_CMD_DAYLOCK (if (nonzero? (-> *online-ext* day-lock)) 0.0 1.0))
           )
          ((OW_TA_SETLV)
           (ow-admin! (-> w tab-target) ONLINE_CMD_SET_LEVEL (the float arg))
           )
          ((OW_TA_SETMONEY)
           (ow-admin! (-> w tab-target) ONLINE_CMD_SET_MONEY (the float arg))
           )
          ((OW_TA_MYLV)
           (ow-admin! (the-as uint 0) ONLINE_CMD_SET_LEVEL (the float arg))
           )
          ((OW_TA_MYMONEY)
           (ow-admin! (the-as uint 0) ONLINE_CMD_SET_MONEY (the float arg))
           )
          ((OW_TA_CHEAT)
           (set! *ow-admin-cheats* (logxor *ow-admin-cheats* (ash 1 arg)))
           )
          ((OW_TA_VERSION)
           (ow-admin! (the-as uint 0) ONLINE_CMD_PUBLISH_VERSION 0.0)
           )
          ((OW_TA_BUY)
           (ow-buy! arg)
           )
          ((OW_TA_PVP)
           (cond
             ((-> w active)
              (ow-admin! (the-as uint 0) ONLINE_CMD_PVP (if (online-pvp-allowed?) 0.0 1.0))
              )
             (else
               (online-send-settings! (not (online-pvp-allowed?)) (nonzero? (-> *online-shm* session-public)))
               )
             )
           )
          ((OW_TA_ANNOUNCE)
           (ow-tab-close!)
           (ow-chat-open! 3)
           )
          ((OW_TA_GOTO)
           (let ((idx (ow-player-index (-> w tab-target)))
                 (pos (ow-puppet-pos (-> w tab-target)))
                 (xp (online-ext-player-by-id (-> w tab-target)))
                 )
             (cond
               ((< idx 0)
                )
               ((or pos (and xp (nonzero? (-> xp has-pos))))
                (let ((dst (new 'stack-no-clear 'vector)))
                  (if pos
                      (vector-copy! dst pos)
                      (set-vector! dst (-> xp x) (-> xp y) (-> xp z) 1.0)
                      )
                  (ow-tab-close!)
                  (ow-teleport-to! dst (online-chars->string (-> w str3) (-> *online-shm* players idx level) 16))
                  )
                )
               (else
                 (ow-hint! (online-fr "Position inconnue pour l'instant" "Position unknown for now"))
                 )
               )
             )
           )
          ((OW_TA_RACE)
           (let ((cp (get-continue-by-name *game-info* (-> *ow-race-cps* arg))))
             (when cp
               (online-push-out-event! ONLINE_EVENT_RACE (the-as uint 0) 0.0 arg (-> cp trans))
               (ow-tab-close!)
               )
             )
           )
          ((OW_TA_TOGGLE)
           (case arg
             ((1) (set! (-> w show-list) (not (-> w show-list))))
             ((2) (set! (-> w show-names) (not (-> w show-names))))
             ((3) (set! (-> w show-chat) (not (-> w show-chat))))
             )
           )
          ((OW_TA_VEHICLE)
           (ow-tab-close!)
           (ow-spawn-vehicle! arg)
           )
          )
        )
      )
    )
  (none)
  )

(defun ow-tab-input! ()
  (let ((w *online-world*)
        (pages (ow-page-count))
        )
    (ow-tab-build!)
    (cond
      ((and (not (-> w tab-sub)) (>= (ow-cat-open-here) 0)
            (or (cpad-pressed? 0 circle) (cpad-pressed? 0 triangle) (ow-key? ONLINE_KEY_ESC))
            )
       (ow-cat-toggle! (ow-cat-open-here))
       (sound-play "roll-over")
       )
      ((or (ow-key? ONLINE_KEY_TAB) (ow-key? ONLINE_KEY_ESC) (cpad-pressed? 0 select)
           (and (not (-> w tab-sub)) (or (cpad-pressed? 0 circle) (cpad-pressed? 0 triangle)))
           )
       (ow-tab-close!)
       )
      ((and (-> w tab-sub) (or (cpad-pressed? 0 circle) (cpad-pressed? 0 triangle) (ow-key? ONLINE_KEY_LEFT)))
       (set! (-> w tab-sub) #f)
       (set! (-> w tab-row) 0)
       (sound-play "roll-over")
       )
      ((and (not (-> w tab-sub)) (or (ow-key? ONLINE_KEY_LEFT) (cpad-pressed? 0 left) (cpad-pressed? 0 l1)))
       (set! (-> w tab-page) (if (> (-> w tab-page) 0) (+ (-> w tab-page) -1) (+ pages -1)))
       (set! (-> w tab-row) 0)
       (set! (-> w tab-scroll) 0)
       (set! (-> w tab-fix-row) #t)
       (sound-play "roll-over")
       )
      ((and (not (-> w tab-sub)) (or (ow-key? ONLINE_KEY_RIGHT) (cpad-pressed? 0 right) (cpad-pressed? 0 r1)))
       (set! (-> w tab-page) (if (< (-> w tab-page) (+ pages -1)) (+ (-> w tab-page) 1) 0))
       (set! (-> w tab-row) 0)
       (set! (-> w tab-scroll) 0)
       (set! (-> w tab-fix-row) #t)
       (sound-play "roll-over")
       )
      ((or (ow-key? ONLINE_KEY_UP) (cpad-pressed? 0 up))
       (set! (-> w tab-row) (ow-tab-step (-> w tab-row) -1))
       (sound-play "roll-over")
       )
      ((or (ow-key? ONLINE_KEY_DOWN) (cpad-pressed? 0 down))
       (set! (-> w tab-row) (ow-tab-step (-> w tab-row) 1))
       (sound-play "roll-over")
       )
      ((ow-key? ONLINE_KEY_PGDN)
       (set! (-> w tab-row) (min (max 0 (+ (-> w row-count) -1)) (+ (-> w tab-row) OW_VISIBLE_ROWS)))
       )
      ((ow-key? ONLINE_KEY_PGUP)
       (set! (-> w tab-row) (max 0 (- (-> w tab-row) OW_VISIBLE_ROWS)))
       )
      ((or (ow-key? ONLINE_KEY_ENTER) (cpad-pressed? 0 x))
       (ow-tab-activate!)
       )
      )
    ;; defilement
    (if (< (-> w tab-row) (-> w tab-scroll))
        (set! (-> w tab-scroll) (-> w tab-row))
        )
    (if (>= (-> w tab-row) (+ (-> w tab-scroll) OW_VISIBLE_ROWS))
        (set! (-> w tab-scroll) (+ (- (-> w tab-row) OW_VISIBLE_ROWS) 1))
        )
    ;; les titres juste au-dessus restent visibles
    (while (and (> (-> w tab-scroll) 0)
                (not (-> w row-on (+ (-> w tab-scroll) -1)))
                (< (- (-> w tab-row) (-> w tab-scroll)) (+ OW_VISIBLE_ROWS -1))
                )
      (+! (-> w tab-scroll) -1)
      )
    )
  (none)
  )

(defun ow-text-chars ((s string))
  "nombre de lettres (UTF-8 : les octets de suite ne comptent pas)"
  (let ((n 0))
    (dotimes (i (length s))
      (if (!= (logand (-> s data i) #xc0) #x80)
          (+! n 1)
          )
      )
    n
    )
  )

(defun ow-fit-scale ((s string) (most int) (scale float))
  "taille du texte reduite si le mot est plus long que most lettres (onglets traduits)"
  (let ((n (ow-text-chars s)))
    (if (< most n)
        (fmax 0.22 (* scale (/ (the float most) (the float n))))
        scale
        )
    )
  )

(defun ow-tab-page-name ((p int))
  (case p
    ((OW_PAGE_PLAYERS) (online-fr "JOUEURS" "PLAYERS"))
    ((OW_PAGE_SHOP) (online-fr "BOUTIQUE" "SHOP"))
    ((OW_PAGE_PERSO) (online-fr "PERSOS" "CHARACTERS"))
    ((OW_PAGE_EVENTS) (online-fr "EVENEMENTS" "EVENTS"))
    ((OW_PAGE_ME) (online-fr "MOI" "ME"))
    (else "ADMIN")
    )
  )

(defun ow-tab-draw! ()
  (let* ((w *online-world*)
         (shm *online-shm*)
         (ext *online-ext*)
         (s (-> w str))
         (x 56.0)
         (y 26.0)
         (width 400.0)
         (pages (ow-page-count))
         (tabw (/ (+ width -16.0) (the float pages)))
         )
    (ow-tab-build!)
    (ow-box x y width 334.0 0 0 0 128)
    (ow-box x y width 2.0 0 170 255 128)
    ;; onglets
    (dotimes (p pages)
      (let ((px (+ x 8.0 (* tabw (the float p)))))
        (if (and (= p (-> w tab-page)) (not (-> w tab-sub)))
            (ow-box px (+ y 6.0) (+ tabw -4.0) 16.0 0 170 255 60)
            )
        (online-print-fit (ow-tab-page-name p) px (+ y 8.0) (+ tabw -4.0) (ow-fit-scale (ow-tab-page-name p) 8 0.33)
                      (cond
                        ((= p OW_PAGE_ADMIN) (font-color red))
                        ((= p (-> w tab-page)) (font-color font-color-33))
                        (else (font-color font-color-32))
                        )
                      (font-flags shadow kerning middle large)
                      )
        )
      )
    ;; titre
    (cond
      ((-> w tab-sub)
       (let* ((idx (ow-player-index (-> w tab-target)))
              (xp (online-ext-player-by-id (-> w tab-target)))
              )
         (when (>= idx 0)
           (ow-zone-name (-> w str2) (-> shm players idx level))
           (format (clear s) (online-fr "~S  -  Nv~D  -  ~S  -  ~D PV" "~S  -  Lv~D  -  ~S  -  ~D HP")
                   (online-chars->string (-> w str3) (-> shm players idx name) 16)
                   (if xp (-> xp level) 1)
                   (-> w str2)
                   (the int (-> shm players idx health))
                   )
           (ow-text-mid s (+ y 30.0) 0.42 (font-color white))
           )
         )
       )
      (else
        (if (-> w active)
            (format (clear s) (online-fr "MONDE EN LIGNE  -  ~D JOUEURS  -  ~D ORBES" "ONLINE WORLD  -  ~D PLAYERS  -  ~D ORBS")
                    (-> shm session-players) (-> ext money))
            (format (clear s) (online-fr "SESSION ~S  -  ~D JOUEURS" "SESSION ~S  -  ~D PLAYERS")
                    (online-chars->string (-> w str3) (-> shm session-code) 8) (-> shm session-players))
            )
        (online-print-fit s (+ x 8.0) (+ y 30.0) (+ width -16.0) 0.42 (font-color white) (font-flags shadow kerning middle large))
        )
      )
    ;; lignes
    (let ((yy (+ y 50.0)))
      (dotimes (k OW_VISIBLE_ROWS)
        (let ((r (+ (-> w tab-scroll) k)))
          (when (< r (-> w row-count))
            (let ((sel (= r (-> w tab-row))))
              (if sel
                  (ow-box (+ x 4.0) (+ yy -2.0) (+ width -8.0) 17.0 0 170 255 56)
                  )
              (online-print-fit (-> w row-text r)
                            (+ x 12.0)
                            yy
                            (if (nonzero? (length (-> w row-right r))) 250.0 (+ width -20.0))
                            0.36
                            (cond
                              ((not (-> w row-on r)) (font-color font-color-44))
                              (sel (font-color font-color-33))
                              ((= (-> w row-action r) OW_TA_CAT) (font-color flat-yellow))
                              (else (font-color white))
                              )
                            (font-flags shadow kerning large)
                            )
              (when (nonzero? (length (-> w row-right r)))
                (online-print-fit (-> w row-right r) (+ x 262.0) (+ yy 1.0) 130.0 0.3
                              (if (>= (-> w row-color r) 0) (the-as font-color (-> w row-color r)) (font-color white))
                              (font-flags shadow kerning large)
                              )
                )
              )
            )
          )
        (set! yy (+ yy 19.0))
        )
      )
    (if (< (+ (-> w tab-scroll) OW_VISIBLE_ROWS) (-> w row-count))
        (ow-text-mid "..." (+ y 298.0) 0.4 (font-color font-color-32))
        )
    (online-print-fit (online-fr "X : ouvrir / valider    TRIANGLE : retour    GAUCHE / DROITE : onglets    SELECT : fermer"
                                 "X: open / select    TRIANGLE: back    LEFT / RIGHT: tabs    SELECT: close"
                                 )
                      (+ x 8.0) (+ y 316.0) (+ width -16.0)
                      0.27
                      (font-color font-color-32)
                      (font-flags shadow kerning middle large)
                      )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; HUD : orbes + niveau, liste des joueurs, annonces, recompenses, course
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun ow-money-icon-update! ((show symbol))
  "orbe precurseur en 3D qui tourne : le logo de l'argent du monde en ligne"
  (let* ((w *online-world*)
         (p (the-as process-drawable (handle->process (-> w money-icon))))
         )
    (when (and show (not p))
      (let ((sg (art-group-get-by-name *level* "skel-skill" (the-as (pointer level) #f))))
        (when (and sg (nonzero? sg))
          (let ((pp (process-spawn
                      manipy
                      :init manipy-init
                      (new 'static 'vector :w 1.0)
                      (the-as entity-actor #f)
                      (the-as skeleton-group sg)
                      (the-as vector #f)
                      (the-as manipy-options 0)
                      :name "online-orbe"
                      :to *default-pool*
                      :stack-size #x20000
                      )
                    )
                )
            (when (and pp (nonzero? (-> (the-as process-drawable (ppointer->process pp)) draw)))
              (set! p (the-as process-drawable (ppointer->process pp)))
              (set! (-> p draw dma-add-func)
                    (the-as (function process-drawable draw-control symbol object none) dma-add-process-drawable-hud)
                    )
              (logior! (-> p mask) (process-mask freeze pause))
              (logclear! (-> p mask) (process-mask menu progress))
              (set! (-> w money-icon) (ppointer->handle pp))
              )
            )
          )
        )
      )
    (when p
      (cond
        (show
          (logclear! (-> p draw status) (draw-control-status no-draw))
          (send-event p 'draw #t)
          ;; position a l'ecran (coordonnees du HUD : 512 x 416)
          (set-vector! (-> p root scale) (* 0.0055 (-> *video-params* relative-x-scale)) -0.011 (* 0.0055 (-> *video-params* relative-x-scale)) 1.0)
          (set! (-> p root trans x) (the float (+ (the int (* 30.0 (-> *video-params* relative-x-scale))) -256)))
          (set! (-> p root trans y) (* 2.0 (+ 29.0 -208.0)))
          (set! (-> p root trans z) 1024.0)
          (+! (-> w money-spin) (* 182.04445 (* 60.0 (-> *display* real-clock seconds-per-frame))))
          (quaternion-axis-angle! (-> p root quat) 0.0 1.0 0.0 (-> w money-spin))
          )
        (else
          (send-event p 'draw #f)
          (logior! (-> p draw status) (draw-control-status no-draw))
          )
        )
      )
    )
  (none)
  )

(defun ow-hud-money! ()
  "orbes + niveau + barre d'experience (monde en ligne)"
  (let* ((w *online-world*)
         (ext *online-ext*)
         (s (-> w str))
         (x0 (+ 12.0 (* 34.0 (-> *video-params* relative-x-scale))))
         )
    (format (clear s) "~D" (-> ext money))
    (ow-text s x0 22.0 0.5 (font-color flat-yellow))
    (format (clear s) (online-fr "NIVEAU ~D  ~S" "LEVEL ~D  ~S") (-> ext level) (ow-rank-name (the-as int (-> ext level))))
    (ow-text s (+ x0 70.0) 24.0 0.34 (ow-rank-color (the-as int (-> ext level))))
    ;; barre d'experience
    (let* ((base (-> ext xp-base))
           (next (-> ext xp-next))
           (frac (if (< base next)
                     (fmax 0.0 (fmin 1.0 (/ (the float (- (-> ext xp) base)) (the float (- next base)))))
                     0.0
                     )
                 )
           )
      (ow-box (+ x0 70.0) 37.0 80.0 3.0 40 40 40 110)
      (ow-box (+ x0 70.0) 37.0 (* 80.0 frac) 3.0 255 200 0 128)
      )
    )
  (none)
  )

(defun ow-hud-list! ((y0 float))
  "liste des joueurs en haut a gauche : niveau, pseudo, zone (les autres : TAB)"
  (let* ((w *online-world*)
         (shm *online-shm*)
         (s (-> w str))
         (n (min 100 (the-as int (-> shm player-count))))
         (y y0)
         (shown 0)
         (room (max 2 (+ -1 (the int (/ (- 118.0 y0) 11.0)))))
         (most (if (< room n) room n))
         )
    (dotimes (i n)
      (when (< shown most)
        (let* ((pe (-> shm players i))
               (xp (online-ext-player-by-id (-> pe player-id)))
               (me? (logtest? (-> pe flags) ONLINE_PFLAG_ME))
               )
          (ow-zone-name (-> w str2) (-> pe level))
          (format (clear s) (online-fr "Nv~D ~S  ~S" "Lv~D ~S  ~S")
                  (if xp (-> xp level) 1)
                  (online-chars->string (-> w str3) (-> pe name) 16)
                  (-> w str2)
                  )
          (ow-text s 14.0 y 0.28
                   (cond
                     (me? (font-color green))
                     ((and xp (logtest? (-> xp flags) ONLINE_PX_BOUNTY)) (font-color orange))
                     ((and xp (logtest? (-> xp flags) ONLINE_PX_CREATEUR)) (font-color flat-yellow))
                     ((logtest? (-> pe flags) ONLINE_PFLAG_DEAD) (font-color red))
                     (else (ow-rank-color (if xp (the-as int (-> xp level)) 1)))
                     )
                   )
          (set! y (+ y 11.0))
          (+! shown 1)
          )
        )
      )
    (when (< shown n)
      (format (clear s) (online-fr "+ ~D autres (TAB)" "+ ~D more (TAB)") (- n shown))
      (ow-text s 14.0 y 0.28 (font-color font-color-32))
      )
    )
  (none)
  )

(defun ow-hud-events! ()
  "annonces, recompenses, messages, course"
  (let* ((w *online-world*)
         (ext *online-ext*)
         (s (-> w str))
         (now (online-now))
         )
    ;; annonce (createur, niveau gagne, prime)
    (when (!= (-> ext ann-seq) (-> w ann-seq))
      (set! (-> w ann-seq) (-> ext ann-seq))
      (set! (-> w ann-time) now)
      (if (= (-> ext ann-kind) 1)
          (sound-play "skill-pickup")
          (sound-play "menu-pick")
          )
      )
    (when (and (< (- now (-> w ann-time)) (seconds 6)) (nonzero? (-> ext ann-text 0)))
      (case (-> ext ann-kind)
        ((0)
         (ow-center-line (online-fr "ANNONCE" "ANNOUNCEMENT") 0.36 (font-color orange))
         (ow-center-line (online-chars->string s (-> ext ann-text) 88) 0.5 (font-color white))
         )
        ((1)
         (ow-center-line (online-chars->string s (-> ext ann-text) 88) 0.7 (font-color flat-yellow))
         )
        (else
          (ow-center-line (online-chars->string s (-> ext ann-text) 88) 0.5 (font-color red))
          )
        )
      )
    ;; recompense (+orbes, +XP)
    (when (!= (-> ext reward-seq) (-> w reward-seq))
      (set! (-> w reward-seq) (-> ext reward-seq))
      (set! (-> w reward-time) now)
      )
    (when (and (< (- now (-> w reward-time)) (seconds 3)) (nonzero? (-> w reward-seq)))
      (let ((m (-> ext reward-money))
            (xp (-> ext reward-xp))
            )
        (when (or (!= m 0) (> xp 0))
          (cond
            ((and (!= m 0) (> xp 0))
             (format (clear s) (online-fr "~S~D orbes    +~D XP" "~S~D orbs    +~D XP") (if (> m 0) "+" "") m xp)
             )
            ((!= m 0)
             (format (clear s) (online-fr "~S~D orbes" "~S~D orbs") (if (> m 0) "+" "") m)
             )
            (else
              (format (clear s) "+~D XP" xp)
              )
            )
          (ow-center-line s 0.45 (if (< m 0) (font-color red) (font-color flat-yellow)))
          )
        (when (nonzero? (-> ext reward-text 0))
          (ow-center-line (online-chars->string s (-> ext reward-text) 48) 0.34 (font-color white))
          )
        )
      )
    ;; course
    (case (-> ext race-state)
      ((1)
       (format (clear s) (online-fr "COURSE vers ~S" "RACE to ~S") (online-chars->string (-> w str2) (-> ext race-name) 24))
       (ow-center-line s 0.5 (font-color cyan))
       (format (clear s) "~D" (+ 1 (the int (fmax 0.0 (-> ext race-timer)))))
       (ow-center-line s 1.2 (font-color flat-yellow))
       )
      ((2)
       (let ((dist (if *target* (vector-vector-distance (-> *target* control trans) (-> ext race-dest)) 0.0)))
         (format (clear s) (online-fr "COURSE : ~,,1f s   -   arrivee a ~D m" "RACE: ~,,1f s   -   finish in ~D m")
                 (-> ext race-timer)
                 (the int (/ dist 4096.0))
                 )
         (ow-center-line s 0.45 (font-color cyan))
         (if (< (-> ext race-timer) 1.5)
             (ow-center-line (online-fr "PARTEZ !" "GO!") 1.2 (font-color green))
             )
         )
       )
      ((3)
       (when (< 0 (the-as int (-> ext race-rank)))
         (format (clear s) (online-fr "ARRIVEE : ~D / ~D" "FINISH: ~D / ~D") (-> ext race-rank) (-> ext race-count))
         (ow-center-line s 0.6 (font-color flat-yellow))
         )
       )
      )
    ;; petit message
    (when (< (- now (-> w hint-time)) (seconds 3.5))
      ;; message long (langues longues, pseudos) : un peu plus petit pour tenir sur l'ecran
      (ow-center-line (-> w hint) (if (< 56 (ow-text-chars (-> w hint))) 0.32 0.4) (font-color yellow))
      )
    ;; gele
    (if (-> w frozen)
        (ow-center-line (online-fr "GELE PAR LA MODERATION" "FROZEN BY A MODERATOR") 0.6 (font-color cyan))
        )
    ;; boutique
    (if (and (-> w in-shop-zone) (not (-> w shop-open)) (not (-> w tab-open)))
        (ow-text-mid (online-fr "TRIANGLE : BOUTIQUE DU NAUGHTY OTTSEL (prix normaux)" "TRIANGLE: NAUGHTY OTTSEL SHOP (normal prices)") 318.0 0.45 (font-color flat-yellow))
        )
    (when (and (-> w active) (not (-> w shop-open)) (not (-> w tab-open)) (not *progress-process*))
      ;; panneau au-dessus de l'entree de la boutique (cache pendant les annonces, messages et
      ;; evenements : on arrive juste devant la porte, il chevaucherait le texte du milieu)
      (if (and (<= 6.0 (/ (the float (- (online-now) (-> w ann-time))) 300.0))
               (<= 4.0 (/ (the float (- (online-now) (-> w hint-time))) 300.0))
               (!= (-> *online-ext* ev-state) 1)
               )
          (ow-ottsel-label!)
          )
      ;; accueil : ou sont le menu, la boutique et les personnages
      (when (< (online-now) *ow-welcome-until*)
        (ow-text-mid (online-fr "SELECT (TAB) : LE MENU  -  BOUTIQUE, PERSOS, EVENEMENTS" "SELECT (TAB): THE MENU  -  SHOP, CHARACTERS, EVENTS") 196.0 0.42 (font-color flat-yellow))
        (ow-text-mid (online-fr "Boutique moins chere : le NAUGHTY OTTSEL (port de Haven, icone sur la carte)" "Cheaper shop: the NAUGHTY OTTSEL (Haven port, icon on the map)") 214.0 0.32 (font-color white))
        )
      )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; boucle (appelee chaque image par online-update)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun online-world-blocks-input? ()
  (let ((w *online-world*))
    (the-as symbol (or (-> w tab-open) (-> w shop-open) (-> w chat-open) (-> w frozen)))
    )
  )

;; MONDE EN LIGNE SANS BROUILLARD : pas de brume meteo (le ciel garde ses nuages) et le
;; brouillard de distance commence 4 fois plus loin (voir engine/draw/drawable.gc)
(define *ow-fog-override* #f)

(defun ow-fog-tick! ()
  (let ((on (and (-> *online-world* active) (online-in-session?))))
    (set! *online-fog-far* on)
    (cond
      (on
        (set! (-> *mood-control* overide-weather-flag) #t)
        (set! (-> *mood-control* overide cloud) (-> *mood-control* current-interp cloud))
        (set! (-> *mood-control* overide fog) 0.0)
        (set! *ow-fog-override* #t)
        )
      (*ow-fog-override*
        (set! (-> *mood-control* overide-weather-flag) #f)
        (set! *ow-fog-override* #f)
        )
      )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; VUE A LA PREMIERE PERSONNE (R3) : reprise du mod "Jak 4" de l'utilisateur. La camera cam-eye
;; du jeu posee aux yeux de Jak ; Jak fait face a la camera (strafe) ; l'arme tire ou l'on
;; regarde. En vehicule, planche, mech, mort ou cinematique : camera normale le temps que ca dure,
;; la vue revient toute seule ensuite. R3 (ou L3) la coupe.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define *ow-fp-on* #f) ;; reglage camera cam-eye pose

(defun ow-fp-off! ()
  (when *ow-fp-on*
    (remove-setting-by-arg0 *setting-control* 'mode-name)
    (remove-setting-by-arg0 *setting-control* 'allow-look-around)
    (set! *ow-fp-on* #f)
    )
  (set! *strafe-mode* #f)
  (set! *cam-eye-height-offset* 0.0)
  (set! *cam-eye-forward-offset* 0.0)
  (none)
  )

(defun ow-fp-tick! ()
  (let ((w *online-world*))
    ;; R3 : bascule (pas quand un menu ou le chat a la main) ; L3 : coupe
    (when (and *target* (not *progress-process*) (not (-> w tab-open)) (not (-> w chat-open)) (not (-> w shop-open)))
      (cond
        ((cpad-pressed? 0 r3)
         (set! *online-fp* (not *online-fp*))
         (sound-play "skill-pickup")
         (ow-hint! (if *online-fp*
                       (online-fr "VUE 1re PERSONNE : stick droit = regarder, R3 = quitter" "FIRST PERSON: right stick = look, R3 = exit")
                       (online-fr "Vue normale" "Normal view")
                       ))
         )
        ((and *online-fp* (cpad-pressed? 0 l3))
         (set! *online-fp* #f)
         (sound-play "skill-pickup")
         )
        )
      )
    (let ((want (and *online-fp* *target* (not (movie?)) (not *progress-process*)
                     (not (focus-test? *target* pilot mech board flut dead grabbed turret tube rail pole))
                     )
                )
          )
      (cond
        (want
          (when (not *ow-fp-on*)
            (set-setting-by-param *setting-control* 'allow-look-around #f 0 0)
            (set-setting-by-param *setting-control* 'mode-name 'cam-eye 0 0)
            (set! *ow-fp-on* #t)
            )
          ;; hauteur des yeux (plus bas en Daxter)
          (cond
            ((focus-test? *target* indax)
             (set! *cam-eye-height-offset* -4000.0)
             (set! *cam-eye-forward-offset* 3000.0)
             )
            (else
              (set! *cam-eye-height-offset* 800.0)
              (set! *cam-eye-forward-offset* 4000.0)
              )
            )
          ;; Jak fait face a la ou l'on regarde
          (let ((fwd (new-stack-vector0)))
            (vector-copy! fwd (-> (camera-matrix) fvec))
            (set! (-> fwd y) 0.0)
            (cond
              ((< 0.001 (vector-length fwd))
               (vector-normalize! fwd 1.0)
               (vector-copy! *strafe-dir* fwd)
               (set! *strafe-mode* #t)
               )
              (else
                (set! *strafe-mode* #f)
                )
              )
            )
          )
        (else
          (ow-fp-off!)
          )
        )
      )
    )
  (none)
  )

(defun online-world-update ((in-session symbol))
  (let* ((w *online-world*)
         (shm *online-shm*)
         (ext *online-ext*)
         (alive (online-companion-alive?))
         )
    (ow-cheats-detect!)
    (ow-read-keys!)
    (ow-kb-tick!)
    (ow-fp-tick!)
    (ow-acc-local-tick!)
    (ow-meteo-tick!)
    (online-coll-test-tick!)
    (ow-chat-update!)
    ;; lancement : vitrine dans Haven avec le menu du titre
    (ow-hub-tick!)
    ;; monde en ligne
    (ow-world-tick!)
    (ow-fog-tick!)
    (ow-cheats-tick!)
    (ow-perso-tick!)
    (ow-house-tick!)
    ;; cartes du mod (parcours)
    (ow-maps-tick!)
    (ow-teleport-tick!)
    ;; gel (commande de moderation) : sans session, plus de gel
    (if (not in-session)
        (set! (-> w frozen) #f)
        )
    (let ((can (and in-session alive *target* (not *progress-process*) (not (movie?)))))
      ;; chat : T
      (when (and in-session alive (not *progress-process*) (not (-> w chat-open)) (not (-> w tab-open)) (not (-> w shop-open)) (ow-key? ONLINE_KEY_T))
        (ow-chat-open! 2)
        )
      ;; menu TAB (ou SELECT a la manette)
      ;; le menu reste ouvert quand on meurt (il ne se ferme plus tout seul) et s'ouvre meme mort
      (let ((menu-ok (and in-session *target* (not *progress-process*) (not (movie?)))))
        (cond
          ((-> w tab-open)
           (if (or (not menu-ok) (-> w chat-open))
               (ow-tab-close!)
               (ow-tab-input!)
               )
           )
          ((and menu-ok (not (-> w chat-open)) (not (-> w shop-open)) (or (ow-key? ONLINE_KEY_TAB) (cpad-pressed? 0 select)))
           (ow-tab-open!)
           )
          )
        )
      ;; boutique du Naughty Ottsel
      (set! (-> w in-shop-zone) (the-as symbol (and can (ow-shop-zone?))))
      (cond
        ((-> w shop-open)
         (if (not (-> w in-shop-zone))
             (begin
               (set! (-> w shop-open) #f)
               (ow-kb-on-later!)
               )
             (ow-shop-input!)
             )
         )
        ((and (-> w in-shop-zone) (not (-> w tab-open)) (not (-> w chat-open)) (cpad-pressed? 0 triangle))
         (set! (-> w shop-open) #t)
         (set! (-> w shop-row) 0)
         (ow-kb-off!)
         (sound-play "window-expand")
         )
        )
      )
    ;; jour permanent (createur) : on reste en plein jour
    (when (and in-session (nonzero? (-> ext day-lock)) *time-of-day*
               (let ((h (-> *time-of-day-context* time))) (or (< h 10.0) (< 15.0 h)))
               )
      (send-event (ppointer->process *time-of-day*) 'change 'hour 12)
      )
    ;; heure du monde choisie par le createur / l'hote (et resynchronisee par le programme)
    (when (and in-session (!= (-> ext time-seq) (-> w time-seq)))
      (set! (-> w time-seq) (-> ext time-seq))
      (if (and (<= 0.0 (-> ext time-hour)) *time-of-day*)
          (send-event (ppointer->process *time-of-day*) 'change 'hour (the int (-> ext time-hour)))
          )
      )
    ;; vehicules : maillages a charger, collisions et ecrasement
    (ow-fr3-update!)
    (ow-vehicle-tick!)
    (when in-session
      (ow-collisions!)
      (ow-ride-update!)
      )
    ;; la mini-carte s'efface pendant les menus (sinon elle mange le coin du cadre)
    (if (or (-> w tab-open) (-> w shop-open))
        (logclear! (-> *setting-control* user-default minimap) 128)
        (logior! (-> *setting-control* user-default minimap) 128)
        )
    ;; carte
    (ow-icons-update!)
    ;; evenements du monde, super-pouvoirs, anti-triche
    (online-events-update)
    ;; etat pour Jak3Online.exe
    (set! (-> shm ui-mode) (the-as uint (cond
                                          ((-> w tab-open) 1)
                                          ((-> w shop-open) 2)
                                          (else 0)
                                          )
                                    )
          )
    (set! (-> shm ui-flags) (the-as uint (logior (if (and *target* (not *progress-process*)) 1 0)
                                                 (if (-> w active) 2 0)
                                                 (if *cheat-mode* 4 0)
                                                 )
                                     )
          )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; banc de test : quelles lettres la police du jeu sait dessiner (commande 78)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define *ow-font-test* #f)

(define *ow-font-test-lines*
  (new 'static 'boxed-array :type string
    "1 ÇÑØÆÐÞÝŰ ÂÃÕÙ· ¡º° äöüß åæø éèêàç"
    "2 ĄĆĘŃŹŻ ČĎĚŇŘŠŤŮŽ ĐĖĮŪŲ Ő"
    "3 čďěňřšťůž đėįūų ąćęńźżł ő ű ðþý"
    "4 ЙЩЪЫЬЮЁ йщъыьюё АБВГДЕЖЗИКЛМНОПРСТУФХЦЧШЭЯ"
    "5 견결과관광괴깐꽁꽉끊끔냥넷녁님덤돈돼된됨뜻렸령"
    "6 롭릴말멀못밖받밤밴벤봐빨송숨엄와완왼월의잘잦존"
    "7 좌참채챔천철청쳤최춤켬킬탭텨팅화확환황회획 한국어"
    "8 上下中乗了交人以位低作使倒像先入内切利制前力動勝北友台右合向告器地場壊外天字完容"
    "9 対射左幕式弾後必応性感成戻所押換撃攻敗数敵方映時書替機水泳源無物用画発矢砲破示秒"
    "A 種空突箱終続者能自薬行表要見解言記試話語警走跡転輸送逆連進遊選量録開間限電面頭高"
    "B ねばケザネホワ ぁぃぅぇぉゃゅょっ ァィゥェォャュョッヴー"
    )
  )

(defun ow-font-test-draw ()
  (when *ow-font-test*
    (ow-box 8.0 40.0 496.0 330.0 0 0 0 200)
    (dotimes (i (-> *ow-font-test-lines* length))
      (online-print (-> *ow-font-test-lines* i) 16.0 (+ 48.0 (* 29.0 (the float i))) 480.0 0.5 (font-color white) (font-flags shadow kerning large))
      )
    )
  (none)
  )

(defun online-world-draw ((in-session symbol))
  (let* ((w *online-world*)
         (hud? (and in-session (not *progress-process*) (not (movie?))))
         )
    ;; lancement : le monde en ligne va demarrer (ecran titre) -> compte a rebours et choix
    (when (and (= (-> w starting) 1) (not (-> w active)) (ow-at-title?) (not *online-world-go*))
      (let ((left (- 5 (the int (/ (the float (- (online-now) (-> w want-time))) 300.0)))))
        (when (< 0 left)
          (ow-box 56.0 84.0 400.0 50.0 0 0 0 170)
          (format (clear (-> w str)) (online-fr "MONDE EN LIGNE DANS ~D s" "ONLINE WORLD IN ~D s") left)
          (ow-text-mid (-> w str) 90.0 0.55 (font-color flat-yellow))
          (ow-text-mid (online-fr "ROND : RESTER HORS LIGNE (SOLO)" "CIRCLE: STAY OFFLINE (SOLO)") 114.0 0.38 (font-color white))
          )
        )
      )
    ;; passager : invite
    (when (and hud? (-> w active) (not (-> w tab-open)) (not (-> w shop-open)))
      (cond
        ((nonzero? (-> w ride-with))
         (format (clear (-> w str)) (online-fr "PASSAGER DE ~S  -  TRIANGLE : DESCENDRE" "RIDING WITH ~S  -  TRIANGLE: GET OFF")
                 (ow-player-name (-> w ride-with)))
         (ow-text-mid (-> w str) 196.0 0.4 (font-color cyan))
         )
        ((nonzero? (-> w ride-near))
         (format (clear (-> w str)) (online-fr "TRIANGLE : MONTER AVEC ~S" "TRIANGLE: RIDE WITH ~S")
                 (ow-player-name (-> w ride-near)))
         (ow-text-mid (-> w str) 196.0 0.4 (font-color flat-yellow))
         )
        )
      )
    ;; menu ouvert : son en-tete affiche deja les orbes (sinon le compteur touche le cadre)
    (ow-money-icon-update! (the-as symbol (and hud? (-> w active) (not (-> w tab-open)) (not (-> w shop-open)))))
    (set! *ow-center-y* 124.0)
    (when hud?
      (let ((y 22.0))
        (when (and (-> w active) (not (-> w tab-open)) (not (-> w shop-open)))
          (ow-hud-money!)
          (set! y 46.0)
          (+! y (online-powers-draw y))
          )
        (if (and (-> w show-list) (not (-> w tab-open)) (not (-> w shop-open)))
            (ow-hud-list! y)
            )
        )
      (when (not (or (-> w tab-open) (-> w shop-open)))
        (online-events-draw)
        (ow-hud-events!)
        )
      (ow-font-test-draw)
      ;; menus : dessines apres la mini-carte (sinon elle mange le coin du cadre)
      (set! *online-draw-bucket* (bucket-id hud-draw-pris2))
      (cond
        ((-> w tab-open) (ow-tab-draw!))
        ((-> w shop-open) (ow-shop-draw!))
        )
      (set! *online-draw-bucket* (bucket-id hud-draw-hud-alpha))
      )
    (set! *online-menu-open* (the-as symbol (or (-> w tab-open) (-> w shop-open))))
    ;; chat : pas par-dessus le menu SELECT / la boutique
    (if (and in-session (not (-> w tab-open)) (not (-> w shop-open)))
        (ow-chat-draw!)
        )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; banc de test (Jak3Online.exe --duo2) : menus et actions sans clavier
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun online-world-test! ((arg int))
  (let ((w *online-world*))
    (cond
      ((= arg 60) (if (not (-> w tab-open)) (ow-tab-open!)))
      ((= arg 61) (if (-> w tab-open) (ow-tab-close!)))
      ((= arg 62)
       (set! (-> w tab-page) (if (< (-> w tab-page) (+ (ow-page-count) -1)) (+ (-> w tab-page) 1) 0))
       (set! (-> w tab-row) 0)
       (set! (-> w tab-fix-row) #t)
       )
      ((= arg 63)
       (when (ow-shop-zone?)
         (set! (-> w shop-open) #t)
         (set! (-> w shop-row) 0)
         (ow-kb-off!)
         )
       )
      ((= arg 64)
       (when (-> w shop-open)
         (set! (-> w shop-open) #f)
         (ow-kb-on-later!)
         )
       )
      ((= arg 65) (set! (-> w shop-cat) (if (< (-> w shop-cat) (+ OW_SHOP_CATS -1)) (+ (-> w shop-cat) 1) 0)))
      ((= arg 66) (ow-chat-open! 2))
      ((= arg 67) (if (-> w chat-open) (ow-chat-close!)))
      ((= arg 68)
       ;; dans le Naughty Ottsel
       (let ((cp (get-continue-by-name *game-info* "hiphog-start")))
         (if (and *target* cp)
             (start 'play cp)
             )
         )
       )
      ((= arg 70)
       (if *target*
           (send-event *target* 'end-mode 'pilot)
           )
       )
      ((or (= arg 72) (= arg 93))
       ;; banc de test : frappe le boss (10 degats) / boss devant Jak
       (online-events-test! arg)
       )
      ((= arg 73)
       ;; banc de test : menu SELECT sur l'onglet donne par la commande suivante
       (set! (-> w tab-page) OW_PAGE_SHOP)
       (if (not (-> w tab-open)) (ow-tab-open!))
       (set! (-> w tab-page) OW_PAGE_SHOP)
       )
      ((= arg 74)
       (set! (-> w tab-page) OW_PAGE_ADMIN)
       (if (not (-> w tab-open)) (ow-tab-open!))
       (set! (-> w tab-page) OW_PAGE_ADMIN)
       )
      ((= arg 75)
       ;; monter sur un lezard (Spargus)
       (if *target*
           (send-event *target* 'change-mode 'flut #f)
           )
       )
      ((= arg 76)
       (if *target*
           (send-event *target* 'end-mode 'flut)
           )
       )
      ((= arg 79)
       ;; banc de test : ouvre le menu Start (comme la touche Start)
       (if (not *progress-process*)
           (activate-progress *dproc* 'main)
           )
       )
      ((= arg 85)
       ;; banc de test : menu Start directement sur la page EN LIGNE
       (if (not *progress-process*)
           (activate-progress *dproc* 'online)
           )
       )
      ((= arg 81)
       ;; banc de test : menu Start directement sur la page OPTIONS (page classique)
       (if (not *progress-process*)
           (activate-progress *dproc* 'options)
           )
       )
      ((= arg 82)
       (if (not *progress-process*)
           (activate-progress *dproc* 'secret)
           )
       )
      ((= arg 80)
       (if *progress-process*
           (hide-progress-screen)
           )
       )
      ((= arg 84)
       ;; banc de test : se placer a 2,5 m du premier autre joueur (meme zone)
       (let ((done #f))
         (dotimes (i ONLINE_MAX_PUPPETS)
           (let ((rs (-> *online-shm* remote i)))
             (when (and (not done) (nonzero? (-> rs active)) *target*)
               (let ((pos (ow-puppet-pos (-> rs player-id))))
                 (when pos
                   (let ((dst (new 'stack-no-clear 'vector)))
                     (vector-copy! dst pos)
                     (+! (-> dst x) (meters 2.5))
                     (+! (-> dst y) (meters 1.0))
                     (move-to-point! (-> *target* control) dst)
                     (set! done #t)
                     )
                   )
                 )
               )
             )
           )
         )
       )
      ((= arg 83)
       ;; banc de test : TRIANGLE (monter / descendre du vehicule d'un autre joueur)
       (set! *ow-ride-press* #t)
       )
      ((= arg 85)
       ;; banc de test : menu Start directement sur la CARTE
       (if (not *progress-process*)
           (activate-progress *dproc* 'bigmap)
           )
       )
      ((= arg 86)
       ;; banc de test : eco bleu (comme l'achat de la boutique)
       (when *target*
         (send-event *target* 'get-pickup (pickup-type eco-blue) 100.0)
         (set! (-> *target* fact eco-timeout) (the-as seconds (seconds 180)))
         )
       )
      ((= arg 87)
       ;; banc de test : 5 vies au sol
       (ow-drop-pickups! (pickup-type health) 5 1.0)
       )
      ((= arg 89)
       ;; banc de test : monde remis a neuf
       (ow-reset-actors!)
       )
      ((or (= arg 90) (= arg 91) (= arg 92))
       ;; banc de test : se placer a 12 m (90), 30 m (91) ou 60 m (92) du boss, face a lui
       (let ((pos (oe-boss-pos (new 'stack-no-clear 'vector)))
             (bp (new 'stack-no-clear 'vector))
             (d (case arg ((91) (meters 30.0)) ((92) (meters 60.0)) (else (meters 12.0))))
             )
         (when (and *target* (!= (-> *online-ext* ev-kind) 0))
           (vector-copy! bp pos)
           (+! (-> pos x) d)
           (+! (-> pos y) (meters 2.0))
           (move-to-point! (-> *target* control) pos)
           (let ((dir (vector-! (new 'stack-no-clear 'vector) bp pos))
                 (tc (-> *target* control))
                 )
             (set! (-> dir y) 0.0)
             (vector-normalize! dir 1.0)
             (forward-up-nopitch->quaternion (-> tc dir-targ) dir *up-vector*)
             (quaternion-copy! (-> tc quat-for-control) (-> tc dir-targ))
             (quaternion-copy! (-> tc quat) (-> tc dir-targ))
             )
           (send-event *camera* 'teleport)
           )
         )
       )
      ((= arg 480)
       ;; banc de test : essayer de tricher (secret invincible + mode debug)
       (set! (-> *game-info* secrets) (the-as game-secrets (logior (the-as int (-> *game-info* secrets)) (ash 1 17))))
       (set! *cheat-mode* 'debug)
       )
      ((= arg 482)
       ;; banc de test : je tire (vers l'avant)
       (when *target*
         (online-push-out-event! ONLINE_EVENT_SHOT (the-as uint 0) 0.0 1
                                 (vector-z-quaternion! (new-stack-vector0) (-> *target* control quat)))
         )
       )
      ((= arg 483)
       ;; banc de test coop : je detruis la caisse ou l'ennemi (de la carte) le plus proche
       (set! *ow-test-best* (the-as process #f))
       (set! *ow-test-bd* (meters 120.0))
       (when *target*
         (iterate-process-tree *entity-pool* ow-test-pick! *null-kernel-context*)
         )
       (let ((best *ow-test-best*))
         (when best
           (format 0 "[jak3-online] test coop : ~A aid ~D~%" (-> best type) (-> best entity aid))
           (send-event best 'attack #f (static-attack-info :mask (vehicle-impulse-factor) ((id (new-attack-id)) (damage 100.0) (vehicle-damage-factor 1.0) (vehicle-impulse-factor 1.0) (mode 'generic))))
           )
         )
       )
      ((= arg 484)
       ;; banc de test coop : je valide la premiere etape de mission pas encore validee
       (let ((l (-> *game-info* sub-task-list)))
         (let ((k 1))
           (while (and (< k (-> l length)) (task-node-closed? (the-as game-task-node k)))
             (+! k 1)
             )
           (when (< k (-> l length))
             (format 0 "[jak3-online] test coop : etape ~D~%" k)
             (task-node-close! (the-as game-task-node k) 'event)
             )
           )
         )
       )
      ((= arg 481)
       ;; banc de test : triche createur (invincible) depuis ADMIN
       (set! *ow-admin-cheats* (logxor *ow-admin-cheats* 1))
       )
      ((and (>= arg 590) (< arg 601))
       ;; banc de test : jouer le personnage (arg - 590)
       (ow-perso-choose! (- arg 590))
       )
      ((and (>= arg 460) (< arg 470))
       ;; banc de test : personnage
       (ow-perso-choose! (- arg 460))
       )
      ((and (>= arg 470) (< arg 474))
       ;; banc de test : se placer a 4 m du premier autre joueur, face a lui (470 devant, 471 cote, 472 derriere)
       (let ((done #f))
         (dotimes (i ONLINE_MAX_PUPPETS)
           (let ((p (online-puppet-proc i)))
             (when (and (not done) p *target* (-> p placed))
               (let ((pp (-> p root trans))
                     (pos (new 'stack-no-clear 'vector))
                     (fw (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> p root quat)))
                     (tc (-> *target* control))
                     )
                 (set! (-> fw y) 0.0)
                 (vector-normalize! fw 1.0)
                 (case arg
                   ((471) (set-vector! fw (-> fw z) 0.0 (- (-> fw x)) 0.0))
                   ((472) (vector-float*! fw fw -1.0))
                   )
                 (vector+float*! pos pp fw (meters 4.0))
                 (+! (-> pos y) (meters 0.5))
                 (move-to-point! tc pos)
                 (let ((dir (vector-! (new 'stack-no-clear 'vector) pp pos)))
                   (set! (-> dir y) 0.0)
                   (vector-normalize! dir 1.0)
                   (forward-up-nopitch->quaternion (-> tc dir-targ) dir *up-vector*)
                   (quaternion-copy! (-> tc quat-for-control) (-> tc dir-targ))
                   (quaternion-copy! (-> tc quat) (-> tc dir-targ))
                   )
                 (send-event *camera* 'teleport)
                 (set! done #t)
                 )
               )
             )
           )
         )
       )
      ((= arg 581)
       ;; banc de test : premiere personne (pad 37 : 1 demandee, 2 camera posee)
       (set! *online-fp* (not *online-fp*))
       )
      ((= arg 582)
       (set! (-> *online-shm* local pad 37) (the-as uint (logior (if *online-fp* 1 0) (if *ow-fp-on* 2 0))))
       )
      ((or (= arg 579) (= arg 580))
       ;; banc de test : la mer et le requin du village
       (ow-mer-test! arg)
       )
      ((and (>= arg 400) (< arg 450))
       ;; banc de test : cartes du mod
       (online-maps-test! arg)
       )
      ((= arg 78)
       (set! *ow-font-test* (not *ow-font-test*))
       )
      ((and (>= arg 300) (< arg 325))
       ;; banc de test : langue du jeu
       (set! (-> *pc-settings* text-language) (the-as pc-language (- arg 300)))
       )
      ((and (>= arg 330) (< arg 355))
       ;; premier lancement : langue de Windows (textes et sous-titres), sauvee dans les reglages
       (set! (-> *pc-settings* text-language) (the-as pc-language (- arg 330)))
       (set! (-> *pc-settings* subtitle-language) (the-as pc-language (- arg 330)))
       (set! (-> *setting-control* user-default subtitle-language) (the-as language-enum (- arg 330)))
       (commit-to-file *pc-settings*)
       )
      ((= arg 77)
       ;; banc de test : fonce avec mon vehicule sur le vehicule d'un autre joueur
       (let ((veh (ow-my-vehicle))
             (t *target*)
             (best -1)
             (bd (meters 60.0))
             )
         (when (and veh t)
           (dotimes (i ONLINE_MAX_PUPPETS)
             (let ((rs (-> *online-shm* remote i)))
               (when (and (nonzero? (-> rs active)) (logtest? (-> rs flags) ONLINE_FLAG_VEHICLE))
                 (let ((d (vector-vector-xz-distance (-> t control trans) (-> rs pos))))
                   (when (< d bd)
                     (set! bd d)
                     (set! best i)
                     )
                   )
                 )
               )
             )
           (when (>= best 0)
             (let ((dv (vector-! (new 'stack-no-clear 'vector) (-> *online-shm* remote best pos) (-> t control trans))))
               (set! (-> dv y) 0.0)
               (vector-normalize! dv (meters 20.0))
               (set! (-> dv y) (meters 1.0))
               (ow-vehicle-kick! veh dv)
               )
             )
           )
         )
       )
      ((= arg 71)
       ;; en plein desert (loin du garage)
       (let ((cp (get-continue-by-name *game-info* "desert-bbush-desd")))
         (if (and *target* cp)
             (start 'play cp)
             )
         )
       )
      ((= arg 69)
       ;; course vers les portes de Spargus
       (let ((cp (get-continue-by-name *game-info* (-> *ow-race-cps* 6))))
         (if cp
             (online-push-out-event! ONLINE_EVENT_RACE (the-as uint 0) 0.0 6 (-> cp trans))
             )
         )
       )
      ((= arg 569)
       ;; banc de test : mon heure passe a 20 h (l'horloge du monde doit la donner aux autres)
       (if *time-of-day*
           (send-event (ppointer->process *time-of-day*) 'change 'hour 20)
           )
       )
      ((= arg 568)
       ;; banc de test : appeler le Hellcat (objet 104)
       (ow-spawn-vehicle! 104)
       )
      ((or (= arg 571) (= arg 575))
       ;; banc de test : 571 = a 3,5 m AU-DESSUS du premier autre joueur (sur le toit de son vehicule),
       ;; 575 = a 14 m devant lui (face a lui) pour lui foncer dedans
       (let ((done #f))
         (dotimes (i ONLINE_MAX_PUPPETS)
           (let ((rs (-> *online-shm* remote i)))
             (when (and (not done) (nonzero? (-> rs active)) *target*)
               (let ((pos (ow-puppet-pos (-> rs player-id))))
                 (when pos
                   (let ((dst (new 'stack-no-clear 'vector)))
                     (vector-copy! dst pos)
                     (cond
                       ((= arg 571)
                        (+! (-> dst y) (meters 3.5))
                        )
                       (else
                         ;; 14 m derriere lui (d'ou il vient : le chemin est libre), tourne vers lui
                         (let ((fwd (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> rs quat))))
                           (set! (-> fwd y) 0.0)
                           (vector-normalize! fwd (meters -14.0))
                           (vector+! dst dst fwd)
                           )
                         (+! (-> dst y) (meters 1.0))
                         (quaternion-copy! (-> *target* control quat) (-> rs quat))
                         (quaternion-copy! (-> *target* control quat-for-control) (-> *target* control quat))
                         (quaternion-copy! (-> *target* control dir-targ) (-> *target* control quat))
                         )
                       )
                     (move-to-point! (-> *target* control) dst)
                     (set! done #t)
                     )
                   )
                 )
               )
             )
           )
         )
       )
      ((= arg 572)
       ;; banc de test : mon vehicule avance tout droit (12 m/s)
       (let ((veh (ow-my-vehicle)))
         (when veh
           (let ((dv (vector-float*! (new 'stack-no-clear 'vector) (-> veh rbody matrix fvec) (meters 6.0))))
             (set! (-> dv y) 0.0)
             (ow-vehicle-kick! veh dv)
             )
           )
         )
       )
      ((= arg 576)
       ;; banc de test : mon vehicule fonce sur le premier autre joueur (20 m/s)
       (let ((veh (ow-my-vehicle))
             (done #f)
             )
         (when veh
           (dotimes (i ONLINE_MAX_PUPPETS)
             (let ((rs (-> *online-shm* remote i)))
               (when (and (not done) (nonzero? (-> rs active)))
                 (let ((pos (ow-puppet-pos (-> rs player-id))))
                   (when pos
                     (let ((dv (vector-! (new 'stack-no-clear 'vector) pos (-> veh root trans))))
                       (set! (-> dv y) 0.0)
                       (vector-normalize! dv (meters 14.0))
                       (ow-vehicle-kick! veh dv)
                       (set! done #t)
                       )
                     )
                   )
                 )
               )
             )
           )
         )
       )
      ((= arg 577)
       ;; banc de test : pad 34 = 1 je pilote un Hellcat (h-warf), 2 je suis debout sur un vehicule
       ;; d'un autre joueur (sa vraie collision me porte)
       (let ((t *target*)
             (r 0)
             )
         (when t
           (let ((veh (ow-my-vehicle)))
             (if (and veh (= (-> veh type) h-warf))
                 (set! r (logior r 1))
                 )
             ;; diagnostic : os des maillages de collision de mon vehicule (os du prim / joint du maillage)
             (when veh
               (let* ((cs (the-as collide-shape (-> veh root)))
                      (pr (-> cs root-prim))
                      )
                 (dotimes (q (the-as int (-> cs total-prims)))
                   (when (= (-> pr prim-core prim-type) 1)
                     (let ((mp (the-as collide-shape-prim-mesh pr)))
                       (format 0 "[jak3-online] mon vehicule ~A : prim maillage os ~D, joint du maillage ~D, os d'origine ~D~%"
                               (-> veh type) (-> mp transform-index) (if (-> mp mesh) (-> mp mesh joint-id) -1)
                               (-> veh draw origin-joint-index))
                       )
                     )
                   (set! pr (the-as collide-shape-prim (&+ pr 80)))
                   )
                 )
               )
             )
           (dotimes (i ONLINE_MAX_PUPPETS)
             (let ((p (online-puppet-proc i)))
               (when p
                 (dotimes (s ONLINE_PART_SLOTS)
                   (let ((part (the-as online-part (handle->process (-> p parts s)))))
                     (when (and part (-> part coll) (-> part coll-on))
                       (let ((cs (the-as collide-shape (-> part root))))
                         (if (> (-> cs num-riders) 0)
                             (set! r (logior r 2))
                             )
                         )
                       )
                     )
                   )
                 )
               )
             )
           )
         (set! (-> *online-shm* local pad 34) (the-as uint r))
         )
       )
      ((= arg 566)
       ;; banc de test : la mission 114 (anneaux du desert 1) est reussie
       (logior! (-> *game-info* task-perm-list data 114 status) (entity-perm-status complete))
       )
      ((= arg 567)
       ;; banc de test : pad 30 = 1 planche possedee, 2 vol de Light Jak, 4 sur un parcours
       (set! (-> *online-shm* local pad 30)
             (the-as uint (logior (if (logtest? (-> *game-info* features) (game-feature board)) 1 0)
                                  (if (logtest? (-> *game-info* features) (game-feature lightjak-swoop)) 2 0)
                                  (if (ow-parkour-now?) 4 0)
                                  )
                     )
             )
       )
      ((and (>= arg 486) (< arg 498))
       ;; banc de test : je tire avec l'arme 26 + n (les autres voient le vrai tir de cette arme)
       (when *target*
         (online-push-out-event! ONLINE_EVENT_SHOT (the-as uint 0) 0.0 (+ arg -460)
                                 (vector-z-quaternion! (new-stack-vector0) (-> *target* control quat)))
         )
       )
      ((and (>= arg 500) (< arg 532))
       ;; banc de test : achat de l'objet 96 + (arg - 500)
       (online-push-out-event! ONLINE_EVENT_BUY (the-as uint 0) 0.0 (+ arg -404) (the-as vector #f))
       )
      ((and (>= arg 660) (< arg 664))
       ;; banc de test : meteo 0..3 (commande de l'admin)
       (ow-admin! (the-as uint 0) ONLINE_CMD_WEATHER (the float (+ arg -660)))
       )
      ((and (>= arg 750) (< arg (+ 750 OW_DIALOG_COUNT)))
       ;; banc de test : replique jouee ici directement (pour verifier chaque nom)
       (ow-dialog-play! (+ arg -750))
       )
      ((= arg 740)
       ;; banc de test ACCESSOIRES : pad 36 = mes accessoires affiches, pad 37 = octet envoye,
       ;; pad 38 = accessoires affiches sur les autres joueurs
       (let ((mine 0) (theirs 0))
         (dotimes (k 3)
           (let ((p (the-as process-drawable (handle->process (-> *ow-acc-mine* h k)))))
             (if (and p (not (logtest? (-> p draw status) (draw-control-status no-draw))))
                 (+! mine 1)
                 )
             )
           )
         (dotimes (i ONLINE_MAX_PUPPETS)
           (let ((pp (online-puppet-proc i)))
             (when pp
               (dotimes (k 3)
                 (let ((p (the-as process-drawable (handle->process (-> pp accs k)))))
                   (if (and p (not (logtest? (-> p draw status) (draw-control-status no-draw))))
                       (+! theirs 1)
                       )
                   )
                 )
               )
             )
           )
         (set! (-> *online-shm* local pad 36) (the-as uint mine))
         (set! (-> *online-shm* local pad 37) (the-as uint (ow-acc-packed)))
         (set! (-> *online-shm* local pad 38) (the-as uint theirs))
         ;; pad 39 = corps de l'avatar du 1er joueur (geo + 1 ; 0 = aucun)
         (let ((pp (online-puppet-proc 0)))
           (dotimes (i ONLINE_MAX_PUPPETS)
             (if (not pp) (set! pp (online-puppet-proc i)))
             )
           (set! (-> *online-shm* local pad 39) (the-as uint (if pp (+ (-> pp geo) 1) 0)))
           )
         )
       )
      ((= arg 741)
       ;; banc de test : camera de face (pour voir les accessoires)
       (ow-acc-cam-test! #f)
       )
      ((= arg 742)
       (ow-acc-cam-test! #t)
       )
      ((= arg 746)
       ;; banc de test : menu SELECT, BOUTIQUE, categorie STYLE ouverte (accessoires)
       (set! (-> *ow-cat-open* (min 7 OW_PAGE_SHOP)) 12)
       (set! *ow-cat-focus* 12)
       (set! (-> *online-world* tab-page) OW_PAGE_SHOP)
       (if (not (-> *online-world* tab-open)) (ow-tab-open!))
       (set! (-> *online-world* tab-page) OW_PAGE_SHOP)
       (set! (-> *ow-cat-open* (min 7 OW_PAGE_SHOP)) 12)
       (set! *ow-cat-focus* 12)
       )
      ((= arg 747)
       ;; banc de test : curseur du menu une ligne plus bas
       (set! (-> *online-world* tab-row) (ow-tab-step (-> *online-world* tab-row) 1))
       )
      ((= arg 745)
       ;; banc de test : noms des joueurs caches (pour voir les chapeaux)
       (set! (-> *online-world* show-names) #f)
       )
      ((= arg 744)
       ;; banc de test : mon Jak invisible chez moi (la camera voit ce qu'il y a devant lui)
       (if *target*
           (logior! (-> *target* draw status) (draw-control-status no-draw))
           )
       )
      ((= arg 743)
       ;; banc de test : je me place a 3,5 m DEVANT l'autre joueur, tourne vers lui
       (let ((pp (online-puppet-proc 0)))
         (dotimes (i ONLINE_MAX_PUPPETS)
           (if (not pp) (set! pp (online-puppet-proc i)))
           )
         (when (and pp *target*)
           (let ((fw (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> pp root quat)))
                 (p (new 'stack-no-clear 'vector))
                 (q (new 'stack-no-clear 'quaternion))
                 )
             (set! (-> fw y) 0.0)
             (vector-normalize! fw (meters -3.2))
             (vector+! p (-> pp root trans) fw)
             (move-to-point! (-> *target* control) p)
             (vector-negate! fw fw)
             (vector-normalize! fw 1.0)
             (forward-up->quaternion q fw *up-vector*)
             (set-quaternion! (-> *target* control) q)
             (quaternion-copy! (-> *target* control dir-targ) q)
             )
           )
         )
       )
      ((= arg 709)
       ;; banc de test : pad 36 = etat de la derniere replique (0 inconnu, 1 attente, 2 prete, 3 joue, 5 stop)
       (set! (-> *online-shm* local pad 36) (the-as uint (get-status *gui-control* *ow-dialog-last*)))
       )
      ((and (>= arg 710) (< arg (+ 710 OW_DIALOG_COUNT)))
       ;; banc de test : dialogue (commande de l'admin)
       (ow-admin! (the-as uint 0) ONLINE_CMD_DIALOG (the float (+ arg -710)))
       )
      ((= arg 669)
       ;; banc de test : pad 40 = meteo affichee (+ 16 si l'intensite depasse la moitie)
       (set! (-> *online-shm* local pad 36) (the-as uint (logior (the-as int (-> *ow-meteo* kind)) (if (< 0.5 (-> *ow-meteo* f)) 16 0))))
       )
      ((and (>= arg 650) (< arg 654))
       ;; banc de test : collisions entre joueurs (online.gc)
       (online-coll-test! arg)
       )
      ((and (>= arg 610) (< arg 618))
       ;; banc de test : aller dans ma maison k (0..7)
       (ow-house-go! (+ arg -610) (-> *online-shm* my-id))
       )
      ((and (>= arg 690) (< arg 698))
       (ow-maisons-test! arg)
       )
      ((and (>= arg 630) (< arg 646))
       ;; banc de test : boites aux lettres, eau, bateau (online-maps.gc)
       (ow-maisons-test! arg)
       )
      ((and (>= arg 540) (< arg 543))
       ;; banc de test : aller dans ma maison
       (ow-house-go! (+ arg -540) (-> *online-shm* my-id))
       )
      ((and (>= arg 545) (< arg 548))
       ;; banc de test : inviter le premier autre joueur dans ma maison
       (let ((done #f))
         (dotimes (i ONLINE_MAX_PUPPETS)
           (let ((rs (-> *online-shm* remote i)))
             (when (and (not done) (nonzero? (-> rs active)))
               (set! done #t)
               (online-push-out-event! ONLINE_EVENT_INVITE (-> rs player-id) 0.0 (+ arg -545) (the-as vector #f))
               )
             )
           )
         )
       )
      ((= arg 548)
       ;; banc de test : accepter l'invitation
       (let ((from *ow-invite-from*))
         (set! *ow-invite-from* (the-as uint 0))
         (if (nonzero? from)
             (ow-house-go! *ow-invite-house* from)
             )
         )
       )
      ((and (>= arg 550) (< arg 555))
       ;; banc de test : style active / coupe
       (set! *ow-cosm-off* (logxor *ow-cosm-off* (ash 1 (+ arg -550))))
       )
      ((= arg 560)
       ;; banc de test : lignes de la page BOUTIQUE (nombre ; personnages, armes, dark/light, maisons, style)
       (let ((w *online-world*)
             (flags 0)
             )
         (set! (-> w tab-page) OW_PAGE_SHOP)
         (set! (-> w tab-sub) #f)
         (set! *ow-cat-all* #t)
         (ow-tab-build!)
         (set! *ow-cat-all* #f)
         (dotimes (r (-> w row-count))
           (let ((ac (-> w row-action r))
                 (ar (-> w row-arg r))
                 )
             ;; 1 = PAS de personnages dans la boutique (ils sont dans l'onglet PERSOS)
             (if (= ac OW_TA_PERSO) (set! flags (logior flags 32)))
             (if (and (= ac OW_TA_BUY) (<= ar 11)) (set! flags (logior flags 2)))
             (if (and (= ac OW_TA_BUY) (>= ar 28) (<= ar 38)) (set! flags (logior flags 4)))
             (if (or (= ac OW_TA_HOUSE_GO) (and (= ac OW_TA_BUY) (or (and (>= ar 96) (<= ar 98)) (and (>= ar 109) (<= ar 113))))) (set! flags (logior flags 8)))
             (if (or (= ac OW_TA_COSM) (and (= ac OW_TA_BUY) (>= ar 99) (<= ar 103))) (set! flags (logior flags 16)))
             )
           )
         (set! (-> *online-shm* local pad 28) (the-as uint (min 255 (-> w row-count))))
         (set! (-> *online-shm* local pad 29) (the-as uint (logxor flags 1)))
         )
       )
      ((and (>= arg 100) (< arg 196))
       ;; achat de l'objet (arg - 100) par le chemin normal (verifie par Jak3Online.exe ; a distance : +50 %)
       (online-push-out-event! ONLINE_EVENT_BUY (the-as uint (if (ow-remote-buy? (+ arg -100)) 1 0)) 0.0 (+ arg -100) (the-as vector #f))
       )
      ((and (>= arg 200) (< arg 296))
       ;; appeler le vehicule (objet arg - 200)
       (ow-spawn-vehicle! (+ arg -200))
       )
      )
    )
  (none)
  )
