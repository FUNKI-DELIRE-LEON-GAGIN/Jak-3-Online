;;-*-Lisp-*-
(in-package goal)

;; name: online.gc
;; dgos: GAME
;;
;; JAK 3 EN LIGNE (jusqu'a 100 joueurs par session)
;;
;; - chaque joueur garde SA propre partie / SA propre progression (missions, sauvegarde)
;; - les autres joueurs de la session apparaissent dans le monde (avatars animes + pseudo)
;; - PvP : coups de poing / pied, dark jak, armes et projectiles touchent les autres joueurs
;; - menu Start : SELECT sur l'anneau de pause, ou Options > En ligne
;;     creer une session publique / privee, rejoindre une session publique,
;;     rejoindre avec un code, liste des joueurs, PvP, quitter
;;
;; Le reseau est gere par data/online/Jak3Online.exe (voir LISEZ-MOI.txt).

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; etat global
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defmacro online-now ()
  "horloge reelle (continue meme en pause), 300 unites par seconde"
  `(-> *display* real-clock frame-counter))

(defmacro online-fr (fr en)
  "texte dans la langue du jeu : francais, anglais, ou traduction (online-lang.gc)"
  `(online-tr ,en ,fr))

(deftype online-runtime (basic)
  ((last-beat        uint32)
   (beat-time        time-frame)
   (companion-alive  symbol)
   (puppets          handle     16)
   (hit-cooldown     time-frame 16)
   (names            string     16)
   (tmp-str          string)
   (tmp-str2         string)
   (tmp-level        string)
   (feed-str         string)
   (last-anim        basic)
   (last-anim-idx    int32)
   (last-hit-by      uint32)
   (last-hit-time    time-frame)
   (was-dead         symbol)
   (kills            uint32)
   (deaths           uint32)
   (feed-seen        uint32)
   (feed-time        time-frame 8)
   (spawn-time       time-frame)
   (in-session-prev  symbol)
   (bigmap-ok        symbol)
   (live-input       symbol)
   (live-pad         cpad-info)
   (test-seen        uint32)
   (beat-time-log    time-frame)
   (found-level      level)
   (veh-hit-by       uint32)      ;; dernier joueur qui a touche mon vehicule
   (veh-hit-time     time-frame)
   (veh-watch        handle)      ;; mon vehicule (pour savoir s'il est detruit)
   (veh-dead-sent    symbol)
   )
  )

;; file de dessin du texte et des cadres (les menus passent apres la mini-carte)
(define *online-draw-bucket* (bucket-id hud-draw-hud-alpha))

(define *online-shm* (new 'global 'online-shm))
(define *online* (new 'global 'online-runtime))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; pont fichiers avec Jak3Online.exe
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(deftype online-io (basic)
  ((in-fs      file-stream)
   (out-fs     file-stream)
   (in-ok      symbol)
   (out-ok     symbol)
   (next-try   time-frame)
   (rx-seq     uint32)
   (tx-seq     uint32)
   (tx-time    time-frame)
   (tx-str     string)
   )
  )

;; plus de 64 Ko : la taille d'un type GOAL tient sur 16 bits, on alloue donc a la main
(define *online-rx* (the-as online-rx (logand -16 (+ 15 (the-as int (malloc 'global (+ ONLINE_RX_SIZE 16)))))))
(define *online-io* (new 'global 'online-io))
;; monde en ligne : profil, chat, menu TAB, joueurs (copie de la zone EXT de game-in.bin)
(define *online-ext* (new 'global 'online-ext))
(mem-set32! (the-as pointer *online-ext*) (/ ONLINE_EXT_SIZE 4) 0)
(define *online-block-live* #f)
(define-extern online-world-update (function symbol none))
(define-extern online-world-draw (function symbol none))
(define-extern online-world-in-event! (function online-event none))
(define-extern online-world-blocks-input? (function symbol))
(define-extern online-world-names-on? (function symbol))
(define-extern online-world-active? (function symbol))
(define-extern online-world-test! (function int none))
(define-extern online-world-vehicle-lift! (function vector symbol))
(define-extern online-my-vehicle (function process-drawable))
(define-extern ow-rank-color (function int font-color))
(define *online-pose-tx* (new 'global 'online-pose-tx))
;; poses des joueurs distants : 16 blocs de 6192 octets, adresses calculees a la main
;; seq u32 @0, joueur u32 @4, long. actuelle @8, long. precedente @12, heure actuelle @16,
;; heure precedente @24, intervalle f32 @32, pose actuelle @48, pose precedente @3120
(define *online-pose-mem* (the-as pointer (logand -16 (+ 15 (the-as int (malloc 'global (+ (* 16 6192) 16)))))))
(mem-set32! *online-pose-mem* (/ (* 16 6192) 4) 0)

(define-extern online-capture-pose! (function none))
(define-extern online-poses-receive! (function none))
(define-extern online-ext-receive! (function none))

;; acces aux octets des poses
(defmacro online-get-u8 (p o) `(the int (-> (the-as (pointer uint8) (&+ ,p ,o)) 0)))
(defmacro online-get-u16 (p o) `(the int (-> (the-as (pointer uint16) (&+ ,p ,o)) 0)))
(defmacro online-get-s16 (p o) `(the int (-> (the-as (pointer int16) (&+ ,p ,o)) 0)))
(defmacro online-get-u32 (p o) `(-> (the-as (pointer uint32) (&+ ,p ,o)) 0))
(defmacro online-get-f32 (p o) `(-> (the-as (pointer float) (&+ ,p ,o)) 0))
(defmacro online-set-u8! (p o v) `(set! (-> (the-as (pointer uint8) (&+ ,p ,o)) 0) (the-as uint ,v)))
(defmacro online-set-u16! (p o v) `(set! (-> (the-as (pointer uint16) (&+ ,p ,o)) 0) (the-as uint ,v)))
(defmacro online-set-s16! (p o v) `(set! (-> (the-as (pointer int16) (&+ ,p ,o)) 0) ,v))
(defmacro online-set-u32! (p o v) `(set! (-> (the-as (pointer uint32) (&+ ,p ,o)) 0) (the-as uint ,v)))
(defmacro online-set-f32! (p o v) `(set! (-> (the-as (pointer float) (&+ ,p ,o)) 0) ,v))
(defmacro online-get-s64 (p o) `(-> (the-as (pointer int64) (&+ ,p ,o)) 0))
(defmacro online-set-s64! (p o v) `(set! (-> (the-as (pointer int64) (&+ ,p ,o)) 0) ,v))
(defmacro online-ps (i) `(&+ *online-pose-mem* (* ,i 6192)))

;; saisie au clavier : le jeu coupe son clavier (lettres = touches de la manette)
;; pendant que Jak3Online.exe lit les touches tapees
(define *online-kb-disabled* #f)
(define *online-kb-prev* #t)
(define-extern online-kb-end! (function none))

(define *online-code-chars* "ABCDEFGHJKLMNPQRSTUVWXYZ23456789")

(defun online-init! ()
  (let ((shm *online-shm*))
    (mem-set32! (the-as pointer shm) (/ (size-of online-shm) 4) 0)
    ;; signature "J3ONLINE_BRIDGE1"
    (set! (-> shm magic 0) #x4e4f334a)
    (set! (-> shm magic 1) #x454e494c)
    (set! (-> shm magic 2) #x4952425f)
    (set! (-> shm magic 3) #x31454744)
    (set! (-> shm version) 1)
    (set! (-> shm self-addr) (the-as uint shm))
    )
  (let ((rt *online*))
    (dotimes (i ONLINE_MAX_PUPPETS)
      (set! (-> rt puppets i) (the-as handle #f))
      (set! (-> rt hit-cooldown i) 0)
      (set! (-> rt names i) (new 'global 'string 32 (the-as string #f)))
      )
    (dotimes (i ONLINE_FEED_COUNT)
      (set! (-> rt feed-time i) 0)
      )
    (set! (-> rt tmp-str) (new 'global 'string 256 (the-as string #f)))
    (set! (-> rt tmp-str2) (new 'global 'string 256 (the-as string #f)))
    (set! (-> rt tmp-level) (new 'global 'string 40 (the-as string #f)))
    (set! (-> rt feed-str) (new 'global 'string 80 (the-as string #f)))
    (set! (-> rt last-beat) 0)
    (set! (-> rt beat-time) 0)
    (set! (-> rt companion-alive) #f)
    (set! (-> rt last-anim) #f)
    (set! (-> rt last-anim-idx) -1)
    (set! (-> rt last-hit-by) 0)
    (set! (-> rt last-hit-time) 0)
    (set! (-> rt was-dead) #f)
    (set! (-> rt kills) 0)
    (set! (-> rt deaths) 0)
    (set! (-> rt feed-seen) 0)
    (set! (-> rt spawn-time) 0)
    (set! (-> rt in-session-prev) #f)
    (set! (-> rt bigmap-ok) #f)
    (set! (-> rt live-input) #f)
    (set! (-> rt live-pad) #f)
    (set! (-> rt test-seen) (the-as uint 0))
    (set! (-> rt veh-hit-by) (the-as uint 0))
    (set! (-> rt veh-hit-time) 0)
    (set! (-> rt veh-watch) (the-as handle #f))
    (set! (-> rt veh-dead-sent) #f)
    )
  (none)
  )

(online-init!)

(let ((io *online-io*))
  (set! (-> io in-fs) #f)
  (set! (-> io out-fs) #f)
  (set! (-> io in-ok) #f)
  (set! (-> io out-ok) #f)
  (set! (-> io next-try) 0)
  (set! (-> io rx-seq) (the-as uint 0))
  (set! (-> io tx-seq) (the-as uint 0))
  (set! (-> io tx-time) 0)
  (set! (-> io tx-str) (new 'global 'string (+ ONLINE_TX_CHARS 16) (the-as string #f)))
  ;; tout en '0' : la partie non utilisee de la pose reste de l'hexadecimal valide
  (dotimes (i ONLINE_TX_CHARS)
    (set! (-> io tx-str data i) (the-as uint 48))
    )
  (set! (-> *online-pose-tx* len) (the-as uint 0))
  )

(defun online-fs-ok? ((fs file-stream))
  "le flux est-il vraiment ouvert ? (ecrire dans un flux rate fait planter le jeu)"
  (and fs
       (!= (-> fs file) #xffffffff)
       (zero? (logand (-> fs flags) 1))))

(defun online-bridge-open! ()
  "ouvre game-in.bin (cree par Jak3Online.exe) puis game-out.txt"
  (let ((io *online-io*)
        (now (-> *display* real-clock frame-counter))
        )
    (when (and (not (-> io in-ok)) (>= now (-> io next-try)))
      ;; en jeu on reessaie rarement (chaque essai rate ecrit une ligne dans le journal),
      ;; dans le menu Start on reessaie souvent
      (set! (-> io next-try) (+ now (if *progress-process* (seconds 2) (seconds 20))))
      (cond
        ((-> io in-fs)
         (file-stream-close (-> io in-fs))
         (file-stream-open (-> io in-fs) "online/bridge/game-in.bin" 'read)
         )
        (else
          (set! (-> io in-fs) (new 'global 'file-stream "online/bridge/game-in.bin" 'read))
          )
        )
      (set! (-> io in-ok) (the-as symbol (online-fs-ok? (-> io in-fs))))
      )
    (when (and (-> io in-ok) (not (-> io out-ok)))
      (cond
        ((-> io out-fs)
         (file-stream-close (-> io out-fs))
         (file-stream-open (-> io out-fs) "online/bridge/game-out.txt" 'write)
         )
        (else
          (set! (-> io out-fs) (new 'global 'file-stream "online/bridge/game-out.txt" 'write))
          )
        )
      (set! (-> io out-ok) (the-as symbol (online-fs-ok? (-> io out-fs))))
      (if (not (-> io out-ok))
          ;; impossible d'ecrire : on reessaiera plus tard
          (set! (-> io in-ok) #f)
          )
      )
    )
  (none)
  )

(defun online-copy-range! ((from int) (to int))
  (mem-copy! (&+ (the-as pointer *online-shm*) from) (&+ (the-as pointer *online-rx*) from) (- to from))
  (none)
  )

(defun online-bridge-read! ()
  "lit game-in.bin et recopie les champs ecrits par Jak3Online.exe"
  (let ((io *online-io*)
        (rx *online-rx*)
        )
    (when (-> io in-ok)
      (file-stream-seek (-> io in-fs) 0 0)
      ;; lecture en deux morceaux (moins de 64 Ko chacun) : image + poses, puis zone EXT
      (let ((n (file-stream-read (-> io in-fs) (the-as pointer rx) ONLINE_EXT_OFS)))
        (if (and (= n ONLINE_EXT_OFS) (online-fs-ok? (-> io in-fs)))
            (+! n (file-stream-read (-> io in-fs) (&+ (the-as pointer rx) ONLINE_EXT_OFS) ONLINE_EXT_SIZE))
            )
        (cond
          ((not (online-fs-ok? (-> io in-fs)))
           (set! (-> io in-ok) #f)
           )
          ((>= n ONLINE_RX_MIN)
           (let ((head (-> (the-as (pointer uint32) rx) 0))
                 (tail (-> (the-as (pointer uint32) (&+ (the-as pointer rx) ONLINE_SHM_SIZE)) 0))
                 )
             ;; fichier complet et coherent (pas lu pendant une ecriture) ?
             (when (and (= head tail) (nonzero? head) (!= head (-> io rx-seq)))
               (set! (-> io rx-seq) head)
               (online-copy-range! 28 68)     ;; battement, etat reseau, session
               (online-copy-range! 88 192)    ;; listes, statut, nom, messages
               (online-copy-range! 196 204)   ;; out-read, in-write
               (online-copy-range! 208 212)   ;; server-ok
               (online-copy-range! 896 1452)  ;; evenements entrants, clavier, sauvegarde, test
               (online-copy-range! 1536 ONLINE_SHM_SIZE) ;; avatars, sessions, joueurs, messages
               (when (= n ONLINE_RX_SIZE)
                 (online-poses-receive!)
                 (online-ext-receive!)
                 )
               )
             )
           )
          )
        )
      )
    )
  (none)
  )

(defun online-ext-receive! ()
  "copie la zone EXT (monde en ligne) si elle est complete"
  (let* ((src (&+ (the-as pointer *online-rx*) ONLINE_EXT_OFS))
         (head (-> (the-as (pointer uint32) src) 0))
         (tail (-> (the-as (pointer uint32) (&+ src ONLINE_EXT_TAIL)) 0))
         )
    (when (and (= head tail) (nonzero? head))
      (mem-copy! (the-as pointer *online-ext*) src ONLINE_EXT_SIZE)
      )
    )
  (none)
  )

(defun online-hex-put! ((str string) (pos int) (byte uint))
  (let ((hi (logand (shr byte 4) 15))
        (lo (logand byte 15))
        )
    (set! (-> str data pos) (if (< hi 10) (+ hi 48) (+ hi 87)))
    (set! (-> str data (+ pos 1)) (if (< lo 10) (+ lo 48) (+ lo 87)))
    )
  (none)
  )

(defun online-hex-u32! ((str string) (pos int) (v uint))
  (dotimes (i 4)
    (online-hex-put! str (+ pos (* i 2)) (logand (shr v (* i 8)) 255))
    )
  (none)
  )

(defun online-bridge-write! ()
  "ecrit game-out.txt : etat local, requetes du menu, coups portes"
  (let* ((io *online-io*)
         (now (-> *display* real-clock frame-counter))
         ;; 30 fois par seconde si le programme tourne, sinon 1 fois par seconde
         (period (if (-> *online* companion-alive) (seconds 0.033) (seconds 1)))
         )
    (when (and (-> io out-ok) (>= (- now (-> io tx-time)) period))
      (set! (-> io tx-time) now)
      (online-capture-pose!)
      (+! (-> io tx-seq) 1)
      (let ((str (-> io tx-str))
            (src (the-as (pointer uint8) *online-shm*))
            (pose (the-as (pointer uint8) *online-pose-tx*))
            (plen (+ 4 (the-as int (-> *online-pose-tx* len))))
            )
        (online-hex-u32! str 0 (-> io tx-seq))
        (dotimes (i ONLINE_TX_BYTES)
          (online-hex-put! str (+ 8 (* i 2)) (-> src i))
          )
        ;; pose du joueur local (seulement la partie utile, le reste ne change pas)
        (dotimes (i plen)
          (online-hex-put! str (+ 8 (* 2 ONLINE_TX_BYTES) (* i 2)) (-> pose i))
          )
        (online-hex-u32! str (+ 8 (* 2 (+ ONLINE_TX_BYTES ONLINE_TX_POSE_BYTES))) (-> io tx-seq))
        (set! (-> str data ONLINE_TX_CHARS) (the-as uint 0))
        (file-stream-seek (-> io out-fs) 0 0)
        (file-stream-write (-> io out-fs) (-> str data) (the-as uint ONLINE_TX_CHARS))
        ;; le seek vide le tampon : le programme voit les donnees tout de suite
        (file-stream-seek (-> io out-fs) 0 0)
        (if (not (online-fs-ok? (-> io out-fs)))
            (set! (-> io out-ok) #f)
            )
        )
      )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; petits utilitaires
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun online-chars->string ((dst string) (src (pointer uint8)) (max-len int))
  "copie un tableau de caracteres (termine par 0 ou de longueur max-len) dans une string"
  (let ((i 0)
        (limit (min max-len (+ (-> dst allocated-length) -1)))
        )
    (while (and (< i limit) (nonzero? (-> src i)))
      (set! (-> dst data i) (-> src i))
      (+! i 1)
      )
    (set! (-> dst data i) (the-as uint 0))
    )
  dst
  )

(defun online-string->chars ((dst (pointer uint8)) (src string) (max-len int))
  (let ((n (if src (length src) 0)))
    (dotimes (i max-len)
      (set! (-> dst i) (if (< i (min n (+ max-len -1))) (-> src data i) (the-as uint 0)))
      )
    )
  (none)
  )

(defun online-companion-alive? ()
  (-> *online* companion-alive))

(defun online-in-session? ()
  (and (-> *online* companion-alive)
       (= (-> *online-shm* net-state) ONLINE_NET_SESSION)))

(defun online-connected? ()
  (and (-> *online* companion-alive)
       (>= (-> *online-shm* net-state) ONLINE_NET_LOBBY)))

(defun online-pvp-allowed? ()
  (and (online-in-session?)
       (nonzero? (-> *online-shm* pvp-enabled))
       (not (logtest? (-> *online-ext* flags) ONLINE_XF_PVP_OFF))
       *target*
       (not (focus-test? *target* dead teleporting))))

(defun online-request! ((kind int) (arg int))
  "envoie une requete a Jak3Online.exe"
  (let ((shm *online-shm*))
    (set! (-> shm req-type) (the-as uint kind))
    (set! (-> shm req-arg) (the-as uint arg))
    (+! (-> shm req-seq) 1)
    )
  (none)
  )

(defun online-push-out-event! ((kind int) (pid uint) (damage float) (mode int) (dir vector))
  (let* ((shm *online-shm*)
         (ev (-> shm out-events (logand (-> shm out-write) 15)))
         )
    (set! (-> ev kind) (the-as uint kind))
    (set! (-> ev player-id) pid)
    (set! (-> ev damage) damage)
    (set! (-> ev mode) (the-as uint mode))
    (if dir
        (vector-copy! (-> ev dir) dir)
        (vector-reset! (-> ev dir))
        )
    (+! (-> shm out-write) 1)
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; securite des animations
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Une animation ne doit etre jouee sur un avatar que si elle est residente en
;; permanence (dans GAME). Les animations chargees dans les buffers externes de
;; Jak ou dans le tas d'un niveau peuvent disparaitre a tout moment.

(defun online-addr-in-heap? ((addr uint) (heap kheap))
  (and (nonzero? (-> heap base))
       (>= addr (the-as uint (-> heap base)))
       (< addr (the-as uint (-> heap top-base)))))

(defun online-addr-in-buffer? ((addr uint) (buf external-art-buffer))
  (and buf
       (nonzero? buf)
       (online-addr-in-heap? addr (-> buf heap))))

(defun online-anim-ok? ((a art-element))
  (and a
       (nonzero? a)
       (type? a art-joint-anim)
       (let ((addr (the-as uint a)))
         (and (not (online-addr-in-buffer? addr *target-geo-control*))
              (not (online-addr-in-buffer? addr *target-anim-control*))
              (let ((in-level #f))
                (dotimes (i (-> *level* length))
                  (if (online-addr-in-heap? addr (-> *level* level i heap))
                      (set! in-level #t)
                      )
                  )
                (not in-level)
                )
              )
         )
       )
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; avatar d'un joueur distant
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; index dans jakb-ag (voir engine/data/art-elts.gc)
(defconstant ONLINE_ANIM_STANCE 18) ;; jakb-stance-loop-ja
(defconstant ONLINE_ANIM_RUN 20)    ;; jakb-run-ja
(defconstant ONLINE_ANIM_WALK 25)   ;; jakb-walk-ja
(defconstant ONLINE_ANIM_JUMP 36)   ;; jakb-jump-ja

(deftype online-part (process-drawable)
  ((kind  int32)
   (seen  time-frame)
   )
  (:states
    online-part-idle
    )
  )

(deftype online-puppet (process-drawable)
  ((slot         int32)
   (seen-seq     uint32)
   (goal-pos     vector     :inline)
   (vel          vector     :inline)
   (goal-quat    quaternion :inline)
   (frame        float)
   (frame-rate   float)
   (last-idx     int32)
   (last-frame   float)
   (update-time  time-frame)
   (placed       symbol)
   (shown        symbol)
   (geo          int32)
   (perso        int32)        ;; personnage choisi par ce joueur (0 = Jak, voir online-world.gc)
   (pose-on      symbol)
   (last-health  float)
   (fx-time      time-frame)
   (fx-want      symbol)
   (dead-time    time-frame)   ;; il vient de mourir : animation de mort meme sans pose
   (was-dead     symbol)
   (death-fx     symbol)
   (parts        handle     11)
   (part-retry   time-frame 11)
   (obj-name     uint8      192)
   )
  (:states
    online-puppet-idle
    )
  )

(defun online-level-visible? ((chars (pointer uint8)))
  "le niveau du joueur distant est-il charge et actif chez moi ?"
  (let ((s (online-chars->string (-> *online* tmp-level) chars 16))
        (found #f)
        )
    (cond
      ((zero? (length s))
       #t
       )
      (else
        (dotimes (i (-> *level* length))
          (let ((lev (-> *level* level i)))
            (when (and (= (-> lev status) 'active)
                       (-> lev name)
                       (string= (symbol->string (-> lev name)) s)
                       )
              (set! found #t)
              )
            )
          )
        found
        )
      )
    )
  )

(defun online-puppet-pick-anim ((ag art-group) (rs online-remote-state))
  "choisit l'animation a jouer : celle du joueur distant si elle est sure, sinon une animation de base"
  (let ((idx (-> rs anim-idx))
        (result (the-as art-element #f))
        )
    (when (and (>= idx 0) (< idx (-> ag length)))
      (let ((a (-> ag data idx)))
        (if (online-anim-ok? a)
            (set! result a)
            )
        )
      )
    (when (not result)
      (let* ((speed (sqrtf (+ (* (-> rs vel x) (-> rs vel x)) (* (-> rs vel z) (-> rs vel z)))))
             (fallback (cond
                         ((not (logtest? (-> rs flags) ONLINE_FLAG_GROUND))
                          ONLINE_ANIM_JUMP
                          )
                         ((< (meters 5.0) speed)
                          ONLINE_ANIM_RUN
                          )
                         ((< (meters 0.8) speed)
                          ONLINE_ANIM_WALK
                          )
                         (else
                           ONLINE_ANIM_STANCE
                           )
                         )
                       )
             )
        (when (< fallback (-> ag length))
          (let ((a (-> ag data fallback)))
            (if (online-anim-ok? a)
                (set! result a)
                )
            )
          )
        (when (not result)
          (let ((a (-> ag data ONLINE_ANIM_STANCE)))
            (if (online-anim-ok? a)
                (set! result a)
                )
            )
          )
        )
      )
    result
    )
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; PERSONNAGES JOUABLES : le corps d'un autre personnage, recale sur le squelette de Jak (memes
;; 64 os, meme pose de repos : scratchpad perso/retarget.py). On remplace seulement le maillage
;; du dessin de Jak (ou de l'avatar) : toutes les animations de Jak restent. Art dans GAME.CGO,
;; maillage du rendu PC dans owcom.fr3 (demande par ow-fr3-update!).
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(def-actor ow-keira
  :bounds (0 1.5 0 3.2)
  :art (idle-ja)
  :idle idle-ja
  :texture-level 11
  )

(def-actor ow-jak2
  :bounds (0 1.5 0 3.2)
  :art (idle-ja)
  :idle idle-ja
  :texture-level 11
  )

(def-actor ow-jak1
  :bounds (0 1.5 0 3.2)
  :art (idle-ja)
  :idle idle-ja
  :texture-level 11
  )

(def-actor ow-jak4
  :bounds (0 1.5 0 3.2)
  :art (idle-ja)
  :idle idle-ja
  :texture-level 11
  )

(def-actor ow-tess
  :bounds (0 1.5 0 3.2)
  :art (idle-ja)
  :idle idle-ja
  :texture-level 11
  )

;; 0 Jak, 1 Keira, 2 Jak 2, 3 Jak 1, 4 Jak 4, 5 Tess (corps sur le squelette de Jak),
;; 6 Daxter (le vrai mode Daxter du jeu : indax)
(defconstant OW_PERSO_COUNT 7)
(defconstant OW_PERSO_DAXTER 6)
(define *ow-perso-cur* 0) ;; personnage pose sur MON Jak (envoye aux autres dans la pose)

(defun ow-perso-skel ((k int))
  (case k
    ((1) *ow-keira-sg*)
    ((2) *ow-jak2-sg*)
    ((3) *ow-jak1-sg*)
    ((4) *ow-jak4-sg*)
    ((5) *ow-tess-sg*)
    (else (the-as skeleton-group #f))
    )
  )

(defun ow-perso-geo ((k int))
  "maillage du personnage k (#f si pas charge)"
  (let ((sg (ow-perso-skel k))
        (result (the-as merc-ctrl #f))
        )
    (when sg
      (let ((ag (load-to-heap-by-name (-> *level* level-default art-group) (-> sg art-group-name) 'test global (-> sg version))))
        (when (and ag (nonzero? ag) (= (-> ag type) art-group) (< (-> sg mgeo 0) (-> ag length)))
          (let ((m (-> ag data (-> sg mgeo 0))))
            (if (and m (nonzero? m) (= (-> m type) merc-ctrl))
                (set! result (the-as merc-ctrl m))
                )
            )
          )
        )
      )
    result
    )
  )

(defun ow-perso-draw-level! ((dc draw-control) (on symbol))
  "files de dessin : un corps ajoute (owcom.fr3) fait planter le rendu PC dans celles du niveau
   par defaut (comme les vehicules) : on dessine dans celles du niveau ou est Jak"
  (cond
    (on
      (let ((lev (level-get-target-inside *level*)))
        (when (not (and lev (= (-> lev status) 'active) (< (-> lev index) 10)))
          (set! lev (the-as level #f))
          (dotimes (i 10)
            (let ((l (-> *level* level i)))
              (if (and (not lev) (= (-> l status) 'active))
                  (set! lev l)
                  )
              )
            )
          )
        (when lev
          (set! (-> dc level-index) (the-as uint (-> lev index)))
          (set! (-> dc default-texture-page) (the-as uint 0))
          )
        )
      )
    (else
      ;; corps de Jak : comme skel-jchar (texture-level 10, sort 1)
      (set! (-> dc level-index) (the-as uint (-> *level* level-default index)))
      (set! (-> dc default-texture-page) (the-as uint 1))
      )
    )
  (none)
  )

(defun ow-perso-lods! ((dc draw-control) (k int))
  "met le corps du personnage k sur ce dessin (squelette de Jak) ; #t si fait"
  (let ((geo (ow-perso-geo k)))
    (when geo
      (let ((lods (new 'stack-no-clear 'lod-set)))
        (set! (-> lods max-lod) 0)
        (set! (-> lods lod 0 geo) geo)
        (set! (-> lods lod 0 dist) (meters 999999))
        (ow-perso-draw-level! dc #t)
        ;; nombre d'os animes : il se lit sur le maillage. Le corps recale doit annoncer celui de
        ;; Jak (sinon le jeu calcule des os qui n'existent pas et plante)
        (let ((jm (-> dc mgeo)))
          (when (and jm (!= jm geo) (< (-> jm length) (-> geo length)))
            (set! (-> geo length) (-> jm length))
            )
          )
        (lods-assign! dc lods)
        (setup-masks dc 0 -1)
        )
      )
    (the-as symbol geo)
    )
  )

;; Le modele "skel-jchar" de GAME n'est qu'un morceau de secours : le vrai corps
;; de Jak est charge a part (*target-geo-control*). L'avatar utilise ce corps
;; (comme le fait le jeu pour le reflet de Jak) tant qu'il est charge et stable.
(defbehavior online-puppet-sync-geo! online-puppet ()
  (let ((want -1))
    ;; autre personnage choisi par ce joueur (squelette de Jak, meme pose)
    (when (and (> (-> self perso) 0) (< (-> self perso) OW_PERSO_COUNT) (ow-perso-geo (-> self perso)))
      (set! want (+ 100 (-> self perso)))
      (if (= want (-> self geo))
          (ow-perso-draw-level! (-> self draw) #t)
          )
      (when (!= want (-> self geo))
        (if (ow-perso-lods! (-> self draw) (-> self perso))
            (set! (-> self geo) want)
            )
        )
      )
    (when (and (< want 100)
               *target*
               (= (-> *target* ext-geo) (-> *target* pending-ext-geo))
               (= (-> *target-geo-control* status) 'active)
               )
      (case (-> *target* ext-geo)
        (((target-geo jakb) (target-geo jakb-old) (target-geo jakc))
         (set! want (the-as int (-> *target* ext-geo)))
         )
        )
      )
    (when (and (< want 100) (!= want (-> self geo)))
      (if (>= (-> self geo) 100)
          (ow-perso-draw-level! (-> self draw) #f)
          )
      (let ((lods (new 'stack-no-clear 'lod-set))
            (ok #f)
            )
        (when (>= want 0)
          (when (setup-lods! lods (target-skel-group) (-> self draw art-group) (-> self entity))
            (lods-assign! (-> self draw) lods)
            (set! ok #t)
            )
          )
        (when (not ok)
          (set! want -1)
          (when (setup-lods!
                  lods
                  (the-as skeleton-group (art-group-get-by-name *level* "skel-jchar" (the-as (pointer level) #f)))
                  (-> self draw art-group)
                  (-> self entity)
                  )
            (lods-assign! (-> self draw) lods)
            )
          )
        (set! (-> self geo) want)
        )
      )
    )
  (none)
  )

(defun online-puppet-hit-fx! ((p online-puppet))
  "le joueur distant est touche : demande l'effet (joue par l'avatar lui-meme)"
  (when (and (-> p shown) (< (seconds 0.3) (- (online-now) (-> p fx-time))))
    (set! (-> p fx-time) (online-now))
    (set! (-> p fx-want) #t)
    )
  (none)
  )

(defbehavior online-puppet-play-fx! online-puppet ()
  "Jak crie (\"oof\") et des etincelles jaillissent (dans le processus de l'avatar,
   comme le fait le jeu pour Jak)"
  (set! (-> self fx-want) #f)
  (let ((pos (vector-copy! (new 'stack-no-clear 'vector) (-> self root trans))))
    (+! (-> pos y) (meters 1.2))
    (set! (-> pos w) 1.0)
    (sound-play "oof" :position pos)
    (vector-copy! (-> *launch-matrix* trans) pos)
    (part-tracker-spawn part-tracker :to self :group group-target-hit)
    )
  (none)
  )

(defbehavior online-puppet-death-fx! online-puppet ()
  "un joueur vient d'etre elimine : explosion la ou il est (vue par tout le monde)"
  (set! (-> self death-fx) #f)
  (let ((pos (vector-copy! (new 'stack-no-clear 'vector) (-> self root trans))))
    (+! (-> pos y) (meters 1.0))
    (set! (-> pos w) 1.0)
    (sound-play "explosion" :position pos)
    (vector-copy! (-> *launch-matrix* trans) pos)
    (part-tracker-spawn part-tracker :to self :group group-explode-death)
    )
  (none)
  )

(defbehavior online-puppet-post online-puppet ()
  (online-puppet-sync-geo!)
  (if (-> self fx-want)
      (online-puppet-play-fx!)
      )
  (if (-> self death-fx)
      (online-puppet-death-fx!)
      )
  (let ((rs (-> *online-shm* remote (-> self slot)))
        (dt (-> *display* real-clock seconds-per-frame))
        (now (online-now))
        )
    ;; il vient de mourir
    (let ((dead (logtest? (-> rs flags) ONLINE_FLAG_DEAD)))
      (when (and dead (not (-> self was-dead)) (-> self placed))
        (set! (-> self dead-time) now)
        (set! (-> self death-fx) #t)
        (set! (-> self frame) 0.0)
        )
      (set! (-> self was-dead) dead)
      )
    ;; nouvelles donnees recues
    (when (!= (-> rs seq) (-> self seen-seq))
      (set! (-> self seen-seq) (-> rs seq))
      ;; il a perdu de la vie : cri + etincelles (meme si c'est un autre joueur qui l'a frappe)
      (let ((hp (-> rs pos w)))
        (if (and (< 0.0 (-> self last-health))
                 (< hp (+ (-> self last-health) -0.01))
                 (not (logtest? (-> rs flags) ONLINE_FLAG_DEAD))
                 )
            (online-puppet-hit-fx! self)
            )
        (set! (-> self last-health) hp)
        )
      (vector-copy! (-> self goal-pos) (-> rs pos))
      (set! (-> self goal-pos w) 1.0)
      (vector-copy! (-> self vel) (-> rs vel))
      (set! (-> self vel w) 0.0)
      (quaternion-copy! (-> self goal-quat) (-> rs quat))
      (quaternion-normalize! (-> self goal-quat))
      (cond
        ((and (= (-> rs anim-idx) (-> self last-idx)) (< (-> self last-frame) (-> rs anim-frame)))
         (let ((elapsed (the float (- now (-> self update-time)))))
           (if (< 0.0 elapsed)
               (set! (-> self frame-rate) (fmin 1.0 (/ (- (-> rs anim-frame) (-> self last-frame)) elapsed)))
               )
           )
         )
        ((!= (-> rs anim-idx) (-> self last-idx))
         (set! (-> self frame-rate) 0.0)
         )
        )
      (set! (-> self update-time) now)
      (set! (-> self last-idx) (-> rs anim-idx))
      (set! (-> self last-frame) (-> rs anim-frame))
      (set! (-> self frame) (-> rs anim-frame))
      (when (not (-> self placed))
        (vector-copy! (-> self root trans) (-> self goal-pos))
        (quaternion-copy! (-> self root quat) (-> self goal-quat))
        (set! (-> self placed) #t)
        )
      )
    ;; extrapolation courte entre deux paquets
    (when (< (- now (-> self update-time)) (seconds 0.3))
      (vector+float*! (-> self goal-pos) (-> self goal-pos) (-> self vel) dt)
      (+! (-> self frame) (* (-> self frame-rate) (* 300.0 dt)))
      )
    ;; lissage
    (if (< (meters 12.0) (vector-vector-distance (-> self root trans) (-> self goal-pos)))
        (vector-copy! (-> self root trans) (-> self goal-pos))
        (vector-lerp! (-> self root trans) (-> self root trans) (-> self goal-pos) 0.35)
        )
    (quaternion-slerp! (-> self root quat) (-> self root quat) (-> self goal-quat) 0.35)
    (quaternion-normalize! (-> self root quat))
    ;; affichage : avec une pose, le squelette est ecrit par online-apply-poses!
    ;; (apres tous les processus) ; sinon animation de secours
    (let* ((dying (and (logtest? (-> rs flags) ONLINE_FLAG_DEAD) (< (- now (-> self dead-time)) (seconds 5))))
           (anim (the-as art-joint-anim #f))
           (visible (and (-> self placed)
                         (>= (-> self geo) 0)
                         (nonzero? (-> rs active))
                         (logtest? (-> rs flags) ONLINE_FLAG_VALID)
                         ;; mort : on le voit tomber meme si son jeu le cache (cinematique de mort)
                         (or (not (logtest? (-> rs flags) ONLINE_FLAG_HIDDEN)) dying)
                         (online-level-visible? (-> rs level))
                         )
                    )
           )
      (when (and visible (not (-> self pose-on)))
        (cond
          (dying
            ;; pas de pose (son jeu cache Jak) : il s'effondre ici
            (let ((a (-> self draw art-group data 83)))
              (if (online-anim-ok? a)
                  (set! anim (the-as art-joint-anim a))
                  )
              )
            (when anim
              (set! (-> self frame) (fmin (the float (+ (-> anim frames num-frames) -1))
                                          (* 0.5 (/ (the float (- now (-> self dead-time))) 5.0))
                                          )
                    )
              )
            )
          (else
            (set! anim (the-as art-joint-anim (online-puppet-pick-anim (-> self draw art-group) rs)))
            )
          )
        )
      (cond
        ((and visible (-> self pose-on))
         (set! (-> self shown) #t)
         )
        (anim
         (let ((max-frame (the float (+ (-> anim frames num-frames) -1))))
           (if (< max-frame (-> self frame))
               (set! (-> self frame) max-frame)
               )
           (if (< (-> self frame) 0.0)
               (set! (-> self frame) 0.0)
               )
           )
         (logclear! (-> self draw status) (draw-control-status no-draw))
         (ja :group! anim :num! (identity (-> self frame)))
         (set! (-> self shown) #t)
         (ja-post)
         )
        (else
          (set! (-> self shown) #f)
          (logior! (-> self draw status) (draw-control-status no-draw))
          )
        )
      )
    )
  (none)
  )

(defstate online-puppet-idle (online-puppet)
  :code (behavior ()
    (until #f
      (suspend)
      )
    #f
    )
  :post online-puppet-post
  )

(defbehavior online-puppet-init online-puppet ((slot int))
  (set! (-> self slot) slot)
  (set! (-> self root) (new 'process 'trsqv))
  (vector-identity! (-> self root scale))
  (quaternion-identity! (-> self root quat))
  (initialize-skeleton
    self
    (the-as skeleton-group (art-group-get-by-name *level* "skel-jchar" (the-as (pointer level) #f)))
    (the-as pair 0)
    )
  (logior! (-> self skel status) (joint-control-status sync-math))
  (logior! (-> self draw status) (draw-control-status no-draw))
  (ja-channel-set! 1)
  (set! (-> self seen-seq) (the-as uint 0))
  (set! (-> self last-idx) -1)
  (set! (-> self frame) 0.0)
  (set! (-> self frame-rate) 0.0)
  (set! (-> self update-time) 0)
  (set! (-> self placed) #f)
  (set! (-> self shown) #f)
  (set! (-> self geo) -1)
  (set! (-> self perso) 0)
  (set! (-> self pose-on) #f)
  (set! (-> self last-health) -1.0)
  (set! (-> self fx-time) 0)
  (set! (-> self fx-want) #f)
  (set! (-> self dead-time) 0)
  (set! (-> self was-dead) #f)
  (set! (-> self death-fx) #f)
  (dotimes (k ONLINE_PART_SLOTS)
    (set! (-> self parts k) (the-as handle #f))
    (set! (-> self part-retry k) 0)
    )
  (dotimes (k 192)
    (set! (-> self obj-name k) (the-as uint 0))
    )
  (set! (-> self draw lod-set max-lod) 0)
  (go online-puppet-idle)
  )

(defun online-puppet-proc ((i int))
  (the-as online-puppet (handle->process (-> *online* puppets i))))

(defun online-kill-puppet! ((i int))
  (let ((p (online-puppet-proc i)))
    (if p
        (deactivate p)
        )
    )
  (set! (-> *online* puppets i) (the-as handle #f))
  (none)
  )

(defun online-kill-all-puppets! ()
  (dotimes (i ONLINE_MAX_PUPPETS)
    (online-kill-puppet! i)
    )
  (none)
  )

(defun online-update-puppets! ((in-session symbol))
  (let ((shm *online-shm*)
        (rt *online*)
        (spawned #f)
        )
    (dotimes (i ONLINE_MAX_PUPPETS)
      (let* ((rs (-> shm remote i))
             (proc (online-puppet-proc i))
             (want (and in-session *target* (nonzero? (-> rs active))))
             (mem-ok (< (* 192 1024) (memory-free *nk-dead-pool*)))
             )
        (cond
          ((and want (not proc))
           (when (and (not spawned)
                      mem-ok
                      (< (seconds 0.05) (- (online-now) (-> rt spawn-time)))
                      (art-group-get-by-name *level* "skel-jchar" (the-as (pointer level) #f))
                      )
             (set! spawned #t)
             (set! (-> rt spawn-time) (online-now))
             (let ((p (process-spawn
                        online-puppet
                        :init online-puppet-init
                        i
                        :name "online-puppet"
                        :to *default-pool*
                        :stack-size #x10000
                        )
                      )
                   )
               (if p
                   (set! (-> rt puppets i) (ppointer->handle p))
                   )
               )
             )
           )
          ((and (not want) proc)
           (online-kill-puppet! i)
           )
          )
        )
      )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; poses : squelette complet (Jak, Daxter, arme, planche, ailes)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Chaque os est envoye relatif au joueur (position + orientation). L'avatar
;; reproduit ainsi exactement l'autre joueur : planche, arme, dark/light jak,
;; animations speciales... meme si ce jeu-ci n'a pas les animations chargees.
;; Les pieces (Daxter, arme, planche, ailes) sont des processus enfants de l'avatar.

(defun online-round ((f float))
  (the int (if (< f 0.0) (+ f -0.5) (+ f 0.5)))
  )

(defun online-color-byte ((f float))
  (max 0 (min 255 (online-round (* 64.0 f))))
  )

(defun online-quat-pack ((q quaternion))
  "quaternion -> 32 bits : 3 composantes sur 10 bits + index de la plus grande"
  (let ((k 0)
        (m (fabs (-> q x)))
        )
    (when (< m (fabs (-> q y)))
      (set! k 1)
      (set! m (fabs (-> q y)))
      )
    (when (< m (fabs (-> q z)))
      (set! k 2)
      (set! m (fabs (-> q z)))
      )
    (when (< m (fabs (-> q w)))
      (set! k 3)
      (set! m (fabs (-> q w)))
      )
    (let* ((sign (if (< (-> q data k) 0.0) -1.0 1.0))
           (i0 (if (= k 0) 1 0))
           (i1 (if (<= k 1) 2 1))
           (i2 (if (<= k 2) 3 2))
           (v0 (max 0 (min 1023 (online-round (* 723.3868 (+ 0.70710677 (* sign (-> q data i0))))))))
           (v1 (max 0 (min 1023 (online-round (* 723.3868 (+ 0.70710677 (* sign (-> q data i1))))))))
           (v2 (max 0 (min 1023 (online-round (* 723.3868 (+ 0.70710677 (* sign (-> q data i2))))))))
           )
      (the-as uint (logior v0 (shl v1 10) (shl v2 20) (shl k 30)))
      )
    )
  )

(defun online-quat-unpack! ((q quaternion) (packed uint))
  (let* ((k (the-as int (logand (shr packed 30) 3)))
         (i0 (if (= k 0) 1 0))
         (i1 (if (<= k 1) 2 1))
         (i2 (if (<= k 2) 3 2))
         (c0 (+ -0.70710677 (* 0.0013824007 (the float (logand packed 1023)))))
         (c1 (+ -0.70710677 (* 0.0013824007 (the float (logand (shr packed 10) 1023)))))
         (c2 (+ -0.70710677 (* 0.0013824007 (the float (logand (shr packed 20) 1023)))))
         )
    (set! (-> q data i0) c0)
    (set! (-> q data i1) c1)
    (set! (-> q data i2) c2)
    (set! (-> q data k) (sqrtf (fmax 0.0 (- 1.0 (+ (* c0 c0) (* c1 c1) (* c2 c2))))))
    )
  q
  )

(define *online-check-count* 0)

(defun online-pose-add-part! ((buf pointer) (ofs int) (kind int) (proc process-drawable) (inv matrix) (geo int))
  "ajoute une piece (processus dessine) a la pose ; renvoie la nouvelle longueur"
  (let ((result ofs))
    (when (and proc (nonzero? (-> proc draw)))
      (let ((dc (-> proc draw)))
        (when (and (-> dc skeleton)
                   (nonzero? (-> dc skeleton))
                   (not (logtest? (-> dc status) (draw-control-status no-draw no-draw-temp uninited)))
                   )
          (let* ((n (-> dc skeleton length))
                 (need (+ ONLINE_PART_HDR (* n ONLINE_BONE_SIZE)))
                 )
            (when (and (< 0 n) (< n 256) (<= (+ ofs need) ONLINE_POSE_MAX))
              (online-set-u8! buf ofs kind)
              (online-set-u8! buf (+ ofs 1) n)
              (online-set-u8! buf (+ ofs 2) (if (logtest? (-> dc status) (draw-control-status force-fade)) 1 0))
              (online-set-u8! buf (+ ofs 3) (-> dc global-effect))
              (online-set-u8! buf (+ ofs 4) (-> dc force-fade))
              (online-set-u8! buf (+ ofs 5) geo)
              (online-set-u16! buf (+ ofs 6) 0)
              (online-set-u32! buf (+ ofs 8) (-> dc seg-mask))
              (online-set-u8! buf (+ ofs 12) (online-color-byte (-> dc color-mult x)))
              (online-set-u8! buf (+ ofs 13) (online-color-byte (-> dc color-mult y)))
              (online-set-u8! buf (+ ofs 14) (online-color-byte (-> dc color-mult z)))
              (online-set-u8! buf (+ ofs 15) (online-color-byte (-> dc color-mult w)))
              (online-set-u8! buf (+ ofs 16) (online-color-byte (-> dc color-emissive x)))
              (online-set-u8! buf (+ ofs 17) (online-color-byte (-> dc color-emissive y)))
              (online-set-u8! buf (+ ofs 18) (online-color-byte (-> dc color-emissive z)))
              (online-set-u8! buf (+ ofs 19) (online-color-byte (-> dc color-emissive w)))
              (let ((rel (new 'stack-no-clear 'matrix))
                    (rot (new 'stack-no-clear 'matrix))
                    (q (new 'stack-no-clear 'quaternion))
                    )
                (dotimes (b n)
                  (let ((bo (+ ofs ONLINE_PART_HDR (* b ONLINE_BONE_SIZE))))
                    (matrix*! rel (-> dc skeleton bones b transform) inv)
                    (let ((sx (vector-length (-> rel rvec)))
                          (sy (vector-length (-> rel uvec)))
                          (sz (vector-length (-> rel fvec)))
                          )
                      (matrix-identity! rot)
                      (if (< 0.00001 sx)
                          (vector-float*! (-> rot rvec) (-> rel rvec) (/ 1.0 sx))
                          )
                      (if (< 0.00001 sy)
                          (vector-float*! (-> rot uvec) (-> rel uvec) (/ 1.0 sy))
                          )
                      (if (< 0.00001 sz)
                          (vector-float*! (-> rot fvec) (-> rel fvec) (/ 1.0 sz))
                          )
                      (matrix->quaternion q rot)
                      (quaternion-normalize! q)
                      (online-set-u32! buf bo (online-quat-pack q))
                      (online-set-s16! buf (+ bo 4) (max -32767 (min 32767 (online-round (-> rel trans x)))))
                      (online-set-s16! buf (+ bo 6) (max -32767 (min 32767 (online-round (-> rel trans y)))))
                      (online-set-s16! buf (+ bo 8) (max -32767 (min 32767 (online-round (-> rel trans z)))))
                      (online-set-u16! buf (+ bo 10) (max 0 (min 65535 (online-round (* 4096.0 sx)))))
                      (online-set-u16! buf (+ bo 12) (max 0 (min 65535 (online-round (* 4096.0 sy)))))
                      (online-set-u16! buf (+ bo 14) (max 0 (min 65535 (online-round (* 4096.0 sz)))))
                      )
                    )
                  )
                )
              (set! result (+ ofs need))
              )
            )
          )
        )
      )
    result
    )
  )

(define *online-pose-len* 0)

(defun online-find-skel-name ((proc process-drawable))
  "nom du squelette (skel-...) utilise par ce processus, cherche dans les niveaux charges"
  (let ((dc (-> proc draw))
        (found (the-as string #f))
        )
    (when (and dc (nonzero? dc) (-> dc art-group) (-> dc jgeo))
      (let ((ag (-> dc art-group))
            (mg (-> dc lod-set lod 0 geo))
            )
        (countdown (li 11)
          (let ((lev (-> *level* level li)))
            (when (and (not found) (or (= (-> lev status) 'active) (= (-> lev status) 'reserved)))
              (let ((arr (-> lev art-group art-group-array)))
                (dotimes (k (-> arr length))
                  (let ((e (-> arr k)))
                    (when (and (not found) e (nonzero? e) (= (-> e type) skeleton-group))
                      (let ((sg (the-as skeleton-group e)))
                        (if (and (name= (-> sg art-group-name) (-> ag name))
                                 (>= (-> sg jgeo) 0)
                                 (< (-> sg jgeo) (-> ag length))
                                 (= (the-as basic (-> ag data (-> sg jgeo))) (the-as basic (-> dc jgeo)))
                                 (>= (-> sg mgeo 0) 0)
                                 (< (-> sg mgeo 0) (-> ag length))
                                 (= (the-as basic (-> ag data (-> sg mgeo 0))) (the-as basic mg))
                                 )
                            (set! found (-> sg name))
                            )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    found
    )
  )

(defun online-pose-add-object! ((buf pointer) (ofs int) (proc process-drawable) (inv matrix))
  "piece nom + piece objet ; renvoie le nombre de pieces ajoutees (longueur dans *online-pose-len*)"
  (set! *online-pose-len* ofs)
  (let ((added 0)
        (name (online-find-skel-name proc))
        )
    (when (and name (<= (+ ofs 52) ONLINE_POSE_MAX))
      (let ((after (online-pose-add-part! buf (+ ofs 52) ONLINE_PART_OBJECT proc inv 0)))
        (when (!= after (+ ofs 52))
          (online-set-u8! buf ofs ONLINE_PART_NAME)
          (online-set-u8! buf (+ ofs 1) 2)
          (dotimes (i 18)
            (online-set-u8! buf (+ ofs 2 i) 0)
            )
          (let ((nl (length name)))
            (dotimes (i 32)
              (online-set-u8! buf (+ ofs 20 i) (if (< i (min nl 31)) (-> name data i) 0))
              )
            )
          (set! *online-pose-len* after)
          (set! added 2)
          )
        )
      )
    added
    )
  )

(defun online-pose-add-vehicle! ((buf pointer) (ofs int) (veh process-drawable) (inv matrix))
  "le vehicule pilote et ses pieces (roues...) ; renvoie le nombre de pieces ajoutees"
  (let ((count 0)
        (objs 0)
        (len ofs)
        )
    (let ((a (online-pose-add-object! buf len veh inv)))
      (when (< 0 a)
        (+! count a)
        (+! objs 1)
        (set! len *online-pose-len*)
        )
      )
    (let ((c (-> veh child)))
      (while (and c (< objs ONLINE_MAX_OBJECTS))
        (let ((pc (ppointer->process c)))
          (when (and pc (type? pc process-drawable) (nonzero? (-> (the-as process-drawable pc) draw)))
            (let ((a (online-pose-add-object! buf len (the-as process-drawable pc) inv)))
              (when (< 0 a)
                (+! count a)
                (+! objs 1)
                (set! len *online-pose-len*)
                )
              )
            )
          )
        (set! c (-> c 0 brother))
        )
      )
    (set! *online-pose-len* len)
    count
    )
  )

(defun online-capture-pose! ()
  "pose du joueur local -> *online-pose-tx* (envoyee avec l'etat)"
  (let* ((tx *online-pose-tx*)
         (buf (the-as pointer (-> tx data)))
         (t *target*)
         (len 0)
         (count 0)
         )
    (when (and t
               (online-in-session?)
               (nonzero? (-> t control))
               (nonzero? (-> t draw))
               )
      (let ((root (new 'stack-no-clear 'matrix))
            (inv (new 'stack-no-clear 'matrix))
            (geo (the-as int (-> t ext-geo)))
            )
        (quaternion->matrix root (-> t control quat))
        (vector-copy! (-> root trans) (-> t control trans))
        (set! (-> root trans w) 1.0)
        (matrix-inverse-of-rot-trans! inv root)
        (online-set-u8! buf 0 1)
        (online-set-f32! buf 4 (-> t control trans x))
        (online-set-f32! buf 8 (-> t control trans y))
        (online-set-f32! buf 12 (-> t control trans z))
        (online-set-f32! buf 16 (-> t control quat x))
        (online-set-f32! buf 20 (-> t control quat y))
        (online-set-f32! buf 24 (-> t control quat z))
        (online-set-f32! buf 28 (-> t control quat w))
        (set! len ONLINE_POSE_HDR)
        (let ((before len))
          ;; Jak d'abord (indispensable), Daxter en dernier (le plus gros)
          (let ((jofs len))
            (set! len (online-pose-add-part! buf len ONLINE_PART_JAK t inv geo))
            ;; personnage choisi (0 = Jak) : case libre de l'en-tete de la piece
            (if (< jofs len)
                (online-set-u16! buf (+ jofs 6) *ow-perso-cur*)
                )
            )
          (when (!= len before)
            (+! count 1)
            (set! before len)
            (when (and (nonzero? (-> t gun)) (-> t gun gun))
              (set! len (online-pose-add-part! buf len ONLINE_PART_GUN (-> t gun gun 0) inv 0))
              (when (!= len before)
                (+! count 1)
                (set! before len)
                )
              )
            (when (and (nonzero? (-> t board)) (-> t board board))
              (set! len (online-pose-add-part! buf len ONLINE_PART_BOARD (-> t board board 0) inv 0))
              (when (!= len before)
                (+! count 1)
                (set! before len)
                )
              )
            (when (and (nonzero? (-> t lightjak)) (-> t lightjak wings))
              (set! len (online-pose-add-part! buf len ONLINE_PART_WINGS (-> t lightjak wings 0) inv 0))
              (when (!= len before)
                (+! count 1)
                (set! before len)
                )
              )
            ;; vehicule pilote (buggy du desert, vehicules de la ville...) avant Daxter :
            ;; la pose est limitee a 3 Ko et un gros vehicule ne tiendrait plus
            (when (and (focus-test? t pilot) (nonzero? (-> t pilot)))
              (let ((veh (handle->process (-> t pilot vehicle))))
                (when (and veh (type? veh process-drawable))
                  (+! count (online-pose-add-vehicle! buf len (the-as process-drawable veh) inv))
                  (set! len *online-pose-len*)
                  (set! before len)
                  )
                )
              )
            ;; monture (lezard de Spargus) : c'est un objet a part que Jak chevauche
            (when (and (focus-test? t flut) (-> t manipy))
              (let ((mnt (ppointer->process (-> t manipy))))
                (when (and mnt (type? mnt process-drawable))
                  (+! count (online-pose-add-object! buf len (the-as process-drawable mnt) inv))
                  (set! len *online-pose-len*)
                  (set! before len)
                  )
                )
              )
            (when (and (-> t sidekick) (or (zero? *ow-perso-cur*) (= *ow-perso-cur* OW_PERSO_DAXTER)))
              (set! len (online-pose-add-part! buf len ONLINE_PART_DAXTER (-> t sidekick 0) inv 0))
              (when (!= len before)
                (+! count 1)
                (set! before len)
                )
              )
            )
          )
        )
      )
    (online-set-u8! buf 1 count)
    (online-set-u16! buf 2 len)
    (set! (-> tx len) (the-as uint (if (< 0 count) len 0)))
    )
  (none)
  )

(defun online-poses-receive! ()
  "nouvelles poses dans game-in.bin -> *online-poses* (la precedente est gardee)"
  (let ((rx *online-rx*)
                (now (online-now))
        )
    (dotimes (i ONLINE_MAX_PUPPETS)
      (let* ((base (&+ (the-as pointer rx) (+ ONLINE_POSE_RX_OFS (* i ONLINE_POSE_SLOT))))
             (head (online-get-u32 base 0))
             (ps (online-ps i))
             )
        (when (and (nonzero? head)
                   (= head (online-get-u32 base ONLINE_POSE_TAIL))
                   (!= head (online-get-u32 ps 0))
                   )
          (online-set-u32! ps 0 head)
          (let ((len (the-as int (online-get-u32 base 4)))
                (pid (online-get-u32 base 8))
                )
            (when (and (<= ONLINE_POSE_HDR len) (<= len ONLINE_POSE_MAX) (= (online-get-u8 base 16) 1))
              (cond
                ((and (= pid (online-get-u32 ps 4)) (< 0 (the-as int (online-get-u32 ps 8))))
                 (mem-copy! (&+ ps 3120) (&+ ps 48) (the-as int (online-get-u32 ps 8)))
                 (online-set-u32! ps 12 (online-get-u32 ps 8))
                 (online-set-s64! ps 24 (online-get-s64 ps 16))
                 )
                (else
                  ;; nouveau joueur dans cette case : pas d'interpolation
                  (mem-copy! (&+ ps 3120) (&+ base 16) len)
                  (online-set-u32! ps 12 len)
                  (online-set-s64! ps 24 now)
                  (online-set-f32! ps 32 20.0)
                  (online-set-u32! ps 4 pid)
                  )
                )
              (mem-copy! (&+ ps 48) (&+ base 16) len)
              (online-set-u32! ps 8 len)
              (online-set-s64! ps 16 now)
              (let ((dt (the float (- now (online-get-s64 ps 24)))))
                (if (< 0.0 dt)
                    (online-set-f32! ps 32 (+ (* 0.7 (online-get-f32 ps 32)) (* 0.3 (fmax 5.0 (fmin 60.0 dt)))))
                    )
                )
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun online-pose-usable? ((i int))
  (let ((ps (online-ps i))
        (rs (-> *online-shm* remote i))
        )
    (and (< 0 (the-as int (online-get-u32 ps 8)))
         (= (online-get-u32 ps 4) (-> rs player-id))
         (< (- (online-now) (online-get-s64 ps 16)) (seconds 1))
         )
    )
  )

(defun online-pose-find-part ((buf pointer) (len int) (kind int) (want-n int))
  "position de la piece kind dans une pose (-1 si absente) ; want-n > 0 : meme nombre d'os"
  (let ((ofs ONLINE_POSE_HDR)
        (count (online-get-u8 buf 1))
        (found -1)
        )
    (dotimes (k count)
      (when (<= (+ ofs ONLINE_PART_HDR) len)
        (let* ((n (online-get-u8 buf (+ ofs 1)))
               (next (+ ofs ONLINE_PART_HDR (* n ONLINE_BONE_SIZE)))
               )
          (if (and (< found 0)
                   (= (online-get-u8 buf ofs) kind)
                   (<= next len)
                   (or (<= want-n 0) (= n want-n))
                   )
              (set! found ofs)
              )
          (set! ofs next)
          )
        )
      )
    found
    )
  )

(defun online-bone-decode! ((buf pointer) (ofs int) (q quaternion) (tr vector) (sc vector))
  (online-quat-unpack! q (online-get-u32 buf ofs))
  (set-vector! tr
               (the float (online-get-s16 buf (+ ofs 4)))
               (the float (online-get-s16 buf (+ ofs 6)))
               (the float (online-get-s16 buf (+ ofs 8)))
               1.0
               )
  (set-vector! sc
               (* 0.00024414062 (the float (online-get-u16 buf (+ ofs 10))))
               (* 0.00024414062 (the float (online-get-u16 buf (+ ofs 12))))
               (* 0.00024414062 (the float (online-get-u16 buf (+ ofs 14))))
               1.0
               )
  (none)
  )

(defun online-pose-write-part! ((proc process-drawable) (cur pointer) (cofs int) (prev pointer) (pofs int) (alpha float) (root matrix) (seg-ok symbol))
  "ecrit les os d'une piece (interpoles entre les deux dernieres poses) et l'affiche"
  (let* ((dc (-> proc draw))
         (n (online-get-u8 cur (+ cofs 1)))
         (q0 (new 'stack-no-clear 'quaternion))
         (q1 (new 'stack-no-clear 'quaternion))
         (q2 (new 'stack-no-clear 'quaternion))
         (t0 (new 'stack-no-clear 'vector))
         (t1 (new 'stack-no-clear 'vector))
         (t2 (new 'stack-no-clear 'vector))
         (s0 (new 'stack-no-clear 'vector))
         (s1 (new 'stack-no-clear 'vector))
         (s2 (new 'stack-no-clear 'vector))
         (rel (new 'stack-no-clear 'matrix))
         (bad #f)
         )
    ;; effets : light jak (sans textures + contour lumineux), invisibilite, couleurs
    (set! (-> dc global-effect) (the-as draw-control-global-effect (online-get-u8 cur (+ cofs 3))))
    (if (logtest? (online-get-u8 cur (+ cofs 2)) 1)
        (logior! (-> dc status) (draw-control-status force-fade))
        (logclear! (-> dc status) (draw-control-status force-fade))
        )
    (set! (-> dc force-fade) (the-as uint (online-get-u8 cur (+ cofs 4))))
    (set! (-> dc color-mult x) (* 0.015625 (the float (online-get-u8 cur (+ cofs 12)))))
    (set! (-> dc color-mult y) (* 0.015625 (the float (online-get-u8 cur (+ cofs 13)))))
    (set! (-> dc color-mult z) (* 0.015625 (the float (online-get-u8 cur (+ cofs 14)))))
    (set! (-> dc color-mult w) (* 0.015625 (the float (online-get-u8 cur (+ cofs 15)))))
    (set! (-> dc color-emissive x) (* 0.015625 (the float (online-get-u8 cur (+ cofs 16)))))
    (set! (-> dc color-emissive y) (* 0.015625 (the float (online-get-u8 cur (+ cofs 17)))))
    (set! (-> dc color-emissive z) (* 0.015625 (the float (online-get-u8 cur (+ cofs 18)))))
    (set! (-> dc color-emissive w) (* 0.015625 (the float (online-get-u8 cur (+ cofs 19)))))
    ;; parties visibles du modele (meme tenue seulement)
    (when seg-ok
      (let ((sm (the-as uint (online-get-u32 cur (+ cofs 8)))))
        (if (!= (-> dc seg-mask) sm)
            (setup-masks dc (the-as int (-> dc seg-mask)) (the-as int sm))
            )
        )
      )
    ;; os
    (dotimes (b n)
      (let ((bo (+ cofs ONLINE_PART_HDR (* b ONLINE_BONE_SIZE))))
        (online-bone-decode! cur bo q1 t1 s1)
        (cond
          ((>= pofs 0)
           (online-bone-decode! prev (+ pofs ONLINE_PART_HDR (* b ONLINE_BONE_SIZE)) q0 t0 s0)
           (quaternion-slerp! q2 q0 q1 alpha)
           (vector-lerp! t2 t0 t1 alpha)
           (vector-lerp! s2 s0 s1 alpha)
           )
          (else
            (quaternion-copy! q2 q1)
            (vector-copy! t2 t1)
            (vector-copy! s2 s1)
            )
          )
        (quaternion->matrix rel q2)
        ;; attention : vector-float*! met w a 1, or les lignes de rotation doivent avoir w = 0
        ;; (sinon les sommets partent a l'infini a l'affichage)
        (vector-float*! (-> rel rvec) (-> rel rvec) (-> s2 x))
        (vector-float*! (-> rel uvec) (-> rel uvec) (-> s2 y))
        (vector-float*! (-> rel fvec) (-> rel fvec) (-> s2 z))
        (set! (-> rel rvec w) 0.0)
        (set! (-> rel uvec w) 0.0)
        (set! (-> rel fvec w) 0.0)
        (vector-copy! (-> rel trans) t2)
        (set! (-> rel trans w) 1.0)
        (matrix*! (-> dc skeleton bones b transform) rel root)
        (let ((bt (-> dc skeleton bones b transform trans)))
          ;; securite : os invalide (NaN) ou absurde -> on n'affiche pas cette piece
          ;; (les os avant l'articulation d'origine ne servent pas : certains vehicules,
          ;; comme le Sand Shark, les laissent a l'origine du monde)
          (if (or (!= (-> bt x) (-> bt x))
                  (!= (-> bt y) (-> bt y))
                  (!= (-> bt z) (-> bt z))
                  (and (>= b (-> dc origin-joint-index))
                       (< (meters 60.0) (vector-vector-distance bt (-> root trans)))
                       )
                  )
              (set! bad #t)
              )
          (if (and (< b (-> dc origin-joint-index))
                   (< (meters 60.0) (vector-vector-distance bt (-> root trans)))
                   )
              (vector-copy! bt (-> root trans))
              )
          )
        )
      )
    ;; origine (pour savoir si c'est a l'ecran) puis affichage
    (cond
      (bad
        (logior! (-> dc status) (draw-control-status no-draw))
        )
      (else
        (let ((v (new 'stack-no-clear 'vector)))
          (vector-copy! v (-> dc bounds))
          (set! (-> v w) 1.0)
          (vector-norm-matrix*! (-> dc origin) v (-> dc skeleton bones (-> dc origin-joint-index) transform))
          (set! (-> dc origin w) (-> dc bounds w))
          )
        (logclear! (-> dc status) (draw-control-status no-draw no-draw-temp uninited))
        )
      )
    )
  (none)
  )

;; --- pieces (Daxter, arme, planche, ailes)

(defstate online-part-idle (online-part)
  :code (behavior ()
    (until #f
      (suspend)
      )
    #f
    )
  )

(defun online-real-level ()
  "un vrai niveau charge (celui ou est Jak de preference), jamais le niveau par defaut"
  (let ((lev (level-get-target-inside *level*))
        (found (the-as level #f))
        )
    (if (and lev (= (-> lev status) 'active) (< (-> lev index) 10))
        (set! found lev)
        )
    (dotimes (i (-> *level* length))
      (let ((l (-> *level* level i)))
        (if (and (not found) (= (-> l status) 'active) (< (-> l index) 10))
            (set! found l)
            )
        )
      )
    found
    )
  )

(defbehavior online-part-init online-part ((kind int) (sg skeleton-group) (lev level))
  (set! (-> self kind) kind)
  ;; le modele d'un vehicule est dans le niveau (desert, ville...) ou dans GAME (vehicules
  ;; charges en permanence) : dans ce cas il est dessine comme un objet d'un vrai niveau
  (cond
    ((and lev (!= lev (-> *level* level-default)))
     (set! (-> self level) lev)
     )
    ((= kind ONLINE_PART_OBJECT)
     (let ((real (online-real-level)))
       (if real
           (set! (-> self level) real)
           )
       )
     )
    )
  (set! (-> self seen) (online-now))
  (set! (-> self root) (new 'process 'trsqv))
  (vector-identity! (-> self root scale))
  (quaternion-identity! (-> self root quat))
  (cond
    ((= kind ONLINE_PART_OBJECT)
     ;; sans animation de repos (le squelette est ecrit par online-apply-poses!)
     (let ((old (-> sg janim)))
       (set! (-> sg janim) -1)
       (initialize-skeleton self sg (the-as pair 0))
       (set! (-> sg janim) old)
       )
     )
    (else
      (initialize-skeleton self sg (the-as pair 0))
      )
    )
  (logior! (-> self draw status) (draw-control-status no-draw))
  (set! (-> self draw lod-set max-lod) 0)
  (go online-part-idle)
  )

(defun online-art-stable? ((obj basic))
  "cet element graphique restera-t-il en memoire ? (buffers externes de Jak)"
  (let ((addr (the-as uint obj)))
    (cond
      ((online-addr-in-buffer? addr *target-geo-control*)
       (the-as symbol (and *target*
                           (= (-> *target* ext-geo) (-> *target* pending-ext-geo))
                           (= (-> *target-geo-control* status) 'active)
                           )
               )
       )
      ((online-addr-in-buffer? addr *target-anim-control*)
       (the-as symbol (and *target*
                           (= (-> *target* ext-anim) (-> *target* pending-ext-anim))
                           (= (-> *target-anim-control* status) 'active)
                           )
               )
       )
      (else
        ;; dans le tas d'un niveau : il faut qu'un niveau ACTIF le possede (les emplacements
        ;; de niveaux inactifs gardent les bornes de leur ancien tas, reutilise depuis)
        (let ((in-any #f)
              (in-active #f)
              )
          (dotimes (i (-> *level* length))
            (let ((lev (-> *level* level i)))
              (when (online-addr-in-heap? addr (-> lev heap))
                (set! in-any #t)
                (if (= (-> lev status) 'active)
                    (set! in-active #t)
                    )
                )
              )
            )
          (the-as symbol (or (not in-any) in-active))
          )
        )
      )
    )
  )

(define *online-skel-noanim* #f)

(defun online-skel-usable? ((sg skeleton-group) (lev level))
  "le modele de ce squelette est-il charge (et stable) dans ce jeu ?"
  (let ((ok #f))
    (when (and sg (nonzero? sg))
      (let ((ag (load-to-heap-by-name (-> (if lev lev (-> *level* level-default)) art-group) (-> sg art-group-name) 'test global (-> sg version))))
        (when (and ag
                   (nonzero? ag)
                   (= (-> ag type) art-group)
                   (>= (-> sg jgeo) 0)
                   (< (-> sg jgeo) (-> ag length))
                   )
          (let ((jg (-> ag data (-> sg jgeo))))
            (set! ok (the-as symbol (and jg (= (-> jg type) art-joint-geo) (online-art-stable? jg))))
            )
          ;; animation de repos : inutile pour les objets (on ecrit leurs os), et parfois absente
          (when (and ok (>= (-> sg janim) 0) (not *online-skel-noanim*))
            (if (< (-> sg janim) (-> ag length))
                (let ((ja (-> ag data (-> sg janim))))
                  (set! ok (the-as symbol (and ja (= (-> ja type) art-joint-anim) (online-art-stable? ja))))
                  )
                (set! ok #f)
                )
            )
          (when ok
            (dotimes (i (+ (-> sg max-lod) 1))
              (let ((mi (-> sg mgeo i)))
                (if (or (< mi 0) (>= mi (-> ag length)))
                    (set! ok #f)
                    (let ((mg (-> ag data mi)))
                      (if (not (and mg (= (-> mg type) merc-ctrl) (online-art-stable? mg)))
                          (set! ok #f)
                          )
                      )
                    )
                )
              )
            )
          )
        )
      )
    ok
    )
  )

(defun online-skel-find-level ((sg skeleton-group) (first level))
  "niveau charge ou le modele de ce squelette est vraiment present (#f sinon) :
   un squelette peut etre enregistre dans un niveau et son modele dans un autre"
  (set! *online-skel-noanim* #t)
  (let ((found (the-as level #f)))
    (if (and first (= (-> first status) 'active) (online-skel-usable? sg first))
        (set! found first)
        )
    (dotimes (i (-> *level* length))
      (let ((lev (-> *level* level i)))
        (if (and (not found) (= (-> lev status) 'active) (online-skel-usable? sg lev))
            (set! found lev)
            )
        )
      )
    ;; vehicules charges en permanence : leur art est dans GAME (niveau par defaut)
    (if (and (not found) (>= (-> sg texture-level) 10) (online-skel-usable? sg (-> *level* level-default)))
        (set! found (-> *level* level-default))
        )
    (set! *online-skel-noanim* #f)
    found
    )
  )

(defun online-part-skel ((kind int))
  (the-as skeleton-group
          (art-group-get-by-name
            *level*
            (case kind
              ((ONLINE_PART_DAXTER) "skel-sidekick")
              ((ONLINE_PART_GUN) "skel-gun")
              ((ONLINE_PART_BOARD) "skel-board")
              (else "skel-jchar-wings")
              )
            (the-as (pointer level) #f)
            )
          )
  )

(define-extern online-puppet-slot-part (function online-puppet int int int skeleton-group level online-part))

(defun online-puppet-part ((p online-puppet) (kind int) (n int))
  "piece kind de l'avatar p (creee si besoin), #f si impossible"
  (online-puppet-slot-part p kind kind n (online-part-skel kind) (-> *level* level-default))
  )

(defun online-puppet-slot-part ((p online-puppet) (kind int) (slot int) (n int) (sg skeleton-group) (lev level))
  "piece de l'avatar p dans la case slot (creee avec le squelette sg si besoin)"
  (let ((part (the-as online-part (handle->process (-> p parts slot))))
        (now (online-now))
        )
    ;; piece devenue inutilisable (modele decharge, autre squelette) : on la jette
    (when (and part
               (or (!= (-> part draw skeleton length) n)
                   (not (online-art-stable? (-> part draw jgeo)))
                   (not (online-art-stable? (-> part draw mgeo)))
                   )
               )
      (deactivate part)
      (set! (-> p parts slot) (the-as handle #f))
      (set! (-> p part-retry slot) (+ now (seconds 1)))
      (set! part #f)
      )
    (when (and (not part)
               (< (-> p part-retry slot) now)
               (< (seconds 0.02) (- now (-> *online* spawn-time)))
               (< (* 192 1024) (memory-free *nk-dead-pool*))
               )
      (set! (-> *online* spawn-time) now)
      (set! (-> p part-retry slot) (+ now (seconds 2)))
      (begin
        (set! *online-skel-noanim* (= kind ONLINE_PART_OBJECT))
        (when (let ((u (online-skel-usable? sg lev)))
                (set! *online-skel-noanim* #f)
                u
                )
          (let ((pp (process-spawn online-part :init online-part-init kind sg lev :name "online-part" :to p :stack-size #x8000)))
            (when pp
              (set! part (the-as online-part (ppointer->process pp)))
              (cond
                ((and (nonzero? (-> part draw)) (= (-> part draw skeleton length) n))
                 (set! (-> p parts slot) (ppointer->handle pp))
                 )
                (else
                  (deactivate part)
                  (set! part #f)
                  )
                )
              )
            )
          )
        )
      )
    part
    )
  )

(defun online-pose-find-nth ((buf pointer) (len int) (kind int) (nth int) (want-n int))
  "position de la nth piece de sorte kind (avec want-n os), -1 si absente"
  (let ((ofs ONLINE_POSE_HDR)
        (count (online-get-u8 buf 1))
        (seen 0)
        (found -1)
        )
    (dotimes (k count)
      (when (<= (+ ofs ONLINE_PART_HDR) len)
        (let* ((n (online-get-u8 buf (+ ofs 1)))
               (next (+ ofs ONLINE_PART_HDR (* n ONLINE_BONE_SIZE)))
               )
          (when (and (< found 0) (= (online-get-u8 buf ofs) kind) (<= next len))
            (if (and (= seen nth) (= n want-n))
                (set! found ofs)
                )
            (+! seen 1)
            )
          (set! ofs next)
          )
        )
      )
    found
    )
  )

(defun online-puppet-object-part ((p online-puppet) (j int) (n int) (name (pointer uint8)))
  "vehicule / objet j de l'avatar (modele cherche par son nom dans les niveaux charges)"
  (let* ((slot (+ ONLINE_PART_KINDS j))
         (same #t)
         (lev (the-as level #f))
         )
    ;; autre objet qu'avant : on jette l'ancien
    (dotimes (i 32)
      (if (!= (-> p obj-name (+ (* j 32) i)) (-> name i))
          (set! same #f)
          )
      )
    (when (not same)
      (let ((old (handle->process (-> p parts slot))))
        (if old
            (deactivate old)
            )
        )
      (set! (-> p parts slot) (the-as handle #f))
      (set! (-> p part-retry slot) 0)
      (dotimes (i 32)
        (set! (-> p obj-name (+ (* j 32) i)) (-> name i))
        )
      )
    (cond
      ((handle->process (-> p parts slot))
       (online-puppet-slot-part p ONLINE_PART_OBJECT slot n (the-as skeleton-group #f) (the-as level #f))
       )
      ((< (-> p part-retry slot) (online-now))
       ;; modele charge chez moi ? (meme zone que l'autre joueur)
       (set! (-> *online* found-level) #f)
       (set! lev (the-as level #f))
       (let ((sg (the-as skeleton-group
                         (art-group-get-by-name
                           *level*
                           (online-chars->string (-> *online* tmp-level) name 32)
                           (&-> *online* found-level)
                           )
                         )
                 )
             )
         (if (and sg (nonzero? sg) (= (-> sg type) skeleton-group) (-> *online* found-level)
                  (set! lev (online-skel-find-level sg (-> *online* found-level)))
                  )
             (online-puppet-slot-part p ONLINE_PART_OBJECT slot n sg lev)
             (begin
               (set! (-> p part-retry slot) (+ (online-now) (seconds 2)))
               (the-as online-part #f)
               )
             )
         )
       )
      (else
        (the-as online-part #f)
        )
      )
    )
  )

(defun online-part-hide! ((p online-puppet) (kind int) (now time-frame))
  (let ((part (the-as online-part (handle->process (-> p parts kind)))))
    (when part
      (logior! (-> part draw status) (draw-control-status no-draw))
      ;; absente depuis longtemps, ou modele decharge : on libere la memoire
      (when (or (< (seconds 5) (- now (-> part seen)))
                (not (online-art-stable? (-> part draw jgeo)))
                (not (online-art-stable? (-> part draw mgeo)))
                )
        (deactivate part)
        (set! (-> p parts kind) (the-as handle #f))
        )
      )
    )
  (none)
  )

(defun online-apply-poses! ()
  "applique les poses recues aux avatars (appele apres tous les processus, avant l'affichage)"
  (let ((now (online-now)))
    (dotimes (i ONLINE_MAX_PUPPETS)
      (let ((p (online-puppet-proc i)))
        (when p
          (let ((ps (online-ps i))
                (on #f)
                )
            (when (and (-> p shown) (online-pose-usable? i))
              (let* ((cur (&+ ps 48))
                     (prev (&+ ps 3120))
                     (plen (the-as int (online-get-u32 ps 12)))
                     (n-jak (-> p draw skeleton length))
                     (jak-ofs (online-pose-find-part cur (the-as int (online-get-u32 ps 8)) ONLINE_PART_JAK n-jak))
                     )
                (when (>= jak-ofs 0)
                  (set! on #t)
                  (let* ((alpha (fmax 0.0 (fmin 1.0 (/ (the float (- now (online-get-s64 ps 16))) (fmax 1.0 (online-get-f32 ps 32))))))
                         (root (new 'stack-no-clear 'matrix))
                         (pa (new 'stack-no-clear 'vector))
                         (pb (new 'stack-no-clear 'vector))
                         (qa (new 'stack-no-clear 'quaternion))
                         (qb (new 'stack-no-clear 'quaternion))
                         )
                    ;; position et orientation du joueur, interpolees comme le squelette
                    (set-vector! pa (online-get-f32 prev 4) (online-get-f32 prev 8) (online-get-f32 prev 12) 1.0)
                    (set-vector! pb (online-get-f32 cur 4) (online-get-f32 cur 8) (online-get-f32 cur 12) 1.0)
                    (set! (-> qa x) (online-get-f32 prev 16))
                    (set! (-> qa y) (online-get-f32 prev 20))
                    (set! (-> qa z) (online-get-f32 prev 24))
                    (set! (-> qa w) (online-get-f32 prev 28))
                    (set! (-> qb x) (online-get-f32 cur 16))
                    (set! (-> qb y) (online-get-f32 cur 20))
                    (set! (-> qb z) (online-get-f32 cur 24))
                    (set! (-> qb w) (online-get-f32 cur 28))
                    (quaternion-normalize! qa)
                    (quaternion-normalize! qb)
                    (if (< (meters 10.0) (vector-vector-distance pa pb))
                        (set! alpha 1.0)
                        )
                    ;; donnees invalides (NaN) : on garde l'ancienne position
                    (when (or (!= (-> pb x) (-> pb x)) (!= (-> qb w) (-> qb w)) (!= (-> pa x) (-> pa x)) (!= (-> qa w) (-> qa w)))
                      (vector-copy! pa pb)
                      (quaternion-copy! qa qb)
                      )
                    (vector-lerp! (-> p root trans) pa pb alpha)
                    (set! (-> p root trans w) 1.0)
                    (quaternion-slerp! (-> p root quat) qa qb alpha)
                    (quaternion-normalize! (-> p root quat))
                    (quaternion->matrix root (-> p root quat))
                    (vector-copy! (-> root trans) (-> p root trans))
                    (set! (-> root trans w) 1.0)
                    ;; personnage choisi par ce joueur (0 = Jak)
                    (set! (-> p perso) (online-get-u16 cur (+ jak-ofs 6)))
                    ;; Jak
                    (online-pose-write-part!
                      p
                      cur
                      jak-ofs
                      prev
                      (online-pose-find-part prev plen ONLINE_PART_JAK n-jak)
                      alpha
                      root
                      ;; pas le masque de Jak : chez lui l'echarpe et la jupe sont du tissu anime
                      ;; (cache dans le modele), l'avatar doit donc garder toutes ses parties
                      #f
                      )
                    ;; joueur en Daxter (mode indax) : seul Daxter se voit, pas le corps de Jak
                    (if (= (-> p perso) OW_PERSO_DAXTER)
                        (logior! (-> p draw status) (draw-control-status no-draw))
                        )
                    ;; vehicule pilote (et ses roues)
                    (let ((ofs ONLINE_POSE_HDR)
                          (count (online-get-u8 cur 1))
                          (clen (the-as int (online-get-u32 ps 8)))
                          (j 0)
                          (nameofs -1)
                          )
                      (dotimes (k count)
                        (when (<= (+ ofs ONLINE_PART_HDR) clen)
                          (let* ((pk (online-get-u8 cur ofs))
                                 (n (online-get-u8 cur (+ ofs 1)))
                                 (next (+ ofs ONLINE_PART_HDR (* n ONLINE_BONE_SIZE)))
                                 )
                            (cond
                              ((and (= pk ONLINE_PART_NAME) (<= next clen))
                               (set! nameofs (+ ofs ONLINE_PART_HDR))
                               )
                              ((and (= pk ONLINE_PART_OBJECT) (<= next clen) (< j ONLINE_MAX_OBJECTS) (>= nameofs 0))
                               (let ((part (online-puppet-object-part p j n (the-as (pointer uint8) (&+ cur nameofs)))))
                                 (when part
                                   (set! (-> part seen) now)
                                   (vector-copy! (-> part root trans) (-> p root trans))
                                   ;; art de GAME : on le dessine dans les files d'un vrai niveau charge
                                   (when (or (>= (-> part draw level-index) 10)
                                             (not (-> part level))
                                             (!= (-> part level status) 'active)
                                             )
                                     (let ((real (online-real-level)))
                                       (when real
                                         (set! (-> part level) real)
                                         (set! (-> part draw level-index) (the-as uint (-> real index)))
                                         )
                                       )
                                     )
                                   (online-pose-write-part! part cur ofs prev (online-pose-find-nth prev plen ONLINE_PART_OBJECT j n) alpha root #t)
                                   )
                                 )
                               (+! j 1)
                               (set! nameofs -1)
                               )
                              )
                            (set! ofs next)
                            )
                          )
                        )
                      (while (< j ONLINE_MAX_OBJECTS)
                        (online-part-hide! p (+ ONLINE_PART_KINDS j) now)
                        (+! j 1)
                        )
                      )
                    ;; Daxter, arme, planche, ailes
                    (let ((kind 1))
                      (while (< kind ONLINE_PART_KINDS)
                        (let ((cofs (online-pose-find-part cur (the-as int (online-get-u32 ps 8)) kind 0)))
                          (cond
                            ((>= cofs 0)
                             (let* ((n (online-get-u8 cur (+ cofs 1)))
                                    (part (online-puppet-part p kind n))
                                    )
                               (when part
                                 (set! (-> part seen) now)
                                 (vector-copy! (-> part root trans) (-> p root trans))
                                 (online-pose-write-part! part cur cofs prev (online-pose-find-part prev plen kind n) alpha root #t)
                                 )
                               )
                             )
                            (else
                              (online-part-hide! p kind now)
                              )
                            )
                          )
                        (+! kind 1)
                        )
                      )
                    )
                  )
                )
              )
            (when (not on)
              (let ((kind 1))
                (while (< kind ONLINE_PART_SLOTS)
                  (online-part-hide! p kind now)
                  (+! kind 1)
                  )
                )
              )
            (set! (-> p pose-on) on)
            )
          )
        )
      )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; etat du joueur local
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun online-target-anim-index ((t target) (a art-joint-anim))
  (let ((rt *online*))
    (cond
      ((not a)
       -1
       )
      ((= a (-> rt last-anim))
       (-> rt last-anim-idx)
       )
      (else
        (let ((ag (-> t draw art-group))
              (idx -1)
              )
          (dotimes (i (-> ag length))
            (if (and (< idx 0) (= (-> ag data i) a))
                (set! idx i)
                )
            )
          (set! (-> rt last-anim) a)
          (set! (-> rt last-anim-idx) idx)
          idx
          )
        )
      )
    )
  )

(defun online-write-local! ()
  (let* ((shm *online-shm*)
         (loc (-> shm local))
         (t *target*)
         (flags 0)
         )
    (cond
      ((and t (nonzero? (-> t control)) (nonzero? (-> t skel)) (nonzero? (-> t draw)))
       (set! flags (logior flags ONLINE_FLAG_VALID))
       (if (focus-test? t dead)
           (set! flags (logior flags ONLINE_FLAG_DEAD))
           )
       (if (logtest? (-> t draw status) (draw-control-status no-draw))
           (set! flags (logior flags ONLINE_FLAG_HIDDEN))
           )
       (if (logtest? (-> t control status) (collide-status on-surface))
           (set! flags (logior flags ONLINE_FLAG_GROUND))
           )
       (if (focus-test? t dark)
           (set! flags (logior flags ONLINE_FLAG_DARK))
           )
       (if (focus-test? t light)
           (set! flags (logior flags ONLINE_FLAG_LIGHT))
           )
       (if (focus-test? t gun)
           (set! flags (logior flags ONLINE_FLAG_GUN))
           )
       (if (focus-test? t pilot)
           (set! flags (logior flags ONLINE_FLAG_VEHICLE))
           )
       (if (focus-test? t board)
           (set! flags (logior flags ONLINE_FLAG_BOARD))
           )
       (if (paused?)
           (set! flags (logior flags ONLINE_FLAG_PAUSED))
           )
       (vector-copy! (-> loc pos) (-> t control trans))
       (set! (-> loc pos w) (-> t fact health))
       (quaternion-copy! (-> loc quat) (-> t control quat))
       (vector-copy! (-> loc vel) (-> t control transv))
       (set! (-> loc vel w) 0.0)
       (let ((ch (-> t skel root-channel 0)))
         (set! (-> loc anim-idx) (online-target-anim-index t (-> ch frame-group)))
         (set! (-> loc anim-frame) (-> ch frame-num))
         )
       (let ((lev (-> t current-level)))
         (if (and lev (-> lev name))
             (online-string->chars (-> loc level) (symbol->string (-> lev name)) 16)
             (online-string->chars (-> loc level) (the-as string #f) 16)
             )
         )
       )
      (else
        (set! (-> loc anim-idx) -1)
        )
      )
    (set! (-> loc flags) (the-as uint flags))
    ;; diagnostic pour Jak3Online.exe : avatars actifs / affiches
    (let ((alive 0)
          (shown 0)
          (posed 0)
          (parts 0)
          )
      (dotimes (i ONLINE_MAX_PUPPETS)
        (let ((p (online-puppet-proc i)))
          (when p
            (+! alive 1)
            (if (-> p shown)
                (+! shown 1)
                )
            (if (-> p pose-on)
                (+! posed 1)
                )
            (dotimes (k ONLINE_PART_SLOTS)
              (let ((part (the-as online-part (handle->process (-> p parts k)))))
                (if (and part (not (logtest? (-> part draw status) (draw-control-status no-draw))))
                    (+! parts 1)
                    )
                )
              )
            )
          )
        )
      (set! (-> loc pad 0) (the-as uint alive))
      (set! (-> loc pad 1) (the-as uint shown))
      (set! (-> loc pad 2) (the-as uint posed))
      (set! (-> loc pad 3) (the-as uint parts))
      ;; memoire libre des processus (Ko), pour le diagnostic de Jak3Online.exe
      (let ((kb (min 65535 (/ (memory-free *nk-dead-pool*) 1024))))
        (set! (-> loc pad 4) (the-as uint (logand kb 255)))
        (set! (-> loc pad 5) (the-as uint (shr kb 8)))
        )
      ;; horloge du jeu (banc de test : le jeu ne doit jamais s'arreter en ligne)
      (let ((gc (the int (-> *display* game-clock frame-counter))))
        (set! (-> loc pad 8) (the-as uint (logand gc 255)))
        (set! (-> loc pad 9) (the-as uint (logand (shr gc 8) 255)))
        )
      ;; langue du jeu (Jak3Online.exe ecrit ses messages dans cette langue)
      (set! (-> loc pad 7) (the-as uint (-> *pc-settings* text-language)))
      ;; etat de mon vehicule en % (255 = a pied), pour le banc de test
      (let ((veh (online-my-vehicle)))
        (set! (-> loc pad 6)
              (the-as uint (if (and veh (type? veh vehicle))
                               (max 0 (min 100 (the int (* 100.0 (-> (the-as vehicle veh) hit-points)))))
                               255
                               )
                      )
              )
        )
      )
    (set! (-> loc kills) (-> *online* kills))
    (set! (-> loc deaths) (-> *online* deaths))
    (+! (-> loc seq) 1)
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; PvP : detection des coups portes aux autres joueurs
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun online-slot-hit-pos ((i int))
  "position de l'avatar i s'il est visible et touchable, sinon #f"
  (let ((p (online-puppet-proc i))
        (rs (-> *online-shm* remote i))
        )
    (if (and p
             (-> p shown)
             (nonzero? (-> rs active))
             (not (logtest? (-> rs flags) (logior ONLINE_FLAG_DEAD ONLINE_FLAG_PAUSED)))
             )
        (-> p root trans)
        (the-as vector #f)
        )
    )
  )

(defun online-send-hit! ((i int) (damage float) (mode int) (dir vector))
  (let ((rt *online*)
        (now (online-now))
        )
    (when (< (-> rt hit-cooldown i) now)
      (set! (-> rt hit-cooldown i) (+ now (seconds 0.35)))
      (online-push-out-event! ONLINE_EVENT_HIT (-> *online-shm* remote i player-id) damage mode dir)
      ;; retour immediat pour celui qui frappe (sans attendre le reseau)
      (let ((p (online-puppet-proc i)))
        (if (and p (> damage 0.0))
            (online-puppet-hit-fx! p)
            )
        )
      )
    )
  (none)
  )

(define-extern online-pvp-sphere! (function target vector float float int none))

(defun online-pvp-melee! ((t target))
  "coups de poing / pied / roulade / dark jak / flut-flut contre les avatars proches"
  (when (and t
             (= t *target*)
             (online-pvp-allowed?)
             (focus-test? t flut)
             (= (-> t control danger-mode) 'flut-attack)
             )
    (online-pvp-sphere! t (-> t control trans) (meters 4.8) 2.0 ONLINE_MODE_IMPACT)
    )
  (when (and t
             (not (focus-test? t flut grabbed in-head pole tube pilot mech board turret indax))
             (= t *target*)
             (online-pvp-allowed?)
             (-> t control danger-mode)
             )
    ;; dark jak frappe plus fort (mais seulement quand il attaque)
    (let* ((dark-hit? (focus-test? t dark))
           (damage (* (if dark-hit? 2.0 1.0) (penetrate-using->damage (-> t control penetrate-using))))
           )
      (if (<= damage 0.0)
          (set! damage 1.0)
          )
      (dotimes (i ONLINE_MAX_PUPPETS)
        (let ((pos (online-slot-hit-pos i)))
          (when (and pos (< (vector-vector-distance (-> t control trans) pos) (meters 4.6)))
            (let ((away (vector-! (new-stack-vector0) pos (-> t control trans))))
              (set! (-> away y) 0.0)
              (if (< (vector-length away) 1.0)
                  (vector-copy! away (-> t control c-R-w fvec))
                  )
              (vector-normalize! away 1.0)
              (online-send-hit! i damage (if dark-hit? ONLINE_MODE_DARK ONLINE_MODE_GENERIC) away)
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun online-pvp-sphere! ((t target) (center vector) (radius float) (damage float) (mode int))
  (when (and t (= t *target*) (online-pvp-allowed?))
    (dotimes (i ONLINE_MAX_PUPPETS)
      (let ((pos (online-slot-hit-pos i)))
        (when (and pos (< (vector-vector-distance center pos) radius))
          (let ((away (vector-! (new-stack-vector0) pos center)))
            (set! (-> away y) 0.0)
            (if (< (vector-length away) 1.0)
                (vector-copy! away (-> t control c-R-w fvec))
                )
            (vector-normalize! away 1.0)
            (online-send-hit! i damage mode away)
            )
          )
        )
      )
    )
  (none)
  )

(defun online-pvp-ray! ((t target) (origin vector) (dir vector) (range float) (thickness float) (damage float) (mode int))
  "tir instantane (arme) : touche les avatars proches du rayon"
  (when (and t (= t *target*) (online-pvp-allowed?))
    (let ((ray (vector-normalize-copy! (new 'stack-no-clear 'vector) dir 1.0)))
      (dotimes (i ONLINE_MAX_PUPPETS)
        (let ((pos (online-slot-hit-pos i)))
          (when pos
            (let ((hit (vector-copy! (new-stack-vector0) pos)))
              (+! (-> hit y) (meters 1.0))
              (let* ((to (vector-! (new-stack-vector0) hit origin))
                     (along (vector-dot to ray))
                     )
                (when (and (< 0.0 along) (< along range))
                  (let ((closest (vector+*! (new 'stack-no-clear 'vector) origin ray along)))
                    (if (< (vector-vector-distance closest hit) thickness)
                        (online-send-hit! i damage mode ray)
                        )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun online-pvp-lift-ray! ((t target) (origin vector) (dir vector) (range float) (thickness float))
  "tir de gravite : souleve les joueurs touches"
  (online-pvp-ray! t origin dir range thickness 0.0 ONLINE_MODE_LIFT)
  (none)
  )

(defun online-pvp-projectile! ((proj process-drawable) (old-pos vector) (damage float) (mode int))
  "projectile tire par le joueur local : renvoie #t s'il a touche un joueur distant"
  (let ((hit? #f))
    (when (online-pvp-allowed?)
      (let* ((move (vector-! (new-stack-vector0) (-> proj root trans) old-pos))
             (len2 (vector-dot move move))
             )
        (when (< 1.0 len2)
          (dotimes (i ONLINE_MAX_PUPPETS)
            (let ((pos (online-slot-hit-pos i)))
              (when (and pos (not hit?))
                (let ((hp (vector-copy! (new-stack-vector0) pos)))
                  (+! (-> hp y) (meters 1.0))
                  (let* ((to (vector-! (new-stack-vector0) hp old-pos))
                         (tt (fmax 0.0 (fmin 1.0 (/ (vector-dot to move) len2))))
                         (closest (vector+*! (new 'stack-no-clear 'vector) old-pos move tt))
                         )
                    (when (< (vector-vector-distance closest hp) (meters 3.6))
                      (online-send-hit! i damage mode (vector-normalize-copy! (new 'stack-no-clear 'vector) move 1.0))
                      (set! hit? #t)
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    hit?
    )
  )

(defun online-pvp-gun-fire! ((t target) (kind pickup-type))
  "appele au moment ou le joueur local tire (armes bleue, sombre, rouge)"
  (when (and t (= t *target*) (online-pvp-allowed?) (nonzero? (-> t gun)))
    (let ((pos (-> t gun fire-point))
          (dir (-> t gun fire-dir-out))
          )
      (case kind
        (((pickup-type gun-blue-1) (pickup-type gun-blue-2) (pickup-type gun-blue-3))
         (online-pvp-ray! t pos dir (meters 80.0) (meters 1.15) 1.0 ONLINE_MODE_BLUE)
         )
        (((pickup-type gun-dark-1))
         (online-pvp-ray! t pos dir (meters 55.0) (meters 1.15) 3.0 ONLINE_MODE_DARK)
         )
        (((pickup-type gun-dark-2))
         (online-pvp-lift-ray! t pos dir (meters 90.0) (meters 3.2))
         )
        (((pickup-type gun-dark-3))
         (online-pvp-ray! t pos dir (meters 80.0) (meters 1.15) 8.0 ONLINE_MODE_DARK)
         )
        (((pickup-type gun-red-1))
         (online-pvp-ray! t pos dir (meters 6.5) (meters 3.0) 3.0 ONLINE_MODE_RED)
         )
        (((pickup-type gun-red-2))
         (online-pvp-ray! t pos dir (meters 18.0) (meters 5.5) 5.0 ONLINE_MODE_RED)
         )
        (((pickup-type gun-red-3))
         (online-pvp-ray! t pos dir (meters 22.0) (meters 5.5) 8.0 ONLINE_MODE_RED)
         )
        )
      )
    )
  (none)
  )

(defun online-pvp-projectile-move! ((proj projectile) (old-pos vector))
  "chaque deplacement d'un projectile tire par le joueur local"
  (when (and (online-pvp-allowed?)
             (-> proj attack-mode)
             (let ((own (handle->process (-> proj owner-handle))))
               (and own (or (= own *target*) (= own (online-my-vehicle))))
               )
             (not (and (-> proj next-state) (= (-> proj next-state name) 'impact)))
             )
    (when (online-pvp-projectile! proj old-pos (fmax 1.0 (-> proj damage)) (if (= (-> proj attack-mode) 'eco-dark) ONLINE_MODE_DARK ONLINE_MODE_YELLOW))
      (+! (-> proj hits) 1)
      (go (method-of-object proj impact))
      )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; PvP : coups recus
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun online-can-take-damage? ((t target))
  (and t
       (not (focus-test? t dead teleporting grabbed in-head pole tube))
       (not (and (-> t next-state)
                 (let ((n (-> t next-state name)))
                   (or (= n 'target-death) (= n 'target-continue))
                   )
                 )
            )
       )
  )

(defun online-shove! ((t target) (damage float))
  (send-event
    t
    'shove
    #f
    (static-attack-info :mask (vehicle-impulse-factor)
                        ((id (new-attack-id))
                         (damage 0.0)
                         (vehicle-damage-factor 0.0)
                         (vehicle-impulse-factor 0.0)
                         (shove-back (if (< 4.0 damage) (meters 4.0) (meters 1.6)))
                         (shove-up (if (< 4.0 damage) (meters 1.2) (meters 0.45)))
                         )
                        )
    )
  (none)
  )

(defun online-my-vehicle ()
  "le vehicule que je pilote (ou #f)"
  (let ((t *target*))
    (if (and t (focus-test? t pilot) (nonzero? (-> t pilot)))
        (the-as process-drawable (handle->process (-> t pilot vehicle)))
        (the-as process-drawable #f)
        )
    )
  )

(defun online-my-vehicle-hit! ((ev online-event))
  "coup PvP recu alors que je pilote : degats pour le vehicule ; #t si applique"
  (let ((veh (online-my-vehicle)))
    (when (and veh (not (focus-test? (the-as process-focusable veh) dead)) (= (-> ev mode) ONLINE_MODE_IMPACT))
      ;; percute par le vehicule d'un autre joueur : les degats seulement (le choc lui-meme est
      ;; calcule chez moi par ow-collisions!, avec les vraies vitesses)
      (let ((dmg (fmax 0.5 (fmin 20.0 (-> ev damage)))))
        (if (< 0.0 (-> *online-ext* power-left ONLINE_POW_STEEL))
            (set! dmg (* 0.5 dmg))
            )
        (set! (-> *online* veh-hit-by) (-> ev player-id))
        (set! (-> *online* veh-hit-time) (online-now))
        (set! (-> *online* last-hit-by) (-> ev player-id))
        (set! (-> *online* last-hit-time) (online-now))
        (send-event veh 'attack #f
          (static-attack-info :mask (vehicle-impulse-factor)
            ((id (new-attack-id)) (damage (* 1.5 dmg)) (vehicle-damage-factor 1.0) (vehicle-impulse-factor 0.02) (mode 'generic))
            )
          )
        (return #t)
        )
      )
    (when (and veh (not (focus-test? (the-as process-focusable veh) dead)))
      (let ((dmg (fmax 0.5 (fmin 20.0 (-> ev damage))))
            (away (vector-float*! (new-stack-vector0) (-> ev dir) (meters 6.0)))
            )
        (if (< 0.0 (-> *online-ext* power-left ONLINE_POW_STEEL))
            (set! dmg (* 0.5 dmg))
            )
        (set! (-> *online* veh-hit-by) (-> ev player-id))
        (set! (-> *online* veh-hit-time) (online-now))
        (set! (-> *online* last-hit-by) (-> ev player-id))
        (set! (-> *online* last-hit-time) (online-now))
        (send-event veh 'attack #f
          (static-attack-info :mask (vehicle-impulse-factor)
            ((id (new-attack-id)) (damage (* 1.5 dmg)) (vehicle-damage-factor 1.0) (vehicle-impulse-factor 0.6) (mode 'generic) (vector away))
            )
          )
        #t
        )
      )
    )
  )

(defun online-track-vehicle! ()
  "mon vehicule est detruit par un autre joueur : recompense pour lui (recu signe)"
  (let* ((rt *online*)
         (veh (online-my-vehicle))
         )
    (when (and veh (!= (process->handle veh) (-> rt veh-watch)))
      (set! (-> rt veh-watch) (process->handle veh))
      (set! (-> rt veh-dead-sent) #f)
      )
    (let ((w (the-as process-focusable (handle->process (-> rt veh-watch)))))
      (when (and w (focus-test? w dead) (not (-> rt veh-dead-sent)))
        (set! (-> rt veh-dead-sent) #t)
        (if (and (nonzero? (-> rt veh-hit-by)) (< (- (online-now) (-> rt veh-hit-time)) (seconds 10)))
            (online-push-out-event! ONLINE_EVENT_VEH_DEAD (-> rt veh-hit-by) 0.0 0 (the-as vector #f))
            )
        )
      )
    )
  (none)
  )

(defun online-apply-in-event! ((ev online-event))
  (if (= (-> ev kind) ONLINE_EVENT_KILL)
      (+! (-> *online* kills) 1)
      )
  (if (>= (-> ev kind) (the-as uint ONLINE_EVENT_CMD))
      (online-world-in-event! ev)
      )
  (let ((t *target*))
    (when (and (= (-> ev kind) ONLINE_EVENT_HIT)
               t
               (online-pvp-allowed?)
               (not (paused?))
               )
      (cond
        ((= (-> ev mode) ONLINE_MODE_LIFT)
         ;; tir de gravite : en vehicule, c'est le vehicule qui s'envole
         (when (not (online-world-vehicle-lift! (-> ev dir)))
           (let ((lift (vector-float*! (new-stack-vector0) (-> ev dir) (meters 6.0))))
             (set! (-> lift y) (meters 40.0))
             (send-event t 'push-transv lift (seconds 0.45))
             )
           )
         )
        ;; en vehicule : c'est le vehicule qui prend les coups (il peut exploser)
        ((online-my-vehicle-hit! ev)
         )
        ((online-can-take-damage? t)
         (let ((away (vector-float*! (new-stack-vector0) (vector-normalize-copy! (new-stack-vector0) (-> ev dir) 1.0) (meters 8.0)))
               (damage (fmax 0.5 (fmin 20.0 (-> ev damage))))
               (strong? (or (= (-> ev mode) ONLINE_MODE_DARK) (= (-> ev mode) ONLINE_MODE_EXPLODE) (= (-> ev mode) ONLINE_MODE_IMPACT)))
               )
           ;; super-pouvoir "peau d'acier" : degats divises par deux
           (if (< 0.0 (-> *online-ext* power-left ONLINE_POW_STEEL))
               (set! damage (fmax 0.5 (* 0.5 damage)))
               )
           (set! (-> away y) (if strong? (meters 9.0) (meters 2.0)))
           (if strong?
               (vector-float*! away away 2.0)
               )
           (set! (-> *online* last-hit-by) (-> ev player-id))
           (set! (-> *online* last-hit-time) (online-now))
           (let ((nonlethal? (< damage (-> t fact health))))
             (send-event
               t
               'attack
               #f
               (static-attack-info :mask (vehicle-impulse-factor)
                                   ((id (new-attack-id))
                                    (damage damage)
                                    (vehicle-damage-factor 1.0)
                                    (vehicle-impulse-factor (if strong? 1.5 0.35))
                                    ;; coup fatal : Jak explose et s'effondre (visible par tout le monde)
                                    (mode (if (or (= (-> ev mode) ONLINE_MODE_EXPLODE) (not nonlethal?)) 'explode 'generic))
                                    (vector away)
                                    (attacker-velocity away)
                                    )
                                   )
               )
             (if nonlethal?
                 (online-shove! t damage)
                 )
             )
           )
         )
        )
      )
    )
  (none)
  )

(defun online-process-in-events! ()
  (let ((shm *online-shm*))
    ;; programme redemarre (compteur revenu en arriere) ou gros retard : on se recale
    (let ((pending (the-as int (- (-> shm in-write) (-> shm in-read)))))
      (if (or (< pending 0) (< 16 pending))
          (set! (-> shm in-read) (-> shm in-write))
          )
      )
    (while (!= (-> shm in-read) (-> shm in-write))
      (online-apply-in-event! (-> shm in-events (logand (-> shm in-read) 15)))
      (+! (-> shm in-read) 1)
      )
    )
  (none)
  )

(defun online-track-death! ()
  "signale sa mort (et le tueur eventuel) au reste de la session"
  (let* ((rt *online*)
         (t *target*)
         (dead? (and t (focus-test? t dead)))
         )
    (when (and dead? (not (-> rt was-dead)))
      (+! (-> rt deaths) 1)
      (let ((killer (if (< (- (online-now) (-> rt last-hit-time)) (seconds 6)) (-> rt last-hit-by) (the-as uint 0))))
        (online-push-out-event! ONLINE_EVENT_DIED killer 0.0 0 (the-as vector #f))
        )
      (set! (-> rt last-hit-by) (the-as uint 0))
      )
    (set! (-> rt was-dead) (the-as symbol dead?))
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; affichage en jeu (pseudos, statut, messages)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun online-print ((str string) (x float) (y float) (w float) (scale float) (color font-color) (flags font-flags))
  (let ((fc (new 'stack 'font-context *font-default-matrix* (the int x) (the int y) 0.0 color flags)))
    (set-width! fc (the int w))
    (set-height! fc 30)
    (set-scale! fc scale)
    (print-game-text (online-encode str) fc #f 44 *online-draw-bucket*)
    )
  (none)
  )

(defun online-text-height ((str string) (w float) (scale float))
  "hauteur (a l'ecran) d'un texte coupe sur la largeur w"
  (let ((fc (new 'stack 'font-context *font-default-matrix* 0 0 0.0 (font-color white) (font-flags shadow kerning large))))
    (set-width! fc (the int w))
    (set-height! fc 200)
    (set-scale! fc scale)
    (print-game-text (online-encode str) fc #t 44 (bucket-id hud-draw-hud-alpha))
    )
  )

(defun online-ext-player-by-id ((id uint))
  "infos du monde en ligne (niveau, drapeaux, position) d'un joueur, #f si inconnu"
  (let ((ext *online-ext*)
        (found (the-as online-ext-player #f))
        )
    (when (nonzero? id)
      (dotimes (i (min 100 (the-as int (-> ext player-count))))
        (if (and (not found) (= (-> ext players i id) id))
            (set! found (-> ext players i))
            )
        )
      )
    found
    )
  )

(defun online-box ((x float) (y float) (w float) (h float) (r int) (g int) (b int) (a int))
  (with-dma-buffer-add-bucket ((buf (-> *display* frames (-> *display* on-screen) global-buf)) *online-draw-bucket*)
    (draw-sprite2d-xy buf (the int x) (the int y) (the int w) (the int h) (new 'static 'rgba :r r :g g :b b :a a) #x3fffff)
    )
  (none)
  )

(deftype online-tag-work (structure)
  ((idx    int32 16)
   (dist   float 16)
   (sx     float 16)
   (sy     float 16)
   (count  int32)
   )
  )

(define *online-tags* (new 'global 'online-tag-work))

(defun online-draw-name-tags! ()
  "pseudos au-dessus des joueurs : les plus proches d'abord, et ils ne se chevauchent plus"
  (let ((shm *online-shm*)
        (rt *online*)
        (tw *online-tags*)
        (screen (new 'stack-no-clear 'vector))
        (head (new 'stack-no-clear 'vector))
        )
    (set! (-> tw count) 0)
    (when (and *target* (online-world-names-on?) (not (online-world-blocks-input?)))
      ;; 1. avatars visibles a l'ecran, avec leur distance
      (dotimes (i ONLINE_MAX_PUPPETS)
        (let ((p (online-puppet-proc i)))
          (when (and p (-> p shown))
            (let ((d (vector-vector-distance (-> p root trans) (-> *target* control trans))))
              (when (< d (meters 90.0))
                (vector-copy! head (-> p root trans))
                (+! (-> head y) (meters 2.6))
                (set! (-> head w) 1.0)
                (when (transform-point-vector! screen head)
                  (let ((sx (+ -1792.0 (-> screen x)))
                        (sy (+ -1840.0 (-> screen y)))
                        )
                    (when (and (< 0.0 sx) (< sx 512.0) (< 0.0 sy) (< sy 416.0))
                      ;; insertion triee (plus proche en premier)
                      (let ((k (-> tw count)))
                        (while (and (> k 0) (< d (-> tw dist (+ k -1))))
                          (set! (-> tw idx k) (-> tw idx (+ k -1)))
                          (set! (-> tw dist k) (-> tw dist (+ k -1)))
                          (set! (-> tw sx k) (-> tw sx (+ k -1)))
                          (set! (-> tw sy k) (-> tw sy (+ k -1)))
                          (+! k -1)
                          )
                        (set! (-> tw idx k) i)
                        (set! (-> tw dist k) d)
                        (set! (-> tw sx k) sx)
                        (set! (-> tw sy k) sy)
                        (+! (-> tw count) 1)
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      ;; 2. chaque etiquette monte tant qu'elle chevauche une etiquette deja placee
      (dotimes (n (-> tw count))
        (let ((tries 0)
              (moved #t)
              )
          (while (and moved (< tries 6))
            (set! moved #f)
            (dotimes (m n)
              (when (and (< (fabs (- (-> tw sx n) (-> tw sx m))) 78.0)
                         (< (fabs (- (-> tw sy n) (-> tw sy m))) 17.0)
                         )
                (set! (-> tw sy n) (+ (-> tw sy m) -18.0))
                (set! moved #t)
                )
              )
            (+! tries 1)
            )
          )
        )
      ;; 3. dessin (le plus loin d'abord : le plus proche reste lisible par-dessus)
      (let ((n (-> tw count)))
        (while (> n 0)
          (+! n -1)
          (let* ((i (-> tw idx n))
                 (rs (-> shm remote i))
                 (sx (-> tw sx n))
                 (sy (-> tw sy n))
                 (d (-> tw dist n))
                 (scale (fmax 0.3 (fmin 0.42 (- 0.46 (* 0.0016 (/ d 4096.0))))))
                 (name (online-chars->string (-> rt names i) (-> rs name) 16))
                 (xp (online-ext-player-by-id (-> rs player-id)))
                 (lv (if xp (the-as int (-> xp level)) 1))
                 (hp (-> rs pos w))
                 )
            (format (clear (-> rt tmp-str))
                    (cond
                      ((logtest? (-> rs flags) ONLINE_FLAG_DEAD) (online-fr "Nv~D ~S  (ELIMINE)" "Lv~D ~S  (DOWN)"))
                      ((and xp (logtest? (-> xp flags) ONLINE_PX_CREATEUR)) (online-fr "Nv~D ~S (CREATEUR)" "Lv~D ~S (CREATOR)"))
                      ((and xp (logtest? (-> xp flags) ONLINE_PX_BOUNTY)) (online-fr "Nv~D ~S (PRIME)" "Lv~D ~S (BOUNTY)"))
                      (else (online-fr "Nv~D ~S" "Lv~D ~S"))
                      )
                    lv
                    name
                    )
            (online-print (-> rt tmp-str)
                          (+ -100.0 sx)
                          (+ -16.0 sy)
                          200.0
                          scale
                          (cond
                            ((logtest? (-> rs flags) ONLINE_FLAG_DEAD) (font-color red))
                            ((and xp (logtest? (-> xp flags) ONLINE_PX_BOUNTY)) (font-color orange))
                            ((and xp (logtest? (-> xp flags) ONLINE_PX_CREATEUR)) (font-color flat-yellow))
                            (else (ow-rank-color lv))
                            )
                          (font-flags shadow kerning middle large)
                          )
            ;; barre de vie (au lieu du texte "8 PV")
            (when (not (logtest? (-> rs flags) ONLINE_FLAG_DEAD))
              (let ((frac (fmax 0.0 (fmin 1.0 (/ hp 16.0)))))
                (online-box (+ -20.0 sx) (+ -2.0 sy) 40.0 3.0 20 20 20 110)
                (online-box (+ -20.0 sx) (+ -2.0 sy) (* 40.0 frac) 3.0 (if (< hp 3.0) 255 60) (if (< hp 3.0) 40 220) 40 128)
                )
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun online-draw-hud! ()
  (let ((shm *online-shm*)
        (rt *online*)
        (now (online-now))
        )
    ;; ligne de statut (sessions privees ; dans le monde en ligne, le HUD des orbes la remplace)
    (when (and (online-in-session?) (not (online-world-active?)))
      (let ((code (online-chars->string (-> rt tmp-str2) (-> shm session-code) 8)))
        (format (clear (-> rt tmp-str))
                (online-fr "EN LIGNE ~S ~D/~D PVP ~S K~D M~D" "ONLINE ~S ~D/~D PVP ~S K~D D~D")
                code
                (-> shm session-players)
                (-> shm session-max)
                (if (nonzero? (-> shm pvp-enabled)) "ON" "OFF")
                (-> rt kills)
                (-> rt deaths)
                )
        (online-print (-> rt tmp-str) 14.0 6.0 480.0 0.33 (font-color green) (font-flags shadow kerning large))
        )
      )
    ;; nouveaux messages
    (let ((pending (the-as int (- (-> shm feed-write) (-> rt feed-seen)))))
      (cond
        ((or (< pending 0) (< 8 pending))
         ;; programme redemarre ou gros retard : on se recale sans boucler
         (set! (-> rt feed-seen) (-> shm feed-write))
         )
        (else
          (while (!= (-> rt feed-seen) (-> shm feed-write))
            (set! (-> rt feed-time (logand (-> rt feed-seen) 7)) now)
            (+! (-> rt feed-seen) 1)
            )
          )
        )
      )
    ;; messages recents (les 4 derniers, 7 secondes), en haut a droite, pas pendant le menu Start
    (let ((y (if *progress-process* 9999.0 20.0)))
      (dotimes (k 4)
        (let* ((n (- (-> shm feed-write) (the-as uint (+ k 1))))
               (slot (logand n 7))
               )
          (when (and (< y 1000.0)
                     (< k (the-as int (-> shm feed-write)))
                     (< (- now (-> rt feed-time slot)) (seconds 7))
                     (nonzero? (-> shm feed slot text 0))
                     )
            (online-chars->string (-> rt feed-str) (-> shm feed slot text) 64)
            (online-print (-> rt feed-str) 498.0 y 270.0 0.3 (font-color yellow) (font-flags shadow kerning right large))
            (set! y (+ y 12.0))
            )
          )
        )
      )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; menu Start "en direct"
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; En session, l'anneau du menu Start et la page EN LIGNE ne mettent pas le jeu en
;; pause : le monde, les autres joueurs et le reseau continuent. Jak reste immobile
;; (sa manette est remplacee par la manette 2, neutre) et le menu se ferme tout seul
;; s'il meurt ou si une cinematique commence.
;;
;; Les autres pages (carte, sauvegarder / charger, options...) ont besoin de la
;; carte du menu, que le jeu charge a la place de l'image du monde : pour elles on
;; repasse en pause classique (image figee). Pour que l'anneau ne reste pas
;; imprime dans l'image figee, on le cache pendant la capture.

(defconstant ONLINE_LIVE_OFF 0)     ;; pas de menu en direct
(defconstant ONLINE_LIVE_ON 1)      ;; menu en direct (jeu qui tourne)
(defconstant ONLINE_LIVE_HIDE 2)    ;; anneau cache, capture de l'image a l'image suivante
(defconstant ONLINE_LIVE_FROZEN 3)  ;; page classique (jeu en pause, image figee)

(define *online-live-state* ONLINE_LIVE_OFF)
(define *online-live-frames* 0)

(defun online-live-page? ((s symbol))
  (or (= s 'main) (= s 'online) (= s 'none) (= s 'go-away)))

(defun online-progress-hide! ((prog progress) (hide symbol))
  "cache / montre l'anneau du menu (et ses cases)"
  (if hide
      (logior! (-> prog draw status) (draw-control-status no-draw))
      (logclear! (-> prog draw status) (draw-control-status no-draw))
      )
  (let ((c (-> prog child)))
    (while c
      (let ((p (ppointer->process c)))
        (when (and p (type? p process-drawable) (nonzero? (-> (the-as process-drawable p) draw)))
          (if hide
              (logior! (-> (the-as process-drawable p) draw status) (draw-control-status no-draw))
              (logclear! (-> (the-as process-drawable p) draw status) (draw-control-status no-draw))
              )
          )
        )
      (set! c (-> c 0 brother))
      )
    )
  (none)
  )

(defun online-live-input! ((block symbol))
  "bloque (manette 2, neutre) ou rend la manette de Jak"
  (let ((rt *online*)
        (t *target*)
        )
    (when (and t (nonzero? (-> t control)))
      (cond
        (block
          (set! (-> t control cpad) (-> *cpad-list* cpads 1))
          )
        ((-> rt live-input)
         (set! (-> t control cpad) (-> *cpad-list* cpads 0))
         )
        )
      )
    (set! (-> rt live-input) block)
    )
  (none)
  )

(defun online-live-set! ((on symbol))
  "jeu qui tourne (#t) ou pause classique (#f) pendant le menu"
  (when (!= on *online-live-menu*)
    (set! *online-live-menu* on)
    (apply-settings *setting-control*)
    (if on
        (sound-group-continue (the-as sound-group #xffffffff))
        (sound-group-pause (the-as sound-group #xffffffff))
        )
    )
  (none)
  )

(defun online-live-menu-update! ()
  (let* ((prog (if *progress-process* (-> *progress-process* 0) (the-as progress #f)))
         (want (and prog
                    (online-in-session?)
                    *target*
                    (!= (-> prog starting-state) 'title)
                    )
               )
         )
    ;; en session : pas de pause simple (fenetre inactive, manette debranchee...)
    (set! *online-no-pause* (the-as symbol (and (online-in-session?) *target*)))
    (cond
      ((not want)
       ;; plus de menu (ou plus en session) : on rend tout
       (when (and prog (= *online-live-state* ONLINE_LIVE_HIDE))
         (online-progress-hide! prog #f)
         )
       (when *online-live-menu*
         (online-live-set! #f)
         (if (and prog (= *master-mode* 'progress) (!= (-> prog next) 'go-away))
             (set-menu-mode *blit-displays-work* #t)
             )
         )
       (set! *online-live-state* ONLINE_LIVE_OFF)
       (set! *online-block-live* #f)
       )
      (else
        (let* ((classic? (or (not (online-live-page? (-> prog current)))
                             (not (online-live-page? (-> prog next)))
                             )
                         )
               (faded? (< 0.99 (-> prog menu-transition)))
               (closing? (or (= (-> prog next) 'go-away)
                             (and (-> prog next-state) (= (-> prog next-state name) 'gone))
                             )
                         )
               )
          (case *online-live-state*
            ((ONLINE_LIVE_OFF)
             ;; ouverture du menu : directement en direct. La carte (chargee a la place de
             ;; l'image du monde) ne doit pas rester en memoire pendant que le jeu est dessine.
             (if (-> *bigmap* drawing-flag)
                 (disable-drawing *bigmap*)
                 )
             (online-live-set! #t)
             (set! *online-live-state* ONLINE_LIVE_ON)
             )
            ((ONLINE_LIVE_ON)
             (when (and classic? faded? (not closing?))
               ;; page classique demandee : on cache l'anneau pour la capture
               (online-progress-hide! prog #t)
               (set! *online-live-frames* 0)
               (set! *online-live-state* ONLINE_LIVE_HIDE)
               )
             )
            ((ONLINE_LIVE_HIDE)
             (online-progress-hide! prog #t)
             (+! *online-live-frames* 1)
             (when (= *online-live-frames* 1)
               ;; image capturee sans l'anneau, puis page classique + chargement de la carte.
               ;; EN LIGNE, LE JEU CONTINUE DE TOURNER (pas de pause : on ne peut pas se mettre
               ;; a l'abri d'un combat en ouvrant les options) ; seul le dessin du monde s'arrete.
               (if (not (-> *bigmap* drawing-flag))
                   (enable-drawing *bigmap*)
                   )
               (set-menu-mode *blit-displays-work* #t)
               )
             (when (< 2 *online-live-frames*)
               (online-progress-hide! prog #f)
               (set! *online-live-state* ONLINE_LIVE_FROZEN)
               )
             )
            ((ONLINE_LIVE_FROZEN)
             (when (and (not classic?) faded? (not closing?))
               ;; retour a l'anneau : on libere la carte et le jeu reprend
               (if (-> *bigmap* drawing-flag)
                   (disable-drawing *bigmap*)
                   )
               (set-menu-mode *blit-displays-work* #f)
               (online-live-set! #t)
               (set! *online-live-state* ONLINE_LIVE_ON)
               )
             )
            )
          (when (or (= *online-live-state* ONLINE_LIVE_ON) (= *online-live-state* ONLINE_LIVE_HIDE)
                    (= *online-live-state* ONLINE_LIVE_FROZEN))
            ;; le jeu reste dessine derriere le menu, sans charger la carte
            (if (= *online-live-state* ONLINE_LIVE_ON)
                (set-menu-mode *blit-displays-work* #f)
                )
            ;; Jak ne bouge pas pendant le menu
            (set! *online-block-live* #t)
            ;; mort ou cinematique : le menu se ferme
            (if (or (focus-test? *target* dead) (movie?))
                (hide-progress-screen)
                )
            )
          )
        )
      )
    )
  (none)
  )

;; banc de test (Jak3Online.exe --visual) : charger une partie, ouvrir le menu,
;; planche, arme, dark / light jak... pour verifier l'affichage des avatars
(defun online-test-command! ((arg int))
  (let ((prog (if *progress-process* (-> *progress-process* 0) (the-as progress #f))))
    (case arg
      ((1 2 3 4)
       ;; charge directement la sauvegarde (comme le menu "charger")
       (if (and (not (handle->process (-> *game-info* auto-save-proc))) (not (movie?)))
           (auto-save-command 'restore 0 (+ arg -1) *default-pool* #f)
           )
       )
      ((5)
       ;; ecran titre sans appuyer sur Start
       (when (and *target* (not *progress-process*))
         (set! (-> *setting-control* user-current allow-progress) #t)
         (activate-progress *dproc* 'title)
         )
       )
      ((10)
       (if (and *target* (not *progress-process*))
           (set-master-mode 'progress)
           )
       )
      ((11)
       (hide-progress-screen)
       )
      ((12)
       (if prog
           (set-next-state prog 'bigmap 0)
           )
       )
      ((13)
       (if prog
           (set-next-state prog 'main 0)
           )
       )
      ((14)
       (if prog
           (set-next-state prog 'select-load 0)
           )
       )
      ((20)
       (if *target*
           (send-event *target* 'change-mode 'board #f)
           )
       )
      ((21)
       (if *target*
           (send-event *target* 'change-mode 'gun #f (-> *game-info* gun-type))
           )
       )
      ((22)
       (if *target*
           (send-event *target* 'change-mode 'darkjak #f (darkjak-stage force-on active))
           )
       )
      ((23)
       (if *target*
           (send-event *target* 'change-mode 'lightjak #f (lightjak-stage ls0 swoop))
           )
       )
      ((24)
       (if *target*
           (send-event *target* 'end-mode 'board)
           )
       )
      ((40)
       ;; effet de coup sur tous les avatars (verifie le son et les etincelles)
       (dotimes (i ONLINE_MAX_PUPPETS)
         (let ((p (online-puppet-proc i)))
           (if p
               (online-puppet-hit-fx! p)
               )
           )
         )
       )
      ((31 32 33 34)
       ;; 31 desert, 32 Haven City (bidonville), 33 mission tir de Spargus, 34 port de Haven
       (let ((cp (get-continue-by-name *game-info*
                                       (case arg
                                         ((31) "desert-start")
                                         ((32) "ctysluma-start")
                                         ((33) "wascityb-gungame")
                                         (else "ctyport-start")
                                         )
                                       )
                 )
             )
         (if (and *target* cp)
             (start 'play cp)
             )
         )
       )
      ((50 51 52)
       ;; monter dans un vehicule : 50 buggy toad, 51 snake, 52 moto de la ville
       (if *target*
           (send-event *target* 'change-mode 'pilot #f (case arg
                                                          ((50) (vehicle-type v-toad))
                                                          ((51) (vehicle-type v-snake))
                                                          (else (vehicle-type h-bike-a))
                                                          )
                       )
           )
       )
      ((30)
       ;; va dans la ville de Spargus (zone ouverte)
       (let ((cp (get-continue-by-name *game-info* "wascitya-start")))
         (if (and *target* cp)
             (start 'play cp)
             )
         )
       )
      (else
        ;; monde en ligne (menu TAB, boutique, vehicules...)
        (online-world-test! arg)
        )
      )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; boucle principale (appelee chaque image par display-loop-main)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define *online-parts-logged* #f)

(defun online-log-parts! ()
  "journal : quelles pieces (Daxter, arme, planche, ailes) les avatars peuvent afficher"
  (when (and *target* (not *online-parts-logged*))
    (set! *online-parts-logged* #t)
    (format 0 "[jak3-online] pieces des avatars : daxter ~A arme ~A planche ~A ailes ~A~%"
            (online-skel-usable? (online-part-skel ONLINE_PART_DAXTER) (the-as level #f))
            (online-skel-usable? (online-part-skel ONLINE_PART_GUN) (the-as level #f))
            (online-skel-usable? (online-part-skel ONLINE_PART_BOARD) (the-as level #f))
            (online-skel-usable? (online-part-skel ONLINE_PART_WINGS) (the-as level #f))
            )
    )
  (none)
  )

(defun online-update ()
  (online-log-parts!)
  (let ((shm *online-shm*)
        (rt *online*)
        )
    (+! (-> shm game-frame) 1)
    (when (and (nonzero? (-> shm test-seq)) (!= (-> shm test-seq) (-> rt test-seen)))
      (set! (-> rt test-seen) (-> shm test-seq))
      (online-test-command! (the-as int (-> shm test-arg)))
      )
    (when (and *online-kb-disabled*
               (or (not *progress-process*)
                   (not (-> rt companion-alive))
                   )
               )
      (online-kb-end!)
      )
    ;; echange avec Jak3Online.exe (fichiers)
    (online-bridge-open!)
    (online-bridge-read!)
    ;; le programme Jak3Online.exe est-il vivant ?
    (let ((beat (-> shm bridge-beat)))
      (when (!= beat (-> rt last-beat))
        ;; la premiere valeur lue peut venir d'un ancien fichier (programme ferme) :
        ;; le programme n'est vivant que si le battement CHANGE ensuite
        (if (nonzero? (-> rt last-beat))
            (set! (-> rt beat-time) (online-now))
            )
        (set! (-> rt last-beat) beat)
        )
      (set! (-> rt companion-alive)
            (the-as symbol (and (nonzero? beat) (< (- (online-now) (-> rt beat-time)) (seconds 3))))
            )
      )
    (let ((in-session (online-in-session?)))
      (when (and (-> rt in-session-prev) (not in-session))
        ;; on vient de quitter la session
        (set! (-> rt kills) (the-as uint 0))
        (set! (-> rt deaths) (the-as uint 0))
        )
      (set! (-> rt in-session-prev) (the-as symbol in-session))
      (online-live-menu-update!)
      ;; monde en ligne : touches, chat, menu TAB, boutique, carte, commandes...
      (online-world-update (the-as symbol in-session))
      (online-write-local!)
      (online-update-puppets! in-session)
      (online-apply-poses!)
      (cond
        (in-session
         (online-track-death!)
         (online-track-vehicle!)
         (online-process-in-events!)
         (if (and *target* (not (paused?)))
             (online-pvp-melee! *target*)
             )
         (when (not *progress-process*)
           (online-draw-name-tags!)
           )
         )
        (else
          ;; hors session : on ignore les evenements en attente
          (set! (-> shm in-read) (-> shm in-write))
          )
        )
      (when (-> rt companion-alive)
        (online-draw-hud!)
        (online-world-draw (the-as symbol in-session))
        )
      ;; Jak immobile pendant les menus (menu Start en direct, TAB, boutique, chat) ou s'il est gele
      (online-live-input! (the-as symbol (or *online-block-live* (online-world-blocks-input?))))
      (online-bridge-write!)
      )
    )
  (none)
  )

(defun online-count-kill! ()
  (+! (-> *online* kills) 1)
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; menu EN LIGNE (menu Start)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defconstant ONLINE_VIEW_MAIN 0)
(defconstant ONLINE_VIEW_BROWSER 1)
(defconstant ONLINE_VIEW_CODE 2)
(defconstant ONLINE_VIEW_PLAYERS 3)
(defconstant ONLINE_VIEW_NAME 4)
(defconstant ONLINE_ROWS 7)
(defconstant ONLINE_NAME_LEN 12)

;; entrees de la page principale
(defconstant ONLINE_IT_NEW 1)
(defconstant ONLINE_IT_LOAD 2)
(defconstant ONLINE_IT_CREATE_PUB 3)
(defconstant ONLINE_IT_CREATE_PRIV 4)
(defconstant ONLINE_IT_MAX 5)
(defconstant ONLINE_IT_PVP_NEW 6)
(defconstant ONLINE_IT_JOIN_PUB 7)
(defconstant ONLINE_IT_JOIN_CODE 8)
(defconstant ONLINE_IT_PLAYERS 9)
(defconstant ONLINE_IT_PVP 10)
(defconstant ONLINE_IT_VIS 11)
(defconstant ONLINE_IT_LEAVE 12)
(defconstant ONLINE_IT_NAME 13)
(defconstant ONLINE_IT_GETSAVE 14)
(defconstant ONLINE_IT_SAVESYNC 15)
(defconstant ONLINE_IT_ADDBOT 16)
(defconstant ONLINE_IT_WORLD 17)

(define *online-name-chars* " ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-")

(deftype menu-online-option (menu-option)
  ((view         int32)
   (selected     int32)
   (list-index   int32)
   (list-scroll  int32)
   (max-players  int32)
   (pvp-off      symbol)
   (code         int8       8)
   (code-pos     int32)
   (last-move    time-frame)
   (items        int8       16)
   (item-count   int32)
   (pseudo       int8       16)
   (pseudo-pos   int32)
   (kb-seen      uint32)
   (save-choice  int32)
   )
  )

(define *online-options*
  (new 'static 'menu-option-list
    :y-center 198
    :y-space 34
    :scale 0.82
    :options (new 'static 'boxed-array :type menu-option
      (new 'static 'menu-online-option :name (text-id progress-online) :max-players 100 :pvp-off #f :save-choice 3)
      )
    )
  )

(defun online-menu-reset! ()
  "appele quand on ouvre la page en ligne"
  (let ((opt (the-as menu-online-option (-> *online-options* options 0))))
    (online-kb-end!)
    (set! (-> opt view) ONLINE_VIEW_MAIN)
    (set! (-> opt selected) 0)
    (set! (-> opt list-index) 0)
    (set! (-> opt list-scroll) 0)
    (if (or (< (-> opt save-choice) 0) (< 3 (-> opt save-choice)))
        (set! (-> opt save-choice) 3)
        )
    (if (or (< (-> opt max-players) 2) (< 100 (-> opt max-players)))
        (set! (-> opt max-players) 100)
        )
    )
  (none)
  )

(defun online-on-title? ((prog progress))
  "menu ouvert depuis l'ecran titre (pas encore de partie chargee) ?"
  (or (= (-> prog starting-state) 'title) (not *target*)))

(defun online-push-item! ((opt menu-online-option) (it int))
  (set! (-> opt items (-> opt item-count)) it)
  (+! (-> opt item-count) 1)
  (none)
  )

;; demande d'entrer tout de suite dans le monde en ligne (menu EN LIGNE de l'ecran titre)
(define *online-world-go* #f)

(defun online-main-items! ((opt menu-online-option) (title? symbol))
  "liste des entrees de la page principale selon la situation"
  (set! (-> opt item-count) 0)
  (cond
    ((online-in-session?)
     (cond
       ((and title? (logtest? (-> *online-ext* flags) ONLINE_XF_WORLD))
        ;; monde en ligne depuis l'ecran titre : pas de partie a choisir, on y entre
        (online-push-item! opt ONLINE_IT_WORLD)
        )
       (title?
         ;; session prete depuis l'ecran titre : on propose de lancer le jeu
         (online-push-item! opt ONLINE_IT_NEW)
         (online-push-item! opt ONLINE_IT_LOAD)
         )
       )
     (when (zero? (-> *online-shm* is-host))
       ;; les invites peuvent recuperer la progression de l'hote
       (online-push-item! opt ONLINE_IT_GETSAVE)
       (online-push-item! opt ONLINE_IT_SAVESYNC)
       )
     (online-push-item! opt ONLINE_IT_PLAYERS)
     (online-push-item! opt ONLINE_IT_ADDBOT)
     (online-push-item! opt ONLINE_IT_PVP)
     (online-push-item! opt ONLINE_IT_VIS)
     (online-push-item! opt ONLINE_IT_NAME)
     (online-push-item! opt ONLINE_IT_LEAVE)
     )
    (else
      ;; LA session publique : tout le monde s'y retrouve, sans code
      (online-push-item! opt ONLINE_IT_WORLD)
      (online-push-item! opt ONLINE_IT_CREATE_PUB)
      (online-push-item! opt ONLINE_IT_CREATE_PRIV)
      (online-push-item! opt ONLINE_IT_MAX)
      (online-push-item! opt ONLINE_IT_PVP_NEW)
      (online-push-item! opt ONLINE_IT_JOIN_PUB)
      (online-push-item! opt ONLINE_IT_JOIN_CODE)
      (online-push-item! opt ONLINE_IT_NAME)
      )
    )
  (-> opt item-count)
  )

(defun online-name-char-index ((c uint))
  (let ((idx 0))
    (dotimes (i (length *online-name-chars*))
      (if (and (zero? idx) (= (-> *online-name-chars* data i) c))
          (set! idx i)
          )
      )
    idx
    )
  )

(defun online-kb-begin! ()
  "ouverture de l'editeur de pseudo : le programme lit le clavier"
  (set! (-> *online-shm* kb-edit) (the-as uint 1))
  (when (and (online-companion-alive?) (not *online-kb-disabled*))
    (set! *online-kb-prev* (pc-get-keyboard-enabled?))
    (pc-set-keyboard-enabled! #f)
    (set! *online-kb-disabled* #t)
    )
  (none)
  )

(defun online-kb-end! ()
  "fermeture de l'editeur : on rend le clavier au jeu"
  (set! (-> *online-shm* kb-edit) (the-as uint 0))
  (when *online-kb-disabled*
    (pc-set-keyboard-enabled! *online-kb-prev*)
    (set! *online-kb-disabled* #f)
    )
  (none)
  )

(defun online-kb-apply! ((opt menu-online-option))
  "recopie le texte tape au clavier dans l'editeur"
  (let ((src (-> *online-shm* kb-text))
        (len 0)
        )
    (dotimes (i ONLINE_NAME_LEN)
      (cond
        ((nonzero? (-> src i))
         (set! (-> opt pseudo i) (online-name-char-index (-> src i)))
         (set! len (+ i 1))
         )
        (else
          (set! (-> opt pseudo i) 0)
          )
        )
      )
    (set! (-> opt pseudo-pos) (min len (+ ONLINE_NAME_LEN -1)))
    )
  (none)
  )

(defun online-name-begin! ((opt menu-online-option))
  "prepare l'edition du pseudo a partir du pseudo actuel"
  (let ((src (-> *online-shm* my-name)))
    (dotimes (i ONLINE_NAME_LEN)
      (set! (-> opt pseudo i) (if (nonzero? (-> src i)) (online-name-char-index (-> src i)) 0))
      )
    (let ((len 0))
      (while (and (< len ONLINE_NAME_LEN) (nonzero? (-> src len)))
        (+! len 1)
        )
      (set! (-> opt pseudo-pos) (min len (+ ONLINE_NAME_LEN -1)))
      )
    )
  (none)
  )

(defun online-name-commit! ((opt menu-online-option))
  "envoie le nouveau pseudo a Jak3Online.exe"
  (let ((dst (-> *online-shm* req-name))
        (last -1)
        )
    (dotimes (i ONLINE_NAME_LEN)
      (if (nonzero? (-> opt pseudo i))
          (set! last i)
          )
      )
    (dotimes (i 16)
      (set! (-> dst i) (cond
                         ((> i last) (the-as uint 0))
                         ((zero? (-> opt pseudo i)) (the-as uint 95)) ;; espace -> _
                         (else (-> *online-name-chars* data (-> opt pseudo i)))
                         )
            )
      )
    (when (>= last 0)
      (online-request! ONLINE_REQ_NAME 0)
      )
    )
  (none)
  )

(defun online-is-host? ()
  (and (online-in-session?) (nonzero? (-> *online-shm* is-host))))

(defun online-send-settings! ((pvp symbol) (public symbol))
  (online-request! ONLINE_REQ_SETTINGS (logior (if pvp 1 0) (if public 2 0)))
  (none)
  )

(defmacro online-menu-move? (&rest buttons)
  "appui, ou maintien avec repetition"
  `(or (cpad-pressed? 0 ,@buttons)
       (and (cpad-hold? 0 ,@buttons) (>= (- (online-now) (-> this last-move)) (seconds 0.15)))))

(defmethod respond-progress ((this menu-online-option) (arg0 progress) (arg1 symbol))
  (let ((shm *online-shm*)
        (connected (online-connected?))
        (in-session (online-in-session?))
        )
    (case (-> this view)
      ;; ---------------- page principale
      ((ONLINE_VIEW_MAIN)
       (let* ((count (online-main-items! this (online-on-title? arg0)))
              (it (begin
                    (if (>= (-> this selected) count)
                        (set! (-> this selected) 0)
                        )
                    (-> this items (-> this selected))
                    )
                  )
              )
         (cond
           ((online-menu-move? up l-analog-up)
            (set! (-> this last-move) (online-now))
            (sound-play "roll-over")
            (set! (-> this selected) (if (<= (-> this selected) 0) (+ count -1) (+ (-> this selected) -1)))
            )
           ((online-menu-move? down l-analog-down)
            (set! (-> this last-move) (online-now))
            (sound-play "roll-over")
            (set! (-> this selected) (if (>= (-> this selected) (+ count -1)) 0 (+ (-> this selected) 1)))
            )
           ((or (online-menu-move? left l-analog-left) (online-menu-move? right l-analog-right))
            (let ((dir (if (cpad-hold? 0 left l-analog-left) -1 1)))
              (set! (-> this last-move) (online-now))
              (case it
                ((ONLINE_IT_MAX)
                 (sound-play "roll-over")
                 (set! (-> this max-players)
                       (max 2 (min 100 (+ (-> this max-players) (* dir (if (cpad-hold? 0 r1 l1) 10 1))))))
                 )
                ((ONLINE_IT_PVP_NEW)
                 (sound-play "roll-over")
                 (set! (-> this pvp-off) (not (-> this pvp-off)))
                 )
                ((ONLINE_IT_GETSAVE)
                 (sound-play "roll-over")
                 (set! (-> this save-choice) (logand (+ (-> this save-choice) dir 4) 3))
                 )
                ((ONLINE_IT_SAVESYNC)
                 (sound-play "roll-over")
                 (online-request! ONLINE_REQ_SAVESYNC (if (nonzero? (-> shm save-sync)) 0 1))
                 )
                ((ONLINE_IT_PVP)
                 (when (online-is-host?)
                   (sound-play "roll-over")
                   (online-send-settings! (zero? (-> shm pvp-enabled)) (nonzero? (-> shm session-public)))
                   )
                 )
                ((ONLINE_IT_VIS)
                 (when (online-is-host?)
                   (sound-play "roll-over")
                   (online-send-settings! (nonzero? (-> shm pvp-enabled)) (zero? (-> shm session-public)))
                   )
                 )
                )
              )
            )
           ((cpad-pressed? 0 confirm)
            (cpad-clear! 0 confirm)
            (case it
              ((ONLINE_IT_NEW)
               (sound-play "window-expand")
               (push-state arg0)
               (set-next-state arg0 'select-save-title 0)
               )
              ((ONLINE_IT_LOAD)
               (sound-play "window-expand")
               (push-state arg0)
               (set-next-state arg0 'select-load 0)
               )
              ((ONLINE_IT_CREATE_PUB ONLINE_IT_CREATE_PRIV)
               (cond
                 (connected
                   (sound-play "window-expand")
                   (online-request! ONLINE_REQ_CREATE
                                    (logior (-> this max-players)
                                            (if (-> this pvp-off) 0 #x100)
                                            (if (= it ONLINE_IT_CREATE_PUB) #x200 0)
                                            )
                                    )
                   (set! (-> this selected) 0)
                   )
                 (else
                   (sound-play "generic-beep")
                   )
                 )
               )
              ((ONLINE_IT_MAX)
               (sound-play "roll-over")
               )
              ((ONLINE_IT_PVP_NEW)
               (sound-play "roll-over")
               (set! (-> this pvp-off) (not (-> this pvp-off)))
               )
              ((ONLINE_IT_WORLD)
               (cond
                 ((and (online-in-session?) (logtest? (-> *online-ext* flags) ONLINE_XF_WORLD))
                  ;; deja dans la session du monde : on y entre
                  (sound-play "window-expand")
                  (set! *online-world-go* #t)
                  )
                 (connected
                   (sound-play "window-expand")
                   ;; choisi par le joueur : pas de compte a rebours, on y entre des que possible
                   (set! *online-world-go* #t)
                   (online-request! ONLINE_REQ_JOIN_WORLD 0)
                   )
                 (else
                   (sound-play "generic-beep")
                   )
                 )
               )
              ((ONLINE_IT_JOIN_PUB)
               (cond
                 (connected
                   (sound-play "window-expand")
                   (online-request! ONLINE_REQ_LIST 0)
                   (set! (-> this view) ONLINE_VIEW_BROWSER)
                   (set! (-> this list-index) 0)
                   (set! (-> this list-scroll) 0)
                   )
                 (else
                   (sound-play "generic-beep")
                   )
                 )
               )
              ((ONLINE_IT_JOIN_CODE)
               (cond
                 (connected
                   (sound-play "window-expand")
                   (set! (-> this view) ONLINE_VIEW_CODE)
                   (set! (-> this code-pos) 0)
                   )
                 (else
                   (sound-play "generic-beep")
                   )
                 )
               )
              ((ONLINE_IT_NAME)
               (cond
                 ((online-companion-alive?)
                  (sound-play "window-expand")
                  (online-name-begin! this)
                  (set! (-> this kb-seen) (-> shm kb-seq))
                  (online-kb-begin!)
                  (set! (-> this view) ONLINE_VIEW_NAME)
                  )
                 (else
                   (sound-play "generic-beep")
                   )
                 )
               )
              ((ONLINE_IT_PLAYERS)
               (sound-play "window-expand")
               (set! (-> this view) ONLINE_VIEW_PLAYERS)
               (set! (-> this list-index) 0)
               (set! (-> this list-scroll) 0)
               )
              ((ONLINE_IT_PVP)
               (cond
                 ((online-is-host?)
                  (sound-play "roll-over")
                  (online-send-settings! (zero? (-> shm pvp-enabled)) (nonzero? (-> shm session-public)))
                  )
                 (else
                   (sound-play "generic-beep")
                   )
                 )
               )
              ((ONLINE_IT_VIS)
               (cond
                 ((online-is-host?)
                  (sound-play "roll-over")
                  (online-send-settings! (nonzero? (-> shm pvp-enabled)) (zero? (-> shm session-public)))
                  )
                 (else
                   (sound-play "generic-beep")
                   )
                 )
               )
              ((ONLINE_IT_ADDBOT)
               (sound-play "window-expand")
               (online-request! ONLINE_REQ_ADDBOT 0)
               )
              ((ONLINE_IT_GETSAVE)
               (sound-play "window-expand")
               (online-request! ONLINE_REQ_GETSAVE (-> this save-choice))
               )
              ((ONLINE_IT_SAVESYNC)
               (sound-play "roll-over")
               (online-request! ONLINE_REQ_SAVESYNC (if (nonzero? (-> shm save-sync)) 0 1))
               )
              ((ONLINE_IT_LEAVE)
               (sound-play "window-expand")
               (online-request! ONLINE_REQ_LEAVE 0)
               (set! (-> this selected) 0)
               )
              )
            )
           ((cpad-pressed? 0 triangle)
            (cpad-clear! 0 triangle)
            (sound-play "generic-beep")
            (pop-state arg0)
            )
           )
         )
       )
      ;; ---------------- edition du pseudo
      ((ONLINE_VIEW_NAME)
       (let ((nchars (length *online-name-chars*)))
         ;; texte tape au clavier (via Jak3Online.exe)
         (when (!= (-> shm kb-seq) (-> this kb-seen))
           (set! (-> this kb-seen) (-> shm kb-seq))
           (online-kb-apply! this)
           (case (-> shm kb-cmd)
             ((1)
              (sound-play "window-expand")
              (online-name-commit! this)
              (online-kb-end!)
              (set! (-> this view) ONLINE_VIEW_MAIN)
              )
             ((2)
              (sound-play "generic-beep")
              (online-kb-end!)
              (set! (-> this view) ONLINE_VIEW_MAIN)
              )
             )
           )
         (cond
           ((online-menu-move? left l-analog-left)
            (set! (-> this last-move) (online-now))
            (sound-play "roll-over")
            (set! (-> this pseudo-pos) (if (<= (-> this pseudo-pos) 0) (+ ONLINE_NAME_LEN -1) (+ (-> this pseudo-pos) -1)))
            )
           ((online-menu-move? right l-analog-right)
            (set! (-> this last-move) (online-now))
            (sound-play "roll-over")
            (set! (-> this pseudo-pos) (if (>= (-> this pseudo-pos) (+ ONLINE_NAME_LEN -1)) 0 (+ (-> this pseudo-pos) 1)))
            )
           ((online-menu-move? up l-analog-up)
            (set! (-> this last-move) (online-now))
            (sound-play "roll-over")
            (let ((c (-> this pseudo (-> this pseudo-pos))))
              (set! (-> this pseudo (-> this pseudo-pos)) (if (>= c (+ nchars -1)) 0 (+ c 1)))
              )
            )
           ((online-menu-move? down l-analog-down)
            (set! (-> this last-move) (online-now))
            (sound-play "roll-over")
            (let ((c (-> this pseudo (-> this pseudo-pos))))
              (set! (-> this pseudo (-> this pseudo-pos)) (if (<= c 0) (+ nchars -1) (+ c -1)))
              )
            )
           ((cpad-pressed? 0 square)
            ;; effacer la lettre
            (cpad-clear! 0 square)
            (sound-play "roll-over")
            (set! (-> this pseudo (-> this pseudo-pos)) 0)
            )
           ((cpad-pressed? 0 confirm)
            (cpad-clear! 0 confirm)
            (sound-play "window-expand")
            (online-name-commit! this)
            (online-kb-end!)
            (set! (-> this view) ONLINE_VIEW_MAIN)
            )
           ((cpad-pressed? 0 triangle)
            (cpad-clear! 0 triangle)
            (sound-play "generic-beep")
            (online-kb-end!)
            (set! (-> this view) ONLINE_VIEW_MAIN)
            )
           )
         )
       )
      ;; ---------------- liste des sessions publiques
      ((ONLINE_VIEW_BROWSER)
       (let ((count (min (the-as int (-> shm list-count)) ONLINE_MAX_SESSIONS)))
         (cond
           ((online-menu-move? up l-analog-up)
            (set! (-> this last-move) (online-now))
            (when (< 0 (-> this list-index))
              (sound-play "roll-over")
              (+! (-> this list-index) -1)
              )
            )
           ((online-menu-move? down l-analog-down)
            (set! (-> this last-move) (online-now))
            (when (< (-> this list-index) (+ count -1))
              (sound-play "roll-over")
              (+! (-> this list-index) 1)
              )
            )
           ((cpad-pressed? 0 square)
            (cpad-clear! 0 square)
            (sound-play "roll-over")
            (online-request! ONLINE_REQ_LIST 0)
            )
           ((cpad-pressed? 0 confirm)
            (cpad-clear! 0 confirm)
            (cond
              ((and (< (-> this list-index) count) (not in-session))
               (sound-play "window-expand")
               (online-request! ONLINE_REQ_JOIN_ID (the-as int (-> shm sessions (-> this list-index) session-id)))
               (set! (-> this view) ONLINE_VIEW_MAIN)
               (set! (-> this selected) 0)
               )
              (else
                (sound-play "generic-beep")
                )
              )
            )
           ((cpad-pressed? 0 triangle)
            (cpad-clear! 0 triangle)
            (sound-play "generic-beep")
            (set! (-> this view) ONLINE_VIEW_MAIN)
            )
           )
         (if (>= (-> this list-index) count)
             (set! (-> this list-index) (max 0 (+ count -1)))
             )
         )
       )
      ;; ---------------- saisie du code prive
      ((ONLINE_VIEW_CODE)
       (cond
         ((online-menu-move? left l-analog-left)
          (set! (-> this last-move) (online-now))
          (sound-play "roll-over")
          (set! (-> this code-pos) (if (<= (-> this code-pos) 0) 5 (+ (-> this code-pos) -1)))
          )
         ((online-menu-move? right l-analog-right)
          (set! (-> this last-move) (online-now))
          (sound-play "roll-over")
          (set! (-> this code-pos) (if (>= (-> this code-pos) 5) 0 (+ (-> this code-pos) 1)))
          )
         ((online-menu-move? up l-analog-up)
          (set! (-> this last-move) (online-now))
          (sound-play "roll-over")
          (let ((c (-> this code (-> this code-pos))))
            (set! (-> this code (-> this code-pos)) (if (>= c 31) 0 (+ c 1)))
            )
          )
         ((online-menu-move? down l-analog-down)
          (set! (-> this last-move) (online-now))
          (sound-play "roll-over")
          (let ((c (-> this code (-> this code-pos))))
            (set! (-> this code (-> this code-pos)) (if (<= c 0) 31 (+ c -1)))
            )
          )
         ((cpad-pressed? 0 confirm)
          (cpad-clear! 0 confirm)
          (cond
            ((and connected (not in-session))
             (sound-play "window-expand")
             (dotimes (i 6)
               (set! (-> shm req-code i) (-> *online-code-chars* data (-> this code i)))
               )
             (set! (-> shm req-code 6) (the-as uint 0))
             (set! (-> shm req-code 7) (the-as uint 0))
             (online-request! ONLINE_REQ_JOIN_CODE 0)
             (set! (-> this view) ONLINE_VIEW_MAIN)
             (set! (-> this selected) 0)
             )
            (else
              (sound-play "generic-beep")
              )
            )
          )
         ((cpad-pressed? 0 triangle)
          (cpad-clear! 0 triangle)
          (sound-play "generic-beep")
          (set! (-> this view) ONLINE_VIEW_MAIN)
          )
         )
       )
      ;; ---------------- liste des joueurs
      ((ONLINE_VIEW_PLAYERS)
       (let ((count (min (the-as int (-> shm player-count)) ONLINE_MAX_PLAYERS)))
         (cond
           ((online-menu-move? up l-analog-up)
            (set! (-> this last-move) (online-now))
            (when (< 0 (-> this list-index))
              (sound-play "roll-over")
              (+! (-> this list-index) -1)
              )
            )
           ((online-menu-move? down l-analog-down)
            (set! (-> this last-move) (online-now))
            (when (< (-> this list-index) (+ count -1))
              (sound-play "roll-over")
              (+! (-> this list-index) 1)
              )
            )
           ((or (cpad-pressed? 0 triangle) (not in-session))
            (cpad-clear! 0 triangle)
            (sound-play "generic-beep")
            (set! (-> this view) ONLINE_VIEW_MAIN)
            )
           )
         (if (>= (-> this list-index) count)
             (set! (-> this list-index) (max 0 (+ count -1)))
             )
         )
       )
      )
    )
  0
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; dessin du menu
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun online-menu-box! ((box hud-box))
  (cond
    ((= (get-aspect-ratio) 'aspect16x9)
     (set! (-> box min x) 79.0)
     (set! (-> box max x) 434.0)
     (set! (-> box min y) 108.0)
     (set! (-> box max y) 293.0)
     )
    (else
      (set! (-> box min x) 70.0)
      (set! (-> box max x) 444.0)
      (set! (-> box min y) 116.0)
      (set! (-> box max y) 295.0)
      )
    )
  (when (not (-> *pc-settings* use-vis?))
    (let ((w (- (-> box max x) (-> box min x))))
      (set! (-> box min x) (the float (adjust-game-x (-> box min x))))
      (set! (-> box max x) (+ (-> box min x) (* w (-> *pc-settings* aspect-ratio-reciprocal))))
      )
    )
  box
  )

(defun online-draw-frame ((opt menu-option) (box hud-box) (fnt font-context) (alpha float) (title string))
  ;; titre
  (set-scale! fnt 0.65)
  (set-color! fnt (font-color font-color-32))
  (set-flags! fnt (font-flags kerning middle large))
  (set! (-> fnt origin x) (-> box min x))
  (set! (-> fnt width) (- (-> box max x) (-> box min x)))
  (set! (-> fnt height) 50.0)
  (set! (-> fnt origin y) (+ -30.0 (-> box min y)))
  (print-game-text (online-encode title) fnt #f 44 (bucket-id hud-draw-hud-alpha))
  ;; cadre + fond
  (set-vector! (-> opt box 0 color) 64 128 128 (the int (* 128.0 alpha)))
  (draw-savegame-box opt (-> box min x) (-> box max x) (-> box min y) (-> box min y))
  (draw-savegame-box opt (-> box min x) (-> box max x) (-> box max y) (-> box max y))
  (with-dma-buffer-add-bucket ((buf (-> *display* frames (-> *display* on-screen) global-buf)) (bucket-id particles))
    (draw-sprite2d-xy buf
                      (the int (-> box min x))
                      (the int (-> box min y))
                      (the int (- (-> box max x) (-> box min x)))
                      (the int (- (-> box max y) (-> box min y)))
                      (new 'static 'rgba :r #x40 :g #x40 :b #x40 :a (the int (* 64.0 alpha)))
                      #x3fffff
                      )
    )
  (none)
  )

(defun online-menu-line ((fnt font-context) (box hud-box) (str string) (y float) (scale float) (color font-color))
  (set-scale! fnt scale)
  (set-color! fnt color)
  (set-flags! fnt (font-flags kerning middle large))
  (set! (-> fnt origin x) (+ 8.0 (-> box min x)))
  (set! (-> fnt width) (+ -16.0 (- (-> box max x) (-> box min x))))
  (set! (-> fnt height) 30.0)
  (set! (-> fnt origin y) y)
  (print-game-text (online-encode str) fnt #f 44 (bucket-id hud-draw-hud-alpha))
  (none)
  )

(defun online-menu-row ((fnt font-context) (box hud-box) (str string) (y float) (selected symbol) (disabled symbol) (alpha float))
  (when selected
    (draw-highlight (the int (+ -3.0 y)) 21 alpha)
    )
  (online-menu-line fnt box str y 0.5 (cond
                                        (disabled (font-color font-color-44))
                                        (selected (font-color font-color-33))
                                        (else (font-color font-color-32))
                                        )
                    )
  (none)
  )

(defun online-status-lines ((fnt font-context) (box hud-box))
  (let* ((shm *online-shm*)
         (rt *online*)
         (s (-> rt tmp-str))
         (y1 (+ 6.0 (-> box min y)))
         (y2 (+ 22.0 (-> box min y)))
         )
    (cond
      ((not (online-companion-alive?))
       (online-menu-line fnt box (online-fr "MODE EN LIGNE PAS ENCORE ACTIVE" "ONLINE MODE NOT ACTIVE YET") y1 0.42 (font-color red))
       (online-menu-line fnt box (online-fr "OUVREZ UNE FOIS data/online/Jak3Online.exe" "OPEN ONCE data/online/Jak3Online.exe") y2 0.42 (font-color font-color-32))
       )
      ((not (online-connected?))
       (online-menu-line fnt box (online-chars->string s (-> shm status-msg) 64) y1 0.42 (font-color yellow))
       (online-menu-line fnt box (online-fr "CONNEXION AU SERVEUR..." "CONNECTING TO SERVER...") y2 0.42 (font-color font-color-32))
       )
      ((online-in-session?)
       (let ((code (online-chars->string (-> rt tmp-str2) (-> shm session-code) 8)))
         (format (clear s)
                 (online-fr "SESSION ~S  -  CODE : ~S" "~S SESSION  -  CODE: ~S")
                 (if (nonzero? (-> shm session-public)) (online-fr "PUBLIQUE" "PUBLIC") (online-fr "PRIVEE" "PRIVATE"))
                 code
                 )
         )
       (online-menu-line fnt box s y1 0.45 (font-color green))
       (format (clear s)
               (online-fr "JOUEURS ~D/~D   ~S" "PLAYERS ~D/~D   ~S")
               (-> shm session-players)
               (-> shm session-max)
               (if (nonzero? (-> shm is-host)) (online-fr "VOUS ETES L'HOTE" "YOU ARE THE HOST") "")
               )
       (online-menu-line fnt box s y2 0.42 (font-color font-color-32))
       )
      (else
        (let ((name (online-chars->string (-> rt tmp-str2) (-> shm my-name) 16)))
          (format (clear s) (online-fr "CONNECTE : ~S" "CONNECTED: ~S") name)
          )
        (online-menu-line fnt box s y1 0.45 (font-color green))
        (online-menu-line fnt box (online-chars->string s (-> shm status-msg) 64) y2 0.42 (font-color font-color-32))
        )
      )
    )
  (none)
  )

(defmethod draw-option ((this menu-online-option) (arg0 progress) (arg1 font-context) (arg2 int) (arg3 symbol))
  (let* ((alpha (fmax 0.0 (* 2.0 (- 0.5 (-> arg0 menu-transition)))))
         (box (online-menu-box! (new 'stack 'hud-box)))
         (shm *online-shm*)
         (rt *online*)
         (s (-> rt tmp-str))
         (connected (online-connected?))
         (in-session (online-in-session?))
         (row-y (+ 48.0 (-> box min y)))
         (footer-y (+ 6.0 (-> box max y)))
         )
    (set! (-> arg1 alpha) alpha)
    (online-draw-frame this box arg1 alpha (online-fr "JAK 3 EN LIGNE" "JAK 3 ONLINE"))
    (case (-> this view)
      ;; ---------------- page principale
      ((ONLINE_VIEW_MAIN)
       (online-status-lines arg1 box)
       (let* ((count (online-main-items! this (online-on-title? arg0)))
              (first (max 0 (min (+ (-> this selected) -3) (+ count -7))))
              )
         (dotimes (k count)
           (let ((it (-> this items k))
                 (y (+ (* 20.0 (the float (- k first))) (+ 44.0 (-> box min y))))
                 (sel (= k (-> this selected)))
                 )
             (case (if (and (>= k first) (< k (+ first 7))) it 0)
               ((ONLINE_IT_NEW)
                (online-menu-row arg1 box (online-fr "LANCER : NOUVELLE PARTIE" "START: NEW GAME") y sel #f alpha)
                )
               ((ONLINE_IT_LOAD)
                (online-menu-row arg1 box (online-fr "LANCER : CHARGER UNE PARTIE" "START: LOAD GAME") y sel #f alpha)
                )
               ((ONLINE_IT_CREATE_PUB)
                (online-menu-row arg1 box (online-fr "CREER UNE SESSION PUBLIQUE" "CREATE PUBLIC SESSION") y sel (not connected) alpha)
                )
               ((ONLINE_IT_CREATE_PRIV)
                (online-menu-row arg1 box (online-fr "CREER UNE SESSION PRIVEE (CODE)" "CREATE PRIVATE SESSION (CODE)") y sel (not connected) alpha)
                )
               ((ONLINE_IT_MAX)
                (format (clear s) (online-fr "JOUEURS MAX : ~33L~C ~D ~33L~C" "MAX PLAYERS: ~33L~C ~D ~33L~C") 163 (-> this max-players) 161)
                (online-menu-row arg1 box s y sel #f alpha)
                )
               ((ONLINE_IT_PVP_NEW)
                (format (clear s) (online-fr "PVP : ~33L~C ~S ~33L~C" "PVP: ~33L~C ~S ~33L~C") 163 (if (-> this pvp-off) (online-fr "NON" "OFF") (online-fr "OUI" "ON")) 161)
                (online-menu-row arg1 box s y sel #f alpha)
                )
               ((ONLINE_IT_WORLD)
                (if (online-in-session?)
                    (online-menu-row arg1 box (online-fr "ENTRER DANS LE MONDE EN LIGNE" "ENTER THE ONLINE WORLD") y sel #f alpha)
                    (online-menu-row arg1 box (online-fr "MONDE EN LIGNE (SESSION PUBLIQUE)" "ONLINE WORLD (PUBLIC SESSION)") y sel (not connected) alpha)
                    )
                )
               ((ONLINE_IT_JOIN_PUB)
                (online-menu-row arg1 box (online-fr "REJOINDRE UNE SESSION PUBLIQUE" "JOIN A PUBLIC SESSION") y sel (not connected) alpha)
                )
               ((ONLINE_IT_JOIN_CODE)
                (online-menu-row arg1 box (online-fr "REJOINDRE AVEC UN CODE" "JOIN WITH A CODE") y sel (not connected) alpha)
                )
               ((ONLINE_IT_PLAYERS)
                (format (clear s) (online-fr "LISTE DES JOUEURS (~D)" "PLAYER LIST (~D)") (-> shm session-players))
                (online-menu-row arg1 box s y sel #f alpha)
                )
               ((ONLINE_IT_PVP)
                (format (clear s) (online-fr "PVP : ~33L~C ~S ~33L~C" "PVP: ~33L~C ~S ~33L~C") 163 (if (nonzero? (-> shm pvp-enabled)) (online-fr "OUI" "ON") (online-fr "NON" "OFF")) 161)
                (online-menu-row arg1 box s y sel (not (online-is-host?)) alpha)
                )
               ((ONLINE_IT_VIS)
                (format (clear s) (online-fr "SESSION : ~33L~C ~S ~33L~C" "SESSION: ~33L~C ~S ~33L~C") 163 (if (nonzero? (-> shm session-public)) (online-fr "PUBLIQUE" "PUBLIC") (online-fr "PRIVEE" "PRIVATE")) 161)
                (online-menu-row arg1 box s y sel (not (online-is-host?)) alpha)
                )
               ((ONLINE_IT_NAME)
                (format (clear s) (online-fr "PSEUDO : ~S" "NAME: ~S") (online-chars->string (-> rt tmp-str2) (-> shm my-name) 16))
                (online-menu-row arg1 box s y sel (not (online-companion-alive?)) alpha)
                )
               ((ONLINE_IT_ADDBOT)
                (online-menu-row arg1 box (online-fr "AJOUTER UN JOUEUR TEST (BOT)" "ADD A TEST PLAYER (BOT)") y sel #f alpha)
                )
               ((ONLINE_IT_GETSAVE)
                (format (clear s)
                        (online-fr "SAUVEGARDE DE L'HOTE -> EMPLACEMENT ~33L~C ~D ~33L~C~S" "HOST SAVE -> SLOT ~33L~C ~D ~33L~C~S")
                        163 (+ (-> this save-choice) 1) 161
                        (case (-> shm save-status)
                          ((1) (online-fr "  ..." "  ..."))
                          ((2) (online-fr "  RECUE" "  RECEIVED"))
                          ((3) (online-fr "  ECHEC" "  FAILED"))
                          (else "")
                          )
                        )
                (online-menu-row arg1 box s y sel #f alpha)
                )
               ((ONLINE_IT_SAVESYNC)
                (format (clear s) (online-fr "SYNCHRO AUTO DE LA SAUVEGARDE : ~33L~C ~S ~33L~C" "AUTO SYNC HOST SAVE: ~33L~C ~S ~33L~C")
                        163 (if (nonzero? (-> shm save-sync)) (online-fr "OUI" "ON") (online-fr "NON" "OFF")) 161)
                (online-menu-row arg1 box s y sel #f alpha)
                )
               ((ONLINE_IT_LEAVE)
                (online-menu-row arg1 box (online-fr "QUITTER LA SESSION" "LEAVE SESSION") y sel #f alpha)
                )
               )
             )
           )
         )
       (online-menu-line arg1 box (online-fr "X : VALIDER   GAUCHE/DROITE : CHANGER   TRIANGLE : RETOUR"
                                             "X: SELECT   LEFT/RIGHT: CHANGE   TRIANGLE: BACK")
                         footer-y 0.38 (font-color font-color-32))
       )
      ;; ---------------- edition du pseudo
      ((ONLINE_VIEW_NAME)
       (online-menu-line arg1 box (online-fr "CHOISISSEZ VOTRE PSEUDO" "CHOOSE YOUR NAME") (+ 10.0 (-> box min y)) 0.5 (font-color green))
       (let* ((cx (* 0.5 (+ (-> box min x) (-> box max x))))
              (step (if (-> *pc-settings* use-vis?) 24.0 (* 24.0 (-> *pc-settings* aspect-ratio-reciprocal))))
              (y (+ 70.0 (-> box min y)))
              )
         (dotimes (i ONLINE_NAME_LEN)
           (let ((x (+ cx (* step (+ -5.5 (the float i))))))
             (clear s)
             (if (zero? (-> this pseudo i))
                 (format s "_")
                 (format s "~C" (-> *online-name-chars* data (-> this pseudo i)))
                 )
             (when (= i (-> this pseudo-pos))
               (with-dma-buffer-add-bucket ((buf (-> *display* frames (-> *display* on-screen) global-buf)) (bucket-id hud-draw-hud-alpha))
                 (draw-sprite2d-xy buf (the int (+ -10.0 x)) (the int (+ -6.0 y)) 20 32
                                   (new 'static 'rgba :r #x80 :g #x80 :b #x40 :a (the int (* 64.0 alpha)))
                                   #x3fffff)
                 )
               )
             (set-scale! arg1 0.75)
             (set-color! arg1 (if (= i (-> this pseudo-pos)) (font-color font-color-33) (font-color font-color-32)))
             (set-flags! arg1 (font-flags kerning middle large))
             (set! (-> arg1 origin x) (+ -16.0 x))
             (set! (-> arg1 width) 32.0)
             (set! (-> arg1 height) 40.0)
             (set! (-> arg1 origin y) y)
             (print-game-text (online-encode s) arg1 #f 44 (bucket-id hud-draw-hud-alpha))
             )
           )
         )
       (online-menu-line arg1 box (online-fr "CLAVIER : TAPEZ LE PSEUDO, ENTREE = VALIDER, ECHAP = ANNULER" "KEYBOARD: TYPE YOUR NAME, ENTER = OK, ESC = CANCEL") (+ 118.0 (-> box min y)) 0.38 (font-color green))
       (online-menu-line arg1 box (online-fr "MANETTE : HAUT/BAS LETTRE, GAUCHE/DROITE POSITION, CARRE EFFACE" "PAD: UP/DOWN LETTER, LEFT/RIGHT POSITION, SQUARE ERASE") (+ 138.0 (-> box min y)) 0.38 (font-color font-color-32))
       (online-menu-line arg1 box (online-fr "X : VALIDER   TRIANGLE : ANNULER" "X: CONFIRM   TRIANGLE: CANCEL") footer-y 0.38 (font-color font-color-32))
       )
      ;; ---------------- liste des sessions publiques
      ((ONLINE_VIEW_BROWSER)
       (let ((count (min (the-as int (-> shm list-count)) ONLINE_MAX_SESSIONS)))
         (format (clear s) (online-fr "SESSIONS PUBLIQUES (~D)" "PUBLIC SESSIONS (~D)") count)
         (online-menu-line arg1 box s (+ 6.0 (-> box min y)) 0.45 (font-color green))
         (cond
           ((zero? count)
            (online-menu-line arg1 box (online-fr "AUCUNE SESSION PUBLIQUE POUR LE MOMENT" "NO PUBLIC SESSION RIGHT NOW") (+ 60.0 (-> box min y)) 0.45 (font-color font-color-32))
            (online-menu-line arg1 box (online-fr "CREEZ-EN UNE OU ACTUALISEZ (CARRE)" "CREATE ONE OR REFRESH (SQUARE)") (+ 82.0 (-> box min y)) 0.42 (font-color font-color-32))
            )
           (else
             (if (< (-> this list-index) (-> this list-scroll))
                 (set! (-> this list-scroll) (-> this list-index))
                 )
             (if (>= (-> this list-index) (+ (-> this list-scroll) ONLINE_ROWS))
                 (set! (-> this list-scroll) (+ (-> this list-index) (- 1 ONLINE_ROWS)))
                 )
             (dotimes (k ONLINE_ROWS)
               (let ((i (+ k (-> this list-scroll))))
                 (when (< i count)
                   (let* ((e (-> shm sessions i))
                          (host (online-chars->string (-> rt tmp-str2) (-> e host-name) 16))
                          )
                     (format (clear s)
                             (online-fr "~S   ~D/~D   ~S" "~S   ~D/~D   ~S")
                             host
                             (-> e players)
                             (-> e max-players)
                             (if (logtest? (-> e flags) ONLINE_SFLAG_PVP) "PVP" (online-fr "AMICAL" "FRIENDLY"))
                             )
                     (online-menu-row arg1 box s (+ (* 21.0 (the float k)) (+ 28.0 (-> box min y)))
                                      (= i (-> this list-index))
                                      (>= (-> e players) (-> e max-players))
                                      alpha)
                     )
                   )
                 )
               )
             )
           )
         (online-menu-line arg1 box (online-fr "X : REJOINDRE   CARRE : ACTUALISER   TRIANGLE : RETOUR"
                                               "X: JOIN   SQUARE: REFRESH   TRIANGLE: BACK")
                           footer-y 0.38 (font-color font-color-32))
         )
       )
      ;; ---------------- saisie du code
      ((ONLINE_VIEW_CODE)
       (online-menu-line arg1 box (online-fr "CODE DE LA SESSION PRIVEE" "PRIVATE SESSION CODE") (+ 10.0 (-> box min y)) 0.5 (font-color green))
       (online-menu-line arg1 box (online-fr "DEMANDEZ LE CODE A L'HOTE" "ASK THE HOST FOR THE CODE") (+ 32.0 (-> box min y)) 0.42 (font-color font-color-32))
       (let* ((cx (* 0.5 (+ (-> box min x) (-> box max x))))
              (step (if (-> *pc-settings* use-vis?) 34.0 (* 34.0 (-> *pc-settings* aspect-ratio-reciprocal))))
              (y (+ 90.0 (-> box min y)))
              )
         (dotimes (i 6)
           (let ((x (+ cx (* step (+ -2.5 (the float i))))))
             (clear s)
             (format s "~C" (-> *online-code-chars* data (-> this code i)))
             (when (= i (-> this code-pos))
               (with-dma-buffer-add-bucket ((buf (-> *display* frames (-> *display* on-screen) global-buf)) (bucket-id hud-draw-hud-alpha))
                 (draw-sprite2d-xy buf
                                   (the int (+ -12.0 x))
                                   (the int (+ -6.0 y))
                                   24
                                   34
                                   (new 'static 'rgba :r #x80 :g #x80 :b #x40 :a (the int (* 64.0 alpha)))
                                   #x3fffff
                                   )
                 )
               )
             (set-scale! arg1 0.9)
             (set-color! arg1 (if (= i (-> this code-pos)) (font-color font-color-33) (font-color font-color-32)))
             (set-flags! arg1 (font-flags kerning middle large))
             (set! (-> arg1 origin x) (+ -20.0 x))
             (set! (-> arg1 width) 40.0)
             (set! (-> arg1 height) 40.0)
             (set! (-> arg1 origin y) y)
             (print-game-text (online-encode s) arg1 #f 44 (bucket-id hud-draw-hud-alpha))
             )
           )
         )
       (online-menu-line arg1 box (online-fr "HAUT/BAS : LETTRE   GAUCHE/DROITE : POSITION" "UP/DOWN: LETTER   LEFT/RIGHT: POSITION") (+ 140.0 (-> box min y)) 0.4 (font-color font-color-32))
       (online-menu-line arg1 box (online-fr "X : REJOINDRE   TRIANGLE : RETOUR" "X: JOIN   TRIANGLE: BACK") footer-y 0.38 (font-color font-color-32))
       )
      ;; ---------------- liste des joueurs
      ((ONLINE_VIEW_PLAYERS)
       (let ((count (min (the-as int (-> shm player-count)) ONLINE_MAX_PLAYERS)))
         (format (clear s) (online-fr "JOUEURS DANS LA SESSION : ~D/~D" "PLAYERS IN SESSION: ~D/~D") count (-> shm session-max))
         (online-menu-line arg1 box s (+ 6.0 (-> box min y)) 0.45 (font-color green))
         (if (< (-> this list-index) (-> this list-scroll))
             (set! (-> this list-scroll) (-> this list-index))
             )
         (if (>= (-> this list-index) (+ (-> this list-scroll) ONLINE_ROWS))
             (set! (-> this list-scroll) (+ (-> this list-index) (- 1 ONLINE_ROWS)))
             )
         (dotimes (k ONLINE_ROWS)
           (let ((i (+ k (-> this list-scroll))))
             (when (< i count)
               (let* ((e (-> shm players i))
                      (name (online-chars->string (-> rt tmp-str2) (-> e name) 16))
                      (lev (online-chars->string (-> rt tmp-level) (-> e level) 16))
                      )
                 (format (clear s)
                         "~S~S~S  ~S  PV ~D  ~DMS"
                         name
                         (if (logtest? (-> e flags) ONLINE_PFLAG_HOST) (online-fr " (HOTE)" " (HOST)") "")
                         (if (logtest? (-> e flags) ONLINE_PFLAG_ME) (online-fr " (VOUS)" " (YOU)") "")
                         (if (zero? (length lev)) "-" lev)
                         (the int (-> e health))
                         (-> e ping)
                         )
                 (online-menu-row arg1 box s (+ (* 21.0 (the float k)) (+ 28.0 (-> box min y)))
                                  (= i (-> this list-index))
                                  (logtest? (-> e flags) ONLINE_PFLAG_DEAD)
                                  alpha)
                 )
               )
             )
           )
         (online-menu-line arg1 box (online-fr "HAUT/BAS : DEFILER   TRIANGLE : RETOUR" "UP/DOWN: SCROLL   TRIANGLE: BACK") footer-y 0.38 (font-color font-color-32))
         )
       )
      )
    )
  (none)
  )

(defun online-draw-ring-hint ()
  "petit rappel sous l'anneau du menu Start"
  (let ((s (-> *online* tmp-str2)))
    (cond
      ((online-in-session?)
       (let ((code (online-chars->string (-> *online* tmp-level) (-> *online-shm* session-code) 8)))
         (format (clear s) (online-fr "SELECT : EN LIGNE (CODE ~S, ~D JOUEURS)" "SELECT: ONLINE (CODE ~S, ~D PLAYERS)")
                 code (-> *online-shm* session-players))
         )
       )
      (else
        (format (clear s) (online-fr "SELECT : MODE EN LIGNE" "SELECT: ONLINE MODE"))
        )
      )
    (online-print s 56.0 392.0 400.0 0.45 (font-color font-color-32) (font-flags shadow kerning middle large))
    )
  (none)
  )
