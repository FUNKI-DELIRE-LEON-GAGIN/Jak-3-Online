;;-*-Lisp-*-
(in-package goal)

;; name: online-events.gc
;; dgos: GAME
;;
;; JAK 3 EN LIGNE - evenements du monde en ligne, super-pouvoirs, anti-triche du jeu
;;
;; Les evenements sont decides par Jak3Online.exe (zone EXT : ev-kind, ev-pos, ev-hp...).
;; Chaque jeu fabrique sa propre version locale :
;;   * BOSS : un DARK JAK GEANT (le modele de Jak, trois fois plus grand, teinte sombre) qui
;;     marche vers les joueurs, frappe et fait trembler le sol. On peut le toucher avec tout
;;     (poings, armes, dark jak, vehicules) : chaque coup est compte et envoye au programme,
;;     qui additionne les degats de tout le monde (points de vie partages).
;;   * PLUIE D'ORBES : des orbes precurseurs tombent autour du point.
;;   * TRESOR : une orbe geante doree cachee dans la zone ; la premiere personne a la toucher
;;     gagne (indice "chaud / froid" a l'ecran).
;;   * ZONE : rester dans le cercle (balise lumineuse) pour marquer des points.
;;   * DOUBLE XP : simple bandeau.

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; etat
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(deftype online-events-state (basic)
  ((boss          handle)
   (boss-id       uint32)
   (boss-dmg      float)
   (boss-sent     time-frame)
   (orbs-id       uint32)
   (orbs-proc     handle)
   (chest         handle)
   (chest-id      uint32)
   (chest-found   symbol)
   (beacon        handle)
   (beacon-id     uint32)
   (zone-tick     time-frame)
   (in-zone       symbol)
   (banks-saved   symbol)
   (walk-speed    float)
   (walk-transv   float)
   (jump-min      float)
   (jump-max      float)
   (djump-min     float)
   (djump-max     float)
   (turbo-on      symbol)
   (jump-on       symbol)
   (regen-time    time-frame)
   (cheat-sent    uint32)
   (cheat-time    time-frame)
   (warn-seq      uint32)
   (warn-time     time-frame)
   (ev-seq        uint32)
   (ev-shown      time-frame)
   (sync-seen     uint32)
   (sync-time     time-frame)
   (meteor-k      int32)
   (str           string)
   (str2          string)
   )
  )

(define *online-events* (new 'global 'online-events-state))

(let ((es *online-events*))
  (mem-set32! (the-as pointer es) (/ (- (size-of online-events-state) 4) 4) 0)
  (set! (-> es boss) (the-as handle #f))
  (set! (-> es orbs-proc) (the-as handle #f))
  (set! (-> es chest) (the-as handle #f))
  (set! (-> es beacon) (the-as handle #f))
  (set! (-> es chest-found) #f)
  (set! (-> es in-zone) #f)
  (set! (-> es banks-saved) #f)
  (set! (-> es turbo-on) #f)
  (set! (-> es jump-on) #f)
  (set! (-> es str) (new 'global 'string 128 (the-as string #f)))
  (set! (-> es str2) (new 'global 'string 64 (the-as string #f)))
  )

(defun oe-active? ((kind int))
  "evenement de cette sorte en cours ?"
  (let ((ext *online-ext*))
    (and (online-in-session?)
         (= (-> ext ev-kind) (the-as uint kind))
         (= (-> ext ev-state) 1)
         )
    )
  )

(define-extern oe-boss-pos (function vector vector))
(define-extern ow-map-draw-banner! (function float none))

(defun oe-event-pos ((out vector))
  "point de l'evenement (pour un boss : la ou il est vraiment)"
  (if (= (-> *online-ext* ev-kind) ONLINE_EVK_BOSS)
      (oe-boss-pos out)
      (vector-copy! out (-> *online-ext* ev-pos))
      )
  out
  )

(defun oe-dist-to-event ()
  "distance de Jak au point de l'evenement (metres), 99999 sinon"
  (if *target*
      (/ (vector-vector-xz-distance (-> *target* control trans) (oe-event-pos (new 'stack-no-clear 'vector))) 4096.0)
      99999.0
      )
  )

(defun oe-ground! ((pos vector) (probe-up float))
  "pose pos sur le sol (sonde vers le bas depuis probe-up plus haut) ; #t si trouve"
  (let ((start (vector-copy! (new 'stack-no-clear 'vector) pos))
        (hit (new 'stack-no-clear 'vector))
        )
    (+! (-> start y) probe-up)
    (cond
      ((find-collision-below hit start (+ probe-up (meters 60.0)))
       (set! (-> pos y) (-> hit y))
       #t
       )
      (else
        #f
        )
      )
    )
  )

(defconstant OE_BOSS_SCALE 3.0)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; BOSS
;; ev-boss : 0 Dark Jak geant, 1 Ombre de Jak, 2 Jak dechu (le modele de Jak agrandi),
;;           3 ROBO BOSS (robot precurseur), 4 TITAN (robot geant Dark Maker), 5 BETE DU DESERT.
;; Les vrais modeles (3 a 5) sont charges en permanence (GAME.CGO, voir dgos/game.gd) ; leurs
;; maillages pour le rendu PC viennent du FR3 de leur niveau d'origine (voir ow-fr3-update!).
;;
;; SYNCHRONISATION : un seul jeu "pilote" le boss (Jak3Online.exe choisit : le joueur proche au
;; plus petit numero). Il envoie position, cap et action 4 fois par seconde ; les autres jeux
;; suivent (le boss est au meme endroit chez tout le monde, le point de la carte aussi). Chaque
;; jeu calcule les coups du boss sur SON joueur.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(def-actor zone-boss
  :bounds (0 8 0 14)
  :art (cast-ja die-ja hurt-ja idle-ja pound-ja roar-ja swipe-ja walk-ja)
  :idle idle-ja
  :texture-level 11
  )

(defskelgroup skel-ow-titan dm-robot dm-robot-lod0-jg dm-robot-idle-ja
              ((dm-robot-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 45 0 160)
              :texture-level 11
              )

(defskelgroup skel-ow-bete des-beast des-beast-lod0-jg des-beast-idle-ja
              ((des-beast-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 7 0 24)
              :origin-joint-index 3
              :texture-level 11
              )

;; actions (les memes chez tout le monde : envoyees par le pilote)
(defconstant OB_IDLE 0)
(defconstant OB_WALK 1)
(defconstant OB_RUN 2)
(defconstant OB_PUNCH 3)
(defconstant OB_STOMP 4)
(defconstant OB_SHOOT 5)

(deftype ow-boss (process-focusable)
  ((geo          int32)
   (kind         int32)
   (last-attack  uint32)
   (ground-time  time-frame)
   (ground-y     float)
   (attack-time  time-frame)
   (stomp-time   time-frame)
   (shoot-time   time-frame)
   (hit-time     time-frame)
   (contact-time time-frame)
   (ram-time     time-frame)
   (send-time    time-frame)
   (anim-idx     int32)
   (frame        float)
   (act          int32)       ;; action en cours (OB_...)
   (attack-done  symbol)
   (dying        symbol)
   (sync-seq     uint32)
   (want         vector :inline)  ;; position voulue (suiveur) ; w = cap
   (want-act     int32)
   (have-want    symbol)
   )
  (:states
    ow-boss-live
    ow-boss-die
    )
  )

(defun ow-boss-speed ((k int))
  (case k
    ((1) 1.35)
    ((2) 0.75)
    ((3) 0.85)
    ((4) 0.7)
    ((5) 1.8)
    (else 1.0)
    )
  )

(defun ow-boss-scale ((k int))
  (case k
    ((1) 2.6)
    ((2) 3.6)
    ((3) 1.2)      ;; le robot precurseur mesure deja 21 m
    ((4) 0.9)
    ((5) 1.5)
    (else OE_BOSS_SCALE)
    )
  )

(defun ow-boss-reach ((k int))
  "distance d'attaque"
  (case k
    ((3) (meters 13.0))
    ((4) (meters 28.0))
    ((5) (meters 11.0))
    (else (meters 8.0))
    )
  )

(defun ow-boss-height ((k int))
  "hauteur de la tete (nom, barre de vie, tirs)"
  (case k
    ((3) (meters 26.0))
    ((4) (meters 44.0))
    ((5) (meters 17.0))
    (else (meters 13.0))
    )
  )

(defun ow-boss-fr3 ((k int))
  "FR3 qui porte le maillage du boss (rendu PC)"
  (case k
    ((3) "owcom")
    ((4) "wasdefen")
    ((5) "deshover")
    (else "")
    )
  )

(defun ow-boss-anim-idx ((k int) (act int))
  "numero d'animation dans le groupe d'art du boss"
  (case k
    ((3)
     (case act ((OB_WALK OB_RUN) 9) ((OB_PUNCH) 8) ((OB_STOMP) 6) ((OB_SHOOT) 2) ((6) 7) ((7 8) 3) (else 5))
     )
    ((4)
     (case act ((OB_WALK OB_RUN OB_PUNCH OB_STOMP OB_SHOOT) 5) ((7 8) 7) (else 3))
     )
    ((5)
     (case act ((OB_WALK) 4) ((OB_RUN) 5) ((OB_PUNCH OB_STOMP OB_SHOOT) 6) ((7) 15) ((8) 16) (else 3))
     )
    (else
      (case act ((OB_WALK) ONLINE_ANIM_WALK) ((OB_RUN) ONLINE_ANIM_RUN) ((OB_PUNCH OB_SHOOT) 64) ((OB_STOMP) 84) ((7) 82) ((8) 83) (else ONLINE_ANIM_STANCE))
      )
    )
  )

(defbehavior ow-boss-anim ow-boss ((idx int))
  (let ((ag (-> self draw art-group)))
    (if (and (>= idx 0) (< idx (-> ag length)) (online-anim-ok? (-> ag data idx)))
        (the-as art-joint-anim (-> ag data idx))
        (let ((fb (ow-boss-anim-idx (-> self kind) OB_IDLE)))
          (the-as art-joint-anim (-> ag data (if (and (< fb (-> ag length)) (online-anim-ok? (-> ag data fb))) fb 3)))
          )
        )
    )
  )

(defbehavior ow-boss-sync-geo! ow-boss ()
  "le vrai corps de Jak (charge a part), comme les avatars des joueurs"
  (when (and (< (-> self kind) ONLINE_BOSS_ROBOT)
             (< (-> self geo) 0)
             *target*
             (= (-> *target* ext-geo) (-> *target* pending-ext-geo))
             (= (-> *target-geo-control* status) 'active)
             )
    (let ((lods (new 'stack-no-clear 'lod-set)))
      (when (setup-lods! lods (target-skel-group) (-> self draw art-group) (-> self entity))
        (lods-assign! (-> self draw) lods)
        (set! (-> self geo) (the-as int (-> *target* ext-geo)))
        )
      )
    )
  (none)
  )

(defbehavior ow-boss-play ow-boss ((idx int) (speed float) (loop symbol))
  "avance l'animation idx ; renvoie #t quand une animation non bouclee est finie"
  (let ((done #f))
    (when (!= idx (-> self anim-idx))
      (set! (-> self anim-idx) idx)
      (set! (-> self frame) 0.0)
      )
    (let* ((anim (ow-boss-anim idx))
           (maxf (the float (+ (-> anim frames num-frames) -1)))
           )
      (+! (-> self frame) (* speed 60.0 (-> *display* real-clock seconds-per-frame)))
      (cond
        ((< maxf (-> self frame))
         (cond
           (loop
             (set! (-> self frame) 0.0)
             )
           (else
             (set! (-> self frame) maxf)
             (set! done #t)
             )
           )
         )
        )
      (ja :group! anim :num! (identity (-> self frame)))
      )
    done
    )
  )

(defbehavior ow-boss-anim-progress ow-boss ()
  "0..1 : avancement de l'animation en cours"
  (let* ((anim (ow-boss-anim (-> self anim-idx)))
         (maxf (fmax 1.0 (the float (+ (-> anim frames num-frames) -1))))
         )
    (/ (-> self frame) maxf)
    )
  )

(defun ow-boss-pick-target ((boss ow-boss) (out vector))
  "le joueur le plus proche (moi ou un avatar) a portee ; #f sinon"
  (let ((best (if (= (-> boss kind) ONLINE_BOSS_TITAN) (meters 160.0) (meters 100.0)))
        (found #f)
        )
    (when (and *target* (not (focus-test? *target* dead)))
      (let ((d (vector-vector-xz-distance (-> boss root trans) (-> *target* control trans))))
        (when (< d best)
          (set! best d)
          (vector-copy! out (-> *target* control trans))
          (set! found #t)
          )
        )
      )
    (dotimes (i ONLINE_MAX_PUPPETS)
      (let ((p (online-puppet-proc i)))
        (when (and p (-> p shown))
          (let ((d (vector-vector-xz-distance (-> boss root trans) (-> p root trans))))
            (when (< d best)
              (set! best d)
              (vector-copy! out (-> p root trans))
              (set! found #t)
              )
            )
          )
        )
      )
    found
    )
  )

(defun ow-vehicle-fling! ((vh process-drawable) (from vector) (up float) (out float) (dmg float))
  "coup de boss sur un vehicule : degats + projection (vitesse donnee au corps rigide)"
  (send-event vh 'attack #f
    (static-attack-info :mask (vehicle-impulse-factor)
      ((id (new-attack-id)) (damage dmg) (vehicle-damage-factor 1.0) (vehicle-impulse-factor 0.1) (mode 'generic))
      )
    )
  (let ((dir (vector-! (new 'stack-no-clear 'vector) (-> vh root trans) from)))
    (set! (-> dir y) 0.0)
    (if (< (vector-length dir) 1.0)
        (set-vector! dir 0.0 0.0 1.0 0.0)
        )
    (vector-normalize! dir out)
    (set! (-> dir y) up)
    (set! (-> dir w) 0.0)
    (let ((rb (-> (the-as vehicle vh) rbody)))
      (when (and rb (nonzero? rb) (nonzero? (-> rb info)) (< 0.0 (-> rb info mass)) (ow-float-ok? (-> rb info mass)))
        (vector+float*! (-> rb lin-momentum) (-> rb lin-momentum) dir (-> rb info mass))
        (init-velocities! rb)
        )
      )
    )
  (none)
  )

(defun ow-boss-hurt-me ((boss ow-boss) (damage float) (radius float) (up float))
  "le boss touche le joueur local (ou son vehicule) s'il est a portee"
  (let ((t *target*))
    (when (and t
               (not (focus-test? t dead))
               (< (vector-vector-xz-distance (-> boss root trans) (-> t control trans)) radius)
               (< (fabs (- (-> t control trans y) (-> boss root trans y))) (fmax (meters 10.0) (* 0.5 (ow-boss-height (-> boss kind)))))
               )
      ;; super-pouvoir "peau d'acier" : degats divises par deux
      (if (< 0.0 (-> *online-ext* power-left ONLINE_POW_STEEL))
          (set! damage (* 0.5 damage))
          )
      (let ((veh (online-my-vehicle)))
        (cond
          (veh
            ;; EN VEHICULE : le vehicule prend cher et part en l'air
            (ow-vehicle-fling! veh (-> boss root trans) (* 0.6 up) (* 1.6 up) (* 7.0 damage))
            )
          (else
            (let ((away (vector-! (new 'stack-no-clear 'vector) (-> t control trans) (-> boss root trans))))
              (set! (-> away y) 0.0)
              (vector-normalize! away (meters 10.0))
              (set! (-> away y) up)
              (send-event t 'attack #f
                (static-attack-info :mask (vehicle-impulse-factor)
                  ((id (new-attack-id)) (damage damage) (vehicle-damage-factor 1.0) (vehicle-impulse-factor 1.0) (mode 'generic) (vector away) (attacker-velocity away))
                  )
                )
              )
            )
          )
        )
      )
    )
  (none)
  )

(defbehavior ow-boss-take-damage! ow-boss ((dmg float))
  (let ((es *online-events*))
    (+! (-> es boss-dmg) dmg)
    )
  (set! (-> self hit-time) (online-now))
  (let ((pos (vector-copy! (new 'stack-no-clear 'vector) (-> self root trans))))
    (+! (-> pos y) (* 0.45 (ow-boss-height (-> self kind))))
    ;; bruit d'impact sur le boss (et son cri si son son est charge), pas le "aie" de Jak
    (sound-play "punch-hit" :position pos)
    (case (-> self kind)
      ((ONLINE_BOSS_BETE) (sound-play "desbeast-gethit" :position pos))
      ((ONLINE_BOSS_TITAN) (sound-play "dm-get-hit" :position pos))
      ((ONLINE_BOSS_ROBOT) (sound-play "hit-boss-head" :position pos))
      )
    (vector-copy! (-> *launch-matrix* trans) pos)
    (part-tracker-spawn part-tracker :to self :group group-target-hit)
    )
  (none)
  )

(defbehavior ow-boss-handler ow-boss ((proc process) (argc int) (message symbol) (block event-message-block))
  (case message
    (('die)
     (if (not (-> self dying))
         (go ow-boss-die)
         )
     )
    (('attack)
     (let ((info (the-as attack-info (-> block param 1))))
       (when (and info (not (-> self dying)) (!= (-> info id) (-> self last-attack)))
         (set! (-> self last-attack) (-> info id))
         (let ((dmg (if (logtest? (-> info mask) (attack-mask damage))
                        (-> info damage)
                        (penetrate-using->damage (-> info penetrate-using))
                        )
                    )
               )
           (if (<= dmg 0.0)
               (set! dmg 1.0)
               )
           (ow-boss-take-damage! (fmin 15.0 dmg))
           )
         #t
         )
       )
     )
    )
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; projectile du boss (grenade en cloche, vise le joueur local)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(deftype ow-boss-shot (process-drawable)
  ((vel    vector :inline)
   (big    symbol)
   (t0     time-frame)
   )
  (:states
    ow-boss-shot-fly
    )
  )

(defun ow-boss-shot-explode! ((pos vector) (big symbol))
  (vector-copy! (-> *launch-matrix* trans) pos)
  (part-tracker-spawn part-tracker :to *entity-pool* :group group-explode-death)
  (sound-play "explosion" :position pos)
  (let ((t *target*))
    (when (and t (not (focus-test? t dead))
               (< (vector-vector-distance pos (-> t control trans)) (if big (meters 11.0) (meters 7.0))))
      (let ((veh (online-my-vehicle))
            (dmg (if big 2.0 1.0))
            )
        (if (< 0.0 (-> *online-ext* power-left ONLINE_POW_STEEL))
            (set! dmg (* 0.5 dmg))
            )
        (if veh
            (ow-vehicle-fling! veh pos (if big (meters 30.0) (meters 20.0)) (if big (meters 26.0) (meters 14.0)) (* 7.0 dmg))
            (let ((away (vector-! (new 'stack-no-clear 'vector) (-> t control trans) pos)))
              (set! (-> away y) 0.0)
              (vector-normalize! away (meters 10.0))
              (set! (-> away y) (meters 8.0))
              (send-event t 'attack #f
                (static-attack-info :mask (vehicle-impulse-factor)
                  ((id (new-attack-id)) (damage dmg) (vehicle-damage-factor 1.0) (vehicle-impulse-factor 1.0) (mode 'generic) (vector away) (attacker-velocity away))
                  )
                )
              )
            )
        )
      )
    )
  (none)
  )

(defstate ow-boss-shot-fly (ow-boss-shot)
  :code (behavior ()
    (until #f
      (let ((dt (-> *display* real-clock seconds-per-frame))
            (me (-> self root trans))
            )
        (set! (-> self vel y) (- (-> self vel y) (* (meters 40.0) dt)))
        (vector+float*! me me (-> self vel) dt)
        (when (or (< (seconds 5) (- (online-now) (-> self t0)))
                  (and *target* (< (vector-vector-distance me (-> *target* control trans)) (if (-> self big) (meters 5.0) (meters 3.5))))
                  (and *target* (< (-> self vel y) 0.0) (< (-> me y) (- (-> *target* control trans y) (meters 1.0))))
                  )
          (ow-boss-shot-explode! me (-> self big))
          (deactivate self)
          )
        )
      (suspend)
      )
    #f
    )
  :post ja-post
  )

(defbehavior ow-boss-shot-init ow-boss-shot ((pos vector) (vel vector) (big symbol))
  (set! (-> self root) (new 'process 'trsqv))
  (vector-copy! (-> self root trans) pos)
  (vector-copy! (-> self vel) vel)
  (set! (-> self big) big)
  (quaternion-identity! (-> self root quat))
  (let ((sc (if big 9.0 4.0)))
    (set-vector! (-> self root scale) sc sc sc 1.0)
    )
  (initialize-skeleton self (the-as skeleton-group skel-gun-red-3-grenade) (the-as pair 0))
  (logclear! (-> self mask) (process-mask actor-pause))
  (set! (-> self t0) (online-now))
  (ja-post)
  (go ow-boss-shot-fly)
  )

(defun ow-boss-shoot-at-me! ((boss ow-boss))
  "le boss lance un projectile en cloche vers MON joueur (chaque jeu vise le sien)"
  (let ((t *target*))
    (when (and t (not (focus-test? t dead))
               (< (vector-vector-xz-distance (-> boss root trans) (-> t control trans)) (meters 140.0))
               )
      (let* ((from (vector-copy! (new 'stack-no-clear 'vector) (-> boss root trans)))
             (tp (-> t control trans))
             (d 0.0)
             (tv 0.0)
             (vel (new 'stack-no-clear 'vector))
             (big (= (-> boss kind) ONLINE_BOSS_TITAN))
             )
        (+! (-> from y) (* 0.85 (ow-boss-height (-> boss kind))))
        (set! d (vector-vector-xz-distance from tp))
        (set! tv (fmax 1.0 (fmin 3.0 (/ d (meters 45.0)))))
        (vector-! vel tp from)
        (vector-float*! vel vel (/ 1.0 tv))
        (+! (-> vel y) (* 0.5 (meters 40.0) tv))
        (set! (-> vel w) 0.0)
        (process-spawn ow-boss-shot :init ow-boss-shot-init from vel big :name "online-boss-tir" :to *entity-pool* :stack-size #x2000)
        )
      )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; comportement
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun ow-boss-driver? ()
  "c'est mon jeu qui pilote le boss (ou personne ne l'a pilote depuis 2 s)"
  (or (= (-> *online-ext* boss-driver) 1)
      (< (seconds 2) (- (online-now) (-> *online-events* sync-time)))
      )
  )

(defbehavior ow-boss-start-attack! ow-boss ((act int))
  (set! (-> self act) act)
  (set! (-> self attack-done) #f)
  (set! (-> self anim-idx) -1)
  (none)
  )

(defbehavior ow-boss-attack-hit! ow-boss ()
  "le moment ou le coup porte (chez tout le monde : chacun pour son joueur)"
  (let ((k (-> self kind))
        (reach (ow-boss-reach (-> self kind)))
        )
    (case (-> self act)
      ((OB_PUNCH)
       (ow-boss-hurt-me self 1.0 (* 1.15 reach) (meters 8.0))
       (if (= k ONLINE_BOSS_TITAN)
           (ow-boss-shoot-at-me! self)
           )
       )
      ((OB_STOMP)
       ;; onde de choc : tout le monde autour
       (ow-boss-hurt-me self 1.0 (* 1.7 reach) (meters 12.0))
       (let ((pos (vector-copy! (new 'stack-no-clear 'vector) (-> self root trans))))
         (sound-play "explosion" :position pos)
         (vector-copy! (-> *launch-matrix* trans) pos)
         (part-tracker-spawn part-tracker :to self :group group-explode-death)
         )
       )
      ((OB_SHOOT)
       (ow-boss-shoot-at-me! self)
       )
      )
    )
  (none)
  )

(defbehavior ow-boss-ground! ow-boss ()
  "sol sous le boss (toutes les 0.25 s) ; dans l'eau il marche dans l'eau, pas au fond"
  (let ((now (online-now)))
    (when (< (seconds 0.25) (- now (-> self ground-time)))
      (set! (-> self ground-time) now)
      (let ((p (vector-copy! (new 'stack-no-clear 'vector) (-> self root trans))))
        (when (oe-ground! p (meters 14.0))
          (set! (-> self ground-y) (-> p y))
          (if (and *ocean-map* (!= (-> self kind) ONLINE_BOSS_TITAN))
              (set! (-> self ground-y) (fmax (-> self ground-y) (+ (get-base-height *ocean-map*) (meters -2.0))))
              )
          )
        )
      )
    )
  (seek! (-> self root trans y) (-> self ground-y) (* (meters 20.0) (-> *display* real-clock seconds-per-frame)))
  (none)
  )

(defbehavior ow-boss-contact! ow-boss ()
  "vehicule contre le boss : on peut l'ecraser en fonçant dessus... et il ecrase les vehicules"
  (let ((veh (online-my-vehicle))
        (now (online-now))
        )
    (when (and veh *target* (not (focus-test? *target* dead)))
      (let ((d (vector-vector-xz-distance (-> veh root trans) (-> self root trans)))
            (r (* 0.75 (ow-boss-reach (-> self kind))))
            )
        (when (and (< d r) (< (fabs (- (-> veh root trans y) (-> self root trans y))) (fmax (meters 10.0) (* 0.5 (ow-boss-height (-> self kind))))))
          (let* ((rb (-> (the-as vehicle veh) rbody))
                 (spd (if (and rb (nonzero? rb)) (sqrtf (+ (* (-> rb lin-velocity x) (-> rb lin-velocity x)) (* (-> rb lin-velocity z) (-> rb lin-velocity z)))) 0.0))
                 )
            ;; percuter le boss a pleine vitesse l'abime (et le vehicule aussi)
            (when (and (< (meters 12.0) spd) (< (seconds 1) (- now (-> self ram-time))))
              (set! (-> self ram-time) now)
              (ow-boss-take-damage! (fmin 15.0 (/ spd (meters 3.0))))
              )
            ;; au contact : le boss repousse et abime le vehicule
            (when (< (seconds 0.8) (- now (-> self contact-time)))
              (set! (-> self contact-time) now)
              (ow-vehicle-fling! veh (-> self root trans) (meters 9.0) (meters 16.0) 4.0)
              )
            )
          )
        )
      )
    )
  (none)
  )

(defbehavior ow-boss-drive! ow-boss ()
  "pilote : marche vers le joueur le plus proche, frappe, ecrase le sol, tire"
  (let* ((now (online-now))
         (dt (-> *display* real-clock seconds-per-frame))
         (k (-> self kind))
         (reach (ow-boss-reach k))
         (tgt (new 'stack-no-clear 'vector))
         (have (ow-boss-pick-target self tgt))
         )
    (cond
      ((>= (-> self act) OB_PUNCH)
       ;; attaque en cours : elle se termine avec son animation
       )
      (have
        (let* ((to (vector-! (new 'stack-no-clear 'vector) tgt (-> self root trans)))
               (dist (sqrtf (+ (* (-> to x) (-> to x)) (* (-> to z) (-> to z)))))
               )
          (set! (-> to y) 0.0)
          ;; il se tourne vers sa cible
          (quaternion-axis-angle! (-> self root quat) 0.0 1.0 0.0 (atan (-> to x) (-> to z)))
          (cond
            ((and (< dist reach) (< (seconds 2.2) (- now (-> self attack-time))) (< (seconds 4) (- now (-> self state-time))))
             ;; a portee : coup, ou coup au sol de temps en temps
             (set! (-> self attack-time) now)
             (cond
               ((< (seconds 9) (- now (-> self stomp-time)))
                (set! (-> self stomp-time) now)
                (ow-boss-start-attack! OB_STOMP)
                )
               (else
                 (ow-boss-start-attack! OB_PUNCH)
                 )
               )
             )
            ((and (< (meters 25.0) dist) (< dist (meters 120.0))
                  (!= k ONLINE_BOSS_BETE)
                  (< (if (= k ONLINE_BOSS_TITAN) (seconds 3.5) (seconds 6)) (- now (-> self shoot-time)))
                  (< (seconds 4) (- now (-> self state-time)))
                  )
             ;; de loin : il tire (le titan et le robot souvent, les Jak geants parfois)
             (set! (-> self shoot-time) now)
             (ow-boss-start-attack! OB_SHOOT)
             )
            ((< (* 0.8 reach) dist)
             (let ((spd (* (ow-boss-speed k) (if (< (meters 30.0) dist) (meters 11.0) (meters 6.0)))))
               (vector-normalize! to (fmin (* spd dt) (- dist (* 0.8 reach))))
               (vector+! (-> self root trans) (-> self root trans) to)
               (set! (-> self act) (if (< (meters 30.0) dist) OB_RUN OB_WALK))
               )
             )
            (else
              (set! (-> self act) OB_IDLE)
              )
            )
          )
        )
      (else
        (set! (-> self act) OB_IDLE)
        )
      )
    ;; position envoyee aux autres (4 fois par seconde)
    (when (< (seconds 0.25) (- now (-> self send-time)))
      (set! (-> self send-time) now)
      ;; damage = cap (angle), mode = action, dir = position
      (let ((v (vector-copy! (new 'stack-no-clear 'vector) (-> self root trans))))
        (online-push-out-event! ONLINE_EVENT_BOSS_POS (-> *online-ext* ev-id) (quaternion-y-angle (-> self root quat)) (-> self act) v)
        )
      )
    )
  (none)
  )

(defbehavior ow-boss-follow! ow-boss ()
  "suiveur : rejoint la position du pilote, rejoue ses attaques"
  (let* ((ext *online-ext*)
         (dt (-> *display* real-clock seconds-per-frame))
         )
    (when (!= (-> ext boss-seq) (-> self sync-seq))
      (set! (-> self sync-seq) (-> ext boss-seq))
      (vector-copy! (-> self want) (-> ext boss-pos))
      (set! (-> self have-want) #t)
      (let ((a (the-as int (-> ext boss-anim))))
        ;; une nouvelle attaque chez le pilote : on la joue aussi
        (cond
          ((and (>= a OB_PUNCH) (< (-> self want-act) OB_PUNCH) (< (-> self act) OB_PUNCH))
           (ow-boss-start-attack! a)
           )
          ((< (-> self act) OB_PUNCH)
           (set! (-> self act) a)
           )
          )
        (set! (-> self want-act) a)
        )
      )
    (when (-> self have-want)
      (let* ((to (vector-! (new 'stack-no-clear 'vector) (-> self want) (-> self root trans)))
             (dist 0.0)
             )
        (set! (-> to y) 0.0)
        (set! (-> to w) 0.0)
        (set! dist (vector-length to))
        (cond
          ((< (meters 40.0) dist)
           ;; trop loin : il saute a sa place
           (set! (-> self root trans x) (-> self want x))
           (set! (-> self root trans z) (-> self want z))
           (set! (-> self ground-time) 0)
           )
          ((< (meters 0.05) dist)
           (vector-normalize! to (fmin dist (* dt (fmax (meters 6.0) (* 4.0 dist)))))
           (vector+! (-> self root trans) (-> self root trans) to)
           )
          )
        (quaternion-axis-angle! (-> self root quat) 0.0 1.0 0.0 (-> self want w))
        )
      )
    )
  (none)
  )

(defbehavior ow-boss-think ow-boss ()
  ;; vrai boss rattache a un niveau qui se decharge : il s'en va
  (if (and (>= (-> self kind) ONLINE_BOSS_ROBOT) (or (not (-> self level)) (!= (-> self level status) 'active)))
      (deactivate self)
      )
  (let ((now (online-now))
        (k (-> self kind))
        )
    (ow-boss-ground!)
    (if (ow-boss-driver?)
        (ow-boss-drive!)
        (ow-boss-follow!)
        )
    (ow-boss-contact!)
    ;; animation de l'action ; le coup porte a mi-animation
    (let* ((act (-> self act))
           (attacking (>= act OB_PUNCH))
           (spd (cond
                  (attacking (if (= k ONLINE_BOSS_TITAN) 0.8 1.0))
                  ((= k ONLINE_BOSS_BETE) 0.9)
                  ((< k ONLINE_BOSS_ROBOT) 0.5)
                  (else 0.7)
                  )
                )
           )
      (when (and attacking (not (-> self attack-done)) (< 0.45 (ow-boss-anim-progress)))
        (set! (-> self attack-done) #t)
        (ow-boss-attack-hit!)
        )
      (when (ow-boss-play (ow-boss-anim-idx k act) spd (not attacking))
        (set! (-> self act) OB_IDLE)
        (set! (-> self anim-idx) -1)
        )
      )
    ;; couleur de la variante, eclair blanc quand il est touche
    (let ((flash (if (< (- now (-> self hit-time)) (seconds 0.12)) 1.0 0.0)))
      (case k
        ((0)
         (set-vector! (-> self draw color-mult) (+ 0.35 flash) (+ 0.22 flash) (+ 0.6 flash) 1.0)
         (set-vector! (-> self draw color-emissive) (+ 0.12 (* 0.5 flash)) 0.0 (+ 0.25 (* 0.5 flash)) 1.0)
         )
        ((1)
         (set-vector! (-> self draw color-mult) (+ 0.08 flash) (+ 0.08 flash) (+ 0.12 flash) 1.0)
         (set-vector! (-> self draw color-emissive) (* 0.5 flash) (* 0.5 flash) (+ 0.05 (* 0.5 flash)) 1.0)
         )
        ((2)
         (set-vector! (-> self draw color-mult) (+ 0.8 flash) (+ 0.18 flash) (+ 0.12 flash) 1.0)
         (set-vector! (-> self draw color-emissive) (+ 0.3 (* 0.5 flash)) 0.0 0.0 1.0)
         )
        (else
          (set-vector! (-> self draw color-mult) (+ 1.0 flash) (+ 1.0 flash) (+ 1.0 flash) 1.0)
          (set-vector! (-> self draw color-emissive) (* 0.6 flash) (* 0.6 flash) (* 0.6 flash) 1.0)
          )
        )
      )
    )
  (none)
  )

(defbehavior ow-boss-post ow-boss ()
  (ow-boss-sync-geo!)
  (update-transforms (-> self root))
  (ja-post)
  (none)
  )

(defstate ow-boss-live (ow-boss)
  :event ow-boss-handler
  :trans (behavior ()
    (ow-boss-think)
    )
  :code (behavior ()
    (until #f
      (suspend)
      )
    #f
    )
  :post ow-boss-post
  )

(defstate ow-boss-die (ow-boss)
  :code (behavior ()
    (set! (-> self dying) #t)
    (let ((pos (vector-copy! (new 'stack-no-clear 'vector) (-> self root trans))))
      (+! (-> pos y) (* 0.3 (ow-boss-height (-> self kind))))
      (sound-play "jak-explode" :position pos)
      (vector-copy! (-> *launch-matrix* trans) pos)
      (part-tracker-spawn part-tracker :to self :group group-explode-death)
      )
    (let ((rp (-> self root root-prim)))
      (set! (-> rp prim-core collide-as) (collide-spec))
      (set! (-> rp prim-core collide-with) (collide-spec))
      )
    (set! (-> self anim-idx) -1)
    (until (ow-boss-play (ow-boss-anim-idx (-> self kind) 7) 0.5 #f)
      (suspend)
      )
    (when (< (-> self kind) ONLINE_BOSS_ROBOT)
      (set! (-> self anim-idx) -1)
      (until (ow-boss-play (ow-boss-anim-idx (-> self kind) 8) 0.5 #f)
        (suspend)
        )
      )
    (let ((start (online-now))
          (sc (ow-boss-scale (-> self kind)))
          )
      (while (< (- (online-now) start) (seconds 3))
        (let ((k (- 1.0 (/ (the float (- (online-now) start)) (the float (seconds 3))))))
          (set-vector! (-> self root scale) (* sc k) (* sc k) (* sc k) 1.0)
          )
        (suspend)
        )
      )
    (deactivate self)
    )
  :post ow-boss-post
  )

(defbehavior ow-boss-init ow-boss ((pos vector) (kind int))
  (set! (-> self kind) kind)
  (let* ((sc (ow-boss-scale kind))
         (real? (>= kind ONLINE_BOSS_ROBOT))
         ;; spheres de collision (en metres, avant l'echelle du modele)
         (h (/ (ow-boss-height kind) sc))
         (r (/ (* 0.55 (ow-boss-reach kind)) sc))
         (cs (new 'process 'collide-shape-moving self (collide-list-enum usually-hit-by-player)))
         )
    (set! (-> cs dynam) (copy *standard-dynamics* 'process))
    (set! (-> cs reaction) cshape-reaction-default)
    (set! (-> cs no-reaction) (the-as (function collide-shape-moving collide-query vector vector object) nothing))
    (set! (-> cs penetrated-by) (penetrate
                                  generic-attack lunge flop punch spin roll uppercut bonk tube vehicle flut-attack board
                                  mech mech-punch mech-bonk dark-skin dark-punch dark-bomb dark-smack flut explode
                                  jak-yellow-shot jak-red-shot jak-blue-shot jak-dark-shot knocked jak-red-shockwave
                                  jak-dark-nuke jak-dark-blackhole
                                  )
          )
    (let ((grp (new 'process 'collide-shape-prim-group cs (the-as uint 3) 0)))
      (set! (-> cs total-prims) (the-as uint 4))
      (set! (-> grp prim-core collide-as) (collide-spec enemy))
      (set! (-> grp prim-core collide-with) (collide-spec backgnd jak bot crate obstacle hit-by-others-list player-list))
      (set! (-> grp prim-core action) (collide-action solid))
      (set-vector! (-> grp local-sphere) 0.0 (* 0.5 h) 0.0 (fmax (* 0.6 h) (* 1.2 r)))
      (set! (-> cs root-prim) grp)
      )
    (let ((sph (new 'process 'collide-shape-prim-sphere cs (the-as uint 0))))
      (set! (-> sph prim-core collide-as) (collide-spec enemy))
      (set! (-> sph prim-core collide-with) (collide-spec jak bot player-list hit-by-others-list))
      (set! (-> sph prim-core action) (collide-action solid))
      (set-vector! (-> sph local-sphere) 0.0 (* 0.2 h) 0.0 (* 0.8 r))
      )
    (let ((sph (new 'process 'collide-shape-prim-sphere cs (the-as uint 0))))
      (set! (-> sph prim-core collide-as) (collide-spec enemy))
      (set! (-> sph prim-core collide-with) (collide-spec jak bot player-list hit-by-others-list))
      (set! (-> sph prim-core action) (collide-action solid))
      (set-vector! (-> sph local-sphere) 0.0 (* 0.5 h) 0.0 r)
      )
    (let ((sph (new 'process 'collide-shape-prim-sphere cs (the-as uint 0))))
      (set! (-> sph prim-core collide-as) (collide-spec enemy))
      (set! (-> sph prim-core collide-with) (collide-spec jak bot player-list hit-by-others-list))
      (set! (-> sph prim-core action) (collide-action solid))
      (set-vector! (-> sph local-sphere) 0.0 (* 0.8 h) 0.0 (* 0.8 r))
      )
    (set! (-> cs nav-radius) (* r sc))
    (let ((rp (-> cs root-prim)))
      (set! (-> cs backup-collide-as) (-> rp prim-core collide-as))
      (set! (-> cs backup-collide-with) (-> rp prim-core collide-with))
      )
    (set! (-> self root) cs)
    (vector-copy! (-> self root trans) pos)
    (set! (-> self root trans w) 1.0)
    (quaternion-identity! (-> self root quat))
    (set-vector! (-> self root scale) sc sc sc 1.0)
    (initialize-skeleton
      self
      (the-as skeleton-group
              (case kind
                ((ONLINE_BOSS_ROBOT) *zone-boss-sg*)
                ((ONLINE_BOSS_TITAN) skel-ow-titan)
                ((ONLINE_BOSS_BETE) skel-ow-bete)
                (else (art-group-get-by-name *level* "skel-jchar" (the-as (pointer level) #f)))
                )
              )
      (the-as pair 0)
      )
    (if (and real? (nonzero? (-> self draw)) (-> self draw shadow-ctrl))
        (logior! (-> self draw shadow-ctrl settings flags) (shadow-flags disable-draw))
        )
    (if (and real? *target* (nonzero? (-> *target* draw)) (nonzero? (-> self draw)))
        (set! (-> self draw light-index) (-> *target* draw light-index))
        )
    )
  (ja-channel-set! 1)
  (set! (-> self geo) -1)
  (set! (-> self anim-idx) -1)
  (set! (-> self frame) 0.0)
  (set! (-> self act) OB_IDLE)
  (set! (-> self want-act) OB_IDLE)
  (set! (-> self have-want) #f)
  (set! (-> self sync-seq) (-> *online-ext* boss-seq))
  (set! (-> self attack-done) #t)
  (set! (-> self dying) #f)
  (set! (-> self last-attack) (the-as uint 0))
  (set! (-> self ground-y) (-> pos y))
  (set! (-> self ground-time) 0)
  (set! (-> self attack-time) 0)
  (set! (-> self shoot-time) (online-now))
  (set! (-> self contact-time) 0)
  (set! (-> self ram-time) 0)
  (set! (-> self send-time) 0)
  (set! (-> self stomp-time) (online-now))
  (set! (-> self hit-time) 0)
  (set! (-> self draw lod-set max-lod) 0)
  (logclear! (-> self mask) (process-mask actor-pause))
  (logior! (-> self mask) (process-mask enemy))
  (set-time! (-> self state-time))
  (go ow-boss-live)
  )

(defun oe-boss-art-ok? ((kind int))
  "l'art du boss est-il la ?"
  (case kind
    ((ONLINE_BOSS_ROBOT ONLINE_BOSS_TITAN ONLINE_BOSS_BETE) #t)
    (else (art-group-get-by-name *level* "skel-jchar" (the-as (pointer level) #f)))
    )
  )

(defun oe-boss-pos ((out vector))
  "ou est le boss : le mien s'il est la, sinon la derniere position du pilote, sinon le point de l'evenement"
  (let ((boss (the-as ow-boss (handle->process (-> *online-events* boss))))
        (ext *online-ext*)
        )
    (cond
      ((and boss (not (-> boss dying)))
       (vector-copy! out (-> boss root trans))
       )
      ((and (nonzero? (-> ext boss-seq)) (< (- (online-now) (-> *online-events* sync-time)) (seconds 10)))
       (vector-copy! out (-> ext boss-pos))
       )
      (else
        (vector-copy! out (-> ext ev-pos))
        )
      )
    (set! (-> out w) 1.0)
    out
    )
  )

(defun oe-boss-update! ()
  (let* ((es *online-events*)
         (ext *online-ext*)
         (boss (the-as ow-boss (handle->process (-> es boss))))
         (kind (the-as int (-> ext ev-boss)))
         (bpos (oe-boss-pos (new 'stack-no-clear 'vector)))
         (dist (if *target* (/ (vector-vector-xz-distance (-> *target* control trans) bpos) 4096.0) 99999.0))
         (want (and (oe-active? ONLINE_EVK_BOSS) *target* (not (movie?)) (< dist 180.0)))
         )
    ;; nouvelle position du pilote
    (when (!= (-> ext boss-seq) (-> es sync-seen))
      (set! (-> es sync-seen) (-> ext boss-seq))
      (set! (-> es sync-time) (online-now))
      )
    (cond
      ;; le boss tombe (points de vie partages a zero) ou l'evenement est fini
      ((and boss (not (-> boss dying))
            (or (not (online-in-session?))
                (!= (-> ext ev-id) (-> es boss-id))
                (!= (-> ext ev-state) 1)
                (<= (-> ext ev-hp) 0.0)
                )
            )
       (cond
         ((and (= (-> ext ev-id) (-> es boss-id)) (or (= (-> ext ev-state) 2) (<= (-> ext ev-hp) 0.0)))
          ;; vaincu : il meurt (animation, explosion)
          (send-event boss 'die)
          )
         (else
           (deactivate boss)
           (set! (-> es boss) (the-as handle #f))
           )
         )
       )
      ;; loin : il disparait chez moi (il continue chez les autres ; il reviendra a sa place)
      ((and boss (not (-> boss dying)) (< 240.0 dist))
       (deactivate boss)
       (set! (-> es boss) (the-as handle #f))
       )
      ((and want (not boss) (< 0.0 (-> ext ev-hp)) (oe-boss-art-ok? kind))
       (let ((pos (vector-copy! (new 'stack-no-clear 'vector) bpos))
             (lt (level-get-target-inside *level*))
             )
         (set! (-> pos w) 1.0)
         (oe-ground! pos (meters 40.0))
         (cond
           ((< kind ONLINE_BOSS_ROBOT)
            (let ((pp (process-spawn ow-boss :init ow-boss-init pos kind :name "online-boss" :to *entity-pool* :stack-size #x8000)))
              (when pp
                (set! (-> es boss) (ppointer->handle pp))
                (set! (-> es boss-id) (-> ext ev-id))
                (set! (-> es boss-dmg) 0.0)
                )
              )
            )
           ((and lt (!= (-> lt name) 'default) (< (-> lt index) 10))
            ;; vrais boss : rattaches au niveau ou se trouve Jak (dessin), art pris dans GAME
            (let ((proc (get-process *default-dead-pool* ow-boss #x8000 1)))
              (when proc
                ((method-of-type process activate) proc *entity-pool* "online-boss" (the-as pointer #x70004000))
                (set! (-> (the-as process-drawable proc) level) lt)
                (run-now-in-process proc ow-boss-init pos kind)
                (set! (-> es boss) (process->handle proc))
                (set! (-> es boss-id) (-> ext ev-id))
                (set! (-> es boss-dmg) 0.0)
                )
              )
            )
           )
         )
       )
      )
    ;; mes degats -> Jak3Online.exe (paquets de 0.4 s)
    (when (and (< 0.0 (-> es boss-dmg)) (< (seconds 0.4) (- (online-now) (-> es boss-sent))))
      (set! (-> es boss-sent) (online-now))
      (online-push-out-event! ONLINE_EVENT_BOSS_DMG (the-as uint 0) 0.0 (the int (* 10.0 (-> es boss-dmg))) (the-as vector #f))
      (set! (-> es boss-dmg) 0.0)
      )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; PLUIE D'ORBES, TRESOR, ZONE
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun oe-random-around ((out vector) (center vector) (radius float))
  (let ((a (rand-vu-float-range 0.0 65536.0))
        (r (* radius (sqrtf (rand-vu-float-range 0.0 1.0))))
        )
    (set-vector! out (+ (-> center x) (* r (sin a))) (-> center y) (+ (-> center z) (* r (cos a))) 1.0)
    )
  out
  )

(defun oe-orbs-update! ()
  (let* ((es *online-events*)
         (ext *online-ext*)
         (proc (handle->process (-> es orbs-proc)))
         )
    (cond
      ((and proc (not (oe-active? ONLINE_EVK_ORBS)))
       (deactivate proc)
       (set! (-> es orbs-proc) (the-as handle #f))
       )
      ((and (not proc) (oe-active? ONLINE_EVK_ORBS) (!= (-> es orbs-id) (-> ext ev-id)) *target* (< (oe-dist-to-event) 90.0))
       (set! (-> es orbs-id) (-> ext ev-id))
       (let ((pp (process-spawn-function
                   process
                   (lambda :behavior process ()
                     (let ((pos (new 'stack-no-clear 'vector))
                           (n 0)
                           )
                       (while (and (< n 45) (oe-active? ONLINE_EVK_ORBS))
                         (oe-random-around pos (-> *online-ext* ev-pos) (meters 28.0))
                         (when (oe-ground! pos (meters 30.0))
                           (+! (-> pos y) (meters 1.5))
                           (birth-pickup-at-point pos (pickup-type skill) 1.0 #t *entity-pool* (the-as fact-info #f))
                           (+! n 1)
                           )
                         (suspend-for (seconds 0.35))
                         )
                       )
                     (until #f (suspend))
                     #f
                     )
                   :name "online-pluie"
                   :to *entity-pool*
                   :stack-size #x2000
                   )
                 )
             )
         (if pp
             (set! (-> es orbs-proc) (ppointer->handle pp))
             )
         )
       )
      )
    )
  (none)
  )

(defun oe-spawn-orb-art ((pos vector) (scale float))
  "une orbe precurseur geante (tresor, balise de zone)"
  (let ((sg (art-group-get-by-name *level* "skel-skill" (the-as (pointer level) #f)))
        (result (the-as handle #f))
        )
    (when (and sg (nonzero? sg))
      (let ((pp (process-spawn
                  manipy
                  :init manipy-init
                  pos
                  (the-as entity-actor #f)
                  (the-as skeleton-group sg)
                  (the-as vector #f)
                  (the-as manipy-options 0)
                  :name "online-orbe-geante"
                  :to *entity-pool*
                  :stack-size #x20000
                  )
                )
            )
        (when pp
          (let ((p (the-as process-drawable (ppointer->process pp))))
            (set-vector! (-> p root scale) scale scale scale 1.0)
            )
          (set! result (ppointer->handle pp))
          )
        )
      )
    result
    )
  )

(defun oe-treasure-update! ()
  (let* ((es *online-events*)
         (ext *online-ext*)
         (chest (the-as process-drawable (handle->process (-> es chest))))
         (want (and (oe-active? ONLINE_EVK_TREASURE) *target* (not (-> es chest-found)) (< (oe-dist-to-event) 150.0)))
         )
    (if (!= (-> es chest-id) (-> ext ev-id))
        (set! (-> es chest-found) #f)
        )
    (cond
      ((and chest (not want))
       (deactivate chest)
       (set! (-> es chest) (the-as handle #f))
       )
      ((and want (not chest))
       (let ((pos (vector-copy! (new 'stack-no-clear 'vector) (-> ext ev-pos))))
         (set! (-> pos w) 1.0)
         (oe-ground! pos (meters 40.0))
         (+! (-> pos y) (meters 1.5))
         (set! (-> es chest) (oe-spawn-orb-art pos 4.0))
         (set! (-> es chest-id) (-> ext ev-id))
         )
       )
      (chest
        ;; l'orbe doree tourne ; on la touche -> tresor trouve
        (quaternion-axis-angle! (-> chest root quat) 0.0 1.0 0.0 (* 30000.0 (/ (the float (online-now)) 300.0)))
        (set-vector! (-> chest draw color-mult) 1.6 1.3 0.4 1.0)
        (set-vector! (-> chest draw color-emissive) 0.5 0.35 0.0 1.0)
        (when (and *target* (< (vector-vector-distance (-> *target* control trans) (-> chest root trans)) (meters 4.0)))
          (set! (-> es chest-found) #t)
          (online-push-out-event! ONLINE_EVENT_EVENT (the-as uint 0) 0.0 1 (-> chest root trans))
          (sound-play "skill-pickup")
          (deactivate chest)
          (set! (-> es chest) (the-as handle #f))
          )
        )
      )
    )
  (none)
  )

(defun oe-zone-update! ()
  (let* ((es *online-events*)
         (ext *online-ext*)
         (beacon (the-as process-drawable (handle->process (-> es beacon))))
         (active (and (or (oe-active? ONLINE_EVK_ZONE) (oe-active? ONLINE_EVK_METEOR)) *target*))
         )
    (cond
      ((and beacon (or (not active) (!= (-> es beacon-id) (-> ext ev-id))))
       (deactivate beacon)
       (set! (-> es beacon) (the-as handle #f))
       )
      ((and active (not beacon) (< (oe-dist-to-event) 180.0))
       (let ((pos (vector-copy! (new 'stack-no-clear 'vector) (-> ext ev-pos))))
         (set! (-> pos w) 1.0)
         (oe-ground! pos (meters 40.0))
         (+! (-> pos y) (meters 9.0))
         (set! (-> es beacon) (oe-spawn-orb-art pos 6.0))
         (set! (-> es beacon-id) (-> ext ev-id))
         )
       )
      (beacon
        (quaternion-axis-angle! (-> beacon root quat) 0.0 1.0 0.0 (* 20000.0 (/ (the float (online-now)) 300.0)))
        (let ((inside (-> es in-zone)))
          (cond
            ((= (-> ext ev-kind) ONLINE_EVK_METEOR)
             (set-vector! (-> beacon draw color-mult) 1.8 0.5 0.1 1.0)
             (set-vector! (-> beacon draw color-emissive) 0.6 0.15 0.0 1.0)
             )
            (else
              (set-vector! (-> beacon draw color-mult) (if inside 0.4 1.6) (if inside 1.6 0.5) 0.5 1.0)
              (set-vector! (-> beacon draw color-emissive) (if inside 0.0 0.5) (if inside 0.5 0.0) 0.0 1.0)
              )
            )
          )
        )
      )
    (set! (-> es in-zone)
          (the-as symbol (and active
                              (not (focus-test? *target* dead))
                              (< (* 4096.0 (oe-dist-to-event)) (fmax (meters 8.0) (-> ext ev-radius)))
                              )
                  )
          )
    (when (and (-> es in-zone) (< (seconds 1) (- (online-now) (-> es zone-tick))))
      (set! (-> es zone-tick) (online-now))
      (online-push-out-event! ONLINE_EVENT_EVENT (the-as uint 0) 0.0 3 (-> *target* control trans))
      )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; PLUIE DE METEORES : les memes meteores au meme endroit chez tout le monde (tires d'un hasard
;; calcule a partir du numero de l'evenement et du temps ecoule). On marque des points en restant
;; dans la zone ; un meteore fait mal (et envoie les vehicules en l'air).
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(deftype ow-meteor (process-drawable)
  ((ground  float)
   (speed   float)
   )
  (:states
    ow-meteor-fall
    )
  )

(defstate ow-meteor-fall (ow-meteor)
  :code (behavior ()
    (until #f
      (let ((dt (-> *display* real-clock seconds-per-frame))
            (me (-> self root trans))
            )
        (+! (-> self speed) (* (meters 30.0) dt))
        (set! (-> me y) (- (-> me y) (* (-> self speed) dt)))
        (quaternion-rotate-y! (-> self root quat) (-> self root quat) (* 30000.0 dt))
        (when (< (-> me y) (-> self ground))
          (set! (-> me y) (-> self ground))
          (ow-boss-shot-explode! me #t)
          (deactivate self)
          )
        )
      (suspend)
      )
    #f
    )
  :post ja-post
  )

(defbehavior ow-meteor-init ow-meteor ((pos vector) (ground float))
  (set! (-> self root) (new 'process 'trsqv))
  (vector-copy! (-> self root trans) pos)
  (set! (-> self ground) ground)
  (set! (-> self speed) (meters 25.0))
  (quaternion-identity! (-> self root quat))
  (set-vector! (-> self root scale) 12.0 12.0 12.0 1.0)
  (initialize-skeleton self (the-as skeleton-group skel-gun-red-3-grenade) (the-as pair 0))
  (set-vector! (-> self draw color-mult) 1.6 0.5 0.1 1.0)
  (set-vector! (-> self draw color-emissive) 1.0 0.3 0.0 1.0)
  (logclear! (-> self mask) (process-mask actor-pause))
  (ja-post)
  (go ow-meteor-fall)
  )

(defun oe-meteor-update! ()
  (let* ((es *online-events*)
         (ext *online-ext*)
         )
    (when (and (oe-active? ONLINE_EVK_METEOR) *target* (not (movie?)) (< (oe-dist-to-event) 150.0))
      (let* ((elapsed (- (-> ext ev-dur) (-> ext ev-timer)))
             (k (the int (/ elapsed 0.55)))
             )
        (when (and (< 3.0 elapsed) (!= k (-> es meteor-k)) (< 0.0 (-> ext ev-timer)))
          (set! (-> es meteor-k) k)
          ;; hasard commun a tous : numero de l'evenement + numero du meteore
          (let* ((h (logand (+ (* (the-as int (-> ext ev-id)) 1103515245) (* k 2654435761) 12345) #xffffffff))
                 (a (* 65536.0 (/ (the float (logand h #xffff)) 65536.0)))
                 (r (* (fmax (meters 8.0) (-> ext ev-radius)) (sqrtf (/ (the float (logand (ash h -16) #xffff)) 65536.0))))
                 (pos (new 'stack-no-clear 'vector))
                 )
            (set-vector! pos (+ (-> ext ev-pos x) (* r (sin a))) (-> ext ev-pos y) (+ (-> ext ev-pos z) (* r (cos a))) 1.0)
            (when (oe-ground! pos (meters 40.0))
              (let ((ground (-> pos y)))
                (+! (-> pos y) (meters 70.0))
                (process-spawn ow-meteor :init ow-meteor-init pos ground :name "online-meteore" :to *entity-pool* :stack-size #x2000)
                )
              )
            )
          )
        )
      )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; SUPER-POUVOIRS (effets dans le jeu)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define-extern ow-parkour-now? (function symbol))

(defun oe-powers-update! ()
  (let* ((es *online-events*)
         (ext *online-ext*)
         ;; sur un parcours : pas de super-pouvoirs (pas de raccourci)
         (on (and (online-in-session?) (-> *online-world* active) (not (ow-parkour-now?))))
         (turbo (and on (< 0.0 (-> ext power-left ONLINE_POW_TURBO))))
         (jump (and on (< 0.0 (-> ext power-left ONLINE_POW_JUMP))))
         (regen (and on (< 0.0 (-> ext power-left ONLINE_POW_REGEN))))
         )
    (when (not (-> es banks-saved))
      (set! (-> es banks-saved) #t)
      (set! (-> es walk-speed) (-> *walk-mods* target-speed))
      (set! (-> es walk-transv) (-> *walk-mods* transv-max))
      (set! (-> es jump-min) (-> *TARGET-bank* jump-height-min))
      (set! (-> es jump-max) (-> *TARGET-bank* jump-height-max))
      (set! (-> es djump-min) (-> *TARGET-bank* double-jump-height-min))
      (set! (-> es djump-max) (-> *TARGET-bank* double-jump-height-max))
      )
    ;; TURBO : on court 60 % plus vite (la vitesse de marche est reglee par oe-blue-eco-update!,
    ;; qui tient compte du turbo ET de l'eco bleu)
    (set! (-> es turbo-on) turbo)
    ;; SUPER SAUT : on saute deux fois plus haut
    (when (!= jump (-> es jump-on))
      (set! (-> es jump-on) jump)
      (set! (-> *TARGET-bank* jump-height-min) (* (if jump 2.0 1.0) (-> es jump-min)))
      (set! (-> *TARGET-bank* jump-height-max) (* (if jump 2.0 1.0) (-> es jump-max)))
      (set! (-> *TARGET-bank* double-jump-height-min) (* (if jump 2.0 1.0) (-> es djump-min)))
      (set! (-> *TARGET-bank* double-jump-height-max) (* (if jump 2.2 1.0) (-> es djump-max)))
      )
    ;; sur un parcours : on descend de la planche et on quitte Light / Dark Jak (pas de raccourci)
    (when (and *target* (online-in-session?) (ow-parkour-now?) (not (focus-test? *target* dead)))
      (if (focus-test? *target* board) (send-event *target* 'end-mode 'board))
      (if (focus-test? *target* light) (send-event *target* 'end-mode 'lightjak))
      (if (focus-test? *target* dark) (send-event *target* 'end-mode 'darkjak))
      )
    ;; REGENERATION : 1 point de vie toutes les 1.5 s
    (when (and regen *target* (not (focus-test? *target* dead))
               (< (-> *target* fact health) (-> *target* fact health-max))
               (< (seconds 1.5) (- (online-now) (-> es regen-time)))
               )
      (set! (-> es regen-time) (online-now))
      (send-event *target* 'get-pickup (pickup-type health) 1.0)
      )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; ECO BLEU (achete a la boutique, 3 min) : aussi puissant que dans le mod d'exemple
;;  - Jak court, saute, roule et attaque beaucoup plus vite, roulade-saut tres longue ;
;;  - tir rapide (cadence de l'arme) ;
;;  - vehicule : vitesse de pointe x2.5 (montee progressive) ;
;;  - aimant : orbes, vies, munitions et eco a 40 m viennent toutes seules.
;; Les vitesses d'origine sont gardees et remises chaque image hors eco bleu.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define *oe-surf* (new 'global 'boxed-array surface 10))
(define *oe-surf-save* (new 'static 'array float 40))
(define *oe-surf-blue* (new 'static 'array float 10 240960.0 150960.0 140960.0 340960.0 150960.0 240960.0 240960.0 240960.0 245760.0 245760.0))
(define *oe-surf-ready* #f)
(define *oe-flip-save* (new 'static 'array float 2))
(define *oe-blue-on* #f)
(define *oe-magnet-pos* (new 'static 'vector))

(defun oe-surf-init! ()
  (let ((arr *oe-surf*))
    (set! (-> arr 0) *attack-mods*)
    (set! (-> arr 1) *walk-mods*)
    (set! (-> arr 2) *jump-mods*)
    (set! (-> arr 3) *double-jump-mods*)
    (set! (-> arr 4) *gun-walk-mods*)
    (set! (-> arr 5) *run-attack-mods*)
    (set! (-> arr 6) *jump-attack-mods*)
    (set! (-> arr 7) *uppercut-jump-mods*)
    (set! (-> arr 8) *roll-mods*)
    (set! (-> arr 9) *roll-flip-mods*)
    (dotimes (i 10)
      (let ((sf (-> arr i)))
        (set! (-> *oe-surf-save* (* i 4)) (-> sf transv-max))
        (set! (-> *oe-surf-save* (+ (* i 4) 1)) (-> sf target-speed))
        (set! (-> *oe-surf-save* (+ (* i 4) 2)) (-> sf seek0))
        (set! (-> *oe-surf-save* (+ (* i 4) 3)) (-> sf seek90))
        )
      )
    )
  (set! (-> *oe-flip-save* 0) (-> *TARGET-bank* roll-flip-height))
  (set! (-> *oe-flip-save* 1) (-> *TARGET-bank* roll-flip-dist))
  (set! *oe-surf-ready* #t)
  (none)
  )

(defun oe-blue? ()
  (and *target*
       (nonzero? (-> *target* fact))
       (= (-> *target* fact eco-type) (pickup-type eco-blue))
       (< 0.0 (-> *target* fact eco-level))
       )
  )

(defun oe-magnet-try ((p process))
  "aimant de l'eco bleu : l'objet ramassable vient vers Jak"
  (when (and (type-type? (-> p type) collectable)
             (nonzero? (-> (the-as process-drawable p) root))
             )
    (let* ((c (the-as collectable p))
           (d (vector-vector-distance (-> c root trans) *oe-magnet-pos*))
           )
      (cond
        ((< d (meters 0.6))
         ;; a toucher : on le donne directement (le contact exact n'arrive jamais)
         (send-event *target* 'get-pickup (-> c pickup-type) (-> c pickup-amount))
         (set! (-> c root trans y) -1000000.0)
         (vector-copy! (-> c base) (-> c root trans))
         )
        ((< d (meters 40.0))
         (vector-seek! (-> c root trans) *oe-magnet-pos* (* (meters 60.0) (-> *display* real-clock seconds-per-frame)))
         (vector-copy! (-> c base) (-> c root trans))
         )
        )
      )
    )
  #f
  )

(defun oe-blue-eco-update! ()
  (if (not *oe-surf-ready*)
      (oe-surf-init!)
      )
  (let* ((on (and (online-in-session?) (-> *online-world* active) (not (ow-parkour-now?))))
         (blue (and on (oe-blue?)))
         (turbo (-> *online-events* turbo-on))
         )
    (set! *oe-blue-on* (the-as symbol blue))
    ;; vitesses de Jak : d'origine, x1.6 en marche avec le turbo, eco bleu au maximum
    (dotimes (i 10)
      (let ((sf (-> *oe-surf* i))
            (tm (-> *oe-surf-save* (* i 4)))
            (ts (-> *oe-surf-save* (+ (* i 4) 1)))
            (s0 (-> *oe-surf-save* (+ (* i 4) 2)))
            (s9 (-> *oe-surf-save* (+ (* i 4) 3)))
            )
        ;; TURBO : vraiment rapide, sur tous les mouvements (course, sauts, roulade, attaques)
        (when turbo
          (set! tm (fmax (* 2.2 tm) (* 0.9 (-> *oe-surf-blue* i))))
          (set! ts (fmax (* 2.2 ts) (* 0.9 (-> *oe-surf-blue* i))))
          )
        (when blue
          (set! tm (fmax tm (-> *oe-surf-blue* i)))
          (set! ts (fmax ts (-> *oe-surf-blue* i)))
          (when (< i 4)
            (set! s0 111.0)
            (set! s9 111.0)
            )
          )
        (set! (-> sf transv-max) tm)
        (set! (-> sf target-speed) ts)
        (set! (-> sf seek0) s0)
        (set! (-> sf seek90) s9)
        )
      )
    (set! (-> *TARGET-bank* roll-flip-height) (if blue (meters 6.0) (-> *oe-flip-save* 0)))
    (set! (-> *TARGET-bank* roll-flip-dist) (if blue (meters 40.0) (-> *oe-flip-save* 1)))
    (when blue
      ;; tir rapide (sauf le lance-roquettes et l'inverseur de masse, qui n'aiment pas ca)
      (when (and (focus-test? *target* gun) (nonzero? (-> *target* gun)))
        (let ((gt (-> *target* gun gun-type)))
          (if (and (!= gt (pickup-type gun-yellow-3)) (!= gt (pickup-type gun-dark-2)))
              (set! (-> *target* gun fire-delay) (the-as uint 5))
              )
          )
        )
      ;; vehicule : vitesse de pointe x2.5, montee progressive (+5 % par image au plus)
      (let ((veh (online-my-vehicle)))
        (when veh
          (let ((rb (-> (the-as vehicle veh) rbody)))
            (when (and rb (nonzero? rb))
              (let* ((v (-> rb lin-velocity))
                     (spd (sqrtf (+ (* (-> v x) (-> v x)) (* (-> v z) (-> v z)))))
                     (cap (* 2.5 (-> (the-as vehicle veh) info handling max-xz-speed)))
                     )
                (when (and (< (meters 1.0) spd) (< spd cap) (ow-float-ok? spd))
                  (let ((g (fmin 1.05 (/ cap spd)))
                        (m (-> rb lin-momentum))
                        )
                    (set! (-> v x) (* g (-> v x)))
                    (set! (-> v z) (* g (-> v z)))
                    (set! (-> m x) (* g (-> m x)))
                    (set! (-> m z) (* g (-> m z)))
                    )
                  )
                )
              )
            )
          )
        )
      )
    ;; aimant (une image sur deux) : eco bleu OU super-pouvoir AIMANT A ORBES
    (when (and (or blue (and on (< 0.0 (-> *online-ext* power-left ONLINE_POW_MAGNET))))
               *target*
               (not (focus-test? *target* dead))
               (logtest? (-> *display* real-clock frame-counter) 1)
               )
      (vector-copy! *oe-magnet-pos* (-> *target* control trans))
      (iterate-process-tree *active-pool* (lambda ((p object)) (oe-magnet-try (the-as process p))) *null-kernel-context*)
      )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; ANTI-TRICHE (ce que ce jeu voit chez lui)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun oe-cheat-check! ()
  (let ((es *online-events*)
        (reason 0)
        )
    (when (and (-> *online-world* active) *target* (not (ow-createur?)) (< (seconds 2) (- (online-now) (-> es cheat-time))))
      (set! (-> es cheat-time) (online-now))
      (cond
        ((= *cheat-mode* 'debug)
         (set! reason 1)
         )
        ((< (+ 0.5 (-> *target* fact health-max)) (-> *target* fact health))
         (set! reason 2)
         )
        ((< 16.5 (-> *target* fact health-max))
         (set! reason 2)
         )
        ((let ((gi *game-info*))
           (or (< (+ 1.0 (get-max-ammo-for-gun gi (pickup-type gun-yellow-1))) (-> gi gun-ammo 0))
               (< (+ 1.0 (get-max-ammo-for-gun gi (pickup-type gun-red-1))) (-> gi gun-ammo 1))
               (< (+ 1.0 (get-max-ammo-for-gun gi (pickup-type gun-blue-1))) (-> gi gun-ammo 2))
               (< (+ 1.0 (get-max-ammo-for-gun gi (pickup-type gun-dark-1))) (-> gi gun-ammo 3))
               )
           )
         (set! reason 3)
         )
        )
      (when (and (nonzero? reason) (not (logtest? (-> es cheat-sent) (ash 1 reason))))
        (logior! (-> es cheat-sent) (ash 1 reason))
        (online-push-out-event! ONLINE_EVENT_CHEAT (the-as uint 0) 0.0 reason (the-as vector #f))
        )
      )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; boucle + affichage
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun oe-test-pads! ()
  "banc de test (Jak3Online.exe) : boss present et sa position, eco bleu"
  (let ((loc (-> *online-shm* local))
        (boss (the-as ow-boss (handle->process (-> *online-events* boss))))
        )
    (set! (-> loc pad 10) (the-as uint (if (and boss (not (-> boss dying))) (+ 1 (-> boss kind)) 0)))
    (when boss
      (let ((x (the int (/ (-> boss root trans x) 4096.0)))
            (z (the int (/ (-> boss root trans z) 4096.0)))
            )
        (set! (-> loc pad 12) (the-as uint (logand x 255)))
        (set! (-> loc pad 13) (the-as uint (logand (ash x -8) 255)))
        (set! (-> loc pad 14) (the-as uint (logand z 255)))
        (set! (-> loc pad 15) (the-as uint (logand (ash z -8) 255)))
        )
      )
    (set! (-> loc pad 17) (the-as uint (if *oe-blue-on* 1 0)))
    )
  (none)
  )

(defun online-events-update ()
  (oe-test-pads!)
  (oe-boss-update!)
  (oe-orbs-update!)
  (oe-treasure-update!)
  (oe-zone-update!)
  (oe-meteor-update!)
  (oe-powers-update!)
  (oe-blue-eco-update!)
  (oe-cheat-check!)
  (none)
  )

(defun oe-time-text ((s string) (secs float))
  (let ((n (max 0 (the int secs))))
    (format (clear s) "~D:~2,'0D" (/ n 60) (mod n 60))
    )
  s
  )

(defun oe-draw-boss-tag ()
  "nom + barre de vie au-dessus du boss"
  (let ((boss (the-as ow-boss (handle->process (-> *online-events* boss))))
        (screen (new 'stack-no-clear 'vector))
        (head (new 'stack-no-clear 'vector))
        )
    (when (and boss (not (-> boss dying)))
      (vector-copy! head (-> boss root trans))
      (+! (-> head y) (ow-boss-height (-> boss kind)))
      (set! (-> head w) 1.0)
      (when (transform-point-vector! screen head)
        (let ((sx (+ -1792.0 (-> screen x)))
              (sy (+ -1840.0 (-> screen y)))
              )
          (when (and (< 20.0 sx) (< sx 492.0) (< 10.0 sy) (< sy 400.0))
            (online-print (online-chars->string (-> *online-events* str2) (-> *online-ext* ev-name) 32)
                          (+ -100.0 sx) (+ -16.0 sy) 200.0 0.42 (font-color red) (font-flags shadow kerning middle large))
            (ow-box (+ -40.0 sx) (+ 0.0 sy) 80.0 4.0 30 0 0 128)
            (ow-box (+ -40.0 sx) (+ 0.0 sy) (* 80.0 (fmax 0.0 (fmin 1.0 (-> *online-ext* ev-hp)))) 4.0 255 40 40 128)
            )
          )
        )
      )
    )
  (none)
  )

(defun oe-hot-cold ()
  (let ((d (oe-dist-to-event)))
    (cond
      ((< d 12.0) (online-fr "BRULANT !" "BURNING HOT!"))
      ((< d 30.0) (online-fr "CHAUD" "HOT"))
      ((< d 60.0) (online-fr "TIEDE" "WARM"))
      ((< d 120.0) (online-fr "FROID" "COLD"))
      (else (online-fr "GLACIAL" "FREEZING"))
      )
    )
  )

(defun online-events-draw ()
  (let* ((es *online-events*)
         (ext *online-ext*)
         (s (-> es str))
         (kind (the-as int (-> ext ev-kind)))
         (y *ow-center-y*)
         (used 0.0)
         )
    (when (and (online-in-session?) (nonzero? kind) (not *progress-process*) (not (movie?)))
      (cond
        ((= (-> ext ev-state) 1)
         (ow-zone-name (-> es str2) (-> ext ev-level))
         (case kind
           ((ONLINE_EVK_BOSS)
            (format (clear s) (online-fr "ALERTE BOSS : ~S  -  ~S  -  ~D m" "BOSS ALERT: ~S  -  ~S  -  ~D m")
                    (online-chars->string (-> *online-world* str3) (-> ext ev-name) 32) (-> es str2) (the int (oe-dist-to-event)))
            (ow-text-mid s y 0.42 (font-color red))
            (ow-box 156.0 (+ y 14.0) 200.0 6.0 40 0 0 110)
            (ow-box 156.0 (+ y 14.0) (* 200.0 (fmax 0.0 (fmin 1.0 (-> ext ev-hp)))) 6.0 230 30 30 128)
            (format (clear s) (online-fr "PV ~D %   -   tes degats : ~D   -   ~D joueurs   -   ~S" "HP ~D %   -   your damage: ~D   -   ~D players   -   ~S")
                    (the int (* 100.0 (-> ext ev-hp))) (the int (-> ext ev-my-dmg)) (-> ext ev-count) (oe-time-text (-> *online-world* str3) (-> ext ev-timer)))
            (ow-text-mid s (+ y 22.0) 0.3 (font-color white))
            (set! used 36.0)
            (oe-draw-boss-tag)
            )
           ((ONLINE_EVK_ORBS)
            (format (clear s) (online-fr "PLUIE D'ORBES  -  ~S  -  ~D m  -  ~S" "ORB RAIN  -  ~S  -  ~D m  -  ~S")
                    (-> es str2) (the int (oe-dist-to-event)) (oe-time-text (-> *online-world* str3) (-> ext ev-timer)))
            (ow-text-mid s y 0.4 (font-color flat-yellow))
            (set! used 16.0)
            )
           ((ONLINE_EVK_TREASURE)
            (format (clear s) (online-fr "CHASSE AU TRESOR  -  ~S  -  ~S" "TREASURE HUNT  -  ~S  -  ~S")
                    (-> es str2) (oe-time-text (-> *online-world* str3) (-> ext ev-timer)))
            (ow-text-mid s y 0.4 (font-color flat-yellow))
            (ow-text-mid (oe-hot-cold) (+ y 14.0) 0.5 (if (< (oe-dist-to-event) 30.0) (font-color red) (font-color cyan)))
            (set! used 32.0)
            )
           ((ONLINE_EVK_DOUBLEXP)
            (format (clear s) (online-fr "DOUBLE XP POUR TOUT LE MONDE  -  ~S" "DOUBLE XP FOR EVERYONE  -  ~S")
                    (oe-time-text (-> *online-world* str3) (-> ext ev-timer)))
            (ow-text-mid s y 0.4 (font-color cyan))
            (set! used 16.0)
            )
           ((ONLINE_EVK_HUNT)
            (cond
              ((= (-> ext ev-target) (-> *online-shm* my-id))
               (format (clear s) (online-fr "CHASSE A L'HOMME : TU ES LA CIBLE !  SURVIS ~S" "MANHUNT: YOU ARE THE TARGET!  SURVIVE ~S")
                       (oe-time-text (-> *online-world* str3) (-> ext ev-timer)))
               (ow-text-mid s y 0.42 (font-color red))
               )
              (else
                (format (clear s) (online-fr "CHASSE A L'HOMME : ~S  -  ~D m  -  ~S" "MANHUNT: ~S  -  ~D m  -  ~S")
                        (online-chars->string (-> *online-world* str3) (-> ext ev-name) 32) (the int (oe-dist-to-event))
                        (oe-time-text (-> es str2) (-> ext ev-timer)))
                (ow-text-mid s y 0.42 (font-color red))
                )
              )
            (ow-text-mid (online-fr "le premier qui l'elimine gagne 1500 orbes" "the first to eliminate them wins 1500 orbs") (+ y 14.0) 0.3 (font-color white))
            (set! used 28.0)
            )
           ((ONLINE_EVK_METEOR)
            (format (clear s) (online-fr "PLUIE DE METEORES  -  ~S  -  ~D m  -  ~S" "METEOR SHOWER  -  ~S  -  ~D m  -  ~S")
                    (-> es str2) (the int (oe-dist-to-event)) (oe-time-text (-> *online-world* str3) (-> ext ev-timer)))
            (ow-text-mid s y 0.4 (font-color orange))
            (format (clear s) (if (-> es in-zone) (online-fr "DANS LA ZONE : ~D s" "IN THE ZONE: ~D s") (online-fr "hors de la zone : ~D s" "outside the zone: ~D s"))
                    (the int (-> ext ev-score)))
            (ow-text-mid s (+ y 14.0) 0.38 (if (-> es in-zone) (font-color green) (font-color font-color-44)))
            (set! used 30.0)
            )
           ((ONLINE_EVK_PARKOUR ONLINE_EVK_KART ONLINE_EVK_HIDE)
            (ow-map-draw-banner! y)
            (set! used 30.0)
            )
           ((ONLINE_EVK_MISSION)
            (format (clear s) (online-fr "MISSION : ~S  -  ~S" "MISSION: ~S  -  ~S")
                    (online-chars->string (-> *online-world* str3) (-> ext ev-name) 32) (oe-time-text (-> es str2) (-> ext ev-timer)))
            (ow-text-mid s y 0.42 (font-color flat-yellow))
            (ow-text-mid (if (task-complete? *game-info* (the-as game-task (-> ext ev-boss)))
                             (online-fr "tu l'as deja reussie dans cette partie" "you already completed it in this game")
                             (online-fr "le premier qui la reussit gagne 2000 orbes !" "the first to complete it wins 2000 orbs!")
                             )
                         (+ y 14.0) 0.3 (font-color white))
            (set! used 28.0)
            )
           ((ONLINE_EVK_ZONE)
            (format (clear s) (online-fr "ZONE A CAPTURER  -  ~S  -  ~D m  -  ~S" "CAPTURE THE ZONE  -  ~S  -  ~D m  -  ~S")
                    (-> es str2) (the int (oe-dist-to-event)) (oe-time-text (-> *online-world* str3) (-> ext ev-timer)))
            (ow-text-mid s y 0.4 (font-color green))
            (format (clear s) (if (-> es in-zone) (online-fr "DANS LA ZONE : ~D s" "IN THE ZONE: ~D s") (online-fr "hors de la zone : ~D s" "outside the zone: ~D s"))
                    (the int (-> ext ev-score)))
            (ow-text-mid s (+ y 14.0) 0.38 (if (-> es in-zone) (font-color green) (font-color font-color-44)))
            (set! used 30.0)
            )
           )
         )
        ((< (-> ext ev-timer) 10.0)
         ;; resultat (quelques secondes)
         (when (nonzero? (-> ext ev-top 0))
           (ow-text-mid (online-chars->string s (-> ext ev-top) 64) y 0.36 (font-color flat-yellow))
           (set! used 16.0)
           )
         )
        )
      )
    (set! *ow-center-y* (+ *ow-center-y* used))
    ;; avertissement anti-triche / version
    (when (!= (-> ext warn-seq) (-> es warn-seq))
      (set! (-> es warn-seq) (-> ext warn-seq))
      (set! (-> es warn-time) (online-now))
      )
    (when (and (< (- (online-now) (-> es warn-time)) (seconds 12)) (nonzero? (-> ext warn-text 0)) (not *progress-process*))
      (ow-box 56.0 *ow-center-y* 400.0 26.0 90 0 0 110)
      (ow-text-mid (online-chars->string s (-> ext warn-text) 64) (+ 7.0 *ow-center-y*) 0.42 (font-color red))
      (set! *ow-center-y* (+ *ow-center-y* 30.0))
      )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; super-pouvoirs actifs (sous l'argent, en haut a gauche)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define *oe-power-names*
  (new 'static 'boxed-array :type string "TURBO" "SUPER SAUT" "PEAU D'ACIER" "FANTOME" "RADAR" "XP x2" "AIMANT" "REGEN")
  )

(define *oe-power-names-en*
  (new 'static 'boxed-array :type string "TURBO" "SUPER JUMP" "STEEL SKIN" "GHOST" "RADAR" "XP x2" "MAGNET" "REGEN")
  )

(defun online-powers-draw ((y float))
  "renvoie la hauteur utilisee"
  (let ((ext *online-ext*)
        (s (-> *online-events* str))
        (x 14.0)
        (used 0.0)
        )
    (dotimes (i 8)
      (let ((left (-> ext power-left i)))
        (when (< 0.0 left)
          (format (clear s) "~S ~S" (online-fr (-> *oe-power-names* i) (-> *oe-power-names-en* i)) (oe-time-text (-> *online-events* str2) left))
          (ow-text s x (+ y used) 0.28 (if (< left 10.0) (font-color red) (font-color cyan)))
          (+! used 10.0)
          )
        )
      )
    (when (and (< 1 (the-as int (-> ext xp-mul))) (not (< 0.0 (-> ext power-left ONLINE_POW_DOUBLEXP))))
      (ow-text "XP x2" x (+ y used) 0.28 (font-color cyan))
      (+! used 10.0)
      )
    used
    )
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; banc de test (Jak3Online.exe)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun online-events-test! ((arg int))
  (case arg
    ((93)
     ;; banc de test : le boss vient se placer 35 m devant Jak (pour le photographier)
     (let ((boss (the-as ow-boss (handle->process (-> *online-events* boss)))))
       (when (and boss *target*)
         ;; dans l'axe camera -> Jak : le boss est forcement dans l'image
         (let ((fw (vector-! (new 'stack-no-clear 'vector) (-> *target* control trans) (math-camera-pos)))
               (pos (new 'stack-no-clear 'vector))
               )
           (set! (-> fw y) 0.0)
           (vector-normalize! fw (meters 35.0))
           (vector+! pos (-> *target* control trans) fw)
           (set! (-> pos w) 1.0)
           (oe-ground! pos (meters 30.0))
           (vector-copy! (-> boss root trans) pos)
           (set! (-> boss ground-y) (-> pos y))
           (format 0 "[jak3-online] boss ~D devant la camera : niveau ~A dessin ~X lod ~D~%" (-> boss kind)
                   (if (-> boss level) (-> boss level name) 'aucun) (-> boss draw status) (-> boss draw cur-lod))
           )
         )
       )
     )
    ((72)
     ;; frappe le boss (10 degats), comme un coup de Jak
     (let ((boss (handle->process (-> *online-events* boss))))
       (if boss
           (send-event boss 'attack #f
             (static-attack-info :mask (vehicle-impulse-factor)
               ((id (new-attack-id)) (damage 10.0) (vehicle-damage-factor 1.0) (vehicle-impulse-factor 1.0) (mode 'generic))
               )
             )
           )
       )
     )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; LA METEO DU MONDE (admin) : pluie, orage (eclairs + tonnerre), neige. Meme recette que le mod
;; "Jak 4" de l'utilisateur : le ciel par le mecanisme natif (overide-weather-flag, nuages et brume),
;; la pluie et les flocons du jeu (update-rain / update-snow) devant la camera. Jamais en cinematique.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(deftype ow-meteo-state (structure)
  ((kind      int32)       ;; meteo affichee
   (f         float)       ;; intensite 0..1 (monte / descend doucement)
   (saved     symbol)      ;; on a pris la main sur le ciel du jeu
   (flag0     symbol)
   (c0        float)
   (g0        float)
   (flash     float)
   (next-bolt time-frame)
   (thunder   time-frame)
   )
  )

(define *ow-meteo* (new 'static 'ow-meteo-state))

(defun ow-meteo-tick! ()
  (let* ((m *ow-meteo*)
         (want (if (and (online-in-session?) (-> *online-world* active)) (the-as int (-> *online-ext* weather)) 0))
         (dt (-> *display* real-clock seconds-per-frame))
         (now (online-now))
         )
    (if (or (< want 0) (< 3 want))
        (set! want 0)
        )
    ;; changement de meteo : l'ancienne s'efface d'abord
    (cond
      ((= want (-> m kind))
       (if (< 0 want)
           (set! (-> m f) (fmin 1.0 (+ (-> m f) (* dt 0.12))))
           )
       )
      (else
        (set! (-> m f) (fmax 0.0 (- (-> m f) (* dt 0.25))))
        (if (<= (-> m f) 0.0)
            (set! (-> m kind) want)
            )
        )
      )
    (let ((f (-> m f))
          (k (-> m kind))
          )
      ;; le ciel
      (cond
        ((and *mood-control* (< 0 k) (< 0.0 f))
         (when (not (-> m saved))
           (set! (-> m saved) #t)
           (set! (-> m flag0) (-> *mood-control* overide-weather-flag))
           (set! (-> m c0) (-> *mood-control* overide cloud))
           (set! (-> m g0) (-> *mood-control* overide fog))
           )
         (set! (-> *mood-control* overide-weather-flag) #t)
         (set! (-> *mood-control* overide cloud) (* f (case k ((2) 1.0) (else 0.85))))
         (set! (-> *mood-control* overide fog) (* f (case k ((1) 0.3) ((2) 0.75) (else 0.45))))
         )
        ((-> m saved)
         (set! (-> m saved) #f)
         (when *mood-control*
           (set! (-> *mood-control* overide-weather-flag) (-> m flag0))
           (set! (-> *mood-control* overide cloud) (-> m c0))
           (set! (-> *mood-control* overide fog) (-> m g0))
           (set! (-> *mood-control* lightning-flash) 0.0)
           )
         )
        )
      ;; pluie et neige devant la camera (comme time-of-day-update)
      (when (and (< 0.02 f) (< 0 k) (not (movie?)) *math-camera*)
        (let ((p (new 'stack-no-clear 'vector))
              (v (new 'stack-no-clear 'vector))
              (fv (-> *math-camera* inv-camera-rot fvec))
              )
          (vector-copy! p (-> *math-camera* trans))
          (vector-! v p (-> *math-camera* prev-trans))
          (vector+float*! p p fv (* 25.0 (vector-dot v fv)))
          (set! (-> p y) (-> *math-camera* trans y))
          (case k
            ((1) (update-rain (* 0.45 f) p v))
            ((2) (update-rain (* 0.75 f) p v) (update-rain (* 0.75 f) p v))
            ((3)
             (update-snow f p v)
             (let ((q (new 'stack-no-clear 'vector)))
               (dotimes (n 4)
                 (vector-copy! q p)
                 (case n
                   ((0) (+! (-> q x) (meters 22)))
                   ((1) (+! (-> q x) (meters -22)))
                   ((2) (+! (-> q z) (meters 22)))
                   (else (+! (-> q z) (meters -22)))
                   )
                 (update-snow f q v)
                 )
               )
             )
            )
          )
        )
      ;; l'orage : eclairs (le ciel du jeu s'illumine) puis tonnerre
      (set! (-> m flash) (fmax 0.0 (- (-> m flash) (* 4.0 dt))))
      (when (and (= k 2) (< 0.5 f) (not (movie?)))
        (when (< (-> m next-bolt) now)
          (set! (-> m next-bolt) (+ now (the int (* 300.0 (rand-vu-float-range 5.0 12.0)))))
          (set! (-> m flash) 1.0)
          (set! (-> m thunder) (+ now (the int (* 300.0 (rand-vu-float-range 0.4 1.6)))))
          )
        (when (and (nonzero? (-> m thunder)) (< (-> m thunder) now))
          (set! (-> m thunder) 0)
          (case (rand-vu-int-count 3)
            ((0) (sound-play "thunder-a" :position #f))
            ((1) (sound-play "thunder-b" :position #f))
            (else (sound-play "thunder-c" :position #f))
            )
          )
        )
      (if *mood-control*
          (if (< 0.0 (-> m flash))
              (set! (-> *mood-control* lightning-flash) (-> m flash))
              (if (= k 2)
                  (set! (-> *mood-control* lightning-flash) 0.0)
                  )
              )
          )
      )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; LES DIALOGUES (admin) : les vraies repliques du jeu (voix internes), jouees chez chacun dans la
;; langue de son jeu. Meme technique que le mod "Jak 4" (add-process sur *gui-control*, canal jak).
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defconstant OW_DIALOG_COUNT 35)

(define *ow-dialog-names* (new 'static 'boxed-array :type string
  "DAX553" "DAX201" "DAX398" "DAX609" "DAX414" "JAK127" "JAK102" "JAK103" "JAK117" "TORN203"
  "TORN216" "TORN125" "SIG304" "SIG153" "SIG176" "DAM101" "DAM102" "DAM106" "ASH134" "ASH119"
  "PECK130" "PECK148" "KLEV111" "KLEV109" "KLEV134" "VIN128" "VIN134" "TESS143" "TESS154" "JINX102"
  "ERO093" "ERO068" "CIT143" "GRDS108A" "ORA102"))

(define *ow-dialog-who* (new 'static 'boxed-array :type string
  "Daxter" "Daxter" "Daxter" "Daxter" "Daxter" "Jak" "Jak" "Jak" "Jak" "Torn"
  "Torn" "Torn" "Sig" "Sig" "Sig" "Damas" "Damas" "Damas" "Ashelin" "Ashelin"
  "Pecker" "Pecker" "Kleiver" "Kleiver" "Kleiver" "Vin" "Vin" "Tess" "Tess" "Jinx"
  "Errol" "Errol" "Citizen" "Guard" "Oracle"))

(define *ow-dialog-fr* (new 'static 'boxed-array :type string
  "Du gateauuuu !" "Viens la, espece de lezard fou !" "Plus vite, bebe !" "Attends ici, Jak. Je vais sauver la situation."
  "Cinq, et on est toujours vivants !" "Je sais conduire ca ! Je sais tout conduire." "Faut bouger !" "Accroche-toi, Dax !"
  "Waouh, je vois notre planete !" "Vas-y, Jak, vas-y !" "Vas-y, bebe, vas-y !" "T'y es presque !"
  "Sig est dans la place, bebe !" "Ouais ! Youhou !" "Accrochez-vous !" "Les voila !" "Reste en alerte, Jak !"
  "Sors ton arme ! Feu, feu !" "Tu peux le faire !" "Le dernier, joli tir !" "Et la foule est en delire !"
  "Tres bien. Tres bien vraiment." "Attrape-moi si tu peux." "Bye bye, le bleu." "Pas sur ma piste !"
  "Tu as battu le jeu !" "Salut, j'voudrais pas etre a ta place." "Super score, Jak !" "On recommence ?"
  "Salut beau gosse. Pret a tout casser ?" "Dommage, j'ai gagne !" "Cette ville est a moi."
  "Arrete de respirer !" "Des Metal Heads ! Tirez, tirez !" "Voulez-vous echanger ?"))

(define *ow-dialog-en* (new 'static 'boxed-array :type string
  "Piece of caaaaake!" "Come here ya crazy lizard!" "Faster, baby!" "Wait here, Jak. I'll save the day."
  "Five and we're still alive!" "I can drive this! I can drive anything." "We gotta move!" "Hold on, Dax!"
  "Wow, I can see our planet!" "Go, Jak, go!" "Go, baby, go!" "You're almost there!"
  "Sig is in the house, baby!" "Yes! Woohoo!" "Hold on to something!" "Here they come!" "Look alive, Jak!"
  "Open up with the gun! Fire, fire!" "You can do it!" "Last one, nice shooting!" "And the crowd goes wild!"
  "Very nice. Very nice indeed." "Catch me if you can." "Bye bye, newbie." "Not on my track!"
  "You beat the game!" "See ya, wouldn't wanna be ya." "Great score, Jak!" "Wanna go again?"
  "Hey there, pretty boy. Ready to rock and rumble?" "Too bad, I win!" "I own this city."
  "Stop breathing!" "Metal Heads! Shoot 'em, shoot 'em!" "Would you like to trade?"))

(define *ow-dialog-last* (the-as sound-id 0)) ;; derniere replique lancee (banc de test : son etat)

(defun ow-dialog-who-name ((k int))
  (case k
    ((32) (online-fr "Citoyen" "Citizen"))
    ((33) (online-fr "Garde" "Guard"))
    (else (-> *ow-dialog-who* k))
    )
  )

(defun ow-dialog-text ((k int))
  (online-fr (-> *ow-dialog-fr* k) (-> *ow-dialog-en* k))
  )

(defun ow-dialog-play! ((k int))
  "joue la replique k (voix du jeu, dans la langue du jeu) et l'affiche"
  (when (and (>= k 0) (< k OW_DIALOG_COUNT) *target* *gui-control* (not (movie?)))
    (set! *ow-dialog-last* (add-process *gui-control* *target* (gui-channel jak) (gui-action play) (-> *ow-dialog-names* k) -99.0 0))
    (format (clear (-> *online-world* str3)) "~S : ~S" (ow-dialog-who-name k) (ow-dialog-text k))
    (ow-hint! (-> *online-world* str3))
    )
  (none)
  )
