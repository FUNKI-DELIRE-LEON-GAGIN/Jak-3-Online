(defconstant OWM_LINE 1)
(defconstant OWM_CIRCLE 2)
(defconstant OWM_LIFT 3)
(defconstant OWM_SPIN 4)
(defconstant OWM_VANISH 5)
(defconstant OWM_BOAT 6)     ;; BATEAU (modele ow-bateau) qui tourne autour du point, cap dans le sens de la marche
(defconstant OWM_BOOST 12)   ;; accelerateur du circuit : a = rayon, b = vitesse ajoutee (m/s), c d = direction
(defconstant OWM_TURBO 13)   ;; TURBO a ramasser (le vrai du jeu : turbo-pickup), il reapparait
(defconstant OW_MAP_CIRCUIT 16)
(defconstant OW_MAP_HIDE 12)  ;; le cache-cache se joue au manoir
(defconstant OWM_MAIL 40)    ;; boite aux lettres d'une maison (a = numero)
(defconstant OWM_WATER 50)   ;; eau ou l'on nage : (x y z) = centre de la surface, a b = demi-largeurs, c = profondeur
(defconstant OWM_PAD 10)
(defconstant OWM_WIND 11)
(defconstant OWM_CHECK 20)
(defconstant OWM_FINISH 30)
(defconstant OWM_MAX_PLATS 48)

;; la plateforme des parcours (modele ow-plat.glb, dalle de 5 x 5 m, dessus a y = 0). Son art est
;; dans le DGO de chaque carte : la plateforme est rattachee au niveau de la carte.
(def-actor ow-plat
  :bounds (0 0 0 4)
  )

;; le bateau des maisons au bord de l'eau (modele ow-bateau.glb : pont a y = 0, 9 x 3.6 m)
(def-actor ow-bateau
  :bounds (0 0 0 6)
  )

(deftype ow-maps-state (basic)
  ((plats        handle OWM_MAX_PLATS)
   (plat-map     int32)        ;; carte dont les plateformes sont posees (-1 : aucune)
   (plat-next    int32)        ;; prochain element a poser (une plateforme par image)
   (check        vector :inline)
   (check-set    symbol)
   (joined       uint32)       ;; evenement parcours rejoint
   (declined     uint32)       ;; evenement parcours refuse (ROND)
   (finish-sent  uint32)
   (finished     symbol)
   (leave-at     time-frame)   ;; retour au port programme (0 : non)
   (pad-time     time-frame)
   (hint-time    time-frame)
   (orb          handle)       ;; orbe doree de l'arrivee
   (boost-until  time-frame)   ;; tremplin : poussee vers le haut jusqu'a cette heure
   (boost-top    float)        ;; ... ou jusqu'a cette hauteur
   (boost-vel    vector :inline)
   (leaving-until time-frame)  ;; depart en cours (goto / retour au port) : pas de regles de carte
   (mail-k       int32)        ;; boite aux lettres ou je suis (-1 : aucune)
   (race-next    int32)        ;; COURSE AUTO : prochain point de passage a franchir
   (race-placed  uint32)       ;; ... course pour laquelle j'ai ete place sur la grille
   (race-veh     time-frame)   ;; ... dernier vehicule donne
   (boost-time   time-frame)
   (hide-npc     handle)       ;; CACHE-CACHE : le personnage rouge
   (hide-found   uint32)
   (tinted       symbol)       ;; les joueurs sont teintes en bleu
   (turbos       handle 16)    ;; COURSE AUTO : les turbos poses (un par element OWM_TURBO)
   (turbo-gone   time-frame 16)
   (veh-rules    symbol)       ;; tirs et turbo des vehicules autorises (reglages poses)
   (mail-time    time-frame)
   (str          string)
   )
  )

(define *ow-maps* (new 'global 'ow-maps-state))

(let ((m *ow-maps*))
  (dotimes (i OWM_MAX_PLATS)
    (set! (-> m plats i) (the-as handle #f))
    )
  (set! (-> m plat-map) -1)
  (set! (-> m plat-next) 0)
  (set! (-> m check-set) #f)
  (set! (-> m joined) (the-as uint 0))
  (set! (-> m declined) (the-as uint 0))
  (set! (-> m finish-sent) (the-as uint 0))
  (set! (-> m finished) #f)
  (set! (-> m leave-at) 0)
  (set! (-> m pad-time) 0)
  (set! (-> m hint-time) 0)
  (set! (-> m boost-until) 0)
  (set! (-> m leaving-until) 0)
  (set! (-> m orb) (the-as handle #f))
  (set! (-> m mail-k) -1)
  (set! (-> m mail-time) 0)
  (set! (-> m race-next) 0)
  (set! (-> m race-placed) (the-as uint 0))
  (set! (-> m race-veh) 0)
  (set! (-> m boost-time) 0)
  (set! (-> m hide-npc) (the-as handle #f))
  (set! (-> m hide-found) (the-as uint 0))
  (set! (-> m tinted) #f)
  (set! (-> m veh-rules) #f)
  (dotimes (k 16)
    (set! (-> m turbos k) (the-as handle #f))
    (set! (-> m turbo-gone k) 0)
    )
  (set! (-> m str) (new 'global 'string 96 (the-as string #f)))
  )

(defun ow-map-name ((i int))
  (if (and (>= i 0) (< i OW_MAP_COUNT))
      (online-fr (-> *ow-map-names* i) (-> *ow-map-names-en* i))
      "?"
      )
  )

(defun ow-map-index-of ((lev string))
  "numero de la carte de ce niveau (-1 : aucune)"
  (let ((res -1))
    (dotimes (i OW_MAP_COUNT)
      (if (string= lev (-> *ow-map-levels* i))
          (set! res i)
          )
      )
    res
    )
  )

(defun ow-map-current ()
  "carte ou se trouve Jak (-1 : aucune) : les cartes sont chargees seules"
  (let ((res -1))
    (when *target*
      (dotimes (n (-> *level* length))
        (let ((l (-> *level* level n)))
          (when (= (-> l status) 'active)
            (dotimes (i OW_MAP_COUNT)
              (if (string= (symbol->string (-> l name)) (-> *ow-map-levels* i))
                  (set! res i)
                  )
              )
            )
          )
        )
      )
    res
    )
  )

(defun ow-map-inside? ()
  (the-as symbol (>= (ow-map-current) 0))
  )

(defun ow-evk-map? ((k int))
  "evenement qui se joue sur une carte du mod (parcours, course auto, cache-cache)"
  (the-as symbol (or (= k ONLINE_EVK_PARKOUR) (= k ONLINE_EVK_KART) (= k ONLINE_EVK_HIDE)))
  )

(defun ow-map-event? ((i int))
  "un parcours est en cours sur cette carte"
  (and (online-in-session?)
       (ow-evk-map? (the-as int (-> *online-ext* ev-kind)))
       (= (-> *online-ext* ev-state) 1)
       (= (the-as int (-> *online-ext* ev-boss)) i)
       )
  )

(defun ow-map-clock ()
  "horloge commune (secondes) : celle de l'evenement s'il y en a un, sinon celle du jeu"
  (if (and (online-in-session?) (ow-evk-map? (the-as int (-> *online-ext* ev-kind))) (= (-> *online-ext* ev-state) 1))
      (- (-> *online-ext* ev-dur) (-> *online-ext* ev-timer))
      (/ (the float (online-now)) 300.0)
      )
  )

(defun ow-map-elem ((k int) (j int))
  (-> *ow-map-elems* (+ (* k 8) j))
  )

(defun ow-map-level ((i int))
  (let ((lv (the-as level #f)))
    (dotimes (n (-> *level* length))
      (let ((l (-> *level* level n)))
        (if (and (= (-> l status) 'active) (string= (symbol->string (-> l name)) (-> *ow-map-levels* i)))
            (set! lv l)
            )
        )
      )
    (the-as level lv)
    )
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; les plateformes vivantes
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(deftype ow-plat (process-drawable)
  ((root   collide-shape :override)
   (elem   int32)
   (kind   int32)
   (base   vector :inline)
   (pa     float)
   (pb     float)
   (pc     float)
   (pd     float)
   (shown  symbol)
   )
  (:states
    ow-plat-idle
    )
  )

(defbehavior ow-plat-move! ow-plat ()
  (let* ((t (ow-map-clock))
         (pos (new 'stack-no-clear 'vector))
         (visible #t)
         )
    (vector-copy! pos (-> self base))
    (case (-> self kind)
      ((OWM_LINE)
       (let ((s (sin (* 65536.0 (/ t (fmax 0.5 (-> self pd)))))))
         (+! (-> pos x) (* s (meters 1.0) (-> self pa)))
         (+! (-> pos y) (* s (meters 1.0) (-> self pb)))
         (+! (-> pos z) (* s (meters 1.0) (-> self pc)))
         )
       )
      ((OWM_CIRCLE)
       (let ((a (* 65536.0 (+ (-> self pc) (/ t (fmax 0.5 (-> self pb)))))))
         (+! (-> pos x) (* (meters 1.0) (-> self pa) (cos a)))
         (+! (-> pos z) (* (meters 1.0) (-> self pa) (sin a)))
         )
       )
      ((OWM_LIFT)
       (+! (-> pos y) (* (meters 1.0) (-> self pa) (sin (* 65536.0 (+ (-> self pc) (/ t (fmax 0.5 (-> self pb))))))))
       )
      ((OWM_BOAT)
       (let ((a (* 65536.0 (+ (-> self pc) (/ t (fmax 0.5 (-> self pb)))))))
         (+! (-> pos x) (* (meters 1.0) (-> self pa) (cos a)))
         (+! (-> pos z) (* (meters 1.0) (-> self pa) (sin a)))
         (+! (-> pos y) (* (meters 0.12) (sin (* 65536.0 (/ t 3.1)))))
         ;; cap : la tangente au cercle (sens de la marche)
         (let ((q (new 'stack-no-clear 'quaternion))
               (r (new 'stack-no-clear 'quaternion))
               )
           (quaternion-axis-angle! (-> self root quat) 0.0 1.0 0.0 (- a))
           (quaternion-axis-angle! r 0.0 0.0 1.0 (* 400.0 (sin (* 65536.0 (/ t 2.3)))))
           (quaternion*! q (-> self root quat) r)
           (quaternion-copy! (-> self root quat) q)
           )
         )
       )
      ((OWM_SPIN)
       (quaternion-axis-angle! (-> self root quat) 0.0 1.0 0.0 (* 182.04445 (-> self pa) t))
       )
      ((OWM_VANISH)
       ;; visible pendant une partie de la periode ; clignote juste avant de disparaitre
       (let* ((per (fmax 0.5 (-> self pa)))
              (ph (- (+ (/ t per) (-> self pb)) (the float (the int (+ (/ t per) (-> self pb))))))
              )
         (set! visible (< ph (-> self pc)))
         (when (and visible (< (- (-> self pc) 0.15) ph))
           (if (logtest? (-> *display* real-clock frame-counter) 4)
               (logior! (-> self draw status) (draw-control-status no-draw))
               (logclear! (-> self draw status) (draw-control-status no-draw))
               )
           )
         )
       )
      )
    (when (!= visible (-> self shown))
      (set! (-> self shown) visible)
      (let ((rp (-> self root root-prim)))
        (cond
          (visible
            (set! (-> rp prim-core collide-as) (-> self root backup-collide-as))
            (set! (-> rp prim-core collide-with) (-> self root backup-collide-with))
            (logclear! (-> self draw status) (draw-control-status no-draw))
            )
          (else
            (set! (-> rp prim-core collide-as) (collide-spec))
            (set! (-> rp prim-core collide-with) (collide-spec))
            (logior! (-> self draw status) (draw-control-status no-draw))
            )
          )
        )
      )
    (if (and visible (!= (-> self kind) OWM_VANISH))
        (logclear! (-> self draw status) (draw-control-status no-draw))
        )
    (vector-copy! (-> self root trans) pos)
    )
  (none)
  )

(defstate ow-plat-idle (ow-plat)
  :trans (behavior ()
    ;; son niveau (la carte) n'est plus charge : son art n'existe plus, on disparait tout de suite
    (if (or (not (-> self level)) (!= (-> self level status) 'active))
        (deactivate self)
        )
    (rider-trans)
    (ow-plat-move!)
    )
  :code (behavior ()
    (until #f
      (suspend)
      )
    #f
    )
  :post rider-post
  )

(defbehavior ow-plat-init ow-plat ((k int))
  (let ((cs (new 'process 'collide-shape self (collide-list-enum hit-by-player))))
    (let ((mesh (new 'process 'collide-shape-prim-mesh cs (the-as uint 0) (the-as uint 0))))
      (set! (-> mesh prim-core collide-as) (collide-spec pusher))
      (set! (-> mesh prim-core collide-with) (collide-spec jak player-list))
      (set! (-> mesh prim-core action) (collide-action solid rideable))
      (set! (-> mesh transform-index) 0)
      (set-vector! (-> mesh local-sphere) 0.0 0.0 0.0 (meters 4.0))
      (set! (-> cs total-prims) (the-as uint 1))
      (set! (-> cs root-prim) mesh)
      )
    (pusher-init cs)
    (set! (-> cs nav-radius) (meters 3.0))
    (let ((rp (-> cs root-prim)))
      (set! (-> cs backup-collide-as) (-> rp prim-core collide-as))
      (set! (-> cs backup-collide-with) (-> rp prim-core collide-with))
      )
    (set! (-> self root) cs)
    )
  (set! (-> self elem) k)
  (set! (-> self kind) (the int (ow-map-elem k 0)))
  (set-vector! (-> self base) (* (meters 1.0) (ow-map-elem k 1)) (* (meters 1.0) (ow-map-elem k 2)) (* (meters 1.0) (ow-map-elem k 3)) 1.0)
  (set! (-> self pa) (ow-map-elem k 4))
  (set! (-> self pb) (ow-map-elem k 5))
  (set! (-> self pc) (ow-map-elem k 6))
  (set! (-> self pd) (ow-map-elem k 7))
  (set! (-> self shown) #t)
  (vector-copy! (-> self root trans) (-> self base))
  (quaternion-identity! (-> self root quat))
  (vector-identity! (-> self root scale))
  (if (= (-> self kind) OWM_BOAT)
      (initialize-skeleton self *ow-bateau-sg* (the-as pair 0))
      (initialize-skeleton self *ow-plat-sg* (the-as pair 0))
      )
  (if (= (-> self kind) OWM_BOAT)
      (set-vector! (-> self root root-prim local-sphere) 0.0 0.0 0.0 (meters 7.0))
      )
  (logclear! (-> self mask) (process-mask actor-pause))
  (logior! (-> self mask) (process-mask platform))
  (ow-plat-move!)
  (update-transforms (-> self root))
  (ja-post)
  (go ow-plat-idle)
  )

(defun ow-map-clear-plats! ()
  (let ((m *ow-maps*))
    (dotimes (i OWM_MAX_PLATS)
      (let ((p (handle->process (-> m plats i))))
        (if p
            (deactivate p)
            )
        )
      (set! (-> m plats i) (the-as handle #f))
      )
    (when (handle->process (-> m orb))
      (deactivate (handle->process (-> m orb)))
      )
    (set! (-> m orb) (the-as handle #f))
    (set! (-> m plat-map) -1)
    (set! (-> m plat-next) 0)
    )
  (none)
  )

(defun ow-map-spawn-plats! ((i int))
  "pose les plateformes de la carte (une par image, pour ne pas geler le jeu)"
  (let* ((m *ow-maps*)
         (lv (ow-map-level i))
         (k0 (-> *ow-map-first* i))
         (k1 (-> *ow-map-first* (+ i 1)))
         )
    (when (!= (-> m plat-map) i)
      (ow-map-clear-plats!)
      (set! (-> m plat-map) i)
      (set! (-> m plat-next) k0)
      (set! (-> m check-set) #f)
      )
    (when (and lv (< (-> m plat-next) k1))
      (let* ((k (-> m plat-next))
             (kind (the int (ow-map-elem k 0)))
             )
        (+! (-> m plat-next) 1)
        (when (and (>= kind OWM_LINE) (<= kind OWM_BOAT))
          (let ((slot -1))
            (dotimes (s OWM_MAX_PLATS)
              (if (and (< slot 0) (not (handle->process (-> m plats s))))
                  (set! slot s)
                  )
              )
            (when (>= slot 0)
              (let ((proc (get-process *default-dead-pool* ow-plat #x4000 1)))
                (when proc
                  ((method-of-type process activate) proc *entity-pool* "online-plateforme" (the-as pointer #x70004000))
                  (set! (-> (the-as process-drawable proc) level) lv)
                  (run-now-in-process proc ow-plat-init k)
                  (set! (-> m plats slot) (process->handle proc))
                  )
                )
              )
            )
          )
        (when (= kind OWM_FINISH)
          ;; l'orbe doree geante au-dessus de l'arrivee
          (let ((pos (new 'stack-no-clear 'vector)))
            (set-vector! pos (* (meters 1.0) (ow-map-elem k 1)) (+ (* (meters 1.0) (ow-map-elem k 2)) (meters 3.5)) (* (meters 1.0) (ow-map-elem k 3)) 1.0)
            (set! (-> m orb) (oe-spawn-orb-art pos 3.0))
            )
          )
        )
      )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; aller sur une carte / en revenir
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun ow-map-goto! ((i int))
  (when (and *target* (>= i 0) (< i OW_MAP_COUNT))
    (if (focus-test? *target* pilot)
        (send-event *target* 'end-mode 'pilot)
        )
    (format (clear (-> *ow-maps* str)) "~S-start" (-> *ow-map-levels* i))
    (let ((cp (get-continue-by-name *game-info* (-> *ow-maps* str))))
      (when cp
        ;; les plateformes de la carte actuelle partent AVANT son dechargement
        (ow-map-clear-plats!)
        (set! (-> *ow-maps* leaving-until) (+ (online-now) (seconds 5)))
        (set! (-> *ow-maps* boost-until) 0)
        (set! (-> *ow-maps* check-set) #f)
        (set! (-> *ow-maps* finished) #f)
        (start 'play cp)
        )
      )
    )
  (none)
  )

(defun ow-map-join! ()
  "rejoindre le parcours en cours"
  (let ((ext *online-ext*))
    (when (and (online-in-session?) (ow-evk-map? (the-as int (-> ext ev-kind))) (= (-> ext ev-state) 1))
      (set! (-> *ow-maps* joined) (-> ext ev-id))
      (set! (-> *ow-maps* leave-at) 0)
      (ow-map-goto! (the-as int (-> ext ev-boss)))
      )
    )
  (none)
  )

(defun ow-map-leave! ()
  "retour au port de Haven"
  (set! (-> *ow-maps* leave-at) 0)
  (set! (-> *ow-maps* check-set) #f)
  (set! (-> *ow-maps* leaving-until) (+ (online-now) (seconds 5)))
  (set! (-> *ow-maps* boost-until) 0)
  (ow-map-clear-plats!)
  (when *target*
    (let ((cp (get-continue-by-name *game-info* "ctyport-hiphog")))
      (if cp
          (start 'play cp)
          (start 'play (get-continue-by-name *game-info* "ctyport-start"))
          )
      )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; sur la carte : chute, points de passage, tremplins, vent, arrivee
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun ow-map-respawn! ((i int))
  "retour au dernier point de passage (ou au depart)"
  (let ((m *ow-maps*)
        (pos (new 'stack-no-clear 'vector))
        )
    (if (-> m check-set)
        (vector-copy! pos (-> m check))
        (set-vector! pos (* (meters 1.0) (-> *ow-map-start* (* i 4))) (* (meters 1.0) (-> *ow-map-start* (+ (* i 4) 1)))
                     (* (meters 1.0) (-> *ow-map-start* (+ (* i 4) 2))) 1.0)
        )
    (+! (-> pos y) (meters 0.8))
    (set-blackout-frames (seconds 0.3))
    (move-to-point! (-> *target* control) pos)
    (vector-reset! (-> *target* control transv))
    (send-event *camera* 'teleport)
    (sound-play "oof")
    )
  (none)
  )

(defun ow-map-in-zone? ((k int) (radius float) (above float) (below float))
  "Jak est-il sur la zone de l'element k ?"
  (let* ((tp (-> *target* control trans))
         (dx (- (-> tp x) (* (meters 1.0) (ow-map-elem k 1))))
         (dz (- (-> tp z) (* (meters 1.0) (ow-map-elem k 3))))
         (dy (- (-> tp y) (* (meters 1.0) (ow-map-elem k 2))))
         )
    (and (< (+ (* dx dx) (* dz dz)) (* radius radius))
         (< (- below) dy)
         (< dy above)
         )
    )
  )

(defun ow-map-count-elem ((i int) (kind int))
  "nombre d'elements de cette sorte sur la carte"
  (let ((n 0)
        (k (-> *ow-map-first* i))
        )
    (while (< k (-> *ow-map-first* (+ i 1)))
      (if (= (the int (ow-map-elem k 0)) kind)
          (+! n 1)
          )
      (+! k 1)
      )
    n
    )
  )

(define *ow-veh-free* #f) ;; course auto : le vehicule est prete (pas besoin de l'avoir achete)

(defun ow-turbos-tick! ((i int))
  "les TURBOS du circuit (vrais turbo-pickup du jeu : le vehicule les garde, R2 pour les lancer)"
  (let ((m *ow-maps*)
        (n 0)
        (k (-> *ow-map-first* i))
        (now (online-now))
        )
    (while (and (< k (-> *ow-map-first* (+ i 1))) (< n 16))
      (when (= (the int (ow-map-elem k 0)) OWM_TURBO)
        (cond
          ((handle->process (-> m turbos n))
           (set! (-> m turbo-gone n) now)
           )
          ((< (seconds 6) (- now (-> m turbo-gone n)))
           (let ((p (new 'stack-no-clear 'vector)))
             (set-vector! p (* (meters 1.0) (ow-map-elem k 1)) (+ (* (meters 1.0) (ow-map-elem k 2)) (meters 1.2))
                          (* (meters 1.0) (ow-map-elem k 3)) 1.0)
             (let ((tp (race-turbo-pickup-spawn (the-as process *entity-pool*) p)))
               (if tp
                   (set! (-> m turbos n) (process->handle tp))
                   )
               )
             )
           )
          )
        (+! n 1)
        )
      (+! k 1)
      )
    )
  (none)
  )

(defun ow-turbos-clear! ()
  (let ((m *ow-maps*))
    (dotimes (n 16)
      (let ((p (handle->process (-> m turbos n))))
        (if p
            (deactivate p)
            )
        )
      (set! (-> m turbos n) (the-as handle #f))
      (set! (-> m turbo-gone n) 0)
      )
    )
  (none)
  )

(defun ow-veh-rules-tick! ()
  "dans le monde en ligne, en vehicule : on peut TIRER (R1) et lancer ses TURBOS (R2), meme si
   l'histoire ne les a pas encore debloques"
  (let* ((m *ow-maps*)
         (want (and (online-in-session?) (-> *online-world* active) *target* (focus-test? *target* pilot)))
         )
    (cond
      ((and want (not (-> m veh-rules)))
       (set-setting-by-param *setting-control* 'gun #t 0 0)
       (set-setting-by-param *setting-control* 'turbo #t 0 0)
       (set! (-> m veh-rules) #t)
       )
      ((and (not want) (-> m veh-rules))
       (remove-setting-by-arg0 *setting-control* 'gun)
       (remove-setting-by-arg0 *setting-control* 'turbo)
       (set! (-> m veh-rules) #f)
       )
      )
    )
  (none)
  )

(defun ow-kart-tick! ((i int))
  "COURSE AUTO : place sur la grille, un vehicule pour chacun, points de passage dans l'ordre"
  (let ((m *ow-maps*)
        (ext *online-ext*)
        (t *target*)
        (now (online-now))
        )
    (ow-turbos-tick! i)
    (when (and t (ow-map-event? i) (= (-> ext ev-kind) ONLINE_EVK_KART) (not (-> m finished)) (not (focus-test? t dead)))
      ;; arrivee sur le circuit : ma place sur la grille (4 de front, rangees de 7 m)
      (when (!= (-> m race-placed) (-> ext ev-id))
        (set! (-> m race-placed) (-> ext ev-id))
        (set! (-> m race-next) 0)
        (set! (-> m race-veh) 0)
        (let* ((id (the-as int (-> *online-shm* my-id)))
               (lane (+ -1.5 (the float (logand id 3))))
               (row (the float (logand (shr id 2) 3)))
               (p (new 'stack-no-clear 'vector))
               )
          (set-vector! p (* (meters 1.0) (-> *ow-map-start* (* i 4))) (* (meters 1.0) (-> *ow-map-start* (+ (* i 4) 1)))
                       (* (meters 1.0) (-> *ow-map-start* (+ (* i 4) 2))) 1.0)
          (+! (-> p x) (* (meters -7.0) row))
          (+! (-> p z) (* (meters 3.6) lane))
          (format 0 "[jak3-online] course auto : place sur la grille ~M ~M ~M~%" (-> p x) (-> p y) (-> p z))
          (move-to-point! (-> t control) p)
          )
        )
      ;; pas (ou plus) de vehicule : on en recoit un (le Requin des sables, robuste)
      (when (and (not (focus-test? t pilot)) (< (seconds 4) (- now (-> m race-veh))))
        (set! (-> m race-veh) now)
        (set! *ow-veh-free* #t)
        (format 0 "[jak3-online] course auto : vehicule~%")
        (ow-spawn-vehicle! 45)
        (format 0 "[jak3-online] course auto : vehicule demande~%")
        (set! *ow-veh-free* #f)
        )
      )
    )
  (none)
  )

(defun ow-map-tick-inside! ((i int))
  (let* ((m *ow-maps*)
         (t *target*)
         (now (online-now))
         (ext *online-ext*)
         (k0 (-> *ow-map-first* i))
         (k1 (-> *ow-map-first* (+ i 1)))
         )
    (ow-map-spawn-plats! i)
    (ow-kart-tick! i)
    ;; l'orbe de l'arrivee tourne
    (let ((orb (the-as process-drawable (handle->process (-> m orb)))))
      (when orb
        (quaternion-axis-angle! (-> orb root quat) 0.0 1.0 0.0 (* 30000.0 (/ (the float now) 300.0)))
        (set-vector! (-> orb draw color-mult) 1.6 1.3 0.4 1.0)
        (set-vector! (-> orb draw color-emissive) 0.5 0.35 0.0 1.0)
        )
      )
    ;; GLACE : les plaques de glace des cartes sont marquees "gravier" (la vraie glace du jeu
    ;; n'existe pas dans Jak 3 : elle fait planter) ; dessus, Jak garde son elan et glisse
    (when (and t (not (focus-test? t dead))
               (logtest? (-> t control status) (collide-status on-surface))
               (= (-> t control ground-pat material) (pat-material gravel))
               (not (focus-test? t pilot))
               )
      (let ((v (vector-copy! (new 'stack-no-clear 'vector) (-> t control transv))))
        (set! (-> v y) 0.0)
        (when (< (meters 2.0) (vector-length v))
          (vector-float*! v v 0.75)
          (send-event t 'push-transv v (seconds 0.25))
          )
        )
      )
    ;; vol du tremplin : vitesse balistique imposee (boost-until = depart, boost-top = duree en s,
    ;; boost-vel = vitesse de depart, w = gravite)
    (when (and t (nonzero? (-> m boost-until)))
      (let ((el (/ (the float (- now (-> m boost-until))) 300.0)))
        (cond
          ((or (< (-> m boost-top) el) (focus-test? t dead))
           (set! (-> m boost-until) 0)
           )
          (else
            (let ((tv (-> t control transv)))
              (set! (-> tv x) (-> m boost-vel x))
              (set! (-> tv z) (-> m boost-vel z))
              (set! (-> tv y) (- (-> m boost-vel y) (* (-> m boost-vel w) el)))
              )
            )
          )
        )
      )
    (when (and t (not (focus-test? t dead)) (not (movie?)))
      ;; chute : sous la carte, dans la lave, dans l'eau
      (if (< (-> t control trans y) (* (meters 1.0) (-> *ow-map-kill-y* i)))
          (ow-map-respawn! i)
          )
      (let ((k k0)
            (mail-here -1)
            )
        (while (< k k1)
          (let ((kind (the int (ow-map-elem k 0))))
            (case kind
              ((OWM_CHECK)
               (when (ow-map-in-zone? k (* (meters 1.0) (ow-map-elem k 4)) (meters 4.0) (meters 1.5))
                 (let ((cx (* (meters 1.0) (ow-map-elem k 1)))
                       (cz (* (meters 1.0) (ow-map-elem k 3)))
                       )
                   (when (or (not (-> m check-set)) (< (meters 3.0) (+ (fabs (- cx (-> m check x))) (fabs (- cz (-> m check z))))))
                     (set-vector! (-> m check) cx (* (meters 1.0) (ow-map-elem k 2)) cz 1.0)
                     ;; course auto : c'est le prochain a franchir ?
                     (when (and (ow-map-event? i) (= (-> ext ev-kind) ONLINE_EVK_KART))
                       (let ((ord 0)
                             (q k0)
                             )
                         (while (< q k)
                           (if (= (the int (ow-map-elem q 0)) OWM_CHECK)
                               (+! ord 1)
                               )
                           (+! q 1)
                           )
                         (when (= ord (-> m race-next))
                           (+! (-> m race-next) 1)
                           (online-push-out-event! ONLINE_EVENT_EVENT (the-as uint 0) 0.0 (+ 10 ord) (-> t control trans))
                           (format (clear (-> m str)) (online-fr "Point de passage ~D / ~D" "Checkpoint ~D / ~D")
                                   (-> m race-next) (ow-map-count-elem i OWM_CHECK))
                           (ow-hint! (-> m str))
                           (sound-play "skill-pickup")
                           )
                         )
                       )
                     (when (and (-> m check-set) (not (and (ow-map-event? i) (= (-> ext ev-kind) ONLINE_EVK_KART))))
                       (ow-hint! (online-fr "Point de passage !" "Checkpoint!"))
                       (sound-play "skill-pickup")
                       )
                     (set! (-> m check-set) #t)
                     )
                   )
                 )
               )
              ((OWM_BOOST)
               ;; ACCELERATEUR : mon vehicule prend de la vitesse dans le sens de la fleche
               (let ((veh (ow-my-vehicle)))
                 (when (and veh (ow-map-in-zone? k (* (meters 1.0) (ow-map-elem k 4)) (meters 4.0) (meters 2.0))
                            (< (seconds 1) (- now (-> m boost-time))))
                   (set! (-> m boost-time) now)
                   (let ((dv (new 'stack-no-clear 'vector)))
                     (set-vector! dv (* (meters 1.0) (ow-map-elem k 5) (ow-map-elem k 6)) 0.0
                                  (* (meters 1.0) (ow-map-elem k 5) (ow-map-elem k 7)) 0.0)
                     (ow-vehicle-kick! veh dv)
                     )
                   (sound-play "launch-fire")
                   (ow-hint! (online-fr "TURBO !" "BOOST!"))
                   )
                 )
               )
              ((OWM_PAD)
               (when (and (ow-map-in-zone? k (* (meters 1.0) (ow-map-elem k 5)) (meters 1.2) (meters 0.8))
                          (< (seconds 0.8) (- now (-> m pad-time)))
                          (not (focus-test? t pilot))
                          )
                 (set! (-> m pad-time) now)
                 ;; TREMPLIN : un vrai vol balistique jusqu'a la plateforme d'arrivee (sommet 2,5 m
                 ;; au-dessus). La vitesse est imposee pendant tout le vol (le saut du jeu s'arrete
                 ;; quand on lache le bouton, et son "launch-dir" accroche le premier rebord).
                 (let* ((pad (new 'stack-no-clear 'vector))
                        (d (new 'stack-no-clear 'vector))
                        (g (fmax (meters 20.0) (-> t control dynam gravity-length)))
                        (h (fmax (meters 1.0) (+ (* (meters 1.0) (ow-map-elem k 4)) (meters 2.5))))
                        (vy (sqrtf (* 2.0 g h)))
                        (tt (+ (/ vy g) (sqrtf (/ (* 2.0 (meters 2.5)) g))))
                        )
                   (set-vector! pad (* (meters 1.0) (ow-map-elem k 1)) (* (meters 1.0) (ow-map-elem k 2)) (* (meters 1.0) (ow-map-elem k 3)) 1.0)
                   (set-vector! d (* (meters 1.0) (ow-map-elem k 6)) 0.0 (* (meters 1.0) (ow-map-elem k 7)) 0.0)
                   (+! (-> d x) (- (-> pad x) (-> t control trans x)))
                   (+! (-> d z) (- (-> pad z) (-> t control trans z)))
                   (set-vector! (-> m boost-vel) (/ (-> d x) tt) vy (/ (-> d z) tt) g)
                   (set! (-> m boost-top) tt)
                   (set! (-> m boost-until) now)
                   (send-event t 'launch (meters 2.0) (meters 2.0) (the-as surface #f) (-> m boost-vel))
                   (format 0 "[jak3-online] tremplin ~D : duree ~f~%" k tt)
                   (sound-play "launch-fire")
                   )
                 )
               )
              ((OWM_WIND)
               (when (ow-map-in-zone? k (* (meters 1.0) (ow-map-elem k 6)) (* (meters 1.0) (ow-map-elem k 7)) (meters 2.0))
                 (let ((a (* 182.04445 (ow-map-elem k 4)))
                       (f (* (meters 1.0) (ow-map-elem k 5)))
                       (v (new 'stack-no-clear 'vector))
                       )
                   (set-vector! v (* f (cos a)) 0.0 (* f (sin a)) 0.0)
                   (send-event t 'push-transv v (seconds 0.1))
                   )
                 )
               )
              ((OWM_MAIL)
               (when (ow-map-in-zone? k (meters 1.5) (meters 2.6) (meters 1.0))
                 (set! mail-here k)
                 (when (and (!= (-> m mail-k) k) (< (seconds 2) (- now (-> m mail-time))))
                   (set! (-> m mail-k) k)
                   (set! (-> m mail-time) now)
                   (cond
                     ((and (>= i OW_PARKOUR_COUNT) (online-in-session?)
                           (or (zero? *ow-house-owner*) (= *ow-house-owner* (-> *online-shm* my-id)))
                           )
                      ;; ma boite : le programme compte le courrier (orbes) depuis la derniere releve
                      (online-push-out-event! ONLINE_EVENT_MAIL (the-as uint 0) 0.0
                                              (+ (* 16 (- i OW_PARKOUR_COUNT)) (the int (ow-map-elem k 4)))
                                              (-> t control trans))
                      (sound-play "skill-pickup")
                      )
                     (else
                       (ow-hint! (online-fr "Boite aux lettres : seul le proprietaire peut relever le courrier" "Mailbox: only the owner can collect the mail"))
                       )
                     )
                   )
                 )
               )
              ((OWM_FINISH)
               (when (ow-map-in-zone? k (* (meters 1.0) (ow-map-elem k 4)) (meters 14.0) (meters 6.0))
                 (cond
                   ((and (ow-map-event? i) (= (-> ext ev-kind) ONLINE_EVK_KART) (< (-> m race-next) (ow-map-count-elem i OWM_CHECK)))
                    ;; course auto : il faut d'abord passer les points de passage (un tour complet)
                    (when (< (seconds 3) (- now (-> m hint-time)))
                      (set! (-> m hint-time) now)
                      (format (clear (-> m str)) (online-fr "Fais le tour ! Points de passage : ~D / ~D" "Do the lap! Checkpoints: ~D / ~D")
                              (-> m race-next) (ow-map-count-elem i OWM_CHECK))
                      (ow-hint! (-> m str))
                      )
                    )
                   ((and (ow-map-event? i) (!= (-> m finish-sent) (-> ext ev-id)))
                    (set! (-> m finish-sent) (-> ext ev-id))
                    (set! (-> m finished) #t)
                    (online-push-out-event! ONLINE_EVENT_EVENT (the-as uint 0) 0.0 5 (-> t control trans))
                    (sound-play "skill-pickup")
                    (ow-hint! (online-fr "ARRIVEE !" "FINISH!"))
                    )
                   ((and (not (ow-map-event? i)) (< (seconds 4) (- now (-> m hint-time))))
                    (set! (-> m hint-time) now)
                    (ow-hint! (online-fr "Arrivee ! (hors course : lance un PARCOURS pour gagner des orbes)" "Finish! (no race running: start a PARKOUR to win orbs)"))
                    )
                   )
                 )
               )
              )
            )
          (+! k 1)
          )
        ;; sorti de la boite : on pourra la relever a nouveau en y revenant
        (if (< mail-here 0)
            (set! (-> m mail-k) -1)
            )
        )
      )
    ;; la course est finie (un gagnant, ou le temps) : retour au port
    (when (and (!= (-> m joined) 0) (= (-> m joined) (-> ext ev-id)) (!= (-> ext ev-state) 1) (zero? (-> m leave-at)))
      (set! (-> m leave-at) (+ now (seconds 6)))
      )
    (when (and (nonzero? (-> m leave-at)) (< (-> m leave-at) now))
      (set! (-> m joined) (the-as uint 0))
      (ow-map-leave!)
      )
    )
  (none)
  )

(defun ow-map-countdown ()
  "secondes avant le depart automatique vers le parcours (-1 : pas de compte a rebours)"
  (let ((ext *online-ext*))
    (if (and (online-in-session?)
             (-> *online-world* active)
             (ow-evk-map? (the-as int (-> ext ev-kind)))
             (= (-> ext ev-state) 1)
             (!= (-> ext ev-id) (-> *ow-maps* joined))
             (!= (-> ext ev-id) (-> *ow-maps* declined))
             (< (- (-> ext ev-dur) (-> ext ev-timer)) 14.0)
             )
        (fmax 0.0 (- 12.0 (- (-> ext ev-dur) (-> ext ev-timer))))
        -1.0
        )
    )
  )

(defun ow-map-near-start? ((i int))
  "Jak est-il vraiment sur la carte (a moins de 1 km de son depart) ?"
  (and *target*
       (let ((dx (- (-> *target* control trans x) (* (meters 1.0) (-> *ow-map-start* (* i 4)))))
             (dz (- (-> *target* control trans z) (* (meters 1.0) (-> *ow-map-start* (+ (* i 4) 2)))))
             )
         (< (+ (* dx dx) (* dz dz)) (* (meters 1000.0) (meters 1000.0)))
         )
       )
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; LE VILLAGE DE JAK 1 : la mer (on y nage) et le REQUIN LURKER (repris du mod "Jak 4" de
;; l'utilisateur) : qui nage trop loin du rivage se fait manger, comme dans Jak 1. Regagner la
;; terre ferme a temps le fait repartir.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(def-actor ow-requin :bounds (0 0 0 6) :texture-level 11)

(defconstant OW_MER_J1 59.65) ;; la mer du village (metres, decalage du village compris)

(defun ow-dans-l-eau? ()
  "Jak touche l'eau (nage, pieds dans l'eau, sous l'eau)"
  (the symbol (and *target* (nonzero? (-> *target* water))
                   (logtest? (-> *target* water flags) (water-flag touch-water swimming under-water wading)))))

(deftype ow-requin (process-drawable)
  ((t0       time-frame)
   (mange?   symbol)
   (fini?    symbol)
   (proie    vector :inline)
   )
  (:state-methods chasse)
  )

;; une image de chasse (hors de la boucle du :code : sa pile sauvegardee est petite)
(defbehavior ow-requin-pas! ow-requin ()
  (let* ((age (* (/ 1.0 300.0) (the float (- (current-time) (-> self t0)))))
         (cible (if *target* (-> *target* control trans) (-> self proie)))
         (dir (vector-! (new 'stack-no-clear 'vector) cible (-> self root trans)))
         (sur-terre? (and *target* (> (-> cible y) (meters (+ OW_MER_J1 0.9)))
                          (logtest? (-> *target* control status) (collide-status on-surface))
                          (not (ow-dans-l-eau?))))
         (dist 0.0)
         )
    (set! (-> dir y) 0.0)
    (set! dist (vector-length dir))
    (cond
      ;; Jak a regagne la terre (ou n'est plus sur le village) : le requin repart
      ((and (not (-> self mange?)) (or sur-terre? (not *target*) (focus-test? *target* dead)))
       (set! (-> self fini?) #t)
       )
      ((and (not (-> self mange?))
            (or (< (meters 2.5) dist) (not (ow-dans-l-eau?)))
            )
       ;; il approche entre deux eaux, l'aileron dehors, de plus en plus vite
       (vector-normalize! dir (fmin (fmax 0.0 (- dist (meters 1.0)))
                                    (* (+ (meters 6.0) (* (meters 3.0) age)) (seconds-per-frame))))
       (vector+! (-> self root trans) (-> self root trans) dir)
       (set! (-> self root trans y) (- (meters OW_MER_J1) (meters 1.2)))
       (quaternion-axis-angle! (-> self root quat) 0.0 1.0 0.0 (atan (-> dir x) (-> dir z)))
       )
      (else
        ;; il jaillit sous Jak, gueule ouverte
        (when (not (-> self mange?))
          (set! (-> self mange?) #t)
          (set-time! (-> self t0))
          )
        (let ((t (* (/ 1.0 300.0) (the float (- (current-time) (-> self t0))))))
          (vector-copy! (-> self root trans) cible)
          (set! (-> self root trans y) (+ (- (meters OW_MER_J1) (meters 3.0)) (* (meters 5.0) (fmin 1.0 (* 2.5 t)))))
          (let ((q (new 'stack-no-clear 'quaternion)))
            (quaternion-axis-angle! q 1.0 0.0 0.0 -12000.0)
            (quaternion-axis-angle! (-> self root quat) 0.0 1.0 0.0 (atan (-> dir x) (-> dir z)))
            (quaternion*! (-> self root quat) (-> self root quat) q)
            )
          (when (and (< 0.3 t) (< t 0.36) *target* (not (focus-test? *target* dead)))
            (sound-play "splash" :position #f)
            (sound-play "punch-hit" :position #f)
            (activate! *camera-smush-control* 1638.4 37 300 1.0 1.1 (-> *display* camera-clock))
            (send-event *target* 'attack-invinc #f
                        (static-attack-info ((id (new-attack-id)) (damage 100.0) (mode 'drown-death)))
                        )
            )
          (if (< 2.0 t)
              (set! (-> self fini?) #t)
              )
          )
        )
      )
    )
  (none)
  )

(defstate chasse (ow-requin)
  :virtual #t
  :code (behavior ()
    (sound-play "splash" :position (-> self root trans))
    (set! (-> self mange?) #f)
    (set! (-> self fini?) #f)
    (until (-> self fini?)
      (ow-requin-pas!)
      (suspend)
      )
    (deactivate self)
    )
  :post ja-post
  )

(defbehavior ow-requin-init-by-other ow-requin ((pos vector))
  (set! (-> self root) (new 'process 'trsqv))
  (vector-copy! (-> self root trans) pos)
  (vector-copy! (-> self proie) pos)
  (quaternion-identity! (-> self root quat))
  (set-vector! (-> self root scale) 1.3 1.3 1.3 1.0)
  (set-time! (-> self t0))
  (initialize-skeleton self (the-as skeleton-group *ow-requin-sg*) (the-as pair 0))
  ;; art dans GAME : dessine dans les files du niveau ou est Jak (comme les personnages)
  (ow-perso-draw-level! (-> self draw) #t)
  (logclear! (-> self mask) (process-mask actor-pause))
  (go-virtual chasse)
  )

(deftype ow-mer-garde (structure)
  ((t-sur     time-frame)
   (t-nage    time-frame)
   (t-requin  time-frame)
   (requin    handle)
   (sur       vector :inline)   ;; dernier point sur la terre ferme
   )
  )

(define *ow-mer* (new 'static 'ow-mer-garde))
;; handle vide = #f (un handle a 0 ferait lire l'adresse 0 dans handle->process)
(set! (-> *ow-mer* requin) (the-as handle #f))

(defun ow-water-tick! ((i int))
  "l'eau des cartes du mod (mer, piscines, bassins) : on y nage. Choisit l'eau sous Jak (la plus haute)"
  (let ((best -1)
        (top -1000000000.0)
        )
    (when (and *target* (>= i 0) (< i OW_MAP_COUNT))
      (let ((jp (-> *target* control trans))
            (k (-> *ow-map-first* i))
            (k1 (-> *ow-map-first* (+ i 1)))
            )
        (while (< k k1)
          (when (= (the int (ow-map-elem k 0)) OWM_WATER)
            (let ((y (* (meters 1.0) (ow-map-elem k 2))))
              (when (and (< (fabs (- (-> jp x) (* (meters 1.0) (ow-map-elem k 1)))) (* (meters 1.0) (ow-map-elem k 4)))
                         (< (fabs (- (-> jp z) (* (meters 1.0) (ow-map-elem k 3)))) (* (meters 1.0) (ow-map-elem k 5)))
                         (< (-> jp y) (+ y (meters 4.0)))
                         (< (- y (* (meters 1.0) (ow-map-elem k 6)) (meters 3.0)) (-> jp y))
                         (< top y)
                         )
                (set! best k)
                (set! top y)
                )
              )
            )
          (+! k 1)
          )
        )
      )
    (cond
      ((>= best 0)
       (set! *online-sea-y* top)
       (set! *online-sea-x0* (* (meters 1.0) (- (ow-map-elem best 1) (ow-map-elem best 4))))
       (set! *online-sea-x1* (* (meters 1.0) (+ (ow-map-elem best 1) (ow-map-elem best 4))))
       (set! *online-sea-z0* (* (meters 1.0) (- (ow-map-elem best 3) (ow-map-elem best 5))))
       (set! *online-sea-z1* (* (meters 1.0) (+ (ow-map-elem best 3) (ow-map-elem best 5))))
       )
      (else
        (set! *online-sea-y* -1000000000.0)
        )
      )
    )
  (none)
  )

(defun ow-mer-tick! ((i int))
  "la mer du village (nage) et son requin"
  (ow-water-tick! i)
  (let ((g *ow-mer*))
    (cond
      ((and (= i 0) *target*)
       (let ((jp (-> *target* control trans)))
         (when (and (logtest? (-> *target* control status) (collide-status on-surface))
                    (> (-> jp y) (meters (+ OW_MER_J1 1.2)))
                    (time-elapsed? (-> g t-sur) (seconds 0.5))
                    )
           (set-time! (-> g t-sur))
           (vector-copy! (-> g sur) jp)
           )
         (cond
           ((not (ow-dans-l-eau?))
            (set-time! (-> g t-nage))
            )
           ((and (time-elapsed? (-> g t-nage) (seconds 3))
                 (< (meters 26.0) (vector-vector-xz-distance jp (-> g sur)))
                 (time-elapsed? (-> g t-requin) (seconds 12))
                 (not (handle->process (-> g requin)))
                 (nonzero? *ow-requin-sg*)
                 )
            (set-time! (-> g t-requin))
            (set! *ow-owcom-sticky* #t)
            (ow-hint! (online-fr "UN REQUIN LURKER ! Regagne vite la terre !" "A LURKER SHARK! Get back to land!"))
            (let ((p (new 'stack-no-clear 'vector))
                  (a (* 65536.0 (rand-vu)))
                  )
              (set-vector! p (+ (-> jp x) (* (meters 28.0) (sin a))) (- (meters OW_MER_J1) (meters 1.2))
                           (+ (-> jp z) (* (meters 28.0) (cos a))) 1.0)
              (let ((pp (process-spawn ow-requin p :name "ow-requin" :to *entity-pool* :stack-size #x4000)))
                (if pp
                    (set! (-> g requin) (ppointer->handle pp))
                    )
                )
              )
            )
           )
         )
       )
      (else
        (let ((r (handle->process (-> g requin))))
          (if r
              (deactivate r)
              )
          )
        (set! (-> g requin) (the-as handle #f))
        )
      )
    )
  (none)
  )

(define-extern ow-map-find-elem (function int int int int))
(define-extern ow-map-test-goto-elem! (function int float none))

(defun ow-maisons-test! ((arg int))
  "banc de test : 630 + n = aller a la boite aux lettres n de la carte ; 640 + n = dans l'eau n ;
   645 = pad 38 : 1 nage, 2 bateau(x) pose(s), 4 dans une boite"
  (let ((i (ow-map-current)))
    (cond
      ((and (>= arg 630) (< arg 640) (>= i 0))
       (ow-map-test-goto-elem! (ow-map-find-elem i OWM_MAIL (+ arg -630)) (meters 0.3))
       )
      ((and (>= arg 640) (< arg 645) (>= i 0))
       (let ((k (ow-map-find-elem i OWM_WATER (+ arg -640))))
         (when (and (>= k 0) *target*)
           (let ((p (new 'stack-no-clear 'vector)))
             (set-vector! p (* (meters 1.0) (+ (ow-map-elem k 1) (* 0.6 (ow-map-elem k 4))))
                          (* (meters 1.0) (- (ow-map-elem k 2) 0.9))
                          (* (meters 1.0) (ow-map-elem k 3)) 1.0)
             (move-to-point! (-> *target* control) p)
             (vector-reset! (-> *target* control transv))
             )
           )
         )
       )
      ((and (>= arg 690) (< arg 697) *target* (>= i 0))
       ;; 690 + n : a pied au n-ieme point de passage ; 695 : a l'arrivee ; 696 : au personnage rouge
       (if (focus-test? *target* pilot)
           (send-event *target* 'end-mode 'pilot)
           )
       (cond
         ((< arg 695)
          (ow-map-test-goto-elem! (ow-map-find-elem i OWM_CHECK (+ arg -690)) (meters 0.6))
          )
         ((= arg 695)
          (ow-map-test-goto-elem! (ow-map-find-elem i OWM_FINISH 0) (meters 0.6))
          )
         (else
           (let ((npc (the-as process-drawable (handle->process (-> *ow-maps* hide-npc)))))
             (when npc
               (let ((p (vector-copy! (new 'stack-no-clear 'vector) (-> npc root trans))))
                 (+! (-> p x) (meters 1.0))
                 (+! (-> p y) (meters 0.3))
                 (move-to-point! (-> *target* control) p)
                 )
               )
             )
           )
         )
       )
      ((= arg 697)
       ;; pad 41 : 1 je pilote, 2 personnage rouge present, 4 je suis teinte en bleu ; pad 42 = points de passage
       (set! (-> *online-shm* local pad 37)
             (the-as uint (logior (if (focus-test? *target* pilot) 1 0)
                                  (if (handle->process (-> *ow-maps* hide-npc)) 2 0)
                                  (if (-> *ow-maps* tinted) 4 0))))
       (set! (-> *online-shm* local pad 38) (the-as uint (-> *ow-maps* race-next)))
       )
      ((= arg 645)
       (let ((boats 0))
         (dotimes (s OWM_MAX_PLATS)
           (let ((p (the-as ow-plat (handle->process (-> *ow-maps* plats s)))))
             (if (and p (= (-> p kind) OWM_BOAT))
                 (+! boats 1)
                 )
             )
           )
         (set! (-> *online-shm* local pad 38)
               (the-as uint (logior (if (ow-dans-l-eau?) 1 0) (if (> boats 0) 2 0) (if (>= (-> *ow-maps* mail-k) 0) 4 0)))
               )
         )
       )
      )
    )
  (none)
  )

(defun ow-mer-test! ((arg int))
  "banc de test : 579 = au large (dans la mer du village), 580 = pad 36 : 1 nage, 2 requin"
  (case arg
    ((579)
     (when *target*
       (let ((p (new 'stack-no-clear 'vector)))
         (set-vector! p (meters -2450.0) (meters 62.0) (meters 1600.0) 1.0)
         (move-to-point! (-> *target* control) p)
         )
       )
     )
    ((580)
     (if *target*
         (format 0 "[jak3-online] mer : carte ~D  mer ~M  jak y ~M  eau flags #x~X  hauteur ~M~%"
                 (ow-map-current) *online-sea-y* (-> *target* control trans y)
                 (-> *target* water flags) (-> *target* water height))
         )
     (set! (-> *online-shm* local pad 36)
           (the-as uint (logior (if (ow-dans-l-eau?) 1 0) (if (handle->process (-> *ow-mer* requin)) 2 0)))
           )
     )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; CACHE-CACHE (manoir) : un personnage ROUGE (Keira) est cache a l'une des 10 cachettes (tiree au
;; sort par l'autorite, la meme pour tous) ; tout le monde est BLEU ; le premier qui le touche gagne.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; cachettes (metres, par rapport au centre du manoir 1500 100 -3000)
(define *ow-hide-spots* (new 'static 'array float 30
  -42.5 0.2 -27.5   44.0 0.2 14.5   -15.0 5.45 22.0   6.0 10.45 19.5   0.0 0.1 -17.0
  -55.0 0.1 30.0    6.0 0.45 2.4    55.0 0.1 -40.0    -14.0 0.45 17.5  16.0 0.45 21.5))

(deftype ow-cache (process-drawable)
  ((t0   time-frame)
   (base vector :inline)
   )
  (:states
    ow-cache-idle
    )
  )

(defstate ow-cache-idle (ow-cache)
  :code (behavior ()
    (until #f
      ;; il se balance doucement (on le repere a son mouvement)
      (let ((t (* (/ 1.0 300.0) (the float (- (current-time) (-> self t0))))))
        (vector-copy! (-> self root trans) (-> self base))
        (+! (-> self root trans y) (* (meters 0.12) (sin (* 65536.0 (* 0.5 t)))))
        (quaternion-axis-angle! (-> self root quat) 0.0 1.0 0.0 (* 16384.0 (sin (* 65536.0 (* 0.15 t)))))
        (set-vector! (-> self draw color-mult) 2.2 0.35 0.3 1.0)
        (set-vector! (-> self draw color-emissive) 0.35 0.0 0.0 1.0)
        )
      (suspend)
      )
    #f
    )
  :post ja-post
  )

(defbehavior ow-cache-init-by-other ow-cache ((pos vector))
  (set! (-> self root) (new 'process 'trsqv))
  (vector-copy! (-> self root trans) pos)
  (vector-copy! (-> self base) pos)
  (quaternion-identity! (-> self root quat))
  (vector-identity! (-> self root scale))
  (set-time! (-> self t0))
  (initialize-skeleton self (the-as skeleton-group *ow-keira-sg*) (the-as pair 0))
  (ow-perso-draw-level! (-> self draw) #t)
  (logclear! (-> self mask) (process-mask actor-pause))
  (go ow-cache-idle)
  )

(defun ow-tint-players! ((r float) (g float) (b float))
  "teinte mon Jak et les autres joueurs (cache-cache : tout le monde en bleu)"
  (if *target*
      (set-vector! (-> *target* draw color-mult) r g b 1.0)
      )
  (dotimes (i ONLINE_MAX_PUPPETS)
    (let ((p (online-puppet-proc i)))
      (when p
        (set-vector! (-> p draw color-mult) r g b 1.0)
        (dotimes (k ONLINE_PART_SLOTS)
          (let ((part (the-as process-drawable (handle->process (-> p parts k)))))
            (if (and part (nonzero? (-> part draw)))
                (set-vector! (-> part draw color-mult) r g b 1.0)
                )
            )
          )
        )
      )
    )
  (none)
  )

(defun ow-hide-tick! ((i int))
  (let* ((m *ow-maps*)
         (ext *online-ext*)
         (t *target*)
         (on (and t (= i OW_MAP_HIDE) (ow-map-event? i) (= (-> ext ev-kind) ONLINE_EVK_HIDE)))
         )
    (cond
      (on
        ;; tout le monde en bleu
        (ow-tint-players! 0.45 0.65 1.9)
        (set! (-> m tinted) #t)
        ;; le personnage rouge a sa cachette
        (let ((k (* 3 (mod (the-as int (-> ext ev-target)) 10))))
          (when (and (not (handle->process (-> m hide-npc))) (nonzero? *ow-keira-sg*))
            (let ((p (new 'stack-no-clear 'vector)))
              (set-vector! p (meters (+ 1500.0 (-> *ow-hide-spots* k))) (meters (+ 100.0 (-> *ow-hide-spots* (+ k 1))))
                           (meters (+ -3000.0 (-> *ow-hide-spots* (+ k 2)))) 1.0)
              (let ((pp (process-spawn ow-cache p :name "ow-cache" :to *entity-pool*)))
                (if pp
                    (set! (-> m hide-npc) (ppointer->handle pp))
                    )
                )
              )
            )
          ;; trouve !
          (let ((npc (the-as process-drawable (handle->process (-> m hide-npc)))))
            (when (and npc (!= (-> m hide-found) (-> ext ev-id)) (not (focus-test? t dead))
                       (< (vector-vector-distance (-> t control trans) (-> npc root trans)) (meters 2.0)))
              (set! (-> m hide-found) (-> ext ev-id))
              (set! (-> m finished) #t)
              (set! (-> m finish-sent) (-> ext ev-id))
              (online-push-out-event! ONLINE_EVENT_EVENT (the-as uint 0) 0.0 5 (-> t control trans))
              (sound-play "skill-pickup")
              (ow-hint! (online-fr "TROUVE !" "FOUND!"))
              )
            )
          )
        )
      (else
        (let ((npc (handle->process (-> m hide-npc))))
          (if npc
              (deactivate npc)
              )
          )
        (set! (-> m hide-npc) (the-as handle #f))
        (when (-> m tinted)
          (set! (-> m tinted) #f)
          (ow-tint-players! 1.0 1.0 1.0)
          )
        )
      )
    )
  (none)
  )

(defun ow-maps-tick! ()
  (ow-veh-rules-tick!)
  (if (!= (ow-map-current) OW_MAP_CIRCUIT)
      (if (handle->process (-> *ow-maps* turbos 0))
          (ow-turbos-clear!)
          )
      )
  (ow-mer-tick! (ow-map-current))
  (ow-hide-tick! (ow-map-current))
  (let ((i (ow-map-current))
        (m *ow-maps*)
        (ext *online-ext*)
        )
    ;; banc de test (Jak3Online.exe) : carte, plateformes, point de passage
    (let ((loc (-> *online-shm* local))
          (n 0)
          )
      (dotimes (s OWM_MAX_PLATS)
        (if (handle->process (-> m plats s))
            (+! n 1)
            )
        )
      (set! (-> loc pad 11) (the-as uint (+ i 1)))
      (set! (-> loc pad 16) (the-as uint n))
      (set! (-> loc pad 18) (the-as uint (if (-> m check-set) 1 0)))
      )
    (cond
      ((>= i 0)
       ;; pendant un depart (la carte est encore chargee, Jak deja ailleurs) : rien
       (if (and (< (-> m leaving-until) (online-now)) (ow-map-near-start? i))
           (ow-map-tick-inside! i)
           )
       )
      ((>= (-> m plat-map) 0)
       (ow-map-clear-plats!)
       )
      )
    ;; depart automatique (ROND pendant le compte a rebours : je ne participe pas), aussi depuis
    ;; une maison (cartes OW_PARKOUR_COUNT et suivantes)
    (when (or (< i 0) (>= i OW_PARKOUR_COUNT))
      (let ((cd (ow-map-countdown)))
        (when (<= 0.0 cd)
          (cond
            ((cpad-pressed? 0 circle)
             (set! (-> m declined) (-> ext ev-id))
             (ow-hint! (online-fr "Tu ne participes pas (menu SELECT / EVENEMENTS pour rejoindre)" "You are not taking part (SELECT menu / EVENTS to join)"))
             )
            ((and (<= cd 0.0) *target* (not (movie?)) (not (focus-test? *target* dead)) (not *progress-process*))
             (ow-map-join!)
             )
            )
          )
        )
      )
    )
  (none)
  )

(defun ow-map-draw-banner! ((y float))
  "bandeau de l'evenement PARCOURS (centre de l'ecran)"
  (let* ((ext *online-ext*)
         (m *ow-maps*)
         (s (-> m str))
         (i (the-as int (-> ext ev-boss)))
         (cd (ow-map-countdown))
         )
    (cond
      ((<= 0.0 cd)
       (format (clear s) (case (the-as int (-> ext ev-kind))
                           ((ONLINE_EVK_KART) (online-fr "COURSE AUTO : ~S  -  depart dans ~D s" "CAR RACE: ~S  -  starting in ~D s"))
                           ((ONLINE_EVK_HIDE) (online-fr "CACHE-CACHE : ~S  -  depart dans ~D s" "HIDE AND SEEK: ~S  -  starting in ~D s"))
                           (else (online-fr "PARCOURS : ~S  -  depart dans ~D s" "PARKOUR: ~S  -  starting in ~D s"))
                           )
               (ow-map-name i) (+ 1 (the int cd)))
       (ow-text-mid s y 0.42 (font-color flat-yellow))
       (format (clear s) (case (the-as int (-> ext ev-kind))
                           ((ONLINE_EVK_KART) (online-fr "un tour, un vehicule pour chacun : le premier gagne ~D orbes  -  ROND : ne pas participer" "one lap, a car for everyone: the first wins ~D orbs  -  CIRCLE: do not take part"))
                           ((ONLINE_EVK_HIDE) (online-fr "trouve le personnage ROUGE : ~D orbes  -  ROND : ne pas participer" "find the RED character: ~D orbs  -  CIRCLE: do not take part"))
                           (else (online-fr "le premier en haut gagne ~D orbes  -  ROND : ne pas participer" "first to the top wins ~D orbs  -  CIRCLE: do not take part"))
                           )
               (if (= (-> ext ev-kind) ONLINE_EVK_HIDE) 2500 (-> *ow-map-reward* (max 0 (min i (+ OW_MAP_COUNT -1))))))
       (ow-text-mid s (+ y 14.0) 0.3 (font-color white))
       )
      ((and (= (ow-map-current) i) (= (-> ext ev-kind) ONLINE_EVK_KART))
       (format (clear s) (online-fr "COURSE AUTO  -  points de passage ~D / ~D  -  ~S" "CAR RACE  -  checkpoints ~D / ~D  -  ~S")
               (-> *ow-maps* race-next) (ow-map-count-elem i OWM_CHECK) (oe-time-text (-> *online-world* str3) (-> ext ev-timer)))
       (ow-text-mid s y 0.42 (font-color flat-yellow))
       (ow-text-mid (if (-> m finished) (online-fr "ARRIVE !  en attente du resultat..." "FINISHED!  waiting for the result...")
                        (online-fr "fonce ! les fleches bleues au sol = TURBO" "go! blue arrows on the ground = BOOST"))
                    (+ y 14.0) 0.3 (font-color white))
       )
      ((and (= (ow-map-current) i) (= (-> ext ev-kind) ONLINE_EVK_HIDE))
       (format (clear s) (online-fr "CACHE-CACHE  -  trouve le personnage ROUGE !  -  ~S" "HIDE AND SEEK  -  find the RED character!  -  ~S")
               (oe-time-text (-> *online-world* str3) (-> ext ev-timer)))
       (ow-text-mid s y 0.42 (font-color red))
       (ow-text-mid (if (-> m finished) (online-fr "TROUVE !  en attente du resultat..." "FOUND!  waiting for the result...")
                        (online-fr "il se cache dans le manoir ou le jardin : touche-le le premier (2500 orbes)" "hidden in the manor or the garden: touch it first (2500 orbs)"))
                    (+ y 14.0) 0.3 (font-color white))
       )
      ((= (ow-map-current) i)
       (format (clear s) (online-fr "PARCOURS : ~S  -  difficulte ~D/5  -  ~S" "PARKOUR: ~S  -  difficulty ~D/5  -  ~S")
               (ow-map-name i) (-> *ow-map-stars* (max 0 (min i (+ OW_MAP_COUNT -1))))
               (oe-time-text (-> *online-world* str3) (-> ext ev-timer)))
       (ow-text-mid s y 0.42 (font-color flat-yellow))
       (format (clear s) (if (-> m finished)
                             (online-fr "ARRIVE !  en attente du resultat..." "FINISHED!  waiting for the result...")
                             (online-fr "le premier en haut gagne ~D orbes !" "first to the top wins ~D orbs!")
                             )
               (-> *ow-map-reward* (max 0 (min i (+ OW_MAP_COUNT -1)))))
       (ow-text-mid s (+ y 14.0) 0.3 (font-color white))
       )
      (else
        (format (clear s) (online-fr "PARCOURS EN COURS : ~S  -  ~S" "PARKOUR RUNNING: ~S  -  ~S") (ow-map-name i)
                (oe-time-text (-> *online-world* str3) (-> ext ev-timer)))
        (ow-text-mid s y 0.4 (font-color flat-yellow))
        (ow-text-mid (online-fr "menu SELECT / EVENEMENTS : rejoindre" "SELECT menu / EVENTS: join") (+ y 14.0) 0.3 (font-color white))
        )
      )
    )
  (none)
  )

(defun ow-map-find-elem ((i int) (kind int) (nth int))
  "numero du n-ieme element de cette sorte sur la carte (-1 : aucun)"
  (let ((res -1)
        (n 0)
        (k (-> *ow-map-first* i))
        )
    (while (< k (-> *ow-map-first* (+ i 1)))
      (when (and (< res 0) (= (the int (ow-map-elem k 0)) kind))
        (if (= n nth)
            (set! res k)
            )
        (+! n 1)
        )
      (+! k 1)
      )
    res
    )
  )

(defun ow-map-test-goto-elem! ((k int) (up float))
  (when (and (>= k 0) *target*)
    (let ((pos (new 'stack-no-clear 'vector)))
      (set-vector! pos (* (meters 1.0) (ow-map-elem k 1)) (+ (* (meters 1.0) (ow-map-elem k 2)) up) (* (meters 1.0) (ow-map-elem k 3)) 1.0)
      (move-to-point! (-> *target* control) pos)
      (vector-reset! (-> *target* control transv))
      (send-event *camera* 'teleport)
      )
    )
  (none)
  )

;; banc de test : aller sur une carte (Jak3Online.exe --cartes)
(defun online-maps-test! ((arg int))
  (cond
    ((= arg 441)
     ;; chute dans le vide
     (when *target*
       (let ((pos (vector-copy! (new 'stack-no-clear 'vector) (-> *target* control trans))))
         (set! (-> pos y) (- (-> pos y) (meters 80.0)))
         (move-to-point! (-> *target* control) pos)
         )
       )
     )
    ((= arg 442)
     ;; sur le premier tremplin (banc de test : pad 25 = 1 si la carte en a un)
     (let* ((i (ow-map-current))
            (k (if (>= i 0) (ow-map-find-elem i OWM_PAD 0) -1))
            )
       (set! (-> *online-shm* local pad 25) (the-as uint (if (>= k 0) 1 0)))
       (if (>= k 0) (ow-map-test-goto-elem! k (meters 0.3)))
       )
     )
    ((= arg 443)
     (let ((i (ow-map-current)))
       (if (>= i 0) (ow-map-test-goto-elem! (ow-map-find-elem i OWM_CHECK 1) (meters 0.5)))
       )
     )
    ((= arg 444)
     (let ((i (ow-map-current)))
       (if (>= i 0) (ow-map-test-goto-elem! (ow-map-find-elem i OWM_FINISH 0) (meters 0.5)))
       )
     )
    ((= arg 410)
     (ow-map-leave!)
     )
    ((and (>= arg 400) (< arg 410) (< arg (+ 400 OW_MAP_COUNT)))
     ;; (les maisons, cartes 8 a 10 : commandes 540 et suivantes)
     (ow-map-goto! (- arg 400))
     )
    ((and (>= arg 420) (< arg 440))
     ;; (au-dessus de l'element, pour atterrir sur les plateformes)
     ;; se placer sur l'element n de la carte en cours (points de passage, arrivee...)
     (let ((i (ow-map-current)))
       (when (>= i 0)
         (let ((k (+ (-> *ow-map-first* i) (- arg 420))))
           (when (< k (-> *ow-map-first* (+ i 1)))
             (let ((pos (new 'stack-no-clear 'vector)))
               (set-vector! pos (* (meters 1.0) (ow-map-elem k 1)) (+ (* (meters 1.0) (ow-map-elem k 2)) (meters 1.0)) (* (meters 1.0) (ow-map-elem k 3)) 1.0)
               (move-to-point! (-> *target* control) pos)
               (send-event *camera* 'teleport)
               )
             )
           )
         )
       )
     )
    )
  (none)
  )
