(define *ow-map-names-en* (new 'static 'boxed-array :type string "Jak 1 village" "Sky tower" "Volcano" "Glacier" "Paris"))
(define *ow-map-stars* (new 'static 'array int32 5 1 3 4 4 5))
(define *ow-map-reward* (new 'static 'array int32 5 900 2000 3000 3000 4000))
(define *ow-map-kill-y* (new 'static 'array float 5 40.00 275.00 200.80 175.00 96.00))
