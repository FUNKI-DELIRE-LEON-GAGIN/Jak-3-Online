(defun online-tr-col ((lang int))
  "colonne de traduction de la langue du jeu (#f : francais / anglais)"
  (case lang
    ((2) *online-tr-de*)
    ((3) *online-tr-es*)
    ((4) *online-tr-it*)
    ((6) *online-tr-ja*)
    ((7) *online-tr-ko*)
    ((8) *online-tr-ru*)
    ((9) *online-tr-pt*)
    ((10) *online-tr-nl*)
    ((12) *online-tr-fi*)
    ((13) *online-tr-sv*)
    ((14) *online-tr-da*)
    ((15) *online-tr-no*)
    ((16) *online-tr-ptbr*)
    ((17) *online-tr-hu*)
    ((18) *online-tr-ca*)
    ((19) *online-tr-is*)
    ((20) *online-tr-pl*)
    ((21) *online-tr-lt*)
    ((22) *online-tr-cs*)
    ((23) *online-tr-hr*)
    ((24) *online-tr-gl*)
    (else (the-as (array string) #f))
    )
  )

;; cache : adresse du texte anglais -> numero de la cle (les textes du code sont statiques)
(define *online-tr-cache-key* (new 'static 'array uint32 1024))
(define *online-tr-cache-val* (new 'static 'array int16 1024))

(defun online-tr-index ((en string))
  "numero de la cle du texte anglais, -1 si inconnu"
  (let* ((addr (the-as uint en))
         (h (logand (shr addr 3) 1023))
         (found -2)
         )
    (dotimes (k 8)
      (when (= found -2)
        (let ((slot (logand (+ h k) 1023)))
          (cond
            ((= (-> *online-tr-cache-key* slot) addr)
             (set! found (-> *online-tr-cache-val* slot))
             )
            ((zero? (-> *online-tr-cache-key* slot))
             (let ((idx -1))
               (dotimes (i (-> *online-tr-keys* length))
                 (if (and (< idx 0) (string= (-> *online-tr-keys* i) en))
                     (set! idx i)
                     )
                 )
               (set! (-> *online-tr-cache-key* slot) addr)
               (set! (-> *online-tr-cache-val* slot) idx)
               (set! found idx)
               )
             )
            )
          )
        )
      )
    (if (= found -2)
        ;; cache plein a cet endroit : recherche directe
        (let ((idx -1))
          (dotimes (i (-> *online-tr-keys* length))
            (if (and (< idx 0) (string= (-> *online-tr-keys* i) en))
                (set! idx i)
                )
            )
          (set! found idx)
          )
        )
    found
    )
  )

(defun online-tr ((en string) (fr string))
  "le texte dans la langue du jeu"
  (let ((lang (the-as int (-> *pc-settings* text-language))))
    (cond
      ((= lang 1) fr)
      ((or (= lang 0) (= lang 5) (= lang 11)) en)
      (else
        (let ((col (online-tr-col lang)))
          (if col
              (let ((i (online-tr-index en)))
                (if (and (>= i 0) (< i (-> col length)) (nonzero? (length (-> col i))))
                    (-> col i)
                    en
                    )
                )
              en
              )
          )
        )
      )
    )
  )

(define *online-enc-str* (new 'global 'string 2048 (the-as string #f)))

(defun online-encode ((s string))
  "texte UTF-8 -> codage de la police du jeu (accents, cyrillique, japonais, coreen...)"
  (let ((plain #t)
        (n (length s))
        )
    (dotimes (i n)
      (if (>= (-> s data i) 128)
          (set! plain #f)
          )
      )
    (cond
      (plain s)
      (else
        (clear *online-enc-str*)
        (pc-encode-utf8-string s *online-enc-str*)
        *online-enc-str*
        )
      )
    )
  )
